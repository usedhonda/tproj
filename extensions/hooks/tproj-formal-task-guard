#!/usr/bin/env python3
"""Admission hook for mutations while a unified formal task is assigned."""
from __future__ import annotations
import json, os, sys, sqlite3, shlex
from pathlib import Path
from importlib.machinery import SourceFileLoader

ROOT = Path(__file__).resolve().parents[2]
_unified = ROOT / "extensions/messaging/unified"
if not _unified.is_dir():
    _unified = Path.home() / "lib/tproj-msg-unified"
try:
    sys.path.insert(0, str(_unified))
    import cli  # type: ignore
except ImportError:
    cli = None
_guard_path = ROOT / "extensions/hooks/tproj-mutation-guard"
if not _guard_path.is_file():
    _guard_path = Path(__file__).with_name("tproj-mutation-guard")
guard = SourceFileLoader("tproj_mutation_guard", str(_guard_path)).load_module()

def payload() -> dict:
    try: value = json.load(sys.stdin)
    except (ValueError, OSError): return {}
    return value if isinstance(value, dict) else {}

def tool_name(data):
    return str(data.get("tool_name") or data.get("hook_input", {}).get("tool_name") or "")

def tool_id(data):
    for key in ("tool_use_id", "tool_call_id", "id"):
        value = data.get(key)
        if isinstance(value, str) and value: return value
    for root in (data.get("hook_input"), data.get("raw_event")):
        if isinstance(root, dict):
            for key in ("tool_use_id", "tool_call_id", "id"):
                value = root.get(key)
                if isinstance(value, str) and value: return value
    return ""

def command(data):
    _name, value = guard.parse_command(data)
    return value

def lifecycle(value):
    text = value.strip()
    if not text or guard.AMBIGUOUS_SHELL_RE.search(text): return False
    try: argv = shlex.split(text)
    except ValueError: return False
    return len(argv) >= 2 and argv[0] in {"tproj-msg", "tproj-task"}

def native_ids(data):
    found = {os.environ.get("CODEX_THREAD_ID", ""), os.environ.get("CODEX_SESSION_ID", "")}
    for root in (data, data.get("hook_input"), data.get("raw_event")):
        if isinstance(root, dict):
            for key in ("session_id", "conversation_id", "thread_id"):
                if root.get(key): found.add(str(root[key]))
    return {item for item in found if item}

def assigned(data):
    ids = native_ids(data)
    if not ids: return False
    try:
        host_cfg_path = Path(os.environ.get("TPROJ_MSG_HOST_CONFIG", str(Path.home()/".config/tproj/msg-host.json")))
        host_cfg = json.loads(host_cfg_path.read_text(encoding="utf-8")) if host_cfg_path.is_file() else {}
        journal = host_cfg.get("journal")
        if not journal:
            journal = cli.config().get("journal")
        if not journal: return False
        with sqlite3.connect(f"file:{journal}?mode=ro", uri=True, timeout=0.2) as db:
            marks = ",".join("?" for _ in ids)
            return db.execute(f"SELECT 1 FROM formal_task_binding WHERE native_id IN ({marks}) LIMIT 1", tuple(ids)).fetchone() is not None
    except (sqlite3.Error, OSError, cli.ClientError):
        return False

def main() -> int:
    data = payload(); event = str(data.get("hook_event_name") or data.get("event") or os.environ.get("TPROJ_HOOK_EVENT", "pretool")).lower()
    if "--event" in sys.argv:
        try: event = sys.argv[sys.argv.index("--event") + 1].lower()
        except IndexError: pass
    name, cmd = tool_name(data), command(data)
    if name in getattr(guard, "READONLY_TOOL_NAMES", set()) or guard.is_readonly_shell(cmd) or lifecycle(cmd):
        print(json.dumps({"decision": "allow"}, separators=(",", ":"))); return 0
    if not assigned(data):
        print(json.dumps({"decision": "allow"}, separators=(",", ":"))); return 0
    if event in ("posttooluse", "posttool", "failure", "post_tool_use") or event.startswith("posttool"):
        op = "task_guard_end"
    else:
        op = "task_guard_begin"
    ident = tool_id(data)
    try:
        if cli is None:
            raise RuntimeError("unified task client unavailable")
        cfg = cli.config(); req = cli._caller_request(op, tool_use_id=ident)
        result = cli.rpc(cfg["socket"], req)
        if isinstance(result, dict) and result.get("assigned") is False:
            print(json.dumps({"decision": "allow"}, separators=(",", ":"))); return 0
        print(json.dumps({"decision": "allow"}, separators=(",", ":"))); return 0
    except Exception as exc:
        print(json.dumps({"decision": "block", "reason": f"formal task guard: {exc}"}, separators=(",", ":"))); return 0

if __name__ == "__main__": raise SystemExit(main())
