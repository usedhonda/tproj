#!/usr/bin/env python3
"""Admission hook for mutations while a unified formal task is assigned."""
from __future__ import annotations
import json, os, sys, sqlite3, shlex, re
from pathlib import Path
from importlib.machinery import SourceFileLoader

ROOT = Path(__file__).resolve().parents[2]
_unified = ROOT / "extensions/messaging/unified"
if not _unified.is_dir():
    _unified = Path.home() / "lib/tproj-msg-unified"
try:
    sys.path.insert(0, str(_unified))
    import cli  # type: ignore
    from task_host import binding_marker
    from task_role import native_context
except ImportError:
    cli = None
_guard_path = ROOT / "extensions/hooks/tproj-mutation-guard"
if not _guard_path.is_file():
    _guard_path = Path(__file__).with_name("tproj-mutation-guard")
guard = SourceFileLoader("tproj_mutation_guard", str(_guard_path)).load_module()

def payload() -> dict:
    try: value = json.load(sys.stdin)
    except (ValueError, OSError): return {}
    return value if isinstance(value, dict) else {}

def tool_name(data):
    return str(data.get("tool_name") or data.get("hook_input", {}).get("tool_name") or "")

def tool_id(data):
    for key in ("tool_use_id", "tool_call_id", "id"):
        value = data.get(key)
        if isinstance(value, str) and value: return value
    for root in (data.get("hook_input"), data.get("raw_event")):
        if isinstance(root, dict):
            for key in ("tool_use_id", "tool_call_id", "id"):
                value = root.get(key)
                if isinstance(value, str) and value: return value
    return ""

def command(data):
    name, value = guard.parse_command(data)
    if name in ('exec','functions.exec'):
        source = data.get('tool_input', {}).get('code') or data.get('tool_input', {}).get('source') or value
        # Recognize only a single literal JSON call, not arbitrary JavaScript.
        # This preserves lifecycle access through code mode without allowing
        # appended statements, computed values, custom shells, or extra tools.
        match = re.fullmatch(r'\s*text\(\s*await tools\.exec_command\((\{[\s\S]*\})\)\s*\)\s*;?\s*', source or '')
        if match:
            try: args=json.loads(match.group(1))
            except (ValueError,TypeError): args={}
            allowed={'cmd','workdir','yield_time_ms','max_output_tokens','login'}
            if isinstance(args,dict) and set(args)<=allowed and isinstance(args.get('cmd'),str):
                return args['cmd']
        return source
    return value

def lifecycle(value):
    text = value.strip()
    if not text or guard.AMBIGUOUS_SHELL_RE.search(text): return False
    try: argv = shlex.split(text)
    except ValueError: return False
    return len(argv) >= 2 and argv[0] in {"tproj-msg", "tproj-task"}

def empty_write_stdin_observation(data):
    """Recognize only a schema-valid empty-input poll, never malformed input."""
    if tool_name(data) != 'write_stdin':
        return False
    inputs = data.get('tool_input')
    if not isinstance(inputs, dict):
        nested = data.get('hook_input')
        inputs = nested.get('tool_input') if isinstance(nested, dict) else None
    if not isinstance(inputs, dict) or set(inputs) - {'session_id', 'chars', 'yield_time_ms'}:
        return False
    if type(inputs.get('session_id')) is not int or inputs['session_id'] < 0:
        return False
    if 'yield_time_ms' in inputs and (type(inputs['yield_time_ms']) is not int or inputs['yield_time_ms'] < 0):
        return False
    return 'chars' not in inputs or (type(inputs['chars']) is str and inputs['chars'] == '')

def native_ids(data):
    found = {os.environ.get("CODEX_THREAD_ID", ""), os.environ.get("CODEX_SESSION_ID", "")}
    for root in (data, data.get("hook_input"), data.get("raw_event")):
        if isinstance(root, dict):
            for key in ("session_id", "conversation_id", "thread_id"):
                if root.get(key): found.add(str(root[key]))
    return {item for item in found if item}

def caller_request(op, data, **kwargs):
    native = native_context(data)
    env = cli.native_conversation_context()
    for key in ('thread_id', 'session_id'):
        if native.get(key) and env.get(key) and native[key] != env[key]:
            raise RuntimeError('native conversation context conflict')
    request = cli._caller_request(op, **kwargs)
    if native:
        merged = dict(env)
        merged.update(native)
        request['conversation'] = merged
    return request

def assigned(data):
    ids = native_ids(data)
    if not ids: return False
    if cli is None: raise RuntimeError('unified task client unavailable')
    if any(binding_marker(native_id).exists() for native_id in ids): return True
    try:
        host_cfg_path = Path(os.environ.get("TPROJ_MSG_HOST_CONFIG", str(Path.home()/".config/tproj/msg-host.json")))
        if (not host_cfg_path.exists() and not cli.DEFAULT_CONFIG.exists()
                and not (Path.home()/".config/tproj/msg-client.enrolled").exists()):
            return False
        host_cfg = json.loads(host_cfg_path.read_text(encoding="utf-8")) if host_cfg_path.is_file() else {}
        journal = host_cfg.get("journal")
        if not journal:
            journal = cli.config().get("journal")
        if not journal: return False
        with sqlite3.connect(f"file:{journal}?mode=ro", uri=True, timeout=0.2) as db:
            marks = ",".join("?" for _ in ids)
            return db.execute(f"SELECT 1 FROM formal_task_binding WHERE native_id IN ({marks}) LIMIT 1", tuple(ids)).fetchone() is not None
    except sqlite3.OperationalError as exc:
        if 'no such table: formal_task_binding' in str(exc): return False
        raise RuntimeError('formal task assignment cannot be verified') from None
    except (sqlite3.Error, OSError, ValueError, cli.ClientError):
        raise RuntimeError('formal task assignment cannot be verified') from None

def evaluate(data: dict, event: str) -> dict:
    name, cmd = tool_name(data), command(data)
    if (name in getattr(guard, "READONLY_TOOL_NAMES", set())
            or guard.is_readonly_shell(cmd) or lifecycle(cmd)
            or empty_write_stdin_observation(data)):
        return {"decision": "allow"}
    try:
        is_assigned = assigned(data)
    except Exception:
        return {"decision": "block", "reason": "formal task assignment cannot be verified"}
    if not is_assigned:
        return {"decision": "allow"}
    if event in ("posttooluse", "posttool", "failure", "post_tool_use") or event.startswith("posttool"):
        op = "task_guard_end"
    else:
        op = "task_guard_begin"
    ident = tool_id(data)
    try:
        if cli is None:
            raise RuntimeError("unified task client unavailable")
        cfg = cli.config(); req = caller_request(op, data, tool_use_id=ident)
        result = cli.rpc(cfg["socket"], req)
        if isinstance(result, dict) and result.get("assigned") is False:
            return {"decision": "allow"}
        return {"decision": "allow"}
    except Exception as exc:
        return {"decision": "block", "reason": f"formal task guard: {exc}"}


def main() -> int:
    data = payload(); event = str(data.get("hook_event_name") or data.get("event") or os.environ.get("TPROJ_HOOK_EVENT", "pretool")).lower()
    if "--event" in sys.argv:
        try: event = sys.argv[sys.argv.index("--event") + 1].lower()
        except IndexError: pass
    decision = evaluate(data, event)
    # The evaluator's internal allow is not a native hook wire decision.
    # Empty output leaves the platform's own permission policy in control.
    if decision.get("decision") == "block":
        print(json.dumps(decision, separators=(",", ":")))
    return 0

if __name__ == "__main__": raise SystemExit(main())
