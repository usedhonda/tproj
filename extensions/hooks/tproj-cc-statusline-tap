#!/usr/bin/env python3
"""Copy Claude statusLine input to the cache observer, then run its original renderer."""

import os
from pathlib import Path
import subprocess
import sys
import time


OBSERVE_EVERY_SECONDS = 30


def observer_due():
    """Run the observer at most once per OBSERVE_EVERY_SECONDS per pane.

    Claude refreshes the status line every few seconds in every pane, and each
    observer run lists all processes and queries tmux. Across a full workspace
    that was more than one tmux query a second, enough to stall the tmux server
    and the GUI. The GUI reads the result every 30 seconds, so observing more
    often than that buys nothing."""
    pane = os.environ.get("TMUX_PANE", "").lstrip("%")
    if not pane.isdigit():
        return True
    stamp = Path(os.environ.get("TMPDIR", "/tmp")) / f"tproj-cc-tap-{os.getuid()}-{pane}"
    try:
        if time.time() - stamp.stat().st_mtime < OBSERVE_EVERY_SECONDS:
            return False
    except OSError:
        pass
    try:
        stamp.touch()
    except OSError:
        pass
    return True


def main():
    command = sys.argv[1:]
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        return 0
    payload = sys.stdin.buffer.read()
    observer = Path.home() / "bin/tproj-cc-cache-observer"
    if observer.is_file() and observer_due():
        try:
            subprocess.run(
                [str(observer), "statusline"], input=payload,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=0.5, check=False,
            )
        except (OSError, subprocess.SubprocessError):
            pass  # Cache observation must not affect the status line.
    try:
        result = subprocess.run(command, input=payload, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, check=False)
    except OSError:
        return 1
    sys.stdout.buffer.write(result.stdout)
    sys.stderr.buffer.write(result.stderr)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
