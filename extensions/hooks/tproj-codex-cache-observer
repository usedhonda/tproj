#!/usr/bin/env python3
"""Record bounded, read-only Codex cache samples for Tproj diagnostics."""

import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import tempfile
import time
from datetime import datetime


MAX_INPUT_BYTES = 1_048_576
PANE_FORMAT = "#{pane_id}|#{pane_tty}|#{pane_dead}|#{pane_pid}|#{@role}|#{@alias}|#S"


def _process_rows():
    fixture = os.environ.get("TPROJ_CODEX_OBSERVER_PROCESS_CHAIN")
    if fixture is not None:
        rows = []
        for raw in fixture.split(";"):
            parts = raw.strip().split(" ", 2)
            if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
                rows.append((int(parts[0]), int(parts[1]), parts[2]))
        return rows
    try:
        result = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,comm="],
            capture_output=True, text=True, timeout=2, check=True,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    rows = []
    for raw in result.stdout.splitlines():
        parts = raw.strip().split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            rows.append((int(parts[0]), int(parts[1]), parts[2]))
    return rows


def pane_identity():
    pane = os.environ.get("TMUX_PANE", "")
    if not pane.startswith("%") or not pane[1:].isdigit():
        return None
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-t", pane, "-p", PANE_FORMAT],
            capture_output=True, text=True, timeout=2, check=True,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    parts = result.stdout.strip().split("|")
    if len(parts) != 7 or parts[0] != pane or parts[2] != "0":
        return None
    if not parts[1].startswith("/dev/") or not parts[3].isdigit():
        return None
    if not parts[4].startswith("codex-p") or not parts[5] or not parts[6]:
        return None
    pane_pid = int(parts[3])
    rows = _process_rows()
    by_pid = {pid: (ppid, command) for pid, ppid, command in rows}
    current = int(os.environ.get("TPROJ_CODEX_OBSERVER_PID", str(os.getpid())))
    seen = set()
    has_codex = False
    while current not in seen and current in by_pid:
        seen.add(current)
        parent, command = by_pid[current]
        if Path(command).name == "codex":
            has_codex = True
        if current == pane_pid:
            break
        current = parent
    if current != pane_pid or not has_codex:
        return None
    return {
        "pane_id": parts[0], "tty": parts[1], "pane_pid": pane_pid,
        "role": parts[4],
    }


def state_dir():
    root = os.environ.get("TPROJ_CODEX_CACHE_DIR")
    return Path(root) if root else Path.home() / ".local/state/tproj/codex-cache"


def cache_sample(payload):
    cache = payload.get("prompt_cache")
    if not isinstance(cache, dict):
        return None
    sample = {}
    warm = cache.get("warm")
    if type(warm) is bool:
        sample["warm"] = warm
    expires = cache.get("expires_at")
    if isinstance(expires, (int, float)) and not isinstance(expires, bool) and math.isfinite(expires) and expires > 0:
        sample["expires_at"] = int(expires)
    for key in ("read_tokens", "creation_tokens", "recache_tokens_if_cold"):
        value = cache.get(key)
        if type(value) is int and value >= 0:
            sample[key] = value
    return sample or None


def transcript_token_sample(payload):
    """Read only the numeric latest sample from this hook's exact session file."""
    raw_path = payload.get("transcript_path")
    session_id = payload.get("session_id")
    if not isinstance(raw_path, str) or not isinstance(session_id, str):
        return False, None
    try:
        path = Path(raw_path).resolve(strict=True)
        sessions = (Path.home() / ".codex/sessions").resolve(strict=True)
        if not path.is_relative_to(sessions) or path.suffix != ".jsonl" or not path.is_file():
            return False, None
        with path.open("rb") as stream:
            first = json.loads(stream.readline(65_537))
            meta = first.get("payload", {})
            if (first.get("type") != "session_meta" or meta.get("id") != session_id
                    or meta.get("source") != "cli"
                    or meta.get("originator") != "codex-tui"
                    or meta.get("thread_source") != "user"):
                return False, None
            size = stream.seek(0, os.SEEK_END)
            stream.seek(max(0, size - 65_536))
            tail = stream.read(65_536)
        for raw in reversed(tail.splitlines()):
            try:
                row = json.loads(raw)
                if row.get("type") != "event_msg" or row.get("payload", {}).get("type") != "token_count":
                    continue
                usage = row["payload"]["info"]["last_token_usage"]
                input_tokens = usage["input_tokens"]
                cached_tokens = usage["cached_input_tokens"]
                timestamp = row["timestamp"]
                datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
                if (type(input_tokens) is int and type(cached_tokens) is int
                        and 0 <= cached_tokens <= input_tokens):
                    return True, {"at": timestamp, "input_tokens": input_tokens,
                                  "cached_input_tokens": cached_tokens}
            except (KeyError, TypeError, ValueError, AttributeError):
                continue
        return True, None
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    return False, None


def record(event, payload, identity):
    session_id = payload.get("session_id")
    if not isinstance(session_id, str) or not 0 < len(session_id) <= 128:
        return
    transcript_valid, token_sample = transcript_token_sample(payload)
    if not transcript_valid:
        return
    root = state_dir()
    if root.is_symlink():
        return
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    session_hash = hashlib.sha256(session_id.encode("utf-8")).hexdigest()
    path = root / f"{session_hash}.json"
    lock_path = root / f"{session_hash}.lock"
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        try:
            previous = json.loads(path.read_text())
        except (OSError, ValueError):
            previous = {}
        if not isinstance(previous, dict) or previous.get("session_hash") != session_hash or previous.get("pane_id") != identity["pane_id"] or previous.get("pane_pid") != identity["pane_pid"]:
            previous = {}
        state = {**previous, **identity, "version": 1, "session_hash": session_hash,
                 "observed_at": int(time.time()), "remote": False}
        state["event"] = event
        sample = cache_sample(payload)
        state["cache_sample"] = sample
        state["sample_available"] = sample is not None
        state["last_token_sample"] = token_sample
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=root,
                                         prefix=".codex-cache-", delete=False) as tmp:
            os.chmod(tmp.name, 0o600)
            json.dump(state, tmp, sort_keys=True, separators=(",", ":"))
            tmp.flush()
            os.fsync(tmp.fileno())
            temp_path = tmp.name
        os.replace(temp_path, path)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def main():
    if len(os.sys.argv) != 2 or os.sys.argv[1] not in ("prompt", "stop"):
        return 0
    identity = pane_identity()
    if identity is None:
        return 0
    try:
        raw = os.sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
        if len(raw) > MAX_INPUT_BYTES:
            return 0
        payload = json.loads(raw)
        if (isinstance(payload, dict)
                and payload.get("hook_event_name") in ("UserPromptSubmit", "Stop")
                and payload.get("remote") is not True
                and payload.get("origin") not in ("remote", "cloud")):
            record(os.sys.argv[1], payload, identity)
    except (OSError, ValueError, TypeError, OverflowError):
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
