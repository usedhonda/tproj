#!/usr/bin/env python3
"""Record only the Claude cache facts Tproj needs, without CCStatusBar."""

import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time


KEEP_ALIVE_MARKER = "[keep-alive]"
MAX_INPUT_BYTES = 1_048_576
PANE_FORMAT = "#{pane_id}|#{pane_tty}|#{pane_dead}|#{pane_pid}|#{@role}|#{@alias}|#S"


def agent_binding(pane_pid):
    """Return the sole live Claude descendant, never a pane tag or shell."""
    try:
        rows = subprocess.run(["/bin/ps", "-Ao", "pid=,ppid=,comm="],
                              capture_output=True, text=True, timeout=4, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    children = {}
    for line in rows.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            children.setdefault(int(parts[1]), []).append((int(parts[0]), parts[2]))
    matches = []
    pending, seen = [pane_pid], {pane_pid}
    while pending and len(seen) < 512:
        for pid, command in children.get(pending.pop(0), ()):
            if pid in seen:
                continue
            seen.add(pid)
            pending.append(pid)
            if os.path.basename(command) == "claude":
                matches.append(pid)
    if pending or len(matches) != 1:
        return None
    try:
        started = subprocess.run(["/bin/ps", "-p", str(matches[0]), "-o", "lstart="],
                                 capture_output=True, text=True, timeout=2, check=True).stdout.strip()
        epoch = int(time.mktime(time.strptime(started, "%a %b %d %H:%M:%S %Y")))
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return {"agent_pid": matches[0], "agent_pid_start": epoch} if epoch > 0 else None


def pane_identity():
    pane = os.environ.get("TMUX_PANE", "")
    if not pane.startswith("%") or not pane[1:].isdigit():
        return None
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-t", pane, "-p", PANE_FORMAT],
            capture_output=True, text=True, timeout=2, check=True,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    parts = result.stdout.strip().split("|")
    if len(parts) != 7 or parts[0] != pane or parts[2] != "0":
        return None
    if not parts[1].startswith("/dev/") or not parts[3].isdigit():
        return None
    if not parts[4].startswith("claude-p") or not parts[5] or not parts[6]:
        return None
    return {
        "pane_id": parts[0], "tty": parts[1], "pane_pid": int(parts[3]),
        "role": parts[4], "alias": parts[5], "owner_session": parts[6],
    }


def cache_expiry(payload):
    cache = payload.get("prompt_cache")
    if not isinstance(cache, dict) or cache.get("warm") is not True:
        return None
    value = cache.get("expires_at")
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if not math.isfinite(value) or value <= 0:
        return None
    return int(value)


def state_dir():
    root = os.environ.get("TPROJ_CC_CACHE_DIR")
    return Path(root) if root else Path.home() / ".local/state/tproj/cc-cache"


def record(event, payload, identity):
    session_id = payload.get("session_id")
    if not isinstance(session_id, str) or not 0 < len(session_id) <= 128:
        return
    binding = agent_binding(identity["pane_pid"])
    if binding is None:
        return
    root = state_dir()
    if root.is_symlink():
        return
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    key = hashlib.sha256(session_id.encode("utf-8")).hexdigest()
    path = root / f"{key}.json"
    lock_path = root / f"{key}.lock"
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        try:
            previous = json.loads(path.read_text())
        except (OSError, ValueError):
            previous = {}
        if not isinstance(previous, dict):
            previous = {}
        if (previous.get("session_id") != session_id or
                previous.get("pane_id") != identity["pane_id"] or
                previous.get("pane_pid") != identity["pane_pid"] or
                previous.get("agent_pid") != binding["agent_pid"] or
                previous.get("agent_pid_start") != binding["agent_pid_start"]):
            previous = {}
        state = {**previous, **identity, **binding, "version": 1, "session_id": session_id,
                 "observed_at": int(time.time())}
        if event == "statusline":
            state["cache_expires_at"] = cache_expiry(payload)
            cache = payload.get("prompt_cache")
            tokens = cache.get("recache_tokens_if_cold") if isinstance(cache, dict) else None
            state["recache_tokens_if_cold"] = tokens if type(tokens) is int and tokens >= 0 else None
        elif event == "prompt":
            prompt = payload.get("prompt")
            if not isinstance(prompt, str) or not prompt.strip():
                return
            state["turn_state"] = "running"
            state.pop("idle_prompt_at", None)
            if not prompt.lstrip().startswith(KEEP_ALIVE_MARKER):
                state["last_user_prompt_at"] = int(time.time())
        elif event == "stop":
            # Another Stop hook may block completion and resume this turn.
            # This event is evidence of Stop invocation, not live idle.
            state["turn_state"] = "stop_seen"
        elif event == "notification":
            if payload.get("notification_type") != "idle_prompt":
                return
            state["turn_state"] = "idle_notified"
            state["idle_prompt_at"] = int(time.time())
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=root,
                                         prefix=".cc-cache-", delete=False) as tmp:
            os.chmod(tmp.name, 0o600)
            json.dump(state, tmp, sort_keys=True, separators=(",", ":"))
            tmp.flush()
            os.fsync(tmp.fileno())
            temp_path = tmp.name
        os.replace(temp_path, path)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("statusline", "prompt", "stop", "notification"):
        return 0
    identity = pane_identity()
    if identity is None:
        return 0
    try:
        raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
        if len(raw) > MAX_INPUT_BYTES:
            return 0
        payload = json.loads(raw)
        if isinstance(payload, dict):
            record(sys.argv[1], payload, identity)
    except (OSError, ValueError, TypeError, OverflowError):
        pass  # Observation must never block a Claude turn or statusline.
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
