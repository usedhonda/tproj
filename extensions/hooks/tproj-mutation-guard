#!/usr/bin/env python3
"""Block mutations when the current delegated task is frozen or cancelled."""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import sqlite3
import subprocess
import sys
from pathlib import Path
from typing import Any

READONLY_GIT_SUBCOMMANDS = {"status", "diff", "show", "log", "rev-parse", "ls-files"}
READONLY_HASH_COMMANDS = {"shasum", "sha1sum", "sha256sum", "md5", "md5sum", "cksum"}
# Reading a file is how a frozen receiver collects the evidence the contract asks it
# for. Without these the whitelist could compare hashes but not open a log, so the
# "read-only incident" allowance promised by the contract was not actually usable.
# None of these can write without a redirection, and redirections are already
# refused by AMBIGUOUS_SHELL_RE before this set is consulted.
READONLY_FILE_COMMANDS = {
    "cat", "head", "tail", "wc", "ls", "file", "basename", "dirname",
    "realpath", "readlink", "pwd", "echo", "printf", "date", "du", "df",
    "uname", "whoami", "env", "which", "type", "column", "cut", "sort",
    "uniq", "tr", "grep", "egrep", "fgrep", "rg", "jq", "diff", "comm",
}
MUTATING_TOOL_NAMES = {
    "Edit",
    "Write",
    "MultiEdit",
    "NotebookEdit",
    "apply_patch",
    "functions.apply_patch",
}
# Tools that cannot themselves mutate anything. Skill belongs here: loading a skill
# only puts instructions in front of the model, and every action it then asks for
# comes back through this same guard. Blocking it bought no safety and cost the
# receiver its only documented route to the messaging skill, so a frozen pane could
# not carry out the BLOCK report the contract requires of it.
READONLY_TOOL_NAMES = {
    "Read",
    "LS",
    "Glob",
    "Search",
    "Grep",
    "Skill",
    "SlashCommand",
    "TodoWrite",
    "TaskCreate",
    "TaskUpdate",
    "TaskList",
    "NotebookRead",
    "BashOutput",
    "WebFetch",
    "WebSearch",
}
AMBIGUOUS_SHELL_RE = re.compile(r"[|&;><`$()]|\\n")
FIND_DANGEROUS_ACTIONS = {
    "-delete",
    "-exec",
    "-execdir",
    "-ok",
    "-okdir",
    "-fprint",
    "-fprintf",
    "-fprint0",
    "-fls",
    "-files0-from",
}
FIND_SAFE_NOARG = {
    "-H",
    "-L",
    "-P",
    "-xdev",
    "-mount",
    "-print",
    "-print0",
    "-ls",
    "-true",
    "-false",
    "-empty",
    "-readable",
    "-writable",
    "-executable",
    "-nouser",
    "-nogroup",
    "-a",
    "-and",
    "-o",
    "-or",
    "!",
    "-not",
    "--",
}
FIND_SAFE_WITH_ARG = {
    "-maxdepth",
    "-mindepth",
    "-name",
    "-iname",
    "-path",
    "-ipath",
    "-type",
    "-mtime",
    "-mmin",
    "-ctime",
    "-cmin",
    "-atime",
    "-amin",
    "-size",
    "-user",
    "-group",
    "-perm",
    "-newer",
    "-samefile",
    "-links",
    "-uid",
    "-gid",
    "-printf",
}
GIT_SAFE_GLOBAL_NOARG = {"--no-pager"}
GIT_SAFE_GLOBAL_WITH_ARG = {"-C", "--git-dir", "--work-tree"}
GIT_DIFF_SAFE_NOARG = {
    "--cached",
    "--staged",
    "--stat",
    "--numstat",
    "--shortstat",
    "--summary",
    "--name-only",
    "--name-status",
    "--check",
    "--patch",
    "-p",
    "--no-patch",
    "-s",
    "--color",
    "--no-color",
    "--quiet",
    "--exit-code",
    "--raw",
    "--word-diff",
    "--no-ext-diff",
    "--no-textconv",
}
GIT_DIFF_SAFE_WITH_ARG = {
    "-U",
    "--unified",
    "--relative",
    "--diff-filter",
    "--src-prefix",
    "--dst-prefix",
}
GIT_DIFF_SAFE_PREFIXES = (
    "-U",
    "--unified=",
    "--relative=",
    "--diff-filter=",
    "--src-prefix=",
    "--dst-prefix=",
    "--word-diff=",
    "--color=",
)
GIT_DIFF_DANGEROUS_EXACT = {"--output", "--no-index", "--ext-diff", "--textconv"}
GIT_DIFF_DANGEROUS_PREFIXES = ("--output=",)


def block(reason: str) -> int:
    print(json.dumps({"decision": "block", "reason": reason}, separators=(",", ":")))
    return 0


def owner_identity() -> tuple[str, str, str] | None:
    owner = os.environ.get("TT_CACHE_OWNER", "")
    role = os.environ.get("TT_OWNER_ROLE", "")
    if not owner and os.environ.get("TMUX_PANE"):
        pane = os.environ["TMUX_PANE"]
        try:
            session = subprocess.check_output(["tmux", "display-message", "-t", pane, "-p", "#S"], text=True).strip()
            alias = subprocess.check_output(["tmux", "display-message", "-t", pane, "-p", "#{@alias}"], text=True).strip()
            raw_role = subprocess.check_output(["tmux", "display-message", "-t", pane, "-p", "#{@role}"], text=True).strip()
        except (OSError, subprocess.CalledProcessError):
            return None
        owner = f"{session}/{alias}"
        if not role:
            if raw_role.startswith("claude"):
                role = "cc"
            elif raw_role.startswith("codex"):
                role = "cdx"
    if not re.fullmatch(r"[A-Za-z0-9._-]+/[A-Za-z0-9._-]+", owner):
        return None
    if role not in {"cc", "cdx"}:
        return None
    session, alias = owner.split("/", 1)
    return session, alias, role


def open_db() -> sqlite3.Connection | None:
    path = Path(os.environ.get("TPROJ_MSG_DB_PATH", str(Path.home() / ".local/share/tproj-msg/messages.db")))
    if not path.is_file():
        return None
    try:
        conn = sqlite3.connect(f"file:{path}?mode=rw", uri=True, timeout=1.0)
        conn.execute("PRAGMA busy_timeout=1000")
        return conn
    except sqlite3.Error:
        return None


def active_tombstone(db: sqlite3.Connection, session: str, alias: str, role: str) -> tuple[str, str, str, str] | None:
    """The tombstone this pane is still held by, or None once it has moved on.

    A tombstone is durable forever so the task can never reopen. The pane-wide
    quarantine is not the same thing and must not inherit that lifetime: read the
    row alone and the newest cancel or freeze ever addressed to this pane keeps
    enforcing itself against unrelated work for the rest of the machine's life,
    which is how a freeze meant to park one task ended up making a pane read-only
    indefinitely. A newer non-tombstoned task for the same pane is the owner
    reassigning it, and the quarantine ends there; the frozen task itself stays
    frozen in the cache and in the marker suppression regardless.
    """
    self_alias = f"{alias}.{role}"
    row = db.execute(
        """
        SELECT task_id, owner_alias, state, COALESCE(tombstone_reason_hash, ''),
               COALESCE(frozen_at, cancelled_at, sent_at)
          FROM tasks
         WHERE owner_session=?
           AND target=?
           AND state IN ('cancelled','frozen')
         ORDER BY COALESCE(frozen_at, cancelled_at, sent_at) DESC, sent_at DESC
         LIMIT 1
        """,
        (session, self_alias),
    ).fetchone()
    if row is None:
        return None
    task_id, owner_alias, state, reason_hash, tombstoned_at = row
    newer = db.execute(
        """
        SELECT 1
          FROM tasks
         WHERE owner_session=?
           AND target=?
           AND task_id != ?
           AND state NOT IN ('cancelled','frozen')
           AND sent_at > ?
         LIMIT 1
        """,
        (session, self_alias, task_id, tombstoned_at),
    ).fetchone()
    if newer is not None:
        return None
    return str(task_id), str(owner_alias), str(state), str(reason_hash)


def extract_payload_value(payload: dict[str, Any], *path: str) -> str:
    current: Any = payload
    for key in path:
        if not isinstance(current, dict):
            return ""
        current = current.get(key)
    return current if isinstance(current, str) else ""


def parse_command(payload: dict[str, Any]) -> tuple[str, str]:
    tool_name = str(payload.get("tool_name") or payload.get("hook_input", {}).get("tool_name") or "")
    for path in [
        ("tool_input", "command"),
        ("tool_input", "cmd"),
        ("tool_input", "source"),
        ("hook_input", "tool_input", "command"),
        ("hook_input", "tool_input", "cmd"),
        ("hook_input", "tool_input", "source"),
    ]:
        value = extract_payload_value(payload, *path)
        if value:
            return tool_name, value
    return tool_name, ""


def is_nonempty_arg(token: str) -> bool:
    return bool(token and token != "--")


def is_readonly_find(argv: list[str]) -> bool:
    if not argv or argv[0] != "find":
        return False
    idx = 1
    expression_started = False
    while idx < len(argv):
        token = argv[idx]
        if token in FIND_DANGEROUS_ACTIONS:
            return False
        if not expression_started and not token.startswith("-") and token not in {"!", "-not"}:
            idx += 1
            continue
        expression_started = True
        if token in FIND_SAFE_NOARG:
            idx += 1
            continue
        if token in FIND_SAFE_WITH_ARG:
            if idx + 1 >= len(argv) or not is_nonempty_arg(argv[idx + 1]):
                return False
            idx += 2
            continue
        if token.startswith("-"):
            return False
        idx += 1
    return True


def is_readonly_git_diff(argv: list[str]) -> bool:
    if not argv or argv[0] != "git":
        return False
    idx = 1
    while idx < len(argv):
        token = argv[idx]
        if token == "diff":
            idx += 1
            break
        if token in GIT_SAFE_GLOBAL_NOARG:
            idx += 1
            continue
        if token in GIT_SAFE_GLOBAL_WITH_ARG:
            if idx + 1 >= len(argv) or not is_nonempty_arg(argv[idx + 1]):
                return False
            idx += 2
            continue
        if token.startswith("-C") and token != "-C":
            idx += 1
            continue
        if token.startswith("--git-dir=") or token.startswith("--work-tree="):
            idx += 1
            continue
        if token == "-c" or token.startswith("-c") or token == "--config-env" or token.startswith("--config-env="):
            return False
        return False
    else:
        return False

    while idx < len(argv):
        token = argv[idx]
        if token in GIT_DIFF_DANGEROUS_EXACT:
            return False
        if any(token.startswith(prefix) for prefix in GIT_DIFF_DANGEROUS_PREFIXES):
            return False
        if token in GIT_DIFF_SAFE_NOARG or token == "--":
            idx += 1
            continue
        if token in GIT_DIFF_SAFE_WITH_ARG:
            if idx + 1 >= len(argv) or not is_nonempty_arg(argv[idx + 1]):
                return False
            idx += 2
            continue
        if any(token.startswith(prefix) for prefix in GIT_DIFF_SAFE_PREFIXES):
            idx += 1
            continue
        if token.startswith("-"):
            return False
        idx += 1
    return True


def is_readonly_shell(command: str) -> bool:
    stripped = command.strip()
    if not stripped:
        return False
    if AMBIGUOUS_SHELL_RE.search(stripped):
        return False
    try:
        argv = shlex.split(stripped)
    except ValueError:
        return False
    if not argv:
        return False
    cmd = argv[0]
    if cmd == "git":
        if len(argv) < 2:
            return False
        if argv[1] == "diff" or "diff" in argv[1:]:
            return is_readonly_git_diff(argv)
        return argv[1] in READONLY_GIT_SUBCOMMANDS
    if cmd == "find":
        return is_readonly_find(argv)
    if cmd == "stat":
        return True
    if cmd in READONLY_HASH_COMMANDS:
        return True
    if cmd in READONLY_FILE_COMMANDS:
        return True
    if cmd == "sed":
        # -n prints only what the script selects; -i rewrites the file in place.
        return "-n" in argv[1:] and not any(
            token == "-i" or token.startswith("-i") or token.startswith("--in-place")
            for token in argv[1:]
        )
    if cmd == "sqlite3":
        return "-readonly" in argv[1:]
    return False


def is_owner_report_send(command: str) -> bool:
    """Allow a frozen receiver to report to its owner, but not to delegate onward.

    The contract requires a blocked receiver to send `[BLOCK: <id>]` to the exact
    task owner, and treats an unreported freeze as an incident. The guard used to
    refuse every `tproj-msg` invocation, so the one obligation the receiver still
    had was the one action it could not take -- and the freeze sealed off the route
    to its own release as well. Delegation stays refused: a frozen pane that can
    open a new task could hand the frozen work to somebody else and call the
    quarantine satisfied. Lifecycle markers naming a tombstoned id are still
    suppressed downstream by tproj-msg, so this reopens reporting, not the task.
    """
    if not command.strip() or AMBIGUOUS_SHELL_RE.search(command):
        return False
    try:
        argv = shlex.split(command)
    except ValueError:
        return False
    if not argv:
        return False
    if Path(argv[0]).name != "tproj-msg":
        return False
    return not any(
        token in {"--new-task", "--role-handoff"} for token in argv[1:]
    )


def is_exact_user_unfreeze(command: str) -> bool:
    """Allow only the installed one-shot override CLI through a frozen guard."""
    if not command.strip() or AMBIGUOUS_SHELL_RE.search(command):
        return False
    try:
        argv = shlex.split(command)
    except ValueError:
        return False
    if len(argv) != 5 or argv[1] != "unfreeze":
        return False
    expected = (Path.home() / "bin/tproj-task").resolve(strict=False)
    try:
        actual = Path(argv[0]).expanduser().resolve(strict=False)
    except (OSError, RuntimeError):
        return False
    component = re.compile(r"^[A-Za-z0-9._-]+$")
    confirmation = re.compile(r"^[A-Za-z0-9._:-]{8,128}$")
    return (
        actual == expected
        and component.fullmatch(argv[2]) is not None
        and component.fullmatch(argv[3]) is not None
        and confirmation.fullmatch(argv[4]) is not None
    )


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--platform", choices=("claude", "codex"), default="claude")
    parser.parse_args()
    try:
        payload: Any = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return 0
    if not isinstance(payload, dict):
        return 0
    identity = owner_identity()
    if identity is None:
        return 0
    session, alias, role = identity
    db = open_db()
    if db is None:
        return 0
    try:
        tombstone = active_tombstone(db, session, alias, role)
    except sqlite3.Error:
        db.close()
        return 0
    db.close()
    if tombstone is None:
        return 0
    task_id, owner_alias, state, reason_hash = tombstone
    # Every refusal names the way out. The receiver that hit this guard had to
    # infer both its obligation and its release from a sentence that mentioned
    # neither, and reported the freeze as unescapable because nothing told it
    # otherwise.
    escape = (
        f"; report to {owner_alias} with tproj-msg, and after explicit user "
        f"confirmation release with: ~/bin/tproj-task unfreeze {task_id} "
        f"{alias}.{role} <confirmation-hash>"
        if state == "frozen"
        else f"; report to {owner_alias} with tproj-msg"
    )
    tool_name, command = parse_command(payload)
    if tool_name in READONLY_TOOL_NAMES:
        return 0
    if tool_name in MUTATING_TOOL_NAMES:
        return block(f"Delegated task {task_id} from {owner_alias} is {state} (reason_hash={reason_hash}); edits are blocked{escape}")
    if command:
        if state == "frozen" and is_exact_user_unfreeze(command):
            return 0
        if is_readonly_shell(command) or is_owner_report_send(command):
            return 0
        return block(
            f"Delegated task {task_id} from {owner_alias} is {state} (reason_hash={reason_hash}); only read-only incident shell commands and tproj-msg reports are allowed{escape}"
        )
    if tool_name:
        return block(
            f"Delegated task {task_id} from {owner_alias} is {state} (reason_hash={reason_hash}); mutating tool '{tool_name}' is blocked{escape}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
