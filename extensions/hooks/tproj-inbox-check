#!/bin/bash
set -euo pipefail

PLATFORM=claude
if [[ "${1:-}" == --platform ]]; then
  PLATFORM="${2:-claude}"
  shift 2
fi
[[ $# -eq 0 ]] || exit 0
NOTICES=()
emit_notice() { NOTICES+=("$1"); }

[[ "${TPROJ_HOOK_ENABLED:-}" == "1" ]] || exit 0

CACHE_DIR="${TT_CACHE_DIR:-$HOME/.cache/tproj-expect-reply}"
if [[ -d "$CACHE_DIR" ]]; then
  CACHE_PRESENT=1
else
  CACHE_PRESENT=0
fi
# Fast path: nothing cached at all (no owner subdirs and no legacy flat files) ->
# exit. A regular-file count would miss subdirs and a link count would miss flat
# files, so probe for any entry. nullglob makes the empty case an empty array.
shopt -s nullglob 2>/dev/null || true
_cache_entries=()
if [[ "$CACHE_PRESENT" -eq 1 ]]; then
  _cache_entries=("$CACHE_DIR"/*)
fi

SELF_DIR="$(cd "$(dirname "$0")" && pwd -P)"
CACHE_HELPER="$SELF_DIR/tproj-task-cache.sh"
MSG_CLI="$SELF_DIR/tproj-msg"
if [[ ! -f "$CACHE_HELPER" ]]; then
  CACHE_HELPER="$SELF_DIR/../messaging/tproj-task-cache.sh"
fi
if [[ ! -x "$MSG_CLI" ]]; then
  MSG_CLI="$SELF_DIR/../messaging/tproj-msg"
fi
[[ -f "$CACHE_HELPER" && -x "$MSG_CLI" ]] || exit 0

# shellcheck source=/dev/null
source "$CACHE_HELPER"

# Weekly usage notices are machine-local, informational-only context. The GUI
# writes a sanitized global state (no account identifiers or arbitrary text),
# while this hook owns one cross-project delivery ledger so CC and Cdx do not
# repeat the same notice in every column.
# A side is only worth recommending if this much of its week is still projected
# to be left at its own reset. Below that, pointing work at it just moves the
# problem instead of solving it.
USAGE_ADVICE_MIN_HEADROOM_PCT="${TPROJ_USAGE_ADVICE_MIN_HEADROOM_PCT:-15}"

usage_format_until_reset() {
  local epoch="$1" now="$2" delta days hours
  delta=$((epoch - now))
  (( delta > 0 )) || return 1
  days=$((delta / 86400))
  hours=$(((delta % 86400) / 3600))
  if (( days > 0 )); then
    printf '%s日%s時間後' "$days" "$hours"
  elif (( hours > 0 )); then
    printf '%s時間後' "$hours"
  else
    printf '1時間以内'
  fi
}

usage_resolve_main() {
  if [[ "${TPROJ_USAGE_MAIN:-}" == "cc" || "${TPROJ_USAGE_MAIN:-}" == "cdx" ]]; then
    printf '%s' "$TPROJ_USAGE_MAIN"
    return 0
  fi
  [[ -n "${TMUX_PANE:-}" ]] || return 1
  local project router mode_json main
  project="$(tmux display-message -t "$TMUX_PANE" -p '#{@project}' 2>/dev/null || true)"
  [[ "$project" == /* ]] || return 1
  router="${TPROJ_USAGE_ROUTER:-$HOME/bin/model-role-router}"
  [[ -x "$router" ]] || router="$(command -v model-role-router 2>/dev/null || true)"
  [[ -x "$router" ]] || return 1
  mode_json="$("$router" mode --json --project "$project" 2>/dev/null || true)"
  main="$(printf '%s' "$mode_json" | jq -r '
    if (.main == "cc" or .main == "cdx") then .main
    elif (.lead == "cc" or .lead == "cdx") then .lead
    else "cdx" end
  ' 2>/dev/null || true)"
  [[ "$main" == "cc" || "$main" == "cdx" ]] || return 1
  printf '%s' "$main"
}

usage_write_ledger() {
  local ledger="$1" main="$2" state="$3" severity="$4" reason="$5"
  local main_pct="$6" other_pct="$7" main_reset="$8" other_reset="$9" now="${10}"
  local source_json='{}' tmp
  if [[ -s "$ledger" ]] && jq -e 'type == "object"' "$ledger" >/dev/null 2>&1; then
    source_json="$(cat "$ledger")"
  fi
  tmp="$(mktemp "${ledger}.tmp.XXXXXX" 2>/dev/null)" || return 1
  if ! printf '%s' "$source_json" | jq \
      --arg main "$main" --arg state "$state" --arg severity "$severity" --arg reason "$reason" \
      --argjson main_pct "$main_pct" --argjson other_pct "$other_pct" \
      --argjson main_reset "$main_reset" --argjson other_reset "$other_reset" --argjson now "$now" '
        .version = 1 |
        .sides = (.sides // {}) |
        .sides[$main] = {
          state: $state,
          severity: (if $severity == "" then null else $severity end),
          reason: (if $reason == "" then null else $reason end),
          main_bucket: (($main_pct / 10) | floor),
          main_projected_percent: $main_pct,
          other_projected_percent: $other_pct,
          main_resets_at: $main_reset,
          other_resets_at: $other_reset,
          injected_at: $now
        }
      ' > "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    return 1
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$ledger"
}

emit_weekly_usage_notice() {
  local state_path="${TPROJ_USAGE_STATE_PATH:-$HOME/.local/state/tproj/weekly-pace.json}"
  local ledger_path="${TPROJ_USAGE_LEDGER_PATH:-$HOME/.local/state/tproj/usage-notice.json}"
  local ledger_dir lock_dir now generated age main side_values
  local status severity reason main_remaining other_remaining main_pct other_pct main_reset other_reset
  local prev_values prev_state prev_severity prev_reason prev_bucket prev_main_reset prev_other_reset prev_at
  local current_bucket elapsed cooldown due=false display_main display_other main_label other_label
  local main_projected_remaining other_projected_remaining message instruction

  [[ -s "$state_path" ]] || return 0
  main="$(usage_resolve_main 2>/dev/null || true)"
  [[ "$main" == "cc" || "$main" == "cdx" ]] || return 0
  now="${TPROJ_USAGE_NOW:-$(date +%s)}"
  [[ "$now" =~ ^[0-9]+$ ]] || return 0
  generated="$(jq -r '.generated_at // empty' "$state_path" 2>/dev/null || true)"
  [[ "$generated" =~ ^[0-9]+$ ]] || return 0
  age=$((now - generated))
  (( age >= -300 && age <= 900 )) || return 0
  jq -e --arg main "$main" '
    .version == 1 and (.sides | type == "object") and
    (.sides[$main].status == "alert" or .sides[$main].status == "healthy" or
     .sides[$main].status == "hold" or .sides[$main].status == "unavailable")
  ' "$state_path" >/dev/null 2>&1 || return 0
  side_values="$(jq -r --arg main "$main" '.sides[$main] |
    [(.status // ""), (.severity // "-"), (.reason // "-"),
     (.main_remaining_percent // -1), (.other_remaining_percent // -1),
     (.main_projected_percent // -1), (.other_projected_percent // -1),
     (.main_resets_at // 0), (.other_resets_at // 0)] | @tsv' "$state_path" 2>/dev/null || true)"
  IFS=$'\t' read -r status severity reason main_remaining other_remaining main_pct other_pct main_reset other_reset <<< "$side_values"
  [[ "$severity" == "-" ]] && severity=""
  [[ "$reason" == "-" ]] && reason=""
  [[ "$status" == "hold" || "$status" == "unavailable" ]] && return 0
  [[ "$main_remaining" =~ ^[0-9]+$ && "$other_remaining" =~ ^[0-9]+$ ]] || return 0
  [[ "$main_pct" =~ ^[0-9]+$ && "$other_pct" =~ ^[0-9]+$ && "$main_reset" =~ ^[0-9]+$ && "$other_reset" =~ ^[0-9]+$ ]] || return 0
  (( main_remaining <= 100 && other_remaining <= 100 && main_pct <= 999 && other_pct <= 999 && main_reset > now && other_reset > now )) || return 0
  if [[ "$status" == "alert" ]]; then
    [[ "$severity" == "advisory" || "$severity" == "critical" ]] || return 0
    [[ "$reason" == "exhaustion" || "$reason" == "absolute-high" || "$reason" == "peer-headroom" ]] || return 0
  fi

  ledger_dir="$(dirname "$ledger_path")"
  mkdir -p "$ledger_dir" 2>/dev/null || return 0
  chmod 700 "$ledger_dir" 2>/dev/null || true
  lock_dir="${TPROJ_USAGE_LOCK_DIR:-$ledger_dir/.usage-notice.lock}"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    local lock_mtime
    lock_mtime="$(stat -f '%m' "$lock_dir" 2>/dev/null || printf '0')"
    if [[ "$lock_mtime" =~ ^[0-9]+$ ]] && (( now - lock_mtime > 30 )); then
      rmdir "$lock_dir" 2>/dev/null || return 0
      mkdir "$lock_dir" 2>/dev/null || return 0
    else
      return 0
    fi
  fi

  prev_values="$(jq -r --arg main "$main" '.sides[$main] // {} |
    [(.state // "-"), (.severity // "-"), (.reason // "-"), (.main_bucket // -1),
     (.main_resets_at // 0), (.other_resets_at // 0), (.injected_at // 0)] | @tsv' "$ledger_path" 2>/dev/null || true)"
  IFS=$'\t' read -r prev_state prev_severity prev_reason prev_bucket prev_main_reset prev_other_reset prev_at <<< "$prev_values"
  [[ "$prev_state" == "-" ]] && prev_state=""
  [[ "$prev_severity" == "-" ]] && prev_severity=""
  [[ "$prev_reason" == "-" ]] && prev_reason=""
  [[ "$prev_bucket" =~ ^-?[0-9]+$ ]] || prev_bucket=-1
  [[ "$prev_at" =~ ^[0-9]+$ ]] || prev_at=0
  elapsed=$((now - prev_at))
  current_bucket=$((main_pct / 10))

  if [[ "$status" == "healthy" ]]; then
    [[ "$prev_state" == "alert" ]] && due=true
  elif [[ "$prev_state" != "alert" ]]; then
    due=true
  elif [[ "$prev_severity" == "advisory" && "$severity" == "critical" ]]; then
    due=true
  elif [[ "$prev_severity" == "critical" && "$severity" == "advisory" ]]; then
    (( elapsed >= 14400 )) && due=true
  elif [[ "$reason" != "$prev_reason" || "$main_reset" != "$prev_main_reset" || "$other_reset" != "$prev_other_reset" || "$current_bucket" -gt "$prev_bucket" ]]; then
    due=true
  else
    [[ "$severity" == "critical" ]] && cooldown=14400 || cooldown=43200
    (( elapsed >= cooldown )) && due=true
  fi
  if [[ "$due" != true ]]; then
    rmdir "$lock_dir" 2>/dev/null || true
    return 0
  fi

  [[ "$main" == "cc" ]] && display_main="CC" || display_main="Cdx"
  [[ "$main" == "cc" ]] && display_other="Cdx" || display_other="CC"
  main_label="$(usage_format_until_reset "$main_reset" "$now" 2>/dev/null || true)"
  other_label="$(usage_format_until_reset "$other_reset" "$now" 2>/dev/null || true)"
  if [[ -z "$main_label" || -z "$other_label" ]]; then
    rmdir "$lock_dir" 2>/dev/null || true
    return 0
  fi

  main_projected_remaining=$((100 - main_pct))
  other_projected_remaining=$((100 - other_pct))
  (( main_projected_remaining < 0 )) && main_projected_remaining=0
  (( other_projected_remaining < 0 )) && other_projected_remaining=0

  # Only recommend a side that will actually still have budget at its own reset.
  # Naming the other side unconditionally told the user to move long work onto a
  # pane projected to hit zero, which is worse advice than saying nothing: the
  # point of the notice is to protect the week, not to shuffle work toward
  # whichever pane happens not to be the main one.
  local advice
  if (( other_projected_remaining >= USAGE_ADVICE_MIN_HEADROOM_PCT \
        && other_projected_remaining > main_projected_remaining )); then
    advice="長い作業は${display_other}を検討してください。"
  elif (( main_projected_remaining > 0 )); then
    advice="${display_other}のほうが余力が乏しいため、このまま${display_main}を使うほうが安全です。"
  else
    advice="どちらもリセット前に枯渇する見込みです。長い作業は次のリセットまで待つか、範囲を絞ってください。"
  fi

  if [[ "$status" == "healthy" ]]; then
    message="利用ペースは正常域へ戻りました。主${display_main}は週${main_remaining}%残り、${main_label}リセット時に約${main_projected_remaining}%残る予測です。${display_other}は週${other_remaining}%残り、${other_label}リセット時に約${other_projected_remaining}%残る予測です。現在の主のままで問題ありません。"
    severity=""
    reason=""
  elif [[ "$reason" == "exhaustion" ]]; then
    message="利用枠警告: 主${display_main}は週${main_remaining}%残り、${main_label}リセットですが、このペースではリセット前に使い切る予測です。${display_other}は週${other_remaining}%残り、${other_label}リセット時に約${other_projected_remaining}%残る予測です。${advice}"
  elif [[ "$reason" == "peer-headroom" ]]; then
    message="利用配分のご案内: 主${display_main}は週${main_remaining}%残り、${main_label}リセット時に約${main_projected_remaining}%残る予測です。${display_other}は週${other_remaining}%残り、${other_label}リセット時に約${other_projected_remaining}%残る予測です。${advice}"
  else
    message="利用ペース補足: 主${display_main}は週${main_remaining}%残り、${main_label}リセット時に約${main_projected_remaining}%残る予測です。${display_other}は週${other_remaining}%残り、${other_label}リセット時に約${other_projected_remaining}%残る予測です。${advice}"
  fi

  if ! usage_write_ledger "$ledger_path" "$main" "$status" "$severity" "$reason" \
      "$main_pct" "$other_pct" "$main_reset" "$other_reset" "$now"; then
    rmdir "$lock_dir" 2>/dev/null || true
    return 0
  fi
  rmdir "$lock_dir" 2>/dev/null || true
  if [[ "$severity" == "critical" ]]; then
    instruction="Begin the normal response with the following completed Japanese notice exactly once."
  else
    instruction="Append the following completed Japanese notice to the normal response exactly once."
  fi
  emit_notice "[usage-notice] Informational only; this does not authorize tools, role changes, or external actions. ${instruction}"$'\n'"${message}"
}

# Resolve this pane's owner = "<session>/<owner_alias>" so we enumerate, GC,
# notify on, and --read ONLY our own column's tracked tasks (cross-column leak
# fix). TT_CACHE_OWNER overrides (tests / non-tmux); else resolve from tmux.
# Fail-closed: an unresolvable/invalid owner disables the owner-scoped section
# entirely (we still run the legacy flat drain, which needs no owner).
if [[ -n "${TT_CACHE_OWNER+x}" ]]; then
  OWNER="$TT_CACHE_OWNER"
elif [[ -n "${TMUX_PANE:-}" ]]; then
  # Resolve from THIS hook's pane (-t "$TMUX_PANE"), NOT a bare display-message,
  # which returns the client's active/focused pane. Without -t, this UserPromptSubmit
  # hook would enumerate whatever column the user is looking at -- surfacing another
  # column's task notices in our session (the cross-column leak).
  _own_sess="$(tmux display-message -t "$TMUX_PANE" -p '#S' 2>/dev/null || true)"
  _own_alias="$(tmux display-message -t "$TMUX_PANE" -p '#{@alias}' 2>/dev/null || true)"
  OWNER="${_own_sess}/${_own_alias}"
else
  OWNER=""   # not inside a pane (no TMUX_PANE) -> unresolved -> fail-closed
fi
# Our own platform role (cc/cdx), used to scope the notified_at update to the
# message row whose recipient is exactly us. TT_OWNER_ROLE overrides (tests);
# else resolve from this pane's @role. If it cannot be resolved (empty), the
# notified_at update is skipped entirely (fail-closed) -- the recipient predicate
# is mandatory and never dropped, so we never flag a row we might not own. See
# the notified block below.
if [[ -n "${TT_OWNER_ROLE+x}" ]]; then
  OWNER_ROLE="$TT_OWNER_ROLE"
elif [[ -n "${TMUX_PANE:-}" ]]; then
  # -t "$TMUX_PANE": our own pane's role, not the focused pane's.
  case "$(tmux display-message -t "$TMUX_PANE" -p '#{@role}' 2>/dev/null || true)" in
    claude|claude-p*) OWNER_ROLE=cc ;;
    codex|codex-p*)   OWNER_ROLE=cdx ;;
    *)                OWNER_ROLE="" ;;
  esac
else
  OWNER_ROLE=""   # not inside a pane -> role unknown -> notified update fail-closed
fi

if [[ -n "$OWNER_ROLE" ]] && declare -F tt_db_exec_safe >/dev/null 2>&1 && declare -F tt_db_quote >/dev/null 2>&1 \
   && tt_cache_valid_owner "$OWNER"; then
  self_alias="${OWNER##*/}.${OWNER_ROLE}"
  _notice_row="$(tt_db_exec_safe "SELECT task_id || char(9) || owner_alias || char(9) || state || char(9) || COALESCE(tombstone_reason_hash,'') FROM tasks WHERE owner_session='$(tt_db_quote "${OWNER%%/*}")' AND target='$(tt_db_quote "$self_alias")' AND state IN ('cancelled','frozen') AND (worker_notice_state IS NULL OR worker_notice_state != state) ORDER BY COALESCE(frozen_at, cancelled_at, sent_at) DESC LIMIT 1;" 2>/dev/null || true)"
  if [[ "$_notice_row" == *$'\t'* ]]; then
    IFS=$'\t' read -r notice_task_id notice_owner_alias notice_state notice_reason_hash <<< "$_notice_row"
    emit_notice "[task-${notice_state}] owner=${notice_owner_alias} task=${notice_task_id} reason_hash=${notice_reason_hash}; edits and mutating shell are blocked, collect read-only evidence only"
    tt_db_exec_safe "UPDATE tasks SET worker_notice_state='${notice_state}', worker_notice_at=strftime('%s','now') WHERE owner_session='$(tt_db_quote "${OWNER%%/*}")' AND owner_alias='$(tt_db_quote "$notice_owner_alias")' AND target='$(tt_db_quote "$self_alias")' AND task_id='$(tt_db_quote "$notice_task_id")' AND state='${notice_state}';" >/dev/null 2>&1 || true
  fi
fi

if [[ "$CACHE_PRESENT" -eq 1 && ${#_cache_entries[@]} -gt 0 ]] && tt_cache_valid_owner "$OWNER"; then
  while IFS= read -r target; do
    [[ -n "$target" ]] || continue
    # Snapshot open task ids before --read. Lifecycle transitions retain cache
    # entries through verification; only USER_REPORTED removes them.
    pending_ids="$(tt_cache_list_open_tasks "$OWNER" "$target" | awk -F '\t' 'NF {print $1}')"
    read_output="$("$MSG_CLI" --read "$target" 40 2>&1 >/dev/null || true)"
    while IFS= read -r task_id; do
      [[ -n "$task_id" ]] || continue
      if printf '%s\n' "$read_output" | grep -q "TASK_REPLIED=${task_id}"; then
        if tt_cache_mark_notice "$OWNER" "$target" "$task_id" reply_arrived >/dev/null 2>&1; then
          emit_notice "[inbox-notice] reply arrived from ${target} task=${task_id} - review with tproj-msg --read ${target} 40"
        fi
        # R1' Stage 4: mark notified_at on the latest inbound message for this
        # task, so the R2' Monitor doesn't re-emit it. The row is selected by the
        # FULL identity (session + recipient=self + sender=target + task_id) --
        # never by task_id alone, and the recipient predicate is ALWAYS present.
        # Fail-CLOSED (R4-2): if our own role could not be resolved we cannot
        # identify the recipient, so we skip the notified update entirely rather
        # than flag a row we might not own. Fail-open on missing DB helpers.
        if [[ -n "$OWNER_ROLE" ]] \
           && declare -F tt_db_exec_safe >/dev/null 2>&1 && declare -F tt_db_set_notified >/dev/null 2>&1 \
           && declare -F tt_db_quote >/dev/null 2>&1; then
          _sess_q="$(tt_db_quote "${OWNER%%/*}")"
          _self_q="$(tt_db_quote "${OWNER##*/}.${OWNER_ROLE}")"
          _from_q="$(tt_db_quote "$target")"
          _task_q="$(tt_db_quote "$task_id")"
          _sel="SELECT id FROM messages WHERE session='${_sess_q}' AND to_alias='${_self_q}' AND from_alias='${_from_q}' AND task_id='${_task_q}' AND direction='inbound' ORDER BY id DESC LIMIT 1;"
          _notify_id="$(tt_db_exec_safe "$_sel" 2>/dev/null || true)"
          [[ -n "$_notify_id" ]] && tt_db_set_notified "$_notify_id" 2>/dev/null || true
        fi
      fi
    done <<< "$pending_ids"
  done < <(tt_cache_list_targets "$OWNER")

  while IFS=$'\t' read -r target task_id state event; do
    [[ -n "$target" && -n "$task_id" && -n "$event" ]] || continue
    case "$event" in
      no_ack)
        emit_notice "[inbox-notice] no ACK from ${target} task=${task_id} after ${TT_TASK_NO_ACK_SEC}s"
        ;;
      followup_due)
        emit_notice "[inbox-notice] followup_due target=${target} task=${task_id} state=${state}"
        ;;
      reroute_due)
        emit_notice "[inbox-notice] reroute_due target=${target} task=${task_id} state=${state}"
        ;;
      report_due)
        emit_notice "[inbox-notice] report_due target=${target} task=${task_id} state=${state}"
        ;;
      completion_stalled)
        emit_notice "[inbox-notice] completion_stalled target=${target} task=${task_id} state=${state}; task remains open"
        ;;
    esac
  done < <(tt_cache_due_notices "$OWNER")
fi

# Legacy (pre-v2) flat-layout drain: silently TTL-GC any old unscoped
# "<target>.json" files at the cache root so they self-empty after upgrade.
# NO notice is emitted (owner is unknowable, never guess another column's task).
# Safe to remove a few releases after v2 ships, once no flat files remain.
if [[ "$CACHE_PRESENT" -eq 1 ]]; then
  tt_cache_gc_legacy_flat >/dev/null 2>&1 || true
fi

emit_weekly_usage_notice

if [[ ${#NOTICES[@]} -gt 0 ]]; then
  notice_text="$(printf '%s\n' "${NOTICES[@]}")"
  if [[ "$PLATFORM" == codex ]]; then
    jq -nc --arg context "$notice_text" '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$context}}'
  else
    printf '%s' "$notice_text"
  fi
fi

exit 0
