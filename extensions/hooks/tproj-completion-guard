#!/usr/bin/env python3
"""Block silent delegated-task completion for Claude and Codex Stop hooks."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


LIFECYCLE_RE = re.compile(
    r"\[(ACK-PROGRESS|ACK|DONE|BLOCK|BLOCKED):\s*([A-Za-z0-9._-]+)\]"
)
REPORT_RE = re.compile(r"\[COMPLETION-REPORT:\s*([A-Za-z0-9._-]+)\]")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
WEEKLY_PACE_MAX_AGE_SEC = 900


def block(reason: str) -> int:
    print(json.dumps({"decision": "block", "reason": reason}, separators=(",", ":")))
    return 0


def owner_identity() -> tuple[str, str, str] | None:
    owner = os.environ.get("TT_CACHE_OWNER", "")
    role = os.environ.get("TT_OWNER_ROLE", "")
    if not owner and os.environ.get("TMUX_PANE"):
        pane = os.environ["TMUX_PANE"]
        try:
            session = subprocess.check_output(
                ["tmux", "display-message", "-t", pane, "-p", "#S"], text=True
            ).strip()
            alias = subprocess.check_output(
                ["tmux", "display-message", "-t", pane, "-p", "#{@alias}"], text=True
            ).strip()
            raw_role = subprocess.check_output(
                ["tmux", "display-message", "-t", pane, "-p", "#{@role}"], text=True
            ).strip()
        except (OSError, subprocess.CalledProcessError):
            return None
        owner = f"{session}/{alias}"
        if not role:
            if raw_role.startswith("claude"):
                role = "cc"
            elif raw_role.startswith("codex"):
                role = "cdx"
    if not re.fullmatch(r"[A-Za-z0-9._-]+/[A-Za-z0-9._-]+", owner):
        return None
    if role not in {"cc", "cdx"}:
        return None
    session, alias = owner.split("/", 1)
    return session, alias, role


def open_db() -> sqlite3.Connection | None:
    path = Path(
        os.environ.get(
            "TPROJ_MSG_DB_PATH", str(Path.home() / ".local/share/tproj-msg/messages.db")
        )
    )
    if not path.is_file():
        return None
    try:
        connection = sqlite3.connect(f"file:{path}?mode=rw", uri=True, timeout=1.0)
        connection.execute("PRAGMA busy_timeout=1000")
        return connection
    except sqlite3.Error:
        return None


def activation_epoch() -> int:
    raw = os.environ.get("TPROJ_TASK_GUARD_SINCE", "")
    if raw.isdigit():
        return int(raw)
    try:
        return int(Path(__file__).stat().st_mtime)
    except OSError:
        return 0


def latest_worker_task(
    db: sqlite3.Connection, session: str, self_alias: str
) -> tuple[str, str, str] | None:
    # The inbound message must actually carry a body. A task row whose message
    # arrived empty is an orphan: the agent was never told what the task is, yet the
    # guard would still refuse to let it end a turn until it tagged that task. There
    # is nothing truthful to answer with, so the only outcomes were a fabricated ACK
    # or a stuck session. Requiring a body fails open on exactly that case and leaves
    # every real delegation, which always has one, enforced as before.
    row = db.execute(
        """
        SELECT t.task_id, m.from_alias, t.state
          FROM tasks t
          JOIN messages m
            ON m.task_id=t.task_id
           AND m.direction='inbound'
           AND m.to_alias=t.target
         WHERE t.owner_session=?
           AND t.target=?
           AND t.state IN ('pending','acked')
           AND m.created_at>=?
           AND trim(COALESCE(m.body, '')) != ''
           AND (m.from_alias=t.owner_alias || '.cc' OR m.from_alias=t.owner_alias || '.cdx')
         ORDER BY m.id DESC
         LIMIT 1
        """,
        (session, self_alias, activation_epoch()),
    ).fetchone()
    return tuple(str(value) for value in row) if row else None


def recipient_forms(sender: str, recipient: str) -> list[str]:
    # `tproj-msg cdx "..."` addresses the counterpart in the caller's own column, and
    # the bare form is what gets recorded. Reading only the full alias made a marker
    # that had genuinely been delivered look unsent, and the agent was blocked until
    # it resent to the long form. The bare form is accepted only when the recipient
    # shares this sender's column, so it still cannot stand in for another column's
    # pane, which is the case the strict match existed to prevent.
    forms = [recipient]
    sender_column, _, _ = sender.rpartition(".")
    recipient_column, _, recipient_role = recipient.rpartition(".")
    if recipient_role and recipient_column and recipient_column == sender_column:
        forms.append(recipient_role)
    return forms


def marker_was_sent(
    db: sqlite3.Connection, sender: str, recipient: str, marker: str
) -> bool:
    forms = recipient_forms(sender, recipient)
    placeholders = ",".join("?" for _ in forms)
    row = db.execute(
        f"""
        SELECT 1
          FROM messages
         WHERE from_alias=? AND to_alias IN ({placeholders}) AND direction='outbound'
           AND instr(body, ?) > 0
         ORDER BY id DESC LIMIT 1
        """,
        (sender, *forms, marker),
    ).fetchone()
    return row is not None


def record_worker_transition(
    db: sqlite3.Connection,
    task_id: str,
    session: str,
    sender_alias: str,
    target: str,
    tag: str,
) -> None:
    owner_alias = sender_alias.rsplit(".", 1)[0]
    if tag in {"ACK", "ACK-PROGRESS"}:
        state, column = "acked", "ack_at"
    elif tag == "DONE":
        state, column = "done", "done_at"
    else:
        state, column = "blocked", "block_at"
    with db:
        db.execute(
            f"""
            UPDATE tasks
               SET state=?, {column}=COALESCE({column}, strftime('%s','now'))
             WHERE task_id=? AND owner_session=? AND owner_alias=? AND target=?
               AND state IN ('pending','acked')
            """,
            (state, task_id, session, owner_alias, target),
        )


def verified_cache_tasks(owner: str) -> list[tuple[int, str, str]]:
    root = Path(os.environ.get("TT_CACHE_DIR", str(Path.home() / ".cache/tproj-expect-reply")))
    owner_dir = root / owner
    found: list[tuple[int, str, str]] = []
    if not owner_dir.is_dir():
        return found
    for path in owner_dir.glob("*.json"):
        try:
            document = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(document, dict):
            continue
        for task_id, entry in document.items():
            if not isinstance(entry, dict) or entry.get("state") != "verified":
                continue
            target = str(entry.get("target") or path.stem)
            verified_at = int(entry.get("verified_at") or entry.get("sent_at") or 0)
            found.append((verified_at, str(task_id), target))
    return sorted(found, reverse=True)


def own_project() -> str:
    # The project whose mode governs this guard. The pane's @project tag is how every
    # other consumer scopes itself; asking tmux for this pane keeps the guard on the
    # same project its hooks and messages belong to. Empty on any failure, which the
    # router resolves from cwd -- the same fallback identity resolution uses.
    pane = os.environ.get("TPROJ_PANE", "") or os.environ.get("TMUX_PANE", "")
    if not pane:
        return ""
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-t", pane, "-p", "#{@project}"],
            capture_output=True, text=True, timeout=2, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def declared_role_mode() -> str:
    # The router owns the mode; ask it rather than reading its file. A second parser
    # of the same state is a second thing to keep in step, and this guard is exactly
    # where a disagreement would show up as a turn that cannot be ended. If the router
    # is missing or unhappy, treat the project as collab so the guard keeps behaving
    # the way it does today instead of quietly switching itself off.
    command = shutil.which("model-role-router")
    if not command:
        return "collab"
    invocation = [command, "mode", "--json"]
    project = own_project()
    if project:
        invocation.extend(["--project", project])
    try:
        result = subprocess.run(
            invocation, capture_output=True, text=True, timeout=3, check=False
        )
    except (OSError, subprocess.SubprocessError):
        return "collab"
    if result.returncode != 0:
        return "collab"
    try:
        document = json.loads(result.stdout or "{}")
    except json.JSONDecodeError:
        return "collab"
    mode = str(document.get("mode", "collab")) if isinstance(document, dict) else "collab"
    return mode or "collab"


ROUTER_MODULE_CACHE: dict = {}
MUTATION_MODULE_CACHE: dict = {}


def router_module():
    # Reuse the router's own liveness helpers rather than reimplementing them here.
    # This guard decides whether to hold a turn open; a second, drifting copy of
    # "is that peer really there" is the last thing that should make that call.
    if "m" in ROUTER_MODULE_CACHE:
        return ROUTER_MODULE_CACHE["m"]
    ROUTER_MODULE_CACHE["m"] = None
    path = shutil.which("model-role-router")
    if path:
        try:
            import importlib.machinery
            import importlib.util

            loader = importlib.machinery.SourceFileLoader("model_role_router", path)
            spec = importlib.util.spec_from_loader("model_role_router", loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            ROUTER_MODULE_CACHE["m"] = module
        except Exception:
            ROUTER_MODULE_CACHE["m"] = None
    return ROUTER_MODULE_CACHE["m"]


def mutation_guard_module():
    # PreToolUse and the frozen-task guard must agree on what counts as a mutation.
    # Load the installed sibling instead of maintaining a second shell parser here.
    if "m" in MUTATION_MODULE_CACHE:
        return MUTATION_MODULE_CACHE["m"]
    MUTATION_MODULE_CACHE["m"] = None
    path = Path(__file__).with_name("tproj-mutation-guard")
    if path.is_file():
        try:
            import importlib.machinery
            import importlib.util

            loader = importlib.machinery.SourceFileLoader("tproj_mutation_guard", str(path))
            spec = importlib.util.spec_from_loader("tproj_mutation_guard", loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            MUTATION_MODULE_CACHE["m"] = module
        except Exception:
            MUTATION_MODULE_CACHE["m"] = None
    return MUTATION_MODULE_CACHE["m"]


def pretool_is_mutating(payload: dict[str, Any]) -> bool:
    module = mutation_guard_module()
    if module is None:
        return False
    try:
        tool_name, command = module.parse_command(payload)
        if tool_name in module.READONLY_TOOL_NAMES:
            return False
        if tool_name in module.MUTATING_TOOL_NAMES:
            return True
        if command:
            return not module.is_readonly_shell(command)
        return bool(tool_name)
    except Exception:
        return False


def pane_column() -> str:
    pane = os.environ.get("TPROJ_PANE", "") or os.environ.get("TMUX_PANE", "")
    if not pane:
        return ""
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-t", pane, "-p", "#{@column}"],
            capture_output=True, text=True, timeout=3, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def consultable_peer_info(session: str, alias: str, role: str) -> dict[str, Any]:
    # The peer alias, but only while it is genuinely reachable right now. A stored
    # peer_alias is not that: a peer can exit mid-task, and requiring a consultation
    # with something that is gone would hold the turn open forever.
    module = router_module()
    if module is None:
        return {}
    try:
        column = pane_column()
        if not column:
            return {}
        identity = {"session": session, "column": column, "alias": f"{alias}.{role}", "pane_id": ""}
        peer = module.pane_peer(identity)
    except Exception:
        return {}
    return peer if isinstance(peer, dict) and peer.get("alias") else {}


def consultable_peer(session: str, alias: str, role: str) -> str:
    return str(consultable_peer_info(session, alias, role).get("alias", ""))


def peer_evidence_hash(peer: dict[str, Any]) -> str:
    """Hash live pane evidence without persisting pane text."""
    pane = str(peer.get("pane_id") or "")
    if not pane:
        return ""
    try:
        values = []
        for fmt in ("#{pane_current_command}", "#{@prompt_state}", "#{@prompt_state_ts}"):
            result = subprocess.run(
                ["tmux", "display-message", "-t", pane, "-p", fmt],
                capture_output=True,
                text=True,
                timeout=2,
                check=False,
            )
            if result.returncode != 0:
                return ""
            values.append(result.stdout.strip())
        capture = subprocess.run(
            ["tmux", "capture-pane", "-p", "-t", pane, "-S", "-12"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if capture.returncode != 0:
        return ""
    material = "\0".join([pane, *values, capture.stdout])
    return hashlib.sha256(material.encode("utf-8", errors="replace")).hexdigest()


def weekly_peer_unavailable(peer_alias: str) -> str:
    """Return a state reason only for fresh, authoritative unavailability."""
    role = peer_alias.rsplit(".", 1)[-1]
    if role not in {"cc", "cdx"}:
        return ""
    path = Path(
        os.environ.get(
            "TPROJ_USAGE_STATE_PATH",
            str(Path.home() / ".local/state/tproj/weekly-pace.json"),
        )
    )
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
        generated = int(document.get("generated_at", 0) or 0)
        side = (document.get("sides") or {}).get(role) or {}
        now = int(os.environ.get("TPROJ_USAGE_NOW", "") or time.time())
        status = str(side.get("status") or "")
        remaining = int(side.get("main_remaining_percent", -1))
    except (OSError, TypeError, ValueError, json.JSONDecodeError):
        return ""
    age = now - generated
    if age < -300 or age > WEEKLY_PACE_MAX_AGE_SEC:
        return ""
    if status in {"hold", "unavailable"}:
        return f"weekly-{status}"
    if remaining == 0:
        return "weekly-empty"
    return ""


def intent_guard_command(*args: str) -> bool:
    command = shutil.which("intent-guard")
    if not command:
        return False
    try:
        result = subprocess.run(
            [command, *args], capture_output=True, text=True, timeout=3, check=False
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0


def record_consult_outcome(message_id: int, outcome: str, reason: str, evidence_hash: str = "") -> None:
    args = [
        "consult-observe",
        "--message-id",
        str(message_id),
        "--outcome",
        outcome,
        "--reason",
        reason[:120],
    ]
    if evidence_hash:
        args.extend(["--evidence-hash", evidence_hash])
    intent_guard_command(*args)


def active_task_context(session: str, self_alias: str) -> tuple[str, str, dict[str, Any]]:
    # Identifier, consultation policy, and entry for this pane's current task run.
    # Only `intent-guard start` stamps a run, so a conversational turn is
    # never gated. The entry is found by owner rather than by project path: the
    # sender of a consultation resolves the same run the same way, and neither side
    # has to agree on a cwd. `started_at` is deliberately NOT used -- it survives
    # across starts -- and neither is `started_at_epoch`: one-second resolution lets
    # a consultation sent in the second a later task started satisfy that task.
    path = Path(os.environ.get("INTENT_GUARD_DIR", str(Path.home() / ".claude/intent-guard"))) / "state.json"
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return "", "legacy", {}
    runs = [
        (entry["task_run_id"], str(entry.get("assist_consult_policy") or "legacy"), entry)
        for entry in (state.get("entries") or {}).values()
        if isinstance(entry, dict)
        and entry.get("status") == "active"
        and entry.get("owner_session") == session
        and entry.get("owner_alias") == self_alias
        and isinstance(entry.get("task_run_id"), str)
        and entry["task_run_id"]
    ]
    # Exactly one, or nothing. `start` supersedes an owner's other active runs, so
    # more than one means that invariant is broken here and there is no "current"
    # run to gate against; taking the first would let whichever entry happened to be
    # enumerated first decide, and an older run's consultation would release a newer
    # task. A pre-migration lock carries no run id and so is not a candidate either.
    # `tproj-msg --consult` selects the run the same way, so both sides agree.
    if len(runs) != 1:
        return "", "legacy", {}
    run, policy, entry = runs[0]
    valid_policy = policy if policy in {"adaptive", "wait", "send", "none", "legacy"} else "legacy"
    return run, valid_policy, entry


def consultation_state(
    db: sqlite3.Connection, session: str, self_alias: str, peer_alias: str, run: str
) -> dict[str, Any]:
    # Only a send that was marked as a consultation, and that belongs to THIS task
    # run, counts. Any outbound row would be satisfied by a status report or by the
    # router's own pairing ping, which is not what "you asked someone" means.
    # Caller-audit rows carry an empty body and are excluded. Rejected/error/queued
    # attempts remain visible so adaptive policy can degrade instead of wedging.
    forms = recipient_forms(self_alias, peer_alias)
    placeholders = ",".join("?" for _ in forms)
    try:
        rows = db.execute(
            f"""
            SELECT id, COALESCE(delivery, ''), COALESCE(delivered_at, created_at, 0)
              FROM messages
             WHERE session = ?
               AND from_alias = ?
               AND to_alias IN ({placeholders})
               AND direction = 'outbound'
               AND msg_kind = 'consult'
               AND task_run_id = ?
               AND TRIM(COALESCE(body, '')) != ''
             ORDER BY id
            """,
            (session, self_alias, *forms, run),
        ).fetchall()
    except sqlite3.Error:
        return {"unknown": True}
    if not rows:
        return {"consulted": False, "replied": False, "consult_id": 0, "reply_id": 0}

    consult_id, delivery, delivered_at = rows[-1]
    consult_id = int(consult_id)
    delivery = str(delivery)
    delivered_at = int(delivered_at or 0)

    peer_forms = recipient_forms(self_alias, peer_alias)
    self_forms = recipient_forms(peer_alias, self_alias)
    peer_placeholders = ",".join("?" for _ in peer_forms)
    self_placeholders = ",".join("?" for _ in self_forms)
    if delivery in {"send-keys", "flushed"}:
        try:
            reply = db.execute(
                f"""
                SELECT id FROM messages
                 WHERE session = ?
                   AND from_alias IN ({peer_placeholders})
                   AND to_alias IN ({self_placeholders})
                   AND direction = 'inbound'
                   AND id > ?
                   AND TRIM(COALESCE(body, '')) != ''
                   AND COALESCE(delivery, '') NOT IN ('rejected', 'error')
                 ORDER BY id LIMIT 1
                """,
                (session, *peer_forms, *self_forms, consult_id),
            ).fetchone()
        except sqlite3.Error:
            return {"unknown": True}
        if reply is not None:
            return {
                "consulted": True,
                "replied": True,
                "consult_id": consult_id,
                "reply_id": int(reply[0]),
                "delivery": delivery,
                "delivered_at": delivered_at,
            }
    return {
        "consulted": True,
        "replied": False,
        "consult_id": consult_id,
        "reply_id": 0,
        "delivery": delivery,
        "delivered_at": delivered_at,
    }


def reflection_control(payload: dict[str, Any]) -> bool:
    module = mutation_guard_module()
    if module is None:
        return False
    try:
        _tool_name, command = module.parse_command(payload)
    except Exception:
        return False
    if not command:
        return False
    return (
        "tproj-msg" in command and "--consult" in command
    ) or re.search(r"(?:^|[/\s])intent-guard\s+(?:reflect|advice)(?:\s|$)", command) is not None


def advice_ack_id(entry: dict[str, Any]) -> int:
    try:
        return int((entry.get("advice") or {}).get("message_id", 0) or 0)
    except (TypeError, ValueError):
        return 0


def adaptive_wait_reason(
    peer: dict[str, Any], evidence: dict[str, Any], entry: dict[str, Any]
) -> tuple[str, str]:
    """Return (wait|degrade, reason) from delivery, quota, and pane evidence."""
    delivery = str(evidence.get("delivery") or "")
    consult_id = int(evidence.get("consult_id", 0) or 0)
    if delivery not in {"send-keys", "flushed"}:
        return "degrade", f"delivery-{delivery or 'unknown'}"
    unavailable = weekly_peer_unavailable(str(peer.get("alias") or ""))
    if unavailable:
        return "degrade", unavailable
    current_hash = peer_evidence_hash(peer)
    if not current_hash:
        return "degrade", "pane-evidence-unavailable"
    observed = entry.get("consultation") or {}
    try:
        observed_id = int(observed.get("message_id", 0) or 0)
    except (TypeError, ValueError):
        observed_id = 0
    if observed_id == consult_id and str(observed.get("outcome") or "") == "degraded":
        return "degrade", str(observed.get("reason") or "previously-degraded")
    previous_hash = str(observed.get("evidence_hash") or "") if observed_id == consult_id else ""
    if not previous_hash:
        record_consult_outcome(consult_id, "waiting", "pane-unchanged", current_hash)
        return "wait", "pane-baseline-recorded"
    if not SHA256_RE.fullmatch(previous_hash) or previous_hash != current_hash:
        return "degrade", "pane-state-changed"
    return "wait", "pane-unchanged"


def action_fingerprint(payload: dict[str, Any]) -> str:
    module = mutation_guard_module()
    if module is None:
        return ""
    try:
        tool_name, command = module.parse_command(payload)
        if command:
            material = f"{tool_name}\0{command}"
        else:
            tool_input = payload.get("tool_input")
            if not isinstance(tool_input, dict):
                hook_input = payload.get("hook_input")
                tool_input = hook_input.get("tool_input") if isinstance(hook_input, dict) else {}
            material = f"{tool_name}\0{json.dumps(tool_input, sort_keys=True, separators=(',', ':'))}"
    except Exception:
        return ""
    return hashlib.sha256(material.encode("utf-8", errors="replace")).hexdigest()


def posttool_exit_code(payload: dict[str, Any]) -> int | None:
    candidates: list[Any] = []
    for root in (payload, payload.get("raw_event"), payload.get("hook_input")):
        if not isinstance(root, dict):
            continue
        response = root.get("tool_response")
        if isinstance(response, dict):
            candidates.extend([response.get("exit_code"), response.get("exitCode")])
        candidates.extend([root.get("exit_code"), root.get("exitCode")])
    for value in candidates:
        if isinstance(value, bool):
            continue
        if isinstance(value, int):
            return value
        if isinstance(value, str) and re.fullmatch(r"-?[0-9]+", value.strip()):
            return int(value.strip())
    return None


def pure_predicate_command(command: str) -> bool:
    if not command or re.search(r"[;&|\n]", command):
        return False
    try:
        argv = shlex.split(command)
    except ValueError:
        return False
    return bool(argv) and Path(argv[0]).name in {"grep", "rg", "cmp", "diff", "test", "["}


def observe_posttool_failure(
    payload: dict[str, Any], session: str, alias: str, role: str, mode: str
) -> None:
    exit_code = posttool_exit_code(payload)
    if exit_code is None or exit_code == 0:
        return
    module = mutation_guard_module()
    if module is None:
        return
    try:
        tool_name, command = module.parse_command(payload)
    except Exception:
        return
    if tool_name not in {"Bash", "functions.exec", "functions.exec_command"} or not command:
        return
    if pure_predicate_command(command):
        return
    self_alias = f"{alias}.{role}"
    own_role = own_runtime_role(session, self_alias)
    if not (
        (mode == "assist" and own_role == "solo-fallback")
        or (mode == "collab" and own_role == "worker")
    ):
        return
    run, _policy, _entry = active_task_context(session, self_alias)
    if not run or not consultable_peer(session, alias, role):
        return
    db = open_db()
    if db is None:
        return
    try:
        row = db.execute("SELECT COALESCE(MAX(id), 0) FROM messages").fetchone()
        anchor = int(row[0]) if row else 0
    except (sqlite3.Error, TypeError, ValueError):
        db.close()
        return
    db.close()
    signature = action_fingerprint(payload)
    if signature:
        intent_guard_command(
            "reflect-observe", "--failure-signature", signature, "--anchor", str(anchor)
        )


def own_runtime_role(session: str, self_alias: str) -> str:
    module = router_module()
    if module is None:
        return ""
    column = pane_column()
    if not column:
        return ""
    try:
        own = module.read_json_file(
            module.state_path({"session": session, "column": column, "alias": self_alias})
        )
    except Exception:
        return ""
    return str(own.get("role", "")) if isinstance(own, dict) else ""


def reflection_gate(
    db: sqlite3.Connection,
    session: str,
    alias: str,
    role: str,
    run: str,
    peer_alias: str,
    entry: dict[str, Any],
) -> str:
    reflection = entry.get("reflection") or {}
    state = str(reflection.get("state") or "clear")
    if state == "due-reflect":
        return (
            "Course check: the last verification failed. Read its actual evidence before changing more. "
            "Record `intent-guard reflect --assessment expected-progress|course-correct|stuck "
            "--evidence \"<what changed>\" --next \"<one discriminating action>\"`. "
            f"Choosing stuck requires a fresh consultation with {peer_alias}."
        )
    if state != "due-consult":
        return ""
    try:
        due_anchor = int(reflection.get("anchor_message_id", 0) or 0)
    except (TypeError, ValueError):
        return ""
    evidence = consultation_state(db, session, f"{alias}.{role}", peer_alias, run)
    latest_consult_id = int(evidence.get("consult_id", 0) or 0)
    if (
        latest_consult_id > due_anchor
        and str(evidence.get("delivery") or "") not in {"rejected", "error", ""}
    ):
        intent_guard_command("reflect", "--consulted", "--message-id", str(latest_consult_id))
        return ""
    return (
        "Course correction required: reflection marked this route stuck, or the same machine failure "
        "signature returned without new evidence. Self-classification cannot clear it. "
        f"Consult {peer_alias} again with `tproj-msg --consult {peer_alias} \"<failure evidence and proposed correction>\"` "
        "before retrying."
    )


def consult_gate(session: str, alias: str, role: str, mode: str, event: str) -> str:
    # Empty string when the turn may end. Assist mode pairs the panes correctly but
    # gives the working side no reason to ever use its peer, so it works alone and
    # the mode looks identical to solo. This is the one place that makes the
    # consultation real, and every unknown fails open.
    self_alias = f"{alias}.{role}"
    module = router_module()
    if module is None:
        return ""
    # state_path scopes by column, so an empty one silently reads nothing and the
    # gate would quietly never arm. Ask tmux for this pane's column.
    column = pane_column()
    if not column:
        return ""
    try:
        own = module.read_json_file(
            module.state_path({"session": session, "column": column, "alias": self_alias})
        )
    except Exception:
        own = {}
    own_role = str(own.get("role") or "") if isinstance(own, dict) else ""
    is_working = (mode == "assist" and own_role == "solo-fallback") or (
        mode == "collab" and own_role == "worker"
    )
    if not is_working:
        return ""
    # A Collab worker's ACK-only turn must not be held open before it begins work;
    # PreToolUse is the authoritative early boundary for that mode.
    if mode == "collab" and event == "stop":
        return ""
    run, policy, entry = active_task_context(session, self_alias)
    if not run:
        return ""
    if policy == "none" or (event == "pretool" and policy == "legacy"):
        return ""
    peer = consultable_peer_info(session, alias, role)
    peer_alias = str(peer.get("alias") or "")
    if not peer_alias:
        return ""
    db = open_db()
    if db is None:
        return ""
    try:
        evidence = consultation_state(db, session, self_alias, peer_alias, run)
    finally:
        db.close()
    if evidence.get("unknown"):
        return ""
    if not evidence.get("consulted"):
        timing = "before the first mutation" if event == "pretool" else "before finishing this task"
        return (
            f"{mode.title()} mode: consult {peer_alias} {timing}. Send a design question or approach check with "
            f"`tproj-msg --consult {peer_alias} \"...\"`."
        )
    reply_id = int(evidence.get("reply_id", 0) or 0)
    consult_id = int(evidence.get("consult_id", 0) or 0)
    if reply_id:
        record_consult_outcome(consult_id, "replied", "direct-reply")
        if advice_ack_id(entry) != reply_id:
            return (
                f"Advice pending from {peer_alias}: acknowledge direct reply #{reply_id} before the next "
                "significant mutation or completion with `intent-guard advice --message-id "
                f"{reply_id} --decision adopt|partial|reject --why \"<one concrete reason>\"`."
            )
        return ""
    if policy == "send" and str(evidence.get("delivery") or "") in {"", "rejected", "error"}:
        return (
            f"{mode.title()} mode: the consultation to {peer_alias} was not delivered. "
            f"Send one successful `tproj-msg --consult {peer_alias} \"...\"` before continuing."
        )
    if policy not in {"wait", "adaptive"}:
        return ""
    if policy == "adaptive":
        outcome, reason = adaptive_wait_reason(peer, evidence, entry)
        if outcome == "degrade":
            record_consult_outcome(consult_id, "degraded", reason)
            return ""
    else:
        reason = "strict-wait"
    return (
        f"{mode.title()} mode: {peer_alias} accepted the consultation and its pane evidence is unchanged "
        f"({reason}). Continue read-only investigation until a reply or pane-state change; a later reply "
        "still requires an anchored advice acknowledgement."
    )


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--platform", choices=("claude", "codex"), default="claude")
    parser.add_argument("--event", choices=("stop", "pretool", "posttool"), default="stop")
    args = parser.parse_args()
    try:
        payload: Any = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return 0
    if not isinstance(payload, dict):
        return 0
    raw_event = payload.get("raw_event")
    if not isinstance(raw_event, dict):
        raw_event = {}
    text = payload.get("last_assistant_message") or raw_event.get("last_assistant_message", "")
    if args.event == "stop" and not isinstance(text, str):
        return 0
    identity = owner_identity()
    if identity is None:
        return 0
    session, alias, role = identity
    mode = declared_role_mode()
    if args.event == "posttool":
        if mode in {"assist", "collab"}:
            observe_posttool_failure(payload, session, alias, role, mode)
        return 0
    if args.event == "pretool":
        if not pretool_is_mutating(payload):
            return 0
        if reflection_control(payload):
            return 0
        self_alias = f"{alias}.{role}"
        if mode in {"assist", "collab"}:
            blocked = consult_gate(session, alias, role, mode, args.event)
            if blocked:
                return block(blocked)
        else:
            return 0
        own_role = own_runtime_role(session, self_alias)
        if not (
            (mode == "assist" and own_role == "solo-fallback")
            or (mode == "collab" and own_role == "worker")
        ):
            return 0
        run, _policy, entry = active_task_context(session, self_alias)
        if not run:
            return 0
        peer_alias = consultable_peer(session, alias, role)
        if not peer_alias:
            return 0
        db = open_db()
        if db is None:
            return 0
        try:
            blocked = reflection_gate(db, session, alias, role, run, peer_alias, entry)
        finally:
            db.close()
        return block(blocked) if blocked else 0
    if args.event != "stop":
        return 0
    if mode == "assist":
        blocked = consult_gate(session, alias, role, mode, args.event)
        return block(blocked) if blocked else 0
    # Under any other declared mode there is no orchestrator handing work down, so the
    # delegation lifecycle below does not describe what is happening. Holding a turn
    # open for a tag nobody is waiting on is the friction the mode was introduced to
    # remove.
    if mode != "collab":
        return 0
    owner = f"{session}/{alias}"
    self_alias = f"{alias}.{role}"
    db = open_db()

    if db is not None:
        try:
            worker = latest_worker_task(db, session, self_alias)
        except sqlite3.Error:
            worker = None
        if worker is not None:
            task_id, sender_alias, _state = worker
            markers = LIFECYCLE_RE.findall(text)
            exact = [(tag, marked_id) for tag, marked_id in markers if marked_id == task_id]
            if len(markers) != 1 or len(exact) != 1:
                db.close()
                return block(
                    f"Active delegated task {task_id} requires exactly one sent lifecycle tag: "
                    f"[ACK: {task_id}], [ACK-PROGRESS: {task_id}], [DONE: {task_id}], or [BLOCK: {task_id}]"
                )
            tag, _marked_id = exact[0]
            normalized = "BLOCK" if tag == "BLOCKED" else tag
            marker = f"[{tag}: {task_id}]"
            if not marker_was_sent(db, self_alias, sender_alias, marker):
                db.close()
                return block(
                    f"Lifecycle tag {marker} must first be sent to exact owner {sender_alias} with tproj-msg"
                )
            try:
                record_worker_transition(db, task_id, session, sender_alias, self_alias, normalized)
            except sqlite3.Error:
                db.close()
                return block(f"Could not durably record lifecycle tag {marker}; task remains open")
            db.close()
            return 0
        db.close()

    reports = REPORT_RE.findall(text)
    verified = verified_cache_tasks(owner)
    verified_by_id = {task_id: target for _timestamp, task_id, target in verified}
    if reports:
        if len(reports) != 1 or reports[0] not in verified_by_id:
            if verified:
                task_id = verified[0][1]
                return block(
                    f"Verified task {task_id} requires exactly [COMPLETION-REPORT: {task_id}] before Stop"
                )
            return block(f"Completion report task {reports[0]} is not verified for owner {owner}")
        task_id = reports[0]
        target = verified_by_id[task_id]
        cli = os.environ.get("TPROJ_TASK_CLI", str(Path.home() / "bin/tproj-task"))
        result = subprocess.run(
            [cli, "report", task_id, target],
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            env={
                **os.environ,
                "TT_CACHE_OWNER": owner,
                "TPROJ_PLATFORM_REPORT_OBSERVED": "1",
            },
            timeout=5,
            check=False,
        )
        if result.returncode != 0:
            return block(f"USER_REPORTED recording failed for task {task_id}; task remains open")
    elif verified:
        task_id = verified[0][1]
        return block(
            f"Verified task {task_id} requires exactly [COMPLETION-REPORT: {task_id}] before Stop"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
