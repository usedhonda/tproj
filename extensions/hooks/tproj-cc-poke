#!/usr/bin/env python3
"""Send one conservatively gated Claude keep-alive prompt.

This command is deliberately not registered as a Claude hook.  It is a
standalone, fail-closed primitive for a later Tproj integration.
"""

from __future__ import annotations

import argparse
import errno
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time


MARKER = "[keep-alive]"
MAX_PROMPT_AGE = 15 * 60
MAX_IDLE_AGE = 5 * 60
MAX_CAPTURE = 64 * 1024
PANE_FORMAT = "#{pane_id}|#{pane_tty}|#{pane_dead}|#{pane_pid}|#{@role}|#{@alias}|#S"
PROMPT_RE = re.compile(r"^[ \t]*[›❯][ \t]*$")
ANSI_RE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07]*(?:\x07|\x1b\\))")
UNSAFE_RE = re.compile(
    r"(?i)(permission|approval|allow|deny|ask.?user.?question|choose|select|"
    r"confirmation|continue\?|proceed\?|running|working|thinking|tool.?use|"
    r"esc to interrupt|ctrl-c|interrupt)"
)


def fail(reason: str) -> int:
    print(f"refused: {reason}", file=sys.stderr)
    return 1


def now() -> int:
    return int(time.time())


def integer(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if value <= 0 or value != value or value == float("inf"):
        return None
    return int(value)


def pane_identity(pane: str) -> dict[str, object] | None:
    if not re.fullmatch(r"%[0-9]+", pane):
        return None
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-t", pane, "-p", PANE_FORMAT],
            capture_output=True, text=True, timeout=2, check=True,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    parts = result.stdout.strip().split("|")
    if len(parts) != 7 or parts[0] != pane or parts[2] != "0":
        return None
    if not parts[1].startswith("/dev/") or not parts[3].isdigit():
        return None
    if not parts[4].startswith("claude-p") or not parts[5] or not parts[6]:
        return None
    return {"pane_id": parts[0], "tty": parts[1], "pane_pid": int(parts[3]),
            "role": parts[4], "alias": parts[5], "owner_session": parts[6]}


def agent_binding(pane_pid: int) -> dict[str, int] | None:
    """Prove that exactly one live Claude agent occupies this pane incarnation."""
    try:
        rows = subprocess.run(["/bin/ps", "-Ao", "pid=,ppid=,comm="],
                              capture_output=True, text=True, timeout=4, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    children: dict[int, list[tuple[int, str]]] = {}
    for line in rows.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            children.setdefault(int(parts[1]), []).append((int(parts[0]), parts[2]))
    matches: list[int] = []
    pending, seen = [pane_pid], {pane_pid}
    while pending and len(seen) < 512:
        for pid, command in children.get(pending.pop(0), ()):
            if pid in seen:
                continue
            seen.add(pid)
            pending.append(pid)
            if os.path.basename(command) == "claude":
                matches.append(pid)
    if pending or len(matches) != 1:
        return None
    try:
        started = subprocess.run(["/bin/ps", "-p", str(matches[0]), "-o", "lstart="],
                                 capture_output=True, text=True, timeout=2, check=True).stdout.strip()
        epoch = int(time.mktime(time.strptime(started, "%a %b %d %H:%M:%S %Y")))
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return {"agent_pid": matches[0], "agent_pid_start": epoch} if epoch > 0 else None


def capture(pane: str) -> str | None:
    try:
        result = subprocess.run(["tmux", "capture-pane", "-t", pane, "-p", "-S", "-40"],
                                capture_output=True, text=True, timeout=2, check=True)
    except (OSError, subprocess.SubprocessError):
        return None
    if len(result.stdout) > MAX_CAPTURE:
        return None
    return ANSI_RE.sub("", result.stdout)


def safe_composer_and_state(text: str) -> bool:
    lines = text.splitlines()
    nonempty = [line for line in lines if line.strip()]
    if not nonempty or not PROMPT_RE.fullmatch(nonempty[-1]):
        return False
    # A live dialog, running turn, or permission UI is a veto.  Do not inspect
    # the empty composer line as evidence of a question.
    return not UNSAFE_RE.search("\n".join(nonempty[:-1]))


def read_state(root: Path, session_id: str) -> tuple[Path, dict[str, object]] | None:
    if root.is_symlink() or not root.is_dir():
        return None
    key = hashlib.sha256(session_id.encode()).hexdigest()
    path = root / f"{key}.json"
    if path.is_symlink() or not path.is_file():
        return None
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return path, state if isinstance(state, dict) else {}


def state_ready(state: dict[str, object], session_id: str, identity: dict[str, object], t: int) -> tuple[bool, str]:
    if state.get("session_id") != session_id:
        return False, "session mismatch"
    for field in ("pane_id", "tty", "pane_pid", "role", "alias", "owner_session",
                  "agent_pid", "agent_pid_start"):
        if state.get(field) != identity.get(field):
            return False, f"{field} incarnation mismatch"
    if state.get("turn_state") != "idle_notified":
        return False, "idle_prompt notification absent"
    expiry = integer(state.get("cache_expires_at"))
    idle_at = integer(state.get("idle_prompt_at"))
    prompt_at = integer(state.get("last_user_prompt_at"))
    if expiry is None or expiry <= t:
        return False, "prompt cache expired"
    if idle_at is None or t - idle_at > MAX_IDLE_AGE or idle_at > t:
        return False, "idle notification stale"
    if prompt_at is None or prompt_at > t or t - prompt_at > MAX_PROMPT_AGE or idle_at < prompt_at:
        return False, "recent real user prompt absent"
    return True, "ok"


def acquire_lock(root: Path, session_id: str, expiry: int) -> Path | None:
    # CCStatusBar uses this same atomic name. Independent UIs must not inject
    # two keep-alive turns into one Claude session at the same cache expiry.
    if root.is_symlink():
        raise OSError("dedup directory is a symlink")
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    if root.is_symlink() or not root.is_dir():
        raise OSError("dedup directory unavailable")
    path = root / f"{session_id}-{expiry}"
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="ascii") as handle:
            handle.write(f"{os.getpid()}\n")
        return path
    except OSError as exc:
        if exc.errno == errno.EEXIST:
            return None
        raise


def send(pane: str) -> bool:
    try:
        subprocess.run(["tmux", "send-keys", "-l", "-t", pane, MARKER], check=True,
                       capture_output=True, timeout=2)
        subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True,
                       capture_output=True, timeout=2)
        return True
    except (OSError, subprocess.SubprocessError):
        return False


def lock_dir() -> Path:
    return Path.home() / ".claude/.cache-poke"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("session_id")
    parser.add_argument("--pane", default=os.environ.get("TMUX_PANE", ""))
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9-]{1,128}", args.session_id):
        return fail("invalid session id")
    root = Path(os.environ.get("TPROJ_CC_CACHE_DIR", Path.home() / ".local/state/tproj/cc-cache"))
    first = read_state(root, args.session_id)
    if first is None:
        return fail("cache unavailable")
    _, state = first
    identity = pane_identity(args.pane)
    if identity is None:
        return fail("current Claude pane unavailable")
    binding = agent_binding(identity["pane_pid"])
    if binding is None:
        return fail("live Claude agent unavailable")
    identity.update(binding)
    ok, reason = state_ready(state, args.session_id, identity, now())
    if not ok:
        return fail(reason)
    text = capture(args.pane)
    if text is None or not safe_composer_and_state(text):
        return fail("composer is not empty or live activity is present")
    expiry = integer(state.get("cache_expires_at"))
    assert expiry is not None
    try:
        lock = acquire_lock(lock_dir(), args.session_id, expiry)
    except OSError:
        return fail("dedup lock unavailable")
    if lock is None:
        return fail("poke already claimed for this cache expiry")
    # Re-read both sources immediately before the only send operation.
    latest = read_state(root, args.session_id)
    latest_identity = pane_identity(args.pane)
    latest_text = capture(args.pane)
    if latest is None or latest_identity is None or latest_text is None:
        return fail("pre-send recheck unavailable")
    latest_binding = agent_binding(latest_identity["pane_pid"])
    if latest_binding is None:
        return fail("pre-send Claude agent unavailable")
    latest_identity.update(latest_binding)
    _, latest_state = latest
    ok, reason = state_ready(latest_state, args.session_id, latest_identity, now())
    if not ok or latest_identity != identity or not safe_composer_and_state(latest_text):
        return fail(f"pre-send recheck failed: {reason if not ok else 'pane or composer changed'}")
    if not send(args.pane):
        return fail("tmux send failed")
    print(f"sent {MARKER} to {args.pane}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
