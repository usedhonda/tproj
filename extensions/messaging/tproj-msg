#!/bin/bash
set -euo pipefail

# tproj-msg - Inter-pane messaging CLI for tproj
#
# Usage:
#   tproj-msg <target> <message>         Send message (busy-aware, immediate return)
#   tproj-msg --stdin <target>           Read message from stdin (safe for backticks/special chars)
#   tproj-msg --session <name>            Specify tmux session (allows tmux-external calls)
#   tproj-msg --as <alias.role>           Override sender identity (use with --session)
#   tproj-msg --version                  Show version + actual script path
#   tproj-msg --fire <target> <message>  Send immediately (no idle check, auto-flush)
#   tproj-msg --force <target> <message> Send immediately (no idle check, no auto-flush)
#   tproj-msg --allow-relay <reason> ... One-time override for relay-like send
#   tproj-msg --allow-fanout <reason> .. One-time override for multi-target fan-out
#   tproj-msg --allow-chi-retry <reason> ...
#                                      One-time override for repeated Chi recovery dispatch
#   tproj-msg --new-task [--ttl <spec>] <target> <message>
#                                      Send message with Task ID tracking metadata
#   tproj-msg --new-task --user-authorized <target> <message>
#                                      Mark the delegated task as exact user-authorized
#   tproj-msg --role-handoff --new-task [--role-epoch <n>] [--orchestrator <id>] ...
#                                      Send a symmetric, typing-safe role handoff
#   tproj-msg --list                     List available targets
#   tproj-msg --read <target> [lines]    Read target's recent output
#   tproj-msg --status [target]          Show target idle/busy state + queue info
#   tproj-msg --flush                    Deliver all queued messages to idle targets
#
# Target formats:
#   <role>          Same column / single mode (cc, cdx)
#   <alias>.<role>  Specific column (tproj.cc, sl.cdx)
#   <alias>         Alias only -> defaults to <alias>.cc
#   agent-<name>    Agent pane
#   gate            ClawGate bridge (session-first tmux lane)
#   gate:session    ClawGate bridge (explicit session tmux lane; same as gate)
#   gate:line       ClawGate bridge (explicit LINE lane)
#   gate:direct     ClawGate bridge (legacy direct EventBus lane)
#   gate:default    ClawGate bridge (workspace default adapter)
#   gate:<adapter>  ClawGate bridge with specific adapter (e.g. gate:tmux)
#
# Modes (after fix):
#   --fire    No idle check. Auto-flush queue (max 3), then send. Immediate return.
#   --force   No idle check. No auto-flush. Pure immediate send. Immediate return.
#   --allow-relay <reason>
#             Allow one relay-like send ([from:], [Control:], [ACK:], [Persona Sync/Check]).
#             Does not enable broadcast targets (all/*/broadcast/everyone).
#   --allow-fanout <reason>
#             Allow one multi-target fan-out send of the same message for cc/cdx family.
#   --allow-chi-retry <reason>
#             Allow one repeated Chi recovery dispatch that would otherwise be blocked for 24h.
#   normal    Idle check. If idle: send. If busy/typing: queue. Immediate return.
#   --read    Read pane output.
#   --flush   Deliver queued messages to idle targets.
#   control   Duplicate [Control:*]/[ACK:*] is blocked for 10m per target.

show_usage() {
  cat << 'EOF'
tproj-msg - Inter-pane messaging (busy-aware)

Usage:
  tproj-msg <target> <message>         Send message (busy-aware, immediate return)
  tproj-msg --stdin <target>           Read message from stdin (safe for backticks/special chars)
  tproj-msg --session <name>            Specify tmux session (allows tmux-external calls)
  tproj-msg --as <alias.role>           Override sender identity (use with --session)
  tproj-msg --version                  Show version + actual script path
  tproj-msg --fire <target> <message>  Send immediately (no idle check, auto-flush)
  tproj-msg --force <target> <message> Send immediately (no idle check, no auto-flush)
  tproj-msg --allow-relay <reason> ... One-time override for relay-like send
  tproj-msg --allow-fanout <reason> .. One-time override for multi-target fan-out
  tproj-msg --allow-chi-retry <reason> ...
                                      One-time override for repeated Chi recovery dispatch
  tproj-msg --new-task [--ttl <spec>] <target> <message>
                                       Send message with Task ID tracking metadata
  tproj-msg --new-task --user-authorized <target> <message>
                                       Mark the delegated task as exact user-authorized
  tproj-msg --role-handoff --new-task [--role-epoch <n>] [--orchestrator <id>] ...
                                       Send a symmetric, typing-safe role handoff
  tproj-msg --list                     List available targets
  tproj-msg --read <target> [lines]    Read target's recent output
  tproj-msg --read desktop             Read messages the Codex Desktop sent to this pane
  tproj-msg --drain desktop            Ack-all: clear messages the Codex Desktop sent to this pane
  tproj-msg desktop.<project> <msg>    Write to the Codex Desktop mailbox (data-plane only)
  tproj-msg --desktop --session <name> <target> <msg>
                                       Codex Desktop side: write to a session pane's mailbox
  tproj-msg --desktop --mailbox        Codex Desktop side: read this desktop's own mailbox
  tproj-msg --desktop --drain          Codex Desktop side: ack-all clear this desktop's own mailbox
  tproj-msg --status [target]          Show idle/busy state + queue info
  tproj-msg --flush                    Deliver all queued messages to idle targets
  Note: Desktop is a data-plane mailbox only -- no pane injection, no task tracking, no control flags
  Note: duplicate control tags ([Control:*], [ACK:*]) are blocked for 10m per target
  Note: relay-like message body is blocked by default ([from:], [Control:], [ACK:], [Persona Sync/Check])
  Note: accidental fan-out is blocked by default for cc/cdx family (same message to many targets)
  Note: active typing is protected by queueing (session_typing_busy); use --force to bypass
  Note: --role-handoff always queues when blocked and cannot be combined with --force
  Note: pane @prompt_state (idle/suggestion/typing/unknown) is used first when available
  Note: broadcast-like targets are forbidden (all, *, broadcast, everyone)
  Note: gate uses session-first tmux lane by default; prefix message with [line-private] for LINE-only lane
  Note: repeated Chi recovery/proxy dispatch to gate is blocked for 24h unless --allow-chi-retry <reason> is explicit

Target formats:
  cc, cdx           Same column / single mode
  <alias>.cc        Specific column's Claude Code
  <alias>.cdx       Specific column's Codex
  <alias>           Defaults to <alias>.cc
  agent-<name>      Agent pane

Examples:
  tproj-msg cdx "What do you think about this approach?"
  tproj-msg sl.cc "Can you review the config change?"
  tproj-msg --fire agent-reviewer "Check this file"
  tproj-msg --force cdx "urgent message"
  tproj-msg --allow-relay incident-123 --force tproj.cc "[Control:PSYNC-STOP] ACK"
  tproj-msg --allow-fanout sync-1 tproj.cc "Please review this design"
  tproj-msg --allow-chi-retry current-user-approved-retry gate "Recover missed LINE id 11"
  tproj-msg --new-task --ttl 45m tproj.cc "Please take Lane D"
  tproj-msg --new-task --user-authorized tproj.cc "Run exactly: git push origin main"
  tproj-msg --role-handoff --new-task --role-epoch 7 --orchestrator tproj.cc tproj.cdx "Take orchestration"
  tproj-msg gate "Send via session-first tmux lane"
  tproj-msg gate:session "Send via session tmux lane (explicit)"
  tproj-msg gate:line "Send via LINE adapter"
  tproj-msg gate:direct "Send via direct EventBus lane (legacy)"
  tproj-msg gate "[line-private] this is private to LINE only"
  tproj-msg --status cdx
  tproj-msg --flush
  tproj-msg --list
  tproj-msg --read cdx 50
EOF
}

SCRIPT_VERSION="2026.02.21"

canonicalize_path() {
  local target="$1"
  local dir base
  dir=$(cd "$(dirname "$target")" 2>/dev/null && pwd -P) || return 1
  base=$(basename "$target")
  printf '%s/%s\n' "$dir" "$base"
}

find_repo_tproj_msg_from_cwd() {
  local dir candidate
  dir=$(pwd -P)
  while true; do
    candidate="$dir/bin/tproj-msg"
    if [[ -x "$candidate" ]]; then
      canonicalize_path "$candidate"
      return 0
    fi
    [[ "$dir" == "/" ]] && break
    dir=$(dirname "$dir")
  done
  return 1
}

SELF_PATH=$(canonicalize_path "$0" 2>/dev/null || printf '%s' "$0")
HOME_BIN_PATH="$HOME/bin/tproj-msg"
HOME_BIN_PATH=$(canonicalize_path "$HOME_BIN_PATH" 2>/dev/null || printf '%s' "$HOME_BIN_PATH")
REPO_BIN_CANDIDATE=$(find_repo_tproj_msg_from_cwd 2>/dev/null || true)
TASK_CACHE_HELPER="$(dirname "$SELF_PATH")/tproj-task-cache.sh"
# R1' Stage 3: source cache+DB helpers early so all send paths can shadow-write.
# Existing --new-task and --read paths also source this; idempotent.
# Function-only file, no side effects at source time. Fail-open.
[[ -f "$TASK_CACHE_HELPER" ]] && source "$TASK_CACHE_HELPER" 2>/dev/null || true

# Desktop <-> session data-plane mailbox helper. Function-only, fail-open.
# Provides the isolated Desktop registry schema consumer + mailbox storage.
DESKTOP_HELPER="$(dirname "$SELF_PATH")/tproj-msg-desktop.sh"
if [[ -f "$DESKTOP_HELPER" ]]; then
  # shellcheck source=/dev/null
  source "$DESKTOP_HELPER" 2>/dev/null || true
elif [[ -f "$HOME/bin/tproj-msg-desktop.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/bin/tproj-msg-desktop.sh" 2>/dev/null || true
fi

if [[ -z "${TPROJ_MSG_REEXECED:-}" ]] && [[ "$SELF_PATH" == "$HOME_BIN_PATH" ]] && [[ -n "${REPO_BIN_CANDIDATE:-}" ]] && [[ "$REPO_BIN_CANDIDATE" != "$SELF_PATH" ]]; then
  echo "Info: stale tproj-msg detected at ~/bin; re-exec -> $REPO_BIN_CANDIDATE" >&2
  export TPROJ_MSG_REEXECED=1
  exec "$REPO_BIN_CANDIDATE" "$@"
fi

show_version() {
  local reexeced
  if [[ -n "${TPROJ_MSG_REEXECED:-}" ]]; then
    reexeced="true"
  else
    reexeced="false"
  fi
  cat <<EOF
tproj-msg version: $SCRIPT_VERSION
script_path: $SELF_PATH
reexeced: $reexeced
EOF
}

# Role shorthand: claude/claude-pN -> cc, codex/codex-pN -> cdx, agent-* -> as-is
role_to_short() {
  local r="$1"
  case "$r" in
    claude|claude-p*) echo "cc" ;;
    codex|codex-p*)   echo "cdx" ;;
    *)                echo "$r" ;;
  esac
}

# Short to role pattern (for matching @role tags)
short_to_role_pattern() {
  local short="$1"
  local col="${2:-}"
  case "$short" in
    cc)
      if [[ -n "$col" ]]; then
        echo "claude-p${col}"
      else
        echo "claude"
      fi
      ;;
    cdx)
      if [[ -n "$col" ]]; then
        echo "codex-p${col}"
      else
        echo "codex"
      fi
      ;;
    *)
      echo "$short"
      ;;
  esac
}

# === Parse arguments ===
FIRE_MODE=false
FORCE_MODE=false
MSG_KIND=""
LIST_MODE=false
READ_MODE=false
FLUSH_MODE=false
STATUS_MODE=false
VERSION_MODE=false
NEW_TASK_MODE=false
ROLE_HANDOFF_MODE=false
ROLE_HANDOFF_EPOCH=""
ROLE_HANDOFF_ORCHESTRATOR=""
TTL_SPEC=""
USER_AUTHORIZED_EXACT=false
ALLOW_RELAY=false
ALLOW_RELAY_REASON=""
ALLOW_FANOUT=false
ALLOW_FANOUT_REASON=""
ALLOW_CHI_RETRY=false
ALLOW_CHI_RETRY_REASON=""
STDIN_MODE=false
DESKTOP_MODE=false
MAILBOX_MODE=false
DRAIN_MODE=false
EXPLICIT_SESSION=""
EXPLICIT_AS=""
TARGET=""
MESSAGE=""
READ_LINES=50
POSITIONAL_ARGS=()

if [[ $# -eq 0 ]]; then
  show_usage
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_usage
      exit 0
      ;;
    -V|--version)
      VERSION_MODE=true
      shift
      ;;
    --allow-relay)
      shift
      [[ $# -lt 1 ]] && { echo "Error: --allow-relay requires <reason>" >&2; exit 1; }
      ALLOW_RELAY=true
      ALLOW_RELAY_REASON="$1"
      shift
      ;;
    --allow-fanout)
      shift
      [[ $# -lt 1 ]] && { echo "Error: --allow-fanout requires <reason>" >&2; exit 1; }
      ALLOW_FANOUT=true
      ALLOW_FANOUT_REASON="$1"
      shift
      ;;
    --allow-chi-retry)
      shift
      [[ $# -lt 1 ]] && { echo "Error: --allow-chi-retry requires <reason>" >&2; exit 1; }
      [[ -n "$1" ]] || { echo "Error: --allow-chi-retry requires non-empty <reason>" >&2; exit 1; }
      ALLOW_CHI_RETRY=true
      ALLOW_CHI_RETRY_REASON="$1"
      shift
      ;;
    --new-task)
      NEW_TASK_MODE=true
      shift
      ;;
    --role-handoff)
      ROLE_HANDOFF_MODE=true
      shift
      ;;
    --role-epoch)
      shift
      [[ $# -lt 1 ]] && { echo "Error: --role-epoch requires <n>" >&2; exit 1; }
      ROLE_HANDOFF_EPOCH="$1"
      shift
      ;;
    --orchestrator)
      shift
      [[ $# -lt 1 ]] && { echo "Error: --orchestrator requires <id>" >&2; exit 1; }
      ROLE_HANDOFF_ORCHESTRATOR="$1"
      shift
      ;;
    --ttl)
      shift
      [[ $# -lt 1 ]] && { echo "Error: --ttl requires <spec>" >&2; exit 1; }
      TTL_SPEC="$1"
      shift
      ;;
    --user-authorized)
      USER_AUTHORIZED_EXACT=true
      shift
      ;;
    --consult)
      # Marks this send as a deliberate consultation of the peer. Recorded in the
      # message row so a completion gate can require one without accepting any
      # outbound traffic -- a status report or an automatic pairing ping would
      # otherwise satisfy an obligation meant to mean "you asked someone".
      MSG_KIND="consult"
      shift
      ;;
    --fire)
      [[ "$FORCE_MODE" == "true" ]] && { echo "Error: --fire and --force cannot be combined" >&2; exit 1; }
      FIRE_MODE=true
      shift
      ;;
    --force)
      [[ "$FIRE_MODE" == "true" ]] && { echo "Error: --fire and --force cannot be combined" >&2; exit 1; }
      FORCE_MODE=true
      shift
      ;;
    --list)
      LIST_MODE=true
      shift
      ;;
    --read)
      READ_MODE=true
      shift
      ;;
    --flush)
      FLUSH_MODE=true
      shift
      ;;
    --stdin)
      STDIN_MODE=true
      shift
      ;;
    --desktop)
      # Codex Desktop data-plane side. Identity is resolved by PID ancestry
      # against the Desktop registry entry (never a pane, never --as).
      DESKTOP_MODE=true
      shift
      ;;
    --mailbox)
      # Read the caller's OWN mailbox (Desktop side: messages sessions sent to
      # this desktop). Pure inspection; no send, no exec, no task/role change.
      MAILBOX_MODE=true
      shift
      ;;
    --drain)
      # Explicit ack-all: delete every envelope in the caller's own inbox.
      #   --desktop --drain   Desktop side: drain to-desktop/<project>.
      #   --drain desktop     session side: drain to-session/<session>/<self>.
      # The only delete path a recipient invokes; plain read stays pure.
      DRAIN_MODE=true
      shift
      ;;
    --session)
      shift
      [[ $# -lt 1 ]] && { echo "Error: --session requires <name>" >&2; exit 1; }
      EXPLICIT_SESSION="$1"
      shift
      ;;
    --as)
      shift
      [[ $# -lt 1 ]] && { echo "Error: --as requires <alias.role>" >&2; exit 1; }
      EXPLICIT_AS="$1"
      shift
      ;;
    --status)
      STATUS_MODE=true
      shift
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        POSITIONAL_ARGS+=("$1")
        shift
      done
      ;;
    -*)
      echo "Error: unknown option '$1'" >&2
      exit 1
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

MODE_COUNT=0
[[ "$FIRE_MODE" == "true" ]] && ((MODE_COUNT++)) || true
[[ "$FORCE_MODE" == "true" ]] && ((MODE_COUNT++)) || true
[[ "$LIST_MODE" == "true" ]] && ((MODE_COUNT++)) || true
[[ "$READ_MODE" == "true" ]] && ((MODE_COUNT++)) || true
[[ "$FLUSH_MODE" == "true" ]] && ((MODE_COUNT++)) || true
[[ "$STATUS_MODE" == "true" ]] && ((MODE_COUNT++)) || true
[[ "$VERSION_MODE" == "true" ]] && ((MODE_COUNT++)) || true
[[ "$DRAIN_MODE" == "true" ]] && ((MODE_COUNT++)) || true

if [[ $MODE_COUNT -gt 1 ]]; then
  echo "Error: mode options cannot be combined (--fire/--force/--list/--read/--flush/--status/--version/--drain)" >&2
  exit 1
fi

SEND_MODE=true
if [[ "$LIST_MODE" == "true" || "$READ_MODE" == "true" || "$FLUSH_MODE" == "true" || "$STATUS_MODE" == "true" || "$VERSION_MODE" == "true" || "$DRAIN_MODE" == "true" ]]; then
  SEND_MODE=false
fi
# --mailbox (read own Desktop mailbox) is a pure-inspection mode, not a send.
if [[ "$MAILBOX_MODE" == "true" ]]; then
  SEND_MODE=false
fi

# --- Desktop mode validation (data-plane mailbox only) ---
if [[ "$MAILBOX_MODE" == "true" && "$DESKTOP_MODE" != "true" ]]; then
  echo "Error: --mailbox requires --desktop" >&2
  exit 1
fi

if [[ "$NEW_TASK_MODE" == "true" && "$SEND_MODE" != "true" ]]; then
  echo "Error: --new-task is only valid for send modes" >&2
  exit 1
fi

if [[ -n "$TTL_SPEC" && "$NEW_TASK_MODE" != "true" ]]; then
  echo "Error: --ttl requires --new-task" >&2
  exit 1
fi

if [[ "$USER_AUTHORIZED_EXACT" == "true" && "$NEW_TASK_MODE" != "true" ]]; then
  echo "Error: --user-authorized requires --new-task" >&2
  exit 1
fi

if [[ "$ROLE_HANDOFF_MODE" == "true" && "$SEND_MODE" != "true" ]]; then
  echo "Error: --role-handoff is only valid for send modes" >&2
  exit 1
fi

if [[ "$ROLE_HANDOFF_MODE" == "true" && "$NEW_TASK_MODE" != "true" ]]; then
  echo "Error: --role-handoff requires --new-task" >&2
  exit 1
fi

if [[ "$ROLE_HANDOFF_MODE" == "true" && "$FORCE_MODE" == "true" ]]; then
  echo "Error: --role-handoff cannot be combined with --force; blocked targets are deferred automatically" >&2
  exit 1
fi

# A consultation is an ordinary message to the peer and nothing else. Every flag
# below either delegates instead of asking (--new-task, --role-handoff,
# --user-authorized) or overrides a delivery policy (--force, --fire,
# --allow-relay, --allow-fanout). Allowing any of them would let a pane satisfy the
# assist consultation gate while handing the work off or shouting past a guard,
# which is the opposite of what the mark is supposed to attest.
if [[ "$MSG_KIND" == "consult" ]]; then
  if [[ "$SEND_MODE" != "true" ]]; then
    echo "Error: --consult is only valid for send modes" >&2
    exit 1
  fi
  _conflict=""
  [[ "$NEW_TASK_MODE" == "true" ]]        && _conflict="--new-task" || true
  [[ "$ROLE_HANDOFF_MODE" == "true" ]]    && _conflict="--role-handoff" || true
  [[ "$USER_AUTHORIZED_EXACT" == "true" ]] && _conflict="--user-authorized" || true
  [[ "$FORCE_MODE" == "true" ]]           && _conflict="--force" || true
  [[ "$FIRE_MODE" == "true" ]]            && _conflict="--fire" || true
  [[ "$ALLOW_RELAY" == "true" ]]          && _conflict="--allow-relay" || true
  [[ "$ALLOW_FANOUT" == "true" ]]         && _conflict="--allow-fanout" || true
  if [[ -n "$_conflict" ]]; then
    echo "Error: --consult cannot be combined with ${_conflict}; a consultation is a plain send to the peer" >&2
    exit 1
  fi
  unset _conflict
fi

# The intent-guard task run this consultation belongs to, or empty. Selected by
# owner (tmux session + pane alias) rather than by project path, so the sender and
# the completion gate land on the same run without having to agree on a cwd. Empty
# for every non-consult send: only the consultation mark needs a run boundary.
consult_task_run() {
  [[ "${MSG_KIND:-}" == "consult" ]] || return 0
  local from_alias="$1" state
  state="${INTENT_GUARD_DIR:-$HOME/.claude/intent-guard}/state.json"
  [[ -f "$state" ]] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  # Exactly one, or nothing: intent-guard start supersedes an owner's other active
  # runs, so more than one means there is no single current run to attribute this
  # consultation to. Picking the first would stamp an older run's id and release a
  # gate the pane has not actually consulted for.
  jq -r --arg s "${SESSION:-}" --arg a "$from_alias" '
    [ (.entries // {})[]
      | select(.status == "active")
      | select((.owner_session // "") == $s and (.owner_alias // "") == $a)
      | (.task_run_id // "") ]
    | map(select(. != "")) | if length == 1 then .[0] else "" end' "$state" 2>/dev/null || true
}

if [[ ( -n "$ROLE_HANDOFF_EPOCH" || -n "$ROLE_HANDOFF_ORCHESTRATOR" ) && "$ROLE_HANDOFF_MODE" != "true" ]]; then
  echo "Error: --role-epoch and --orchestrator require --role-handoff" >&2
  exit 1
fi

if [[ -n "$ROLE_HANDOFF_EPOCH" && ! "$ROLE_HANDOFF_EPOCH" =~ ^[0-9]+$ ]]; then
  echo "Error: --role-epoch must be a non-negative integer" >&2
  exit 1
fi

if [[ -n "$ROLE_HANDOFF_ORCHESTRATOR" && ! "$ROLE_HANDOFF_ORCHESTRATOR" =~ ^[[:alnum:]_.:-]+$ ]]; then
  echo "Error: --orchestrator contains unsupported characters" >&2
  exit 1
fi

TTL_SPEC="${TTL_SPEC:-30m}"

if [[ "$NEW_TASK_MODE" == "true" ]]; then
  [[ -f "$TASK_CACHE_HELPER" ]] || { echo "Error: missing task cache helper: $TASK_CACHE_HELPER" >&2; exit 1; }
  # shellcheck source=/dev/null
  source "$TASK_CACHE_HELPER"
  if ! TTL_SEC=$(tt_cache_ttl_to_seconds "$TTL_SPEC"); then
    echo "Error: invalid TTL spec '$TTL_SPEC'" >&2
    exit 1
  fi
fi

if [[ "$VERSION_MODE" == "true" ]]; then
  [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]] || { echo "Error: --version takes no positional arguments" >&2; exit 1; }
  show_version
  exit 0
fi

if [[ "$LIST_MODE" == "true" ]]; then
  [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]] || { echo "Error: --list takes no positional arguments" >&2; exit 1; }
fi

if [[ "$FLUSH_MODE" == "true" ]]; then
  [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]] || { echo "Error: --flush takes no positional arguments" >&2; exit 1; }
fi

if [[ "$STATUS_MODE" == "true" ]]; then
  [[ ${#POSITIONAL_ARGS[@]} -le 1 ]] || { echo "Error: --status accepts at most one target" >&2; exit 1; }
  TARGET="${POSITIONAL_ARGS[0]:-}"
fi

if [[ "$READ_MODE" == "true" ]]; then
  [[ ${#POSITIONAL_ARGS[@]} -ge 1 ]] || { echo "Error: --read requires <target>" >&2; exit 1; }
  [[ ${#POSITIONAL_ARGS[@]} -le 2 ]] || { echo "Error: --read accepts <target> [lines]" >&2; exit 1; }
  TARGET="${POSITIONAL_ARGS[0]}"
  READ_LINES="${POSITIONAL_ARGS[1]:-50}"
fi

if [[ "$DRAIN_MODE" == "true" && "$DESKTOP_MODE" != "true" ]]; then
  # Session-side drain: --drain <desktop target> (drains this pane's own inbox).
  [[ ${#POSITIONAL_ARGS[@]} -eq 1 ]] || { echo "Error: --drain requires exactly one target (desktop[.<project>])" >&2; exit 1; }
  TARGET="${POSITIONAL_ARGS[0]}"
  case "$TARGET" in
    desktop|desktop.*) : ;;
    *) echo "Error: --drain target must be a Desktop mailbox (desktop[.<project>]); use --desktop --drain on the Desktop side" >&2; exit 1 ;;
  esac
fi

if [[ "$LIST_MODE" != "true" && "$READ_MODE" != "true" && "$FLUSH_MODE" != "true" && "$STATUS_MODE" != "true" && "$MAILBOX_MODE" != "true" && "$DRAIN_MODE" != "true" ]]; then
  if [[ "$STDIN_MODE" == "true" ]]; then
    [[ ${#POSITIONAL_ARGS[@]} -ge 1 ]] || { echo "Error: --stdin requires <target>" >&2; show_usage; exit 1; }
    TARGET="${POSITIONAL_ARGS[0]}"
    MESSAGE=$(cat)
  else
    [[ ${#POSITIONAL_ARGS[@]} -ge 2 ]] || { echo "Error: requires <target> <message>" >&2; show_usage; exit 1; }
    TARGET="${POSITIONAL_ARGS[0]}"
    MESSAGE="${POSITIONAL_ARGS[@]:1}"
  fi
fi

if [[ "$ALLOW_RELAY" == "true" && ( "$LIST_MODE" == "true" || "$READ_MODE" == "true" || "$FLUSH_MODE" == "true" || "$STATUS_MODE" == "true" || "$VERSION_MODE" == "true" ) ]]; then
  echo "Error: --allow-relay is only valid for send modes" >&2
  exit 1
fi

if [[ "$ALLOW_FANOUT" == "true" && ( "$LIST_MODE" == "true" || "$READ_MODE" == "true" || "$FLUSH_MODE" == "true" || "$STATUS_MODE" == "true" || "$VERSION_MODE" == "true" ) ]]; then
  echo "Error: --allow-fanout is only valid for send modes" >&2
  exit 1
fi

if [[ "$ALLOW_CHI_RETRY" == "true" && ( "$LIST_MODE" == "true" || "$READ_MODE" == "true" || "$STATUS_MODE" == "true" || "$VERSION_MODE" == "true" ) ]]; then
  echo "Error: --allow-chi-retry is only valid for send/flush modes" >&2
  exit 1
fi

# === Caller identity verification (R2 Stage 1) ===
# --as lets an external caller claim any alias.role with no built-in proof
# of identity, and --role-epoch/--orchestrator accept any syntactically
# valid value (see below). Both were exploited via unauthenticated tmux
# send-keys injection (multiple confirmed incidents, 2026-07). This binds
# a claimed alias to the *live* model-role-router registry entry for that
# alias: the calling process's own ancestry must contain the exact
# (pid, pid_start) pair the registry last recorded for the claimed alias.
# A recycled pid cannot pass this check because pid_start would differ.
# See docs/reference/tproj-msg-sender-verification.md.
TPROJ_MSG_REGISTRY_STALE_SECONDS="${TPROJ_MSG_REGISTRY_STALE_SECONDS:-172800}"  # 48h
TPROJ_MSG_VERIFIER_MAX_ANCESTOR_HOPS="${TPROJ_MSG_VERIFIER_MAX_ANCESTOR_HOPS:-32}"

# E3 (msg-repair): lightweight debug tap. With TPROJ_MSG_DEBUG=1, append a
# timestamped diagnostic line for the major paths (send decision, queue, dedup,
# caller verification) to the debug log. Default off -> immediate return before
# any work, so behavior and output are completely unchanged. Defined early so
# every downstream path (including the pre-flight --as verification) can call it.
TPROJ_MSG_DEBUG="${TPROJ_MSG_DEBUG:-0}"
TPROJ_MSG_DEBUG_LOG="${TPROJ_MSG_DEBUG_LOG:-$HOME/.cache/tproj-msg/debug.log}"
dlog() {
  [[ "$TPROJ_MSG_DEBUG" == "1" ]] || return 0
  mkdir -p "$(dirname "$TPROJ_MSG_DEBUG_LOG")" 2>/dev/null || true
  printf '%s [%s->%s] %s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" \
    "${MY_ALIAS:-?}.${MY_ROLE:-?}" "${TARGET:-?}" "$*" \
    >> "$TPROJ_MSG_DEBUG_LOG" 2>/dev/null || true
  return 0
}

# Walk process ancestry from this script's own pid upward, looking for a
# claude/codex agent process. On success prints "<pid> <role>" to stdout
# and returns 0; on failure (no such ancestor within 6 hops) returns 1.
find_agent_ancestor_pid() {
  local walk_pid=$$ ancestor_cmd role="" _hops
  for _hops in 1 2 3 4 5 6; do
    walk_pid=$(ps -p "$walk_pid" -o ppid= 2>/dev/null | tr -d ' ')
    [[ -n "$walk_pid" && "$walk_pid" != "0" && "$walk_pid" != "1" ]] || return 1
    ancestor_cmd=$(ps -p "$walk_pid" -o comm= 2>/dev/null || true)
    case "$ancestor_cmd" in
      claude*) role="cc"; break ;;
      codex*)  role="cdx"; break ;;
    esac
  done
  [[ -n "$role" ]] || return 1
  printf '%s %s\n' "$walk_pid" "$role"
}

# Walk process ancestry from this process's own pid upward and locate the
# caller pid in the explicit alias.role registry entry. Returns
# "<pid> <pid_start>" on success and 1 if the pid does not appear in the
# bounded ancestor chain.
find_registry_ancestor_match() {
  local reg_pid="$1" walk_pid=$$ ancestor_pid ancestor_start
  local _hops=0

  [[ "$reg_pid" =~ ^[0-9]+$ && "$reg_pid" -gt 0 ]] || return 1

  while [[ $_hops -lt "$TPROJ_MSG_VERIFIER_MAX_ANCESTOR_HOPS" ]]; do
    (( _hops += 1 ))
    walk_pid=$(ps -p "$walk_pid" -o ppid= 2>/dev/null | tr -d ' ')
    [[ -n "$walk_pid" && "$walk_pid" != "0" && "$walk_pid" != "1" ]] || return 1
    [[ "$walk_pid" != "$reg_pid" ]] || {
      ancestor_start=$(pid_start_epoch_bash "$walk_pid")
      printf '%s %s\n' "$walk_pid" "$ancestor_start"
      return 0
    }
  done

  return 1
}

# Absolute process start time (unix epoch) for the given pid, or 0 if the
# pid is invalid/not currently running. macOS `ps -o lstart=` prints an
# absolute calendar timestamp, so two independent queries for the same
# still-alive process agree to the second regardless of when each runs.
pid_start_epoch_bash() {
  local pid="$1" line
  [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 ]] || { printf '0\n'; return 0; }
  line=$(ps -p "$pid" -o lstart= 2>/dev/null)
  [[ -n "$line" ]] || { printf '0\n'; return 0; }
  date -j -f "%a %b %d %H:%M:%S %Y" "$line" +%s 2>/dev/null || printf '0\n'
}

# Locate the model-role-router state file for a claimed alias under a
# given tmux session's registry cache. Prints the file path on success.
find_registry_state_file() {
  local claimed_alias="$1" session="$2" cache_dir session_safe f
  local f_pid f_live f_mtime
  local best="" best_live=-1 best_mtime=-1
  cache_dir="${MODEL_ROLE_CACHE:-$HOME/.cache/tproj-model-role}"
  session_safe=$(printf '%s' "$session" | sed -E 's/[^A-Za-z0-9_.-]+/_/g')
  [[ -n "$session_safe" ]] || session_safe="unknown"
  [[ -d "$cache_dir/$session_safe" ]] || return 1
  # Deterministic candidate pick: the raw find(1) traversal order is
  # filesystem-dependent, so multiple same-alias windows (e.g. a live pane plus
  # a stale/dead-pid leftover) could bind non-deterministically. Prefer a
  # candidate whose reg_pid is still alive; among equal liveness prefer the
  # newest mtime. A single candidate is returned unchanged.
  while IFS= read -r -d '' f; do
    [[ "$(jq -r '.alias // empty' "$f" 2>/dev/null)" == "$claimed_alias" ]] || continue
    f_pid=$(jq -r '.pid // 0' "$f" 2>/dev/null)
    f_live=0
    if [[ "$f_pid" =~ ^[0-9]+$ && "$f_pid" -gt 0 ]] && kill -0 "$f_pid" 2>/dev/null; then
      f_live=1
    fi
    f_mtime=$(stat -f %m "$f" 2>/dev/null || printf '0')
    [[ "$f_mtime" =~ ^[0-9]+$ ]] || f_mtime=0
    if (( f_live > best_live )) || { (( f_live == best_live )) && (( f_mtime > best_mtime )); }; then
      best="$f"; best_live="$f_live"; best_mtime="$f_mtime"
    fi
  done < <(find "$cache_dir/$session_safe" -type f -name '*.json' -print0 2>/dev/null)
  [[ -n "$best" ]] || return 1
  printf '%s\n' "$best"
  return 0
}

# Verify a claimed alias.role for the --session external-caller path by
# binding it to the live model-role-router registry via process ancestry
# without relying on process-name matching.
# On success sets VERIFIED_REGISTRY_FILE / VERIFIED_ROLE_EPOCH /
# VERIFIED_PLATFORM_ROLE / VERIFIED_CALLER_PID / VERIFIED_CALLER_PPID /
# VERIFIED_CALLER_EXECUTABLE / VERIFIED_CALLER_UID / VERIFIED_PROCESS_START
# and returns 0. On any failure sets CALLER_VERIFY_REASON and returns 1.
# Fail-closed: any unexpected condition is treated as unverified, never
# as verified.
verify_as_caller_identity() {
  local claimed_alias="$1" session="$2"
  local ancestor_pair ancestor_pid ancestor_start
  local reg_file reg_pid reg_pid_start reg_observed_at reg_role_epoch reg_role reg_orchestrator_alias reg_project reg_session_id now
  CALLER_VERIFY_REASON=""
  VERIFIED_REGISTRY_FILE=""
  VERIFIED_ROLE_EPOCH=""
  VERIFIED_PLATFORM_ROLE=""
  VERIFIED_ORCHESTRATOR_ALIAS=""
  VERIFIED_REG_PROJECT=""
  VERIFIED_REG_SESSION_ID=""
  VERIFIED_CALLER_PID=0
  VERIFIED_CALLER_PPID=0
  VERIFIED_CALLER_EXECUTABLE=""
  VERIFIED_CALLER_UID=0
  VERIFIED_PROCESS_START=0
  VERIFIED_ANCHOR_PID=0

  if ! reg_file=$(find_registry_state_file "$claimed_alias" "$session"); then
    CALLER_VERIFY_REASON="registry_alias_not_found"
    return 1
  fi

  reg_pid=$(jq -r '.pid // 0' "$reg_file" 2>/dev/null)
  reg_pid_start=$(jq -r '.pid_start // 0' "$reg_file" 2>/dev/null)
  reg_observed_at=$(jq -r '.observed_at // 0' "$reg_file" 2>/dev/null)
  reg_role_epoch=$(jq -r '.role_epoch // 0' "$reg_file" 2>/dev/null)
  reg_role=$(jq -r '.role // empty' "$reg_file" 2>/dev/null)
  reg_orchestrator_alias=$(jq -r '.orchestrator_alias // empty' "$reg_file" 2>/dev/null)
  reg_project=$(jq -r '.project // empty' "$reg_file" 2>/dev/null)
  reg_session_id=$(jq -r '.session_id // empty' "$reg_file" 2>/dev/null)

  if ! [[ "$reg_pid" =~ ^[0-9]+$ && "$reg_pid" -gt 0 ]]; then
    CALLER_VERIFY_REASON="registry_malformed"
    return 1
  fi
  # The registry reg_pid is the verification anchor for the alias.role / cwd
  # paths; record it now so even a reject audit row carries the anchor it checked.
  VERIFIED_ANCHOR_PID="$reg_pid"
  # pid_start binding. A recorded, positive pid_start is REQUIRED: it is compared
  # verbatim against the live ancestor start below (the pid-reuse defence). When
  # the registry omits pid_start (jq // 0 == 0) the caller cannot be authenticated
  # and the send is fail-closed REJECTed with a distinct reason. Re-deriving
  # reg_pid's own live start here (the withdrawn 2814172 recompute) and comparing
  # it to the ancestor's pid_start_epoch_bash(reg_pid) is a tautology -- same
  # function, same pid, always equal -- so it provided ZERO pid-reuse defence. The
  # router now stamps pid_start on the peer path too (general 6a1e7e4), so an
  # unrecorded value is a transient startup race: retry once it is written. See
  # docs/reference/tproj-msg-sender-verification.md.
  if ! [[ "$reg_pid_start" =~ ^[0-9]+$ && "$reg_pid_start" -gt 0 ]]; then
    CALLER_VERIFY_REASON="pid_start_unrecorded"
    echo "Note: sender registry not yet established for '${claimed_alias}' (pid_start unrecorded); retry in a few seconds." >&2
    return 1
  fi

  if ! ancestor_pair=$(find_registry_ancestor_match "$reg_pid"); then
    CALLER_VERIFY_REASON="no_agent_ancestor"
    return 1
  fi

  ancestor_pid="${ancestor_pair%% *}"
  ancestor_start="${ancestor_pair##* }"

  if [[ "$ancestor_start" != "$reg_pid_start" ]]; then
    CALLER_VERIFY_REASON="pid_start_mismatch"
    return 1
  fi
  VERIFIED_CALLER_PID="$ancestor_pid"
  VERIFIED_CALLER_PPID=$(ps -p "$ancestor_pid" -o ppid= 2>/dev/null | tr -d ' ')
  [[ "$VERIFIED_CALLER_PPID" =~ ^[0-9]+$ ]] || VERIFIED_CALLER_PPID=0
  VERIFIED_CALLER_EXECUTABLE=$(ps -p "$ancestor_pid" -o comm= 2>/dev/null || true)
  VERIFIED_CALLER_UID=$(ps -p "$ancestor_pid" -o uid= 2>/dev/null | tr -d ' ')
  [[ "$VERIFIED_CALLER_UID" =~ ^[0-9]+$ ]] || VERIFIED_CALLER_UID=0
  VERIFIED_PROCESS_START="$ancestor_start"

  if [[ "$VERIFIED_PROCESS_START" == "0" ]]; then
    CALLER_VERIFY_REASON="ancestor_start_unavailable"
    return 1
  fi
  now=$(date +%s)
  # observed_at must be present, positive, and within the stale window on BOTH
  # sides. A value in the future (now - observed_at < 0: clock skew or a forged
  # timestamp) is as untrustworthy as a stale one and is REJECTed the same way.
  # Non-numeric values fail closed too (the numeric guard short-circuits before
  # the arithmetic clauses, so a bad observed_at never reaches (( ... ))).
  if ! [[ "$reg_observed_at" =~ ^[0-9]+$ ]] || [[ "$reg_observed_at" == "0" ]] \
     || (( now - reg_observed_at < 0 )) \
     || (( now - reg_observed_at > TPROJ_MSG_REGISTRY_STALE_SECONDS )); then
    CALLER_VERIFY_REASON="registry_stale"
    return 1
  fi

  VERIFIED_REGISTRY_FILE="$reg_file"
  VERIFIED_ROLE_EPOCH="$reg_role_epoch"
  VERIFIED_PLATFORM_ROLE="$reg_role"
  VERIFIED_ORCHESTRATOR_ALIAS="$reg_orchestrator_alias"
  VERIFIED_REG_PROJECT="$reg_project"
  VERIFIED_REG_SESSION_ID="$reg_session_id"
  return 0
}

# --- Bare-role service-bound verifier (distinct from the alias.role class
# above -- bare roles like "gate" have no model-role-router registry entry
# to bind against, since the caller is not a claude/codex agent process).
#
# The only bare-role identity with a confirmed legitimate production
# caller, found from primary sources (not guessed/hardcoded from a product
# name):
#   - extensions/openclaw-plugin/src/outbound.js `sendTprojReturnUrlRedirect()`
#     posts to `${origin.returnUrl}/v1/tproj-msg-deliver` with
#     senderAs = "OpenClaw Agent - Reply" for gate:direct Chi reply routing.
#   - tproj-msg's own gate_reply_callback_url() supplies that return_url
#     from `gui.bridge.reply_callback_url` in workspace.yaml.
#   - Empirically confirmed 2026-07-16: the process holding that callback
#     port (`gui.bridge.url`'s port, currently 8765) is a locally running
#     `ClawGate.app/Contents/MacOS/ClawGate` process (confirmed via `ps`
#     executable path + `lsof -i` showing a live Tailscale connection from
#     the macmini Gateway host to this port) -- not the unrelated `tproj`
#     GUI app. No launchd label could be confirmed for it in this sandbox
#     (`launchctl list` was unavailable here); ancestry+executable-path
#     binding is used instead of a launchd-print binding.
# Any other bare role is default-deny (no known legitimate caller).
BARE_ROLE_SERVICE_EXPECTED_EXEC_DEFAULT="$HOME/projects/ios/clawgate/ClawGate.app/Contents/MacOS/ClawGate"

find_bare_role_service_ancestor() {
  local expected_exec="$1"
  local walk_pid=$$ ancestor_exec _hops
  [[ -n "$expected_exec" ]] || return 1
  for _hops in 1 2 3 4 5 6; do
    walk_pid=$(ps -p "$walk_pid" -o ppid= 2>/dev/null | tr -d ' ')
    [[ -n "$walk_pid" && "$walk_pid" != "0" && "$walk_pid" != "1" ]] || return 1
    ancestor_exec=$(ps -p "$walk_pid" -o comm= 2>/dev/null || true)
    if [[ "$ancestor_exec" == "$expected_exec" ]]; then
      printf '%s\n' "$walk_pid"
      return 0
    fi
  done
  return 1
}

# Verify a bare-role claim (--as <role>, no dot -- e.g. --as "OpenClaw
# Agent - Reply") by binding it to a live, same-UID process in this
# process's own ancestry whose executable matches the configured/known
# service path. Sets the same VERIFIED_* globals as the alias.role
# verifier. Fail-closed: unknown roles and any unexpected condition are
# always unverified.
verify_bare_role_caller_identity() {
  local claimed_role="$1"
  CALLER_VERIFY_REASON=""
  VERIFIED_CALLER_PID=0
  VERIFIED_CALLER_PPID=0
  VERIFIED_CALLER_EXECUTABLE=""
  VERIFIED_CALLER_UID=0
  VERIFIED_PROCESS_START=0
  VERIFIED_ANCHOR_PID=0

  case "$claimed_role" in
    "OpenClaw Agent - Reply") : ;;
    *)
      CALLER_VERIFY_REASON="unknown_bare_role"
      return 1
      ;;
  esac

  local expected_exec="$BARE_ROLE_SERVICE_EXPECTED_EXEC_DEFAULT" ws_cfg="$HOME/.config/tproj/workspace.yaml"
  if command -v yq >/dev/null 2>&1 && [[ -f "$ws_cfg" ]]; then
    local cfg_exec
    cfg_exec=$(yq '.gui.bridge.trusted_caller_executable' "$ws_cfg" 2>/dev/null || true)
    [[ "$cfg_exec" == "null" ]] && cfg_exec=""
    [[ -n "$cfg_exec" ]] && expected_exec="$cfg_exec"
  fi
  if [[ -z "$expected_exec" ]]; then
    CALLER_VERIFY_REASON="service_executable_unconfigured"
    return 1
  fi

  local svc_pid
  if ! svc_pid=$(find_bare_role_service_ancestor "$expected_exec"); then
    CALLER_VERIFY_REASON="service_ancestor_not_found"
    return 1
  fi
  # The service process is the verification anchor for the bare-role path.
  VERIFIED_ANCHOR_PID="$svc_pid"
  local svc_uid my_uid
  svc_uid=$(ps -p "$svc_pid" -o uid= 2>/dev/null | tr -d ' ')
  my_uid=$(id -u)
  if [[ -z "$svc_uid" || "$svc_uid" != "$my_uid" ]]; then
    CALLER_VERIFY_REASON="service_uid_mismatch"
    return 1
  fi
  local svc_start
  svc_start=$(pid_start_epoch_bash "$svc_pid")
  if [[ "$svc_start" == "0" ]]; then
    CALLER_VERIFY_REASON="service_start_unavailable"
    return 1
  fi

  VERIFIED_CALLER_PID="$svc_pid"
  VERIFIED_CALLER_PPID=$(ps -p "$svc_pid" -o ppid= 2>/dev/null | tr -d ' ')
  [[ "$VERIFIED_CALLER_PPID" =~ ^[0-9]+$ ]] || VERIFIED_CALLER_PPID=0
  VERIFIED_CALLER_EXECUTABLE="$expected_exec"
  VERIFIED_CALLER_UID="$svc_uid"
  VERIFIED_PROCESS_START="$svc_start"
  return 0
}

# Best-effort caller-identity audit write. Fail-open (never blocks a send
# path on DB unavailability) but always attempted for both accept and
# reject decisions. No message body/title content is ever passed here.
audit_log_caller_decision() {
  local to_target="$1" claimed_alias="$2" verified="$3" reason="$4" payload_sha="$5" header="${6:-}" task_id="${7:-}"
  # auth_path enum: explicit-as-verified / explicit-as-rejected /
  # bare-role-service / bare-role-rejected / pane-derived / pane-derived-rejected
  # / cwd-ancestry / cwd-ancestry-rejected. caller_* record the REAL direct
  # invoker (DIRECT_CALLER_*); anchor_pid records the verification anchor
  # (ANCHOR_PID). They diverge on a spoof reject -- that divergence is the
  # attribution signal the audit trail is for.
  declare -F tt_db_log_caller_event >/dev/null 2>&1 || return 0
  tt_db_log_caller_event "${SESSION:-}" "$to_target" "$claimed_alias" "$verified" "$reason" \
    "$payload_sha" "${DIRECT_CALLER_PID:-0}" "${DIRECT_CALLER_PPID:-0}" \
    "${DIRECT_CALLER_EXE:-}" "${DIRECT_CALLER_UID:-0}" "${DIRECT_CALLER_START:-0}" \
    "$header" "$task_id" "${AUTH_PATH:-}" "${ANCHOR_PID:-0}" >/dev/null 2>&1 || true
}

# Caller-identity audit metadata. ANCHOR_PID is the verification anchor:
# pane_pid for the in-tmux pane-derived path, registry reg_pid for explicit --as
# and the CWD fallback, service pid for bare-role. AUTH_PATH names which path
# decided (see the enum in audit_log_caller_decision). DIRECT_CALLER_* capture
# the REAL direct invoker (this process's parent) unconditionally, so a reject
# row records who tried even when verification fails. Initialised for set -u
# safety; the identity branches below overwrite ANCHOR_PID / AUTH_PATH.
ANCHOR_PID=0
AUTH_PATH=""
DIRECT_CALLER_PID="$PPID"
DIRECT_CALLER_PPID=$(ps -p "$DIRECT_CALLER_PID" -o ppid= 2>/dev/null | tr -d ' ' || true)
[[ "$DIRECT_CALLER_PPID" =~ ^[0-9]+$ ]] || DIRECT_CALLER_PPID=0
DIRECT_CALLER_EXE=$(ps -p "$DIRECT_CALLER_PID" -o comm= 2>/dev/null || true)
DIRECT_CALLER_UID=$(ps -p "$DIRECT_CALLER_PID" -o uid= 2>/dev/null | tr -d ' ' || true)
[[ "$DIRECT_CALLER_UID" =~ ^[0-9]+$ ]] || DIRECT_CALLER_UID=0
DIRECT_CALLER_START=$(pid_start_epoch_bash "$DIRECT_CALLER_PID")

# === Codex Desktop data-plane mailbox (isolated; never touches panes) ===
# Desktop is identity_class=desktop: a per-project mailbox peer, not a pane and
# not an orchestrator/worker. This handler resolves the Desktop identity purely
# by PID ancestry (resolve_desktop_identity), rejects every control-plane use,
# and moves envelopes through the user-private mailbox. It ALWAYS exits — the
# tmux/--as preflight and pane send paths below never run for --desktop.

# rc 0 iff <target> resolves to EXACTLY ONE live canonical pane in the named
# session (same list-panes format + short_to_role_pattern that resolve_target
# uses). Strict single-match, fail-closed: zero matches reject as unresolved,
# and two-or-more matches reject as ambiguous rather than silently picking the
# first. The reject reason is published in DESKTOP_TARGET_REASON so the caller
# can split the audit trail (desktop_target_unresolved vs desktop_target_ambiguous).
# resolve_target itself is defined far below this early desktop call site, so its
# core matching logic is mirrored here with the shared short_to_role_pattern
# helper rather than reordering the whole script.
DESKTOP_TARGET_REASON=""
_desktop_target_resolves() {
  local session="$1" target="$2"
  local target_alias="" target_role="" pane_list role_pattern requested_role
  local pid prole palias pcol pdead match_count=0
  DESKTOP_TARGET_REASON="desktop_target_unresolved"
  case "$target" in
    *.*)    target_alias="${target%%.*}"; target_role="${target#*.}" ;;
    cc|cdx) target_role="$target" ;;
    *)      target_alias="$target"; target_role="cc" ;;
  esac
  # Bind the session to an EXACT name with tmux's '=' target syntax so a name
  # that is merely a prefix of a live session cannot list its panes. #{pane_dead}
  # is carried so dead panes are excluded from candidate resolution below.
  pane_list=$(tmux list-panes -t "=${session}:dev" -F '#{pane_id}:#{@role}:#{@alias}:#{@column}:#{pane_dead}' 2>/dev/null)
  [[ -n "$pane_list" ]] || return 1
  if [[ -n "$target_alias" ]]; then
    # Explicit alias.role targets bind alias and role on the SAME live pane.
    # Never derive a column from one pane and then search another alias globally.
    requested_role=$(role_to_short "$target_role")
    while IFS=: read -r pid prole palias pcol pdead; do
      [[ "$pdead" == "1" ]] && continue
      [[ "$palias" == "$target_alias" ]] || continue
      [[ "$(role_to_short "$prole")" == "$requested_role" ]] || continue
      match_count=$((match_count+1))
    done <<< "$pane_list"
    if [[ "$match_count" -eq 1 ]]; then
      return 0
    elif [[ "$match_count" -gt 1 ]]; then
      DESKTOP_TARGET_REASON="desktop_target_ambiguous"
    fi
    return 1
  else
    role_pattern=$(short_to_role_pattern "$target_role")
  fi
  # Count LIVE panes matching the resolved role pattern: exactly one -> resolve,
  # zero -> unresolved, two-or-more -> ambiguous (duplicate canonical pane).
  # Dead panes are excluded so a target resolving only to a dead pane rejects.
  while IFS=: read -r pid prole palias pcol pdead; do
    [[ "$pdead" == "1" ]] && continue
    if [[ "$prole" == "$role_pattern" ]]; then
      match_count=$((match_count+1))
    fi
  done <<< "$pane_list"
  if [[ "$match_count" -eq 1 ]]; then
    return 0
  elif [[ "$match_count" -gt 1 ]]; then
    DESKTOP_TARGET_REASON="desktop_target_ambiguous"
  fi
  return 1
}

handle_desktop_mode() {
  # Fail-closed if the helper is unavailable (e.g. stale ~/bin without it).
  if ! declare -F resolve_desktop_identity >/dev/null 2>&1; then
    echo "Error: Desktop mailbox helper (tproj-msg-desktop.sh) not available" >&2
    exit 1
  fi

  # Phase 5 — reject any control-plane use from the Desktop identity class.
  # Desktop is untrusted: it may never drive task tracking, role handoff, forced
  # pane delivery, relay/fanout override, or claim a bare/alias identity via --as.
  local _ctl=""
  [[ "$NEW_TASK_MODE" == "true" ]]     && _ctl="--new-task"
  [[ "$ROLE_HANDOFF_MODE" == "true" ]] && _ctl="--role-handoff"
  [[ "$FORCE_MODE" == "true" ]]        && _ctl="--force"
  [[ "$FIRE_MODE" == "true" ]]         && _ctl="--fire"
  [[ "$ALLOW_RELAY" == "true" ]]       && _ctl="--allow-relay"
  [[ "$ALLOW_FANOUT" == "true" ]]      && _ctl="--allow-fanout"
  [[ "$ALLOW_CHI_RETRY" == "true" ]]   && _ctl="--allow-chi-retry"
  [[ -n "$EXPLICIT_AS" ]]              && _ctl="--as"
  if [[ -n "$_ctl" ]]; then
    echo "Error: Desktop mailbox rejects control-plane use ($_ctl); Desktop is data-plane only" >&2
    AUTH_PATH="desktop-rejected"
    audit_log_caller_decision "${TARGET:-desktop}" "desktop" 0 "desktop_control_rejected" "" "" ""
    exit 1
  fi

  # Resolve the unique live Desktop identity from PID ancestry + recorded
  # pid_start. Body / role labels / --as are NOT consulted.
  if ! resolve_desktop_identity; then
    echo "Error: Desktop identity could not be resolved (reason: ${CALLER_VERIFY_REASON:-desktop_identity_unresolved})" >&2
    AUTH_PATH="desktop-rejected"
    audit_log_caller_decision "${TARGET:-desktop}" "desktop" 0 "${CALLER_VERIFY_REASON:-desktop_identity_unresolved}" "" "" ""
    exit 1
  fi
  ANCHOR_PID="${VERIFIED_ANCHOR_PID:-0}"

  # --- read own mailbox (messages sessions sent to this desktop) ---
  if [[ "$MAILBOX_MODE" == "true" ]]; then
    desktop_mailbox_read "$(desktop_mailbox_dir to-desktop "$DESKTOP_PROJECT")"
    exit 0
  fi

  # --- drain own mailbox (explicit ack-all; reclaims a full to-desktop box) ---
  if [[ "$DRAIN_MODE" == "true" ]]; then
    local _n _drc=0
    _n=$(desktop_mailbox_drain "$(desktop_mailbox_dir to-desktop "$DESKTOP_PROJECT")") || _drc=$?
    if [[ "$_drc" == "$TPROJ_DESKTOP_MAILBOX_BUSY_RC" ]]; then
      # Lock contended/stale: the drain never entered the critical section, so
      # NO envelope was removed. Fail closed rather than delete unserialized.
      echo "Error: Desktop mailbox is busy (reason: desktop_mailbox_busy); could not acquire mailbox lock to drain" >&2
      exit "$TPROJ_DESKTOP_MAILBOX_BUSY_RC"
    fi
    echo "Drained ${_n} message(s) from Desktop mailbox: $DESKTOP_IDENTITY" >&2
    exit 0
  fi

  # --- Desktop -> session send (writes mailbox + body-free arrival bell) ---
  if [[ -z "$EXPLICIT_SESSION" ]]; then
    echo "Error: --desktop send requires --session <name>" >&2
    exit 1
  fi
  # Fix 1 — bound the write to a real destination BEFORE any mailbox dir, DB bell
  # or file is created: the session must be live AND the target must resolve to a
  # single live canonical pane alias. Unresolvable session/target -> hard reject
  # (no mailbox, no DB row, no send-keys), so an unbounded set of bogus target
  # strings can neither spawn per-target mailboxes nor DB bell rows.
  # Exact session match ('=' target syntax): a name that is only a prefix of a
  # live session must NOT satisfy the liveness gate.
  if ! tmux has-session -t "=$EXPLICIT_SESSION" 2>/dev/null; then
    echo "Error: Desktop send rejected: session '$EXPLICIT_SESSION' is not live" >&2
    AUTH_PATH="desktop-rejected"
    audit_log_caller_decision "${TARGET:-desktop}" "$DESKTOP_IDENTITY" 0 "desktop_target_session_invalid" "" "" ""
    exit 1
  fi
  if ! _desktop_target_resolves "$EXPLICIT_SESSION" "$TARGET"; then
    local _dreason="${DESKTOP_TARGET_REASON:-desktop_target_unresolved}"
    if [[ "$_dreason" == "desktop_target_ambiguous" ]]; then
      echo "Error: Desktop send rejected: target '$TARGET' resolves to multiple live panes in session '$EXPLICIT_SESSION' (ambiguous)" >&2
    else
      echo "Error: Desktop send rejected: target '$TARGET' does not resolve to a live pane in session '$EXPLICIT_SESSION'" >&2
    fi
    AUTH_PATH="desktop-rejected"
    audit_log_caller_decision "$TARGET" "$DESKTOP_IDENTITY" 0 "$_dreason" "" "" ""
    exit 1
  fi
  if [[ -z "${MESSAGE//[[:space:]]/}" ]]; then
    echo "Error: refusing to send empty / whitespace-only message" >&2
    exit "$EMPTY_BODY_EXIT"
  fi
  local _mbdir _rc=0
  _mbdir=$(desktop_mailbox_dir to-session "$EXPLICIT_SESSION" "$TARGET")
  # Capture rc without tripping `set -e` when the write is rejected (bounds).
  desktop_mailbox_write "$_mbdir" "$DESKTOP_IDENTITY" "$TARGET" "$MESSAGE" || _rc=$?
  case "$_rc" in
    0) : ;;
    1) echo "Error: message exceeds mailbox size limit (${TPROJ_DESKTOP_MAILBOX_MAX_BYTES} bytes)" >&2; exit 1 ;;
    2) echo "Error: mailbox for $TARGET is full (${TPROJ_DESKTOP_MAILBOX_MAX_COUNT} messages); recipient must drain it (tproj-msg --drain desktop)" >&2; exit 1 ;;
    "$TPROJ_DESKTOP_MAILBOX_BUSY_RC")
      # Lock contended/stale: the write never entered the critical section, so
      # NO envelope was created. Fail closed rather than write unserialized.
      echo "Error: Desktop mailbox for $TARGET is busy (reason: desktop_mailbox_busy); could not acquire mailbox lock" >&2
      AUTH_PATH="desktop-rejected"
      audit_log_caller_decision "$TARGET" "$DESKTOP_IDENTITY" 0 "desktop_mailbox_busy" "" "" ""
      exit "$TPROJ_DESKTOP_MAILBOX_BUSY_RC" ;;
    *) echo "Error: failed to write Desktop mailbox for $TARGET" >&2; exit 1 ;;
  esac

  # Body-free arrival bell: record an inbound row keyed to the recipient so the
  # existing inbox-monitor rings a count-only notification. Body is deliberately
  # EMPTY in the shared DB — the envelope file is the only content store.
  if declare -F tt_db_log_message >/dev/null 2>&1; then
    local _sha
    _sha=$(printf '%s' "$MESSAGE" | shasum -a 256 2>/dev/null | awk '{print $1}')
    tt_db_log_message "$EXPLICIT_SESSION" "$DESKTOP_IDENTITY" "$TARGET" "" "$_sha" \
      "[desktop-mailbox]" "" "inbound" "desktop-mailbox" "desktop" "desktop" "" >/dev/null 2>&1 || true
  fi

  AUTH_PATH="desktop-mailbox"
  audit_log_caller_decision "$TARGET" "$DESKTOP_IDENTITY" 1 "" \
    "$(printf '%s' "$MESSAGE" | shasum -a 256 2>/dev/null | awk '{print $1}')" "[desktop-mailbox]" ""
  echo "Delivered to Desktop mailbox: $DESKTOP_IDENTITY -> $TARGET (session $EXPLICIT_SESSION)" >&2
  exit 0
}

if [[ "$DESKTOP_MODE" == "true" ]]; then
  handle_desktop_mode
fi

# === Validate --as usage ===
if [[ -n "$EXPLICIT_AS" && -z "$EXPLICIT_SESSION" ]]; then
  echo "Error: --as requires --session" >&2
  exit 1
fi

# === Pre-flight: tmux check ===
if [[ -n "$EXPLICIT_SESSION" ]]; then
  # External caller (e.g. ClawGate) specified session explicitly
  SESSION="$EXPLICIT_SESSION"
  IS_WORKSPACE=true
  MY_PANE=""
  AS_CALLER_VERIFIED=false
  AS_CLAIMED_IDENTITY=""
  if [[ -n "$EXPLICIT_AS" ]]; then
    # --as <alias.role>: parse claimed sender identity. This claim is NOT
    # trusted on its own -- verify_as_caller_identity below binds it to
    # the live model-role-router registry via process ancestry before any
    # role-handoff privilege is granted (see R2 Stage 1 block above).
    if [[ "$EXPLICIT_AS" == *.* ]]; then
      MY_ALIAS="${EXPLICIT_AS%.*}"
      MY_ROLE_RAW="${EXPLICIT_AS##*.}"
      MY_ROLE=$(role_to_short "$MY_ROLE_RAW")
    else
      # bare role (e.g. --as gate)
      MY_ALIAS=""
      MY_ROLE_RAW="$EXPLICIT_AS"
      MY_ROLE=$(role_to_short "$MY_ROLE_RAW")
    fi
    if [[ -n "$MY_ALIAS" ]]; then
      AS_CLAIMED_IDENTITY="${MY_ALIAS}.${MY_ROLE:-$MY_ROLE_RAW}"
      if verify_as_caller_identity "$AS_CLAIMED_IDENTITY" "$EXPLICIT_SESSION"; then
        AS_CALLER_VERIFIED=true
        AUTH_PATH="explicit-as-verified"
      else
        AUTH_PATH="explicit-as-rejected"
      fi
      ANCHOR_PID="${VERIFIED_ANCHOR_PID:-0}"
    else
      # Bare role: no alias.role registry entry is possible (not a
      # claude/codex agent). Bound to a known service-owner process
      # instead; any unrecognized bare role is default-deny.
      AS_CLAIMED_IDENTITY="$MY_ROLE_RAW"
      if verify_bare_role_caller_identity "$MY_ROLE_RAW"; then
        AS_CALLER_VERIFIED=true
        AUTH_PATH="bare-role-service"
      else
        AUTH_PATH="bare-role-rejected"
      fi
      ANCHOR_PID="${VERIFIED_ANCHOR_PID:-0}"
    fi
    dlog "verify --as: claimed=${AS_CLAIMED_IDENTITY} verified=${AS_CALLER_VERIFIED}"
  else
    if [[ "$SEND_MODE" != "true" ]]; then
      MY_ALIAS=""
      MY_ROLE=""
      MY_ROLE_RAW=""
      MY_COLUMN=""
      # Non-send modes do not need sender identity.
      :
    else
    # --as omitted: auto-detect the sender's ALIAS from CWD (workspace.yaml) and
    # the platform ROLE from the nearest claude/codex ancestor. Both are only
    # SELECTION inputs (which registry entry to look up) -- the identity itself is
    # then bound through the EXACT same registry verification as explicit --as
    # (recorded pid_start>0 + live-start match + observed_at both-bounded + pid
    # ancestry). The old comm-name-only trust gate is removed: a matching process
    # name no longer authenticates on its own. A failed bind sets
    # AS_CALLER_VERIFIED=false and is refused by the non---as send gate below.
    auto_alias=""
    auto_role=""
    # (a) CWD -> workspace.yaml alias lookup
    ws_cfg="$HOME/.config/tproj/workspace.yaml"
    if command -v yq >/dev/null 2>&1 && [[ -f "$ws_cfg" ]]; then
      auto_alias=$(yq -r ".projects[] | select(.path == \"$(pwd)\") | .alias" "$ws_cfg" 2>/dev/null || true)
      [[ "$auto_alias" == "null" ]] && auto_alias=""
    fi
    # (b) Walk process ancestry to find the platform role (selection hint only).
    if auto_ancestor=$(find_agent_ancestor_pid); then
      auto_role="${auto_ancestor##* }"
    fi
    if [[ -n "$auto_alias" && -n "$auto_role" ]]; then
      MY_ALIAS="$auto_alias"
      MY_ROLE="$auto_role"
      MY_ROLE_RAW="$auto_role"
      AS_CLAIMED_IDENTITY="${MY_ALIAS}.${MY_ROLE}"
      if verify_as_caller_identity "$AS_CLAIMED_IDENTITY" "$SESSION"; then
        AS_CALLER_VERIFIED=true
        AUTH_PATH="cwd-ancestry"
      else
        AS_CALLER_VERIFIED=false
        AUTH_PATH="cwd-ancestry-rejected"
        # CALLER_VERIFY_REASON is set by verify_as_caller_identity; the non---as
        # send gate refuses the send with that reason (fail-closed).
      fi
      ANCHOR_PID="${VERIFIED_ANCHOR_PID:-0}"
    else
      echo "Error: --session used without --as, and auto-detect failed." >&2
      echo "  CWD alias: ${auto_alias:-<not found>}, parent role: ${auto_role:-<not found>}" >&2
      echo "  Use --as <alias.role> to specify sender identity." >&2
      exit 1
    fi
    fi
  fi
  MY_COLUMN=""
elif [[ -z "${TMUX:-}" ]]; then
  echo "Error: must be run inside tmux (or use --session <name>)" >&2
  exit 1
else
  # === Sender info (for prefix) ===
  MY_PANE="${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}"

  # === Session detection ===
  # Resolve from MY_PANE (-t), not a bare display-message, so a hook-spawned
  # tproj-msg (e.g. inbox-check's --read) reads its own pane's session rather
  # than the client's focused pane. Falls back to the bare form if -t fails.
  SESSION=$(tmux display-message -t "$MY_PANE" -p '#S' 2>/dev/null || tmux display-message -p '#S')
  IS_WORKSPACE=false
  [[ "$SESSION" == "tproj-workspace" ]] && IS_WORKSPACE=true

  MY_ALIAS=$(tmux display-message -t "$MY_PANE" -p '#{@alias}' 2>/dev/null || true)
  MY_ROLE_RAW=$(tmux display-message -t "$MY_PANE" -p '#{@role}' 2>/dev/null || true)
  MY_COLUMN=$(tmux display-message -t "$MY_PANE" -p '#{@column}' 2>/dev/null || true)
  MY_ROLE=$(role_to_short "$MY_ROLE_RAW")
  # In-tmux sends resolve identity from this pane's own tmux user-options. The
  # pane id itself is caller-influenced (TMUX_PANE env), so for a real send we
  # additionally require the selected pane's pane_pid (its shell) to be a genuine
  # ancestor of this process -- proof the send actually originates from inside
  # that pane. A spoofed TMUX_PANE pointing at another pane whose pane_pid is not
  # in our ancestry is REJECTed before any send-keys (pane_ancestry_mismatch).
  AS_CALLER_VERIFIED=true
  AS_CLAIMED_IDENTITY="${MY_ALIAS:+${MY_ALIAS}.}${MY_ROLE}"
  if [[ "$SEND_MODE" == "true" ]]; then
    ANCHOR_PID=$(tmux display-message -t "$MY_PANE" -p '#{pane_pid}' 2>/dev/null | tr -d ' ' || true)
    [[ "$ANCHOR_PID" =~ ^[0-9]+$ ]] || ANCHOR_PID=0
    if [[ "$ANCHOR_PID" -gt 0 ]] && find_registry_ancestor_match "$ANCHOR_PID" >/dev/null 2>&1; then
      AUTH_PATH="pane-derived"
    else
      AS_CALLER_VERIFIED=false
      CALLER_VERIFY_REASON="pane_ancestry_mismatch"
      AUTH_PATH="pane-derived-rejected"
    fi
  fi
fi

# === Queue directory ===
QUEUE_DIR="${TPROJ_MSG_QUEUE_DIR:-/tmp/tproj-msg-queue}"
STALE_SECONDS=600  # 10 minutes
# resolve_target failure classification (M-D6): distinguish a permanently-gone
# target from a transient tmux hiccup so flush_all_queues can react differently.
RT_NOT_FOUND=3   # pane list obtained but target absent (likely gone)
RT_TRANSIENT=4   # tmux list-panes failed/empty (transient, retry next poll)
# M-D6c: opt-in early discard for permanently-gone targets. Default equals
# STALE_SECONDS so no deliverable message is lost vs the per-message stale drop
# (a queue is discarded only once even its newest entry is older than the grace).
# Shorten via TPROJ_MSG_TARGET_GONE_GRACE to reclaim gone-target queues sooner.
TARGET_GONE_GRACE="${TPROJ_MSG_TARGET_GONE_GRACE:-$STALE_SECONDS}"
AUTO_FLUSH_MAX=3   # Max messages to auto-flush per send
FLUSH_POLL_INTERVAL=3  # seconds between flush attempts
# M-D5: mutual exclusion between enqueue's append and flush's read->truncate.
# macOS ships no flock(1), so we use an mkdir atomic lock (same idiom as
# generate_task_id's seq_dir). Fail-open: if the lock can't be acquired within
# the wait budget (stale lock / long contention), the section runs unlocked
# rather than stalling delivery -- losing the race is strictly better than
# blocking a send.
QUEUE_LOCK_WAIT_MS="${TPROJ_MSG_QUEUE_LOCK_WAIT_MS:-2000}"
QUEUE_LOCK_POLL_MS=25  # poll interval while waiting for the lock
CONTROL_DEDUP_DIR="${TPROJ_MSG_CONTROL_DEDUP_DIR:-/tmp/tproj-msg-control-dedup}"
CONTROL_DEDUP_FILE="${CONTROL_DEDUP_DIR}/seen.tsv"
CONTROL_DEDUP_TTL="$STALE_SECONDS"
FANOUT_DEDUP_DIR="${TPROJ_MSG_FANOUT_DEDUP_DIR:-/tmp/tproj-msg-fanout-dedup}"
FANOUT_DEDUP_FILE="${FANOUT_DEDUP_DIR}/seen.tsv"
FANOUT_DEDUP_TTL="$STALE_SECONDS"
# E2 (msg-repair): task-id sequence bucket root + GC thresholds. generate_task_id
# allocates collision-free ids under <root>/<target>/<epoch_min>/<seq>; stale
# epoch_min buckets are pruned on the send path at a low frequency (once per
# GC_INTERVAL). Only buckets older than STALE_SEC (>> one allocation minute) are
# removed, so the current minute is never touched. All three are env-adjustable.
TASK_SEQ_ROOT="${TPROJ_MSG_TASK_SEQ_DIR:-/tmp/tproj-task-seq}"
TASK_SEQ_STALE_SEC="${TPROJ_MSG_TASK_SEQ_STALE_SEC:-3600}"
TASK_SEQ_GC_INTERVAL="${TPROJ_MSG_TASK_SEQ_GC_INTERVAL:-3600}"
CHI_DISPATCH_LEDGER="${TPROJ_MSG_CHI_DISPATCH_LEDGER:-$HOME/.cache/tproj-msg/chi-dispatch.tsv}"
CHI_DISPATCH_TTL_SEC="${TPROJ_MSG_CHI_DISPATCH_TTL_SEC:-86400}"
POLICY_DRY_RUN="${TPROJ_MSG_POLICY_DRY_RUN:-false}"
TMUX_TYPING_GUARD_READ_LINES=120
TMUX_TYPING_GUARD_SCAN_TAIL_LINES=48
TMUX_TYPING_GUARD_MAX_PROMPT_DISTANCE_LINES=8
TMUX_TYPING_GUARD_MAX_CONTINUATION_LINES=2
TMUX_TYPING_GUARD_RECHECK_DELAY_SEC=0.12
TMUX_TYPING_GUARD_STABLE_DRAFT_MIN_CHARS="${TPROJ_TYPING_GUARD_STABLE_DRAFT_MIN_CHARS:-4}"
PROMPT_SIGNAL_MAX_AGE_SEC=5
PROMPT_SIGNAL_FUTURE_TOLERANCE_SEC=2
RELAY_BLOCK_EXIT=13
BROADCAST_BLOCK_EXIT=14
FANOUT_BLOCK_EXIT=15
TYPING_BUSY_EXIT=16
CHI_RETRY_BLOCK_EXIT=17
SELECTION_BLOCK_EXIT=18
AMBIGUOUS_BARE_EXIT=19
EMPTY_BODY_EXIT=20
DUP_SEND_EXIT=21

# D2 (msg-repair): generic short-window resend dedup. A new send command whose
# (from|to|body) hash was already sent within TPROJ_MSG_SEND_DEDUP_SEC is
# rejected unless --force. Applied only at new-send-command time (dispatch_mode
# precheck), never inside flush_queue, so legitimate queue re-delivery is not
# swallowed. Modeled on gate_dedup's file+TTL store.
SEND_DEDUP_DIR="${TPROJ_MSG_SEND_DEDUP_DIR:-/tmp/tproj-msg-send-dedup}"
SEND_DEDUP_TTL="${TPROJ_MSG_SEND_DEDUP_SEC:-60}"

# Ensure queue dir exists
ensure_queue_dir() {
  [[ -d "$QUEUE_DIR" ]] || mkdir -p "$QUEUE_DIR"
}

# === Control message duplicate guard ===

ensure_control_dedup_store() {
  [[ -d "$CONTROL_DEDUP_DIR" ]] || mkdir -p "$CONTROL_DEDUP_DIR"
  [[ -f "$CONTROL_DEDUP_FILE" ]] || : > "$CONTROL_DEDUP_FILE"
}

normalize_message_for_hash() {
  local msg="$1"
  printf '%s' "$msg" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
}

sha1_hash() {
  local raw="$1"
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$raw" | shasum -a 1 | awk '{print $1}'
  else
    printf '%s' "$raw" | sha1sum | awk '{print $1}'
  fi
}

# R2 Stage 1 — content reference for the caller-identity audit trail
# (payload_sha256). Never used to persist the content itself.
sha256_hash() {
  local raw="$1"
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$raw" | shasum -a 256 | awk '{print $1}'
  else
    printf '%s' "$raw" | sha256sum | awk '{print $1}'
  fi
}

is_control_message() {
  local msg="$1"
  [[ "$msg" =~ \[(Control|ACK):[^\]]+\] ]]
}

extract_control_token() {
  local msg="$1"
  if [[ "$msg" =~ \[(Control|ACK):([^\]]+)\] ]]; then
    echo "${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
    return 0
  fi
  return 1
}

cleanup_control_dedup_store() {
  ensure_control_dedup_store
  local now tmp epoch key age
  now=$(date +%s)
  tmp=$(mktemp "${CONTROL_DEDUP_DIR}/seen.XXXXXX")

  while IFS=$'\t' read -r epoch key; do
    [[ -z "${epoch:-}" || -z "${key:-}" ]] && continue
    [[ "$epoch" =~ ^[0-9]+$ ]] || continue
    age=$(( now - epoch ))
    if [[ $age -le $CONTROL_DEDUP_TTL ]]; then
      printf '%s\t%s\n' "$epoch" "$key" >> "$tmp"
    fi
  done < "$CONTROL_DEDUP_FILE"

  mv "$tmp" "$CONTROL_DEDUP_FILE"
}

control_dedup_key() {
  local target_name="$1" token="$2" msg="$3" normalized hash
  normalized=$(normalize_message_for_hash "$msg")
  hash=$(sha1_hash "$normalized")
  printf '%s|%s|%s|%s' "$SESSION" "$target_name" "$token" "$hash"
}

control_dedup_check() {
  local target_name="$1" msg="$2"

  is_control_message "$msg" || return 0
  ensure_control_dedup_store
  cleanup_control_dedup_store

  local token key now
  token=$(extract_control_token "$msg") || return 0
  key=$(control_dedup_key "$target_name" "$token" "$msg")

  if awk -F '\t' -v key="$key" '$2 == key { found=1; exit } END { exit(found ? 0 : 1) }' "$CONTROL_DEDUP_FILE"; then
    echo "Blocked duplicate control message (token=${token}, target=${target_name})" >&2
    echo "If intentional, change token or wait ${CONTROL_DEDUP_TTL}s." >&2
    return 12
  fi

  return 0
}

control_dedup_mark() {
  local target_name="$1" msg="$2"

  is_control_message "$msg" || return 0
  ensure_control_dedup_store

  local token key now
  token=$(extract_control_token "$msg") || return 0
  key=$(control_dedup_key "$target_name" "$token" "$msg")
  now=$(date +%s)
  printf '%s\t%s\n' "$now" "$key" >> "$CONTROL_DEDUP_FILE"
  return 0
}

control_dedup_check_and_mark() {
  local target_name="$1" msg="$2"
  control_dedup_check "$target_name" "$msg" || return $?
  control_dedup_mark "$target_name" "$msg"
}

# === Send policy guard ===

is_broadcast_like_target() {
  local target="$1"
  local lower
  lower=$(printf '%s' "$target" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    all|'*'|broadcast|everyone)
      return 0
      ;;
  esac
  return 1
}

is_relay_like_message() {
  local msg="$1"

  [[ "$msg" =~ ^[[:space:]]*\[from:[^\]]+\] ]] && return 0
  [[ "$msg" =~ \[(Control|ACK):[^\]]+\] ]] && return 0
  printf '%s\n' "$msg" | grep -Eiq '\[Persona[[:space:]]+(Sync|Check)\]' && return 0

  return 1
}

is_chi_recovery_dispatch_message() {
  local msg="$1"

  printf '%s\n' "$msg" | grep -Eiq 'ご主人様からの作業依頼として|扱いにしてください|未達[[:space:]]*LINE|読み落とし扱い' && return 0

  local has_recovery=false
  local has_dispatch_context=false
  if printf '%s\n' "$msg" | grep -Eiq '未達|読み落とし|復元|再投入|過去の指示|過去依頼|skip|skipping'; then
    has_recovery=true
  fi
  if printf '%s\n' "$msg" | grep -Eiq 'ご主人様|ユーザー|LINE|id[[:space:]]+[0-9]+|作業依頼|指示|URLだして|日報'; then
    has_dispatch_context=true
  fi

  [[ "$has_recovery" == "true" && "$has_dispatch_context" == "true" ]]
}

ensure_chi_dispatch_ledger() {
  local dir
  dir=$(dirname "$CHI_DISPATCH_LEDGER")
  [[ -d "$dir" ]] || mkdir -p "$dir"
  [[ -f "$CHI_DISPATCH_LEDGER" ]] || : > "$CHI_DISPATCH_LEDGER"
}

cleanup_chi_dispatch_ledger() {
  ensure_chi_dispatch_ledger
  local now tmp epoch iso target_name fingerprint sender reason age
  now=$(date +%s)
  tmp=$(mktemp "$(dirname "$CHI_DISPATCH_LEDGER")/chi-dispatch.XXXXXX")

  while IFS=$'\t' read -r epoch iso target_name fingerprint sender reason; do
    [[ -z "${epoch:-}" || -z "${fingerprint:-}" ]] && continue
    [[ "$epoch" =~ ^[0-9]+$ ]] || continue
    age=$(( now - epoch ))
    if [[ $age -le $CHI_DISPATCH_TTL_SEC ]]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$epoch" "$iso" "$target_name" "$fingerprint" "$sender" "${reason:-}" >> "$tmp"
    fi
  done < "$CHI_DISPATCH_LEDGER"

  mv "$tmp" "$CHI_DISPATCH_LEDGER"
}

chi_dispatch_sender_label() {
  printf '%s.%s' "${MY_ALIAS:-unknown}" "${MY_ROLE:-unknown}"
}

chi_dispatch_fingerprint() {
  local target_name="$1" msg="$2"
  local ids quotes raw normalized

  ids=$(printf '%s\n' "$msg" | grep -Eo 'id[[:space:]]+[0-9]+' | tr '\n' ',' | sed 's/,$//' || true)
  quotes=$(printf '%s\n' "$msg" | grep -Eo '「[^」]{1,160}」' | tr '\n' '|' | sed 's/|$//' || true)

  if [[ -n "$ids" || -n "$quotes" ]]; then
    raw="$(chi_dispatch_sender_label)|${target_name}|ids=${ids}|quotes=${quotes}"
  else
    normalized=$(normalize_message_for_hash "$msg" | sed -E 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T[^ ]+/TIMESTAMP/g; s/[0-9]{4}-[0-9]{2}-[0-9]{2}/DATE/g; s/[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?/TIME/g; s/[Pp][Ii][Dd][=: ]+[0-9]+/pid=PID/g; s/[Cc][Oo][Mm][Mm][Ii][Tt][=: ]+[0-9a-f]{7,40}/commit=HASH/g; s#https?://[^ ]+#URL#g')
    raw="$(chi_dispatch_sender_label)|${target_name}|${normalized}"
  fi

  sha1_hash "$raw"
}

mark_chi_dispatch() {
  local target_name="$1" fingerprint="$2" reason="$3"
  local now iso
  ensure_chi_dispatch_ledger
  now=$(date +%s)
  iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$now" "$iso" "$target_name" "$fingerprint" "$(chi_dispatch_sender_label)" "$reason" >> "$CHI_DISPATCH_LEDGER"
}

enforce_chi_recovery_policy() {
  local target_name="$1" msg="$2"

  is_gate_target "$target_name" || return 0
  is_chi_recovery_dispatch_message "$msg" || return 0

  ensure_chi_dispatch_ledger
  cleanup_chi_dispatch_ledger

  local fingerprint previous prev_iso
  fingerprint=$(chi_dispatch_fingerprint "$target_name" "$msg")
  previous=$(awk -F '\t' -v fp="$fingerprint" '$4 == fp { print $2; exit }' "$CHI_DISPATCH_LEDGER" || true)

  if [[ -z "$previous" ]]; then
    mark_chi_dispatch "$target_name" "$fingerprint" "initial"
    return 0
  fi

  prev_iso="$previous"
  if [[ "$ALLOW_CHI_RETRY" == "true" ]]; then
    echo "Policy override: allow repeated Chi recovery dispatch to '$target_name' (previous: ${prev_iso}, reason: ${ALLOW_CHI_RETRY_REASON})" >&2
    mark_chi_dispatch "$target_name" "$fingerprint" "override:${ALLOW_CHI_RETRY_REASON}"
    return 0
  fi

  echo "Error: repeated Chi recovery dispatch blocked. Same recovery trigger was sent at ${prev_iso}. Use --allow-chi-retry <reason> only after explicit current user authorization." >&2
  return "$CHI_RETRY_BLOCK_EXIT"
}

enforce_send_policy() {
  local target_name="$1" msg="$2"

  if is_broadcast_like_target "$target_name"; then
    echo "Error: broadcast-like target '$target_name' is forbidden by policy" >&2
    return "$BROADCAST_BLOCK_EXIT"
  fi

  if is_relay_like_message "$msg"; then
    if [[ "$ALLOW_RELAY" == "true" ]]; then
      echo "Policy override: allow relay-like send to '$target_name' (reason: ${ALLOW_RELAY_REASON})" >&2
      return 0
    fi
    echo "Error: relay-like message is blocked by policy" >&2
    echo "Hint: add --allow-relay <reason> for one-time explicit override." >&2
    return "$RELAY_BLOCK_EXIT"
  fi

  if enforce_chi_recovery_policy "$target_name" "$msg"; then
    :
  else
    return "$?"
  fi

  return 0
}

ensure_fanout_dedup_store() {
  [[ -d "$FANOUT_DEDUP_DIR" ]] || mkdir -p "$FANOUT_DEDUP_DIR"
  [[ -f "$FANOUT_DEDUP_FILE" ]] || : > "$FANOUT_DEDUP_FILE"
}

cleanup_fanout_dedup_store() {
  ensure_fanout_dedup_store
  local now tmp epoch key target age
  now=$(date +%s)
  tmp=$(mktemp "${FANOUT_DEDUP_DIR}/seen.XXXXXX")

  while IFS=$'\t' read -r epoch key target; do
    [[ -z "${epoch:-}" || -z "${key:-}" || -z "${target:-}" ]] && continue
    [[ "$epoch" =~ ^[0-9]+$ ]] || continue
    age=$(( now - epoch ))
    if [[ $age -le $FANOUT_DEDUP_TTL ]]; then
      printf '%s\t%s\t%s\n' "$epoch" "$key" "$target" >> "$tmp"
    fi
  done < "$FANOUT_DEDUP_FILE"

  mv "$tmp" "$FANOUT_DEDUP_FILE"
}

target_family_from_target() {
  local target="$1"
  local target_role

  if is_gate_target "$target"; then
    echo "gate"
    return 0
  fi

  if [[ "$target" == agent-* ]]; then
    echo "agent"
    return 0
  fi

  if [[ "$target" == *.* ]]; then
    target_role="${target#*.}"
  elif [[ "$target" == "cc" || "$target" == "cdx" ]]; then
    target_role="$target"
  else
    # alias only -> defaults to cc
    target_role="cc"
  fi

  case "$target_role" in
    cc|claude|claude-p*) echo "cc" ;;
    cdx|codex|codex-p*)  echo "cdx" ;;
    agent-*)             echo "agent" ;;
    *)                   echo "$target_role" ;;
  esac
}

fanout_guard_key() {
  local target_name="$1" msg="$2"
  local family normalized hash sender_alias sender_role

  family=$(target_family_from_target "$target_name")
  normalized=$(normalize_message_for_hash "$msg")
  hash=$(sha1_hash "$normalized")
  sender_alias="${MY_ALIAS:-unknown}"
  sender_role="${MY_ROLE:-unknown}"
  printf '%s|%s|%s|%s|%s' "$SESSION" "$sender_alias" "$sender_role" "$family" "$hash"
}

fanout_guard_check() {
  local target_name="$1" msg="$2"
  local family key seen_target

  family=$(target_family_from_target "$target_name")
  case "$family" in
    cc|cdx)
      ;;
    *)
      return 0
      ;;
  esac

  ensure_fanout_dedup_store
  cleanup_fanout_dedup_store

  key=$(fanout_guard_key "$target_name" "$msg")

  seen_target=$(awk -F '\t' -v key="$key" -v target="$target_name" '$2 == key && $3 != target { print $3; exit }' "$FANOUT_DEDUP_FILE" || true)
  if [[ -n "$seen_target" && "$ALLOW_FANOUT" != "true" ]]; then
    echo "Error: potential fan-out blocked for '$family' (already sent same message to '$seen_target')" >&2
    echo "Hint: default is same-project counterpart. Use --allow-fanout <reason> only if intentional." >&2
    return "$FANOUT_BLOCK_EXIT"
  fi

  if [[ -n "$seen_target" && "$ALLOW_FANOUT" == "true" ]]; then
    echo "Policy override: allow fan-out send to '$target_name' (reason: ${ALLOW_FANOUT_REASON})" >&2
  fi

  return 0
}

fanout_guard_mark() {
  local target_name="$1" msg="$2"
  local family key now

  family=$(target_family_from_target "$target_name")
  case "$family" in
    cc|cdx)
      ;;
    *)
      return 0
      ;;
  esac

  ensure_fanout_dedup_store
  key=$(fanout_guard_key "$target_name" "$msg")
  now=$(date +%s)
  printf '%s\t%s\t%s\n' "$now" "$key" "$target_name" >> "$FANOUT_DEDUP_FILE"
  return 0
}

fanout_guard_check_and_mark() {
  local target_name="$1" msg="$2"
  fanout_guard_check "$target_name" "$msg" || return $?
  fanout_guard_mark "$target_name" "$msg"
}

# === Idle detection (rewritten) ===

# Strip ANSI escape sequences from input
strip_ansi() {
  sed 's/\x1b\[[0-9;]*[a-zA-Z]//g; s/\x1b\][^\x07]*\x07//g'
}

trim_spaces() {
  printf '%s' "$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
}

is_tmux_footer_line() {
  local line="$1"
  local s lower
  s=$(trim_spaces "$line")
  [[ -z "$s" ]] && return 1
  lower=$(printf '%s' "$s" | tr '[:upper:]' '[:lower:]')

  [[ "$lower" == "? for shortcuts" ]] && return 0
  [[ "$lower" =~ ^[0-9]+%[[:space:]]+context[[:space:]]+left$ ]] && return 0
  [[ "$lower" =~ ^[0-9]+%[[:space:]]+context[[:space:]]+window$ ]] && return 0
  [[ "$lower" =~ ^autonomous:[[:space:]]+ ]] && return 0
  return 1
}

is_tmux_divider_line() {
  local line="$1" s
  s=$(trim_spaces "$line")
  [[ -z "$s" ]] && return 1
  printf '%s\n' "$s" | grep -Eq '^[-─━]{3,}$'
}

is_prompt_line() {
  local line="$1"
  printf '%s\n' "$line" | grep -Eq '^[[:space:]]*[›❯>][[:space:]]*'
}

has_cursor_glyph() {
  local line="$1"
  printf '%s\n' "$line" | grep -Eq '[▌█▋▍▎▏]'
}

strip_prompt_ui_tail() {
  local text cleaned
  if [[ $# -gt 0 ]]; then
    text="$1"
  else
    text=$(cat)
  fi
  cleaned=$(printf '%s' "$text" \
    | sed -E 's/[[:space:]]+\?[[:space:]]*for[[:space:]]+shortcuts.*$//')
  cleaned=$(printf '%s' "$cleaned" \
    | sed -E 's/[[:space:]]+[0-9]+%[[:space:]]+context[[:space:]]+(left|window)$//')
  printf '%s' "$cleaned" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
}

is_prompt_placeholder_text() {
  local text="$1"
  local lower
  lower=$(printf '%s' "$text" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
  [[ -z "$lower" ]] && return 0
  [[ "$lower" == "? for shortcuts" ]] && return 0
  [[ "$lower" =~ ^(type|enter)[[:space:]]+(a[[:space:]]+)?(message|prompt) ]] && return 0
  [[ "$lower" =~ ^(esc|escape)[[:space:]]+to[[:space:]]+ ]] && return 0
  [[ "$lower" =~ ^(shift|ctrl|control|tab)[+[:space:]-] ]] && return 0
  return 1
}

# Check if raw (ANSI-containing) captured text has dim prompt-line text.
# Expects the full -e capture as $1. Returns 0 if suggestion (dim) detected.
# Verified: CC/Cdx render suggestion text with SGR dim (\e[2m), user input has none.
raw_prompt_has_dim() {
  local raw_captured="$1" line prompt_raw plain
  [[ -z "$raw_captured" ]] && return 1

  prompt_raw=""
  while IFS= read -r line; do
    plain=$(printf '%s' "$line" | strip_ansi)
    if is_prompt_line "$plain"; then
      prompt_raw="$line"
    fi
  done <<< "$raw_captured"
  [[ -z "$prompt_raw" ]] && return 1

  local after_prompt after_plain
  after_prompt=$(printf '%s' "$prompt_raw" | sed -E 's/^.*[›❯>][[:space:]]*//')
  after_plain=$(printf '%s' "$after_prompt" | strip_ansi | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
  [[ -z "$after_plain" ]] && return 1

  local esc=$'\x1b'
  # SGR dim: ESC[2m or ESC[0;2m (not ESC[12m, ESC[22m)
  printf '%s' "$after_prompt" | grep -qE "${esc}\[(0;)?2m|${esc}\[;2m" && return 0
  # Bright black (SGR 90)
  printf '%s' "$after_prompt" | grep -qE "${esc}\[90m" && return 0
  return 1
}

# Signal output slots populated by read_prompt_state_signal:
#   PROMPT_SIGNAL_STATE  -> idle | typing | suggestion | unknown
#   PROMPT_SIGNAL_REASON -> parser reason (missing | invalid | signal)
#   PROMPT_SIGNAL_SOURCE -> source tag (tmux option)
#   PROMPT_SIGNAL_TS     -> unix epoch (optional)
PROMPT_SIGNAL_STATE=""
PROMPT_SIGNAL_REASON="uninitialized"
PROMPT_SIGNAL_SOURCE=""
PROMPT_SIGNAL_TS=""

read_prompt_state_signal() {
  local pane="$1"
  local raw state now age

  PROMPT_SIGNAL_STATE=""
  PROMPT_SIGNAL_REASON="missing"
  PROMPT_SIGNAL_SOURCE=""
  PROMPT_SIGNAL_TS=""

  raw=$(tmux show-options -p -t "$pane" -v @prompt_state 2>/dev/null || true)
  state=$(trim_spaces "$raw" | tr '[:upper:]' '[:lower:]')
  if [[ -z "$state" ]]; then
    return 1
  fi

  case "$state" in
    idle|typing|suggestion|unknown)
      PROMPT_SIGNAL_STATE="$state"
      PROMPT_SIGNAL_SOURCE=$(tmux show-options -p -t "$pane" -v @prompt_state_src 2>/dev/null || true)
      PROMPT_SIGNAL_SOURCE=$(trim_spaces "${PROMPT_SIGNAL_SOURCE:-}")
      [[ -z "$PROMPT_SIGNAL_SOURCE" ]] && PROMPT_SIGNAL_SOURCE="tmux_option"
      PROMPT_SIGNAL_TS=$(tmux show-options -p -t "$pane" -v @prompt_state_ts 2>/dev/null || true)
      PROMPT_SIGNAL_TS=$(trim_spaces "${PROMPT_SIGNAL_TS:-}")
      if [[ -z "$PROMPT_SIGNAL_TS" ]]; then
        PROMPT_SIGNAL_REASON="missing_ts"
        return 1
      fi
      if ! [[ "$PROMPT_SIGNAL_TS" =~ ^[0-9]+$ ]]; then
        PROMPT_SIGNAL_REASON="invalid_ts"
        return 1
      fi
      now=$(date +%s)
      if (( PROMPT_SIGNAL_TS > now + PROMPT_SIGNAL_FUTURE_TOLERANCE_SEC )); then
        PROMPT_SIGNAL_REASON="future_ts(ts=${PROMPT_SIGNAL_TS},now=${now})"
        return 1
      fi
      age=$(( now - PROMPT_SIGNAL_TS ))
      if (( age > PROMPT_SIGNAL_MAX_AGE_SEC )); then
        PROMPT_SIGNAL_REASON="stale_age(${age}s>${PROMPT_SIGNAL_MAX_AGE_SEC}s)"
        return 1
      fi
      PROMPT_SIGNAL_REASON="signal"
      return 0
      ;;
    *)
      PROMPT_SIGNAL_REASON="invalid"
      return 1
      ;;
  esac
}

# Unified output slots set by resolve_prompt_state:
#   PROMPT_RESOLVED_STATE   -> idle | typing | suggestion | unknown
#   PROMPT_RESOLVED_REASON  -> detailed reason
#   PROMPT_RESOLVED_SOURCE  -> tmux option source | heuristic
#   PROMPT_RESOLVED_SNIPPET -> short draft snippet when typing
PROMPT_RESOLVED_STATE="unknown"
PROMPT_RESOLVED_REASON="uninitialized"
PROMPT_RESOLVED_SOURCE="unknown"
PROMPT_RESOLVED_SNIPPET=""

resolve_prompt_state() {
  local pane="$1"
  local signal_reason

  if read_prompt_state_signal "$pane"; then
    PROMPT_RESOLVED_STATE="$PROMPT_SIGNAL_STATE"
    PROMPT_RESOLVED_REASON="signal:${PROMPT_SIGNAL_STATE}"
    PROMPT_RESOLVED_SOURCE="$PROMPT_SIGNAL_SOURCE"
    PROMPT_RESOLVED_SNIPPET=""
    return 0
  fi

  signal_reason="$PROMPT_SIGNAL_REASON"
  detect_prompt_draft_state "$pane"
  PROMPT_RESOLVED_STATE="$PROMPT_DRAFT_STATE"
  PROMPT_RESOLVED_REASON="heuristic:${PROMPT_DRAFT_REASON},signal=${signal_reason}"
  PROMPT_RESOLVED_SOURCE="heuristic"
  PROMPT_RESOLVED_SNIPPET="$PROMPT_DRAFT_SNIPPET"
  return 0
}

# Parser output slots populated by parse_prompt_snapshot:
#   PROMPT_PARSE_OK            -> true | false
#   PROMPT_PARSE_REASON        -> parser reason
#   PROMPT_PARSE_TEXT          -> normalized prompt draft text
#   PROMPT_PARSE_HAS_CURSOR    -> true | false
#   PROMPT_PARSE_DISTANCE      -> prompt line distance from active bottom
#   PROMPT_PARSE_MARKER        -> native | ascii | none (prompt-line marker class)
PROMPT_PARSE_OK="false"
PROMPT_PARSE_REASON="uninitialized"
PROMPT_PARSE_TEXT=""
PROMPT_PARSE_HAS_CURSOR="false"
PROMPT_PARSE_DISTANCE=999
PROMPT_PARSE_MARKER="none"

parse_prompt_snapshot() {
  local captured="$1"
  local cleaned line

  PROMPT_PARSE_OK="false"
  PROMPT_PARSE_REASON="capture_failed"
  PROMPT_PARSE_TEXT=""
  PROMPT_PARSE_HAS_CURSOR="false"
  PROMPT_PARSE_DISTANCE=999
  PROMPT_PARSE_MARKER="none"

  if [[ -z "$captured" ]]; then
    PROMPT_PARSE_REASON="empty_capture"
    return 0
  fi

  cleaned=$(printf '%s\n' "$captured" | strip_ansi)
  local _draft_source=()
  while IFS= read -r line; do
    _draft_source+=("$line")
  done <<< "$cleaned"
  if [[ ${#_draft_source[@]} -eq 0 ]]; then
    PROMPT_PARSE_REASON="empty_capture"
    return 0
  fi

  local source_len start
  source_len=${#_draft_source[@]}
  if (( source_len > TMUX_TYPING_GUARD_SCAN_TAIL_LINES )); then
    start=$(( source_len - TMUX_TYPING_GUARD_SCAN_TAIL_LINES ))
  else
    start=0
  fi
  local _draft_tail=( "${_draft_source[@]:$start}" )
  local tail_len=${#_draft_tail[@]}
  if (( tail_len == 0 )); then
    PROMPT_PARSE_REASON="empty_capture"
    return 0
  fi

  local end=$(( tail_len - 1 ))
  local trimmed
  while (( end >= 0 )); do
    trimmed=$(trim_spaces "${_draft_tail[$end]}")
    [[ -n "$trimmed" ]] && break
    ((end--))
  done
  if (( end < 0 )); then
    PROMPT_PARSE_REASON="blank_capture"
    return 0
  fi

  while (( end >= 0 )); do
    if is_tmux_footer_line "${_draft_tail[$end]}" || is_tmux_divider_line "${_draft_tail[$end]}"; then
      ((end--))
      continue
    fi
    break
  done
  if (( end < 0 )); then
    PROMPT_PARSE_REASON="footer_only_capture"
    return 0
  fi

  local search_start=$(( end - 16 ))
  (( search_start < 0 )) && search_start=0
  local prompt_index=-1 i
  for (( i=end; i>=search_start; i-- )); do
    if is_prompt_line "${_draft_tail[$i]}"; then
      prompt_index=$i
      break
    fi
  done

  if (( prompt_index < 0 )); then
    PROMPT_PARSE_REASON="prompt_not_found"
    return 0
  fi

  if (( end - prompt_index > TMUX_TYPING_GUARD_MAX_PROMPT_DISTANCE_LINES )); then
    PROMPT_PARSE_REASON="prompt_too_far_from_bottom"
    return 0
  fi
  PROMPT_PARSE_DISTANCE=$(( end - prompt_index ))

  # Classify the prompt-line marker so callers can distinguish a native TUI
  # prompt (❯ U+276F / › U+203A) from a bare ASCII '>' -- the latter is also a
  # Markdown blockquote in generated output and must not be trusted as a live
  # input prompt by the signal-agnostic draft guard.
  local _prompt_lead
  _prompt_lead=$(printf '%s' "${_draft_tail[$prompt_index]}" | sed -E 's/^[[:space:]]*//')
  case "$_prompt_lead" in
    $'\xe2\x9d\xaf'*|$'\xe2\x80\xba'*) PROMPT_PARSE_MARKER="native" ;;
    '>'*)                             PROMPT_PARSE_MARKER="ascii" ;;
    *)                                PROMPT_PARSE_MARKER="none" ;;
  esac

  local draft_parts=()
  local prompt_body first_draft
  prompt_body=$(printf '%s' "${_draft_tail[$prompt_index]}" \
    | sed -E 's/^[[:space:]]*[›❯>][[:space:]]*//')
  if has_cursor_glyph "$prompt_body"; then
    PROMPT_PARSE_HAS_CURSOR="true"
  fi

  first_draft=$(printf '%s' "$prompt_body" \
    | sed -E 's/[▌█▋▍▎▏]+$//' \
    | strip_prompt_ui_tail)
  [[ -n "$first_draft" ]] && draft_parts+=("$first_draft")

  local continuation_end=$(( prompt_index + TMUX_TYPING_GUARD_MAX_CONTINUATION_LINES ))
  (( continuation_end > end )) && continuation_end=$end
  local raw normalized
  for (( i=prompt_index+1; i<=continuation_end; i++ )); do
    raw="${_draft_tail[$i]}"
    trimmed=$(trim_spaces "$raw")
    [[ -z "$trimmed" ]] && continue
    if is_tmux_footer_line "$raw" || is_tmux_divider_line "$raw" || is_prompt_line "$raw"; then
      break
    fi
    if has_cursor_glyph "$raw"; then
      PROMPT_PARSE_HAS_CURSOR="true"
    fi
    normalized=$(printf '%s' "$raw" \
      | sed -E 's/[▌█▋▍▎▏]+$//' \
      | strip_prompt_ui_tail)
    [[ -n "$normalized" ]] && draft_parts+=("$normalized")
  done

  local draft_text=""
  if (( ${#draft_parts[@]} > 0 )); then
    draft_text=$(printf '%s ' "${draft_parts[@]}" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')
  fi

  PROMPT_PARSE_OK="true"
  PROMPT_PARSE_REASON="ok"
  PROMPT_PARSE_TEXT="$draft_text"
  return 0
}

# Global output slots set by detect_prompt_draft_state:
#   PROMPT_DRAFT_STATE  -> idle | typing | suggestion | unknown
#   PROMPT_DRAFT_REASON -> parser reason
#   PROMPT_DRAFT_SNIPPET-> short draft snippet when typing
PROMPT_DRAFT_STATE="unknown"
PROMPT_DRAFT_REASON="uninitialized"
PROMPT_DRAFT_SNIPPET=""

detect_prompt_draft_state() {
  local pane="$1"
  local raw_captured captured first_text first_cursor
  local second_text second_cursor

  PROMPT_DRAFT_STATE="unknown"
  PROMPT_DRAFT_REASON="capture_failed"
  PROMPT_DRAFT_SNIPPET=""

  # Single capture with -e (ANSI codes preserved for dim detection).
  raw_captured=$(tmux capture-pane -t "$pane" -e -p -S "-${TMUX_TYPING_GUARD_READ_LINES}" 2>/dev/null || true)
  captured=$(printf '%s\n' "$raw_captured" | strip_ansi)
  parse_prompt_snapshot "$captured"
  if [[ "$PROMPT_PARSE_OK" != "true" ]]; then
    PROMPT_DRAFT_REASON="$PROMPT_PARSE_REASON"
    return 0
  fi

  first_text="$PROMPT_PARSE_TEXT"
  first_cursor="$PROMPT_PARSE_HAS_CURSOR"

  # Empty prompt -> idle
  if [[ -z "$first_text" ]]; then
    PROMPT_DRAFT_STATE="idle"
    PROMPT_DRAFT_REASON="prompt_idle"
    PROMPT_DRAFT_SNIPPET=""
    return 0
  fi

  # Cursor visible -> user is typing
  if [[ "$first_cursor" == "true" ]]; then
    PROMPT_DRAFT_STATE="typing"
    PROMPT_DRAFT_REASON="cursor_detected"
    PROMPT_DRAFT_SNIPPET=$(printf '%s' "$first_text" | cut -c1-120)
    return 0
  fi

  # Dim text on prompt line -> suggestion (primary detection)
  if raw_prompt_has_dim "$raw_captured"; then
    PROMPT_DRAFT_STATE="suggestion"
    PROMPT_DRAFT_REASON="dim_color_detected"
    PROMPT_DRAFT_SNIPPET=$(printf '%s' "$first_text" | cut -c1-120)
    return 0
  fi

  # Re-check after short delay to distinguish transient repaint from real input.
  sleep "$TMUX_TYPING_GUARD_RECHECK_DELAY_SEC"
  raw_captured=$(tmux capture-pane -t "$pane" -e -p -S "-${TMUX_TYPING_GUARD_READ_LINES}" 2>/dev/null || true)
  captured=$(printf '%s\n' "$raw_captured" | strip_ansi)
  parse_prompt_snapshot "$captured"
  if [[ "$PROMPT_PARSE_OK" != "true" ]]; then
    PROMPT_DRAFT_STATE="unknown"
    PROMPT_DRAFT_REASON="recheck_${PROMPT_PARSE_REASON}"
    PROMPT_DRAFT_SNIPPET=""
    return 0
  fi

  second_text="$PROMPT_PARSE_TEXT"
  second_cursor="$PROMPT_PARSE_HAS_CURSOR"

  if [[ -z "$second_text" ]]; then
    PROMPT_DRAFT_STATE="idle"
    PROMPT_DRAFT_REASON="prompt_idle_after_recheck"
    PROMPT_DRAFT_SNIPPET=""
    return 0
  fi

  if [[ "$second_cursor" == "true" ]]; then
    PROMPT_DRAFT_STATE="typing"
    PROMPT_DRAFT_REASON="cursor_detected_after_recheck"
    PROMPT_DRAFT_SNIPPET=$(printf '%s' "$second_text" | cut -c1-120)
    return 0
  fi

  if [[ "$second_text" != "$first_text" ]]; then
    PROMPT_DRAFT_STATE="typing"
    PROMPT_DRAFT_REASON="dynamic_prompt_input"
    PROMPT_DRAFT_SNIPPET=$(printf '%s' "$second_text" | cut -c1-120)
    return 0
  fi

  # Stable non-empty text can be a paused user draft, but only treat it as a
  # block when it is on the active bottom prompt and looks like real input.
  # This keeps the #9 false-busy fix: historical prompt text and placeholders
  # remain unknown instead of becoming a hard typing block.
  if (( PROMPT_PARSE_DISTANCE <= 1 )) \
    && (( ${#second_text} >= TMUX_TYPING_GUARD_STABLE_DRAFT_MIN_CHARS )) \
    && ! is_prompt_placeholder_text "$second_text"; then
    PROMPT_DRAFT_STATE="typing"
    PROMPT_DRAFT_REASON="draft_suspected"
    PROMPT_DRAFT_SNIPPET=$(printf '%s' "$second_text" | cut -c1-120)
    return 0
  fi

  PROMPT_DRAFT_STATE="unknown"
  PROMPT_DRAFT_REASON="stable_non_empty_prompt_unproven"
  PROMPT_DRAFT_SNIPPET=""
  return 0
}

# Signal-agnostic measurement of whether the target pane's INPUT line carries
# unsent draft text, done with its own capture-pane read. This is deliberately
# INDEPENDENT of resolve_prompt_state / @prompt_state: the 2026-07-19 incident
# delivered a notice on a fresh-looking idle signal while the user's half-typed
# draft still sat on the prompt line, so send-keys concatenated the two into a
# single submit (a mangled path fired as a Role-Handoff). resolve_prompt_state
# trusts a fresh signal and returns before the capture heuristic runs, so this
# re-checks the input line directly right before delivery.
#
# Output slots:
#   INPUT_DRAFT_RESULT  -> draft | clear | unknown
#   INPUT_DRAFT_SNIPPET -> short snippet when a draft is present
# Fail-open: a failed/unlocatable capture yields "unknown" so delivery falls
# back to the existing prompt-state resolution rather than blocking forever. A
# detected draft ("draft") must always queue on the non-force paths.
INPUT_DRAFT_RESULT="unknown"
INPUT_DRAFT_SNIPPET=""
measure_input_line_draft() {
  local pane="$1"
  local raw_captured captured
  INPUT_DRAFT_RESULT="unknown"
  INPUT_DRAFT_SNIPPET=""

  raw_captured=$(tmux capture-pane -t "$pane" -e -p -S "-${TMUX_TYPING_GUARD_READ_LINES}" 2>/dev/null || true)
  if [[ -z "$raw_captured" ]]; then
    return 0  # capture failed -> unknown (fail-open)
  fi
  captured=$(printf '%s\n' "$raw_captured" | strip_ansi)
  parse_prompt_snapshot "$captured"
  if [[ "$PROMPT_PARSE_OK" != "true" ]]; then
    return 0  # no locatable prompt line -> unknown (fail-open)
  fi

  # Empty or placeholder-only input line -> clean prompt.
  if [[ -z "$PROMPT_PARSE_TEXT" ]] || is_prompt_placeholder_text "$PROMPT_PARSE_TEXT"; then
    INPUT_DRAFT_RESULT="clear"
    return 0
  fi

  # A dim ghost-suggestion is not an unsent draft; existing behavior treats it
  # as sendable, so do not block on it (keeps the #9 false-busy contract).
  if raw_prompt_has_dim "$raw_captured"; then
    INPUT_DRAFT_RESULT="clear"
    return 0
  fi

  # Require native-marker evidence (❯/›). A bare ASCII '>' line is a Markdown
  # blockquote in generated output, not a live input prompt -- treating it as a
  # draft would queue notices behind ordinary output (2026-07-20 false positive).
  # Without a native marker the measurement is inconclusive -> unknown (fail-open).
  if [[ "$PROMPT_PARSE_MARKER" != "native" ]]; then
    INPUT_DRAFT_RESULT="unknown"
    return 0
  fi

  # Real text on the active bottom native prompt (cursor present, or the prompt
  # line is at/adjacent to the active bottom) is an unsent draft. Text on a
  # prompt line further up the scrollback is historical, not a live draft.
  if [[ "$PROMPT_PARSE_HAS_CURSOR" == "true" ]] || (( PROMPT_PARSE_DISTANCE <= 1 )); then
    INPUT_DRAFT_RESULT="draft"
    INPUT_DRAFT_SNIPPET=$(printf '%s' "$PROMPT_PARSE_TEXT" | cut -c1-120)
    return 0
  fi

  INPUT_DRAFT_RESULT="unknown"
  return 0
}

# Check if pane shows a CC prompt marker (U+276F)
# Simple: search last 15 lines for ❯ — no separator logic needed
has_cc_prompt() {
  local pane="$1"
  local captured
  captured=$(tmux capture-pane -t "$pane" -p -S -15 2>/dev/null || true)
  [[ -z "$captured" ]] && return 1

  local cleaned
  cleaned=$(echo "$captured" | strip_ansi)

  # CC prompt marker: ❯ (U+276F) anywhere in last 15 lines
  echo "$cleaned" | grep -q $'\xe2\x9d\xaf' && return 0

  return 1
}

# Check if pane shows a Codex prompt marker (U+203A)
has_codex_prompt() {
  local pane="$1"
  local captured
  captured=$(tmux capture-pane -t "$pane" -p -S -10 2>/dev/null || true)
  [[ -z "$captured" ]] && return 1

  local cleaned
  cleaned=$(echo "$captured" | strip_ansi)

  # Codex prompt: line starting with > (U+203A)
  echo "$cleaned" | grep -q $'^\xe2\x80\xba' && return 0

  return 1
}

# Determine target role type from pane
get_target_type() {
  local pane="$1"
  local role
  role=$(tmux display-message -t "$pane" -p '#{@role}' 2>/dev/null || true)
  case "$role" in
    claude|claude-p*) echo "cc" ;;
    codex|codex-p*)   echo "cdx" ;;
    agent-*)          echo "agent" ;;
    *)                echo "unknown" ;;
  esac
}

# Check if pane_current_command is a plain shell (agent likely not started)
is_shell_command() {
  local cmd="$1"
  case "$cmd" in
    zsh|bash|sh|fish)
      return 0
      ;;
  esac
  return 1
}

# Returns 0 if target pane has fresh, target-bound AI evidence, 1 otherwise.
# A non-shell pane_current_command is not evidence: stale processes and crashed
# agents can leave a non-shell command behind after the session disappears.
is_target_online() {
  local pane="$1"
  local target_type
  target_type=$(get_target_type "$pane")

  case "$target_type" in
    cc|agent)
      has_cc_prompt "$pane" && return 0
      ;;
    cdx)
      has_codex_prompt "$pane" && return 0
      ;;
    *)
      has_cc_prompt "$pane" && return 0
      has_codex_prompt "$pane" && return 0
      ;;
  esac

  # A fresh local prompt-state signal is bound to this pane and is sufficient
  # even when capture-pane is unavailable (for example a minimal Codex pane).
  if read_prompt_state_signal "$pane"; then
    case "$PROMPT_SIGNAL_STATE" in
      idle|typing|suggestion) return 0 ;;
    esac
  fi

  # WS state is valid only when it matched this pane's tty and its timestamp is
  # fresh. Stopped/unknown records do not authorize direct delivery.
  if get_ws_session_state_for_pane "$pane" \
      && [[ "$WS_SESSION_TTY_MATCH" == "true" ]] \
      && [[ "$WS_SESSION_FRESHNESS" == "fresh" ]]; then
    case "$WS_SESSION_STATUS" in
      running|waiting_input) return 0 ;;
    esac
  fi

  return 1
}

get_liveness_status() {
  local pane="$1"
  if is_target_online "$pane"; then
    echo "online"
  else
    echo "offline"
  fi
}

# WebSocket session state slots populated by get_ws_session_state_for_pane:
#   WS_SESSION_FOUND          -> true | false
#   WS_SESSION_STATUS         -> running | waiting_input | stopped | ...
#   WS_SESSION_WAITING_REASON -> permission_prompt | askUserQuestion | unknown | ...
#   WS_SESSION_TTY            -> matched tty
#   WS_SESSION_TTY_MATCH      -> true | false
#   WS_SESSION_FRESHNESS      -> fresh | stale | unknown_ts
#   WS_SESSION_REASON         -> diagnostic reason
WS_SESSION_FOUND="false"
WS_SESSION_STATUS=""
WS_SESSION_WAITING_REASON=""
WS_SESSION_TTY=""
WS_SESSION_TTY_MATCH="false"
WS_SESSION_FRESHNESS="unknown_ts"
WS_SESSION_REASON="uninitialized"

ws_timeout_cmd() {
  if command -v timeout >/dev/null 2>&1; then
    echo "timeout 1"
  elif command -v gtimeout >/dev/null 2>&1; then
    echo "gtimeout 1"
  else
    echo ""
  fi
}

get_ws_session_state_for_pane() {
  local pane="$1"
  local target_tty ws_to sessions_json record status reason tty ts now ts_sec age

  WS_SESSION_FOUND="false"
  WS_SESSION_STATUS=""
  WS_SESSION_WAITING_REASON=""
  WS_SESSION_TTY=""
  WS_SESSION_TTY_MATCH="false"
  WS_SESSION_FRESHNESS="unknown_ts"
  WS_SESSION_REASON="uninitialized"

  command -v websocat >/dev/null 2>&1 || { WS_SESSION_REASON="websocat_missing"; return 1; }
  command -v jq >/dev/null 2>&1 || { WS_SESSION_REASON="jq_missing"; return 1; }

  target_tty=$(tmux display-message -t "$pane" -p '#{pane_tty}' 2>/dev/null || true)
  if [[ -z "$target_tty" ]]; then
    WS_SESSION_REASON="pane_tty_missing"
    return 1
  fi

  ws_to=$(ws_timeout_cmd)
  if [[ -z "$ws_to" ]]; then
    WS_SESSION_REASON="timeout_missing"
    return 1
  fi

  sessions_json=$($ws_to websocat --no-async-stdio -n ws://localhost:8080/ws/sessions </dev/null 2>/dev/null \
    | head -5 \
    | jq -rc 'select(.type == "sessions.list")' 2>/dev/null \
    | head -1) || true
  if [[ -z "${sessions_json:-}" ]]; then
    WS_SESSION_REASON="sessions_list_missing"
    return 1
  fi

  record=$(printf '%s' "$sessions_json" | jq -r \
    --arg tty "$target_tty" \
    'def epoch:
        if type == "number" then .
        elif type == "string" then
          if test("^[0-9]+$") then tonumber
          else (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601? // empty)
          end
        else empty end;
      ([.sessions[]? | select(.tty == $tty)] | first) as $s
      | if $s == null then empty
        else [
          ($s.status // ""),
          ($s.waiting_reason // "unknown"),
          ($s.tty // ""),
          (($s.updated_at // $s.last_seen_at // $s.timestamp // $s.ts // $s.last_update // "") | epoch)
        ] | @tsv
        end' 2>/dev/null) || true
  if [[ -z "$record" ]]; then
    WS_SESSION_REASON="tty_not_found"
    return 1
  fi

  IFS=$'\t' read -r status reason tty ts <<< "$record"
  WS_SESSION_FOUND="true"
  WS_SESSION_STATUS="${status:-}"
  WS_SESSION_WAITING_REASON="${reason:-unknown}"
  WS_SESSION_TTY="${tty:-}"
  WS_SESSION_TTY_MATCH="true"
  WS_SESSION_FRESHNESS="unknown_ts"
  WS_SESSION_REASON="matched"

  if [[ -n "${ts:-}" && "$ts" =~ ^[0-9]+$ ]]; then
    ts_sec="$ts"
    if (( ts_sec > 1000000000000 )); then
      ts_sec=$(( ts_sec / 1000 ))
    fi
    now=$(date +%s)
    if (( ts_sec > now + PROMPT_SIGNAL_FUTURE_TOLERANCE_SEC )); then
      WS_SESSION_FRESHNESS="stale"
      WS_SESSION_REASON="future_ts(ts=${ts_sec},now=${now})"
    else
      age=$(( now - ts_sec ))
      if (( age > PROMPT_SIGNAL_MAX_AGE_SEC )); then
        WS_SESSION_FRESHNESS="stale"
        WS_SESSION_REASON="stale_age(${age}s>${PROMPT_SIGNAL_MAX_AGE_SEC}s)"
      else
        WS_SESSION_FRESHNESS="fresh"
        WS_SESSION_REASON="fresh_age(${age}s)"
      fi
    fi
  fi

  return 0
}

waiting_reason_is_selection() {
  local reason="$1"
  local normalized
  normalized=$(printf '%s' "$reason" | tr '[:upper:]' '[:lower:]' | sed -E 's/[-[:space:]]+/_/g')
  case "$normalized" in
    permission_prompt|askuserquestion|ask_user_question|choice|choice_prompt|approval|approval_prompt|confirmation|confirmation_prompt|tool_approval|tool_permission|permission)
      return 0
      ;;
  esac
  printf '%s\n' "$normalized" | grep -Eq '(permission|ask.*question|approval|confirmation|choice)' && return 0
  return 1
}

# Selection screen slots populated by detect_selection_screen:
#   SELECTION_SCREEN_DETECTED -> true | false
#   SELECTION_SCREEN_SOURCE   -> ws_waiting_reason | capture | none
#   SELECTION_SCREEN_REASON   -> diagnostic reason
SELECTION_SCREEN_DETECTED="false"
SELECTION_SCREEN_SOURCE="none"
SELECTION_SCREEN_REASON="uninitialized"

detect_selection_screen_capture() {
  local pane="$1"
  local captured cleaned bottom selector_hits context_hits

  captured=$(tmux capture-pane -t "$pane" -p -S -30 2>/dev/null || true)
  [[ -z "$captured" ]] && return 1

  cleaned=$(printf '%s\n' "$captured" | strip_ansi)
  bottom=$(printf '%s\n' "$cleaned" | tail -30 | tr '[:upper:]' '[:lower:]')

  selector_hits=$(printf '%s\n' "$bottom" | grep -Eic '^[[:space:]]*([>›❯▶▷▸▹●○◉◯◆◇*+-]|[0-9]+[.)])[[:space:]]*(allow|deny|yes|no|approve|reject|continue|cancel|run|always allow|continue anyway|許可|拒否|承認|続行|キャンセル)' || true)
  context_hits=$(printf '%s\n' "$bottom" | grep -Eic '(permission|approval|approve|allow[[:space:]]+.*command|do you want|continue[?？]|choose|select|askuserquestion|ask user question|proceed[?？]|許可|承認|選択)' || true)

  if (( selector_hits > 0 && context_hits > 0 )); then
    SELECTION_SCREEN_DETECTED="true"
    SELECTION_SCREEN_SOURCE="capture"
    SELECTION_SCREEN_REASON="selector=${selector_hits},context=${context_hits}"
    return 0
  fi

  return 1
}

detect_selection_screen() {
  local pane="$1"
  local needs_capture="true"

  SELECTION_SCREEN_DETECTED="false"
  SELECTION_SCREEN_SOURCE="none"
  SELECTION_SCREEN_REASON="none"

  if get_ws_session_state_for_pane "$pane"; then
    if [[ "${WS_SESSION_STATUS:-}" == "running" ]]; then
      needs_capture="false"
    fi
    if waiting_reason_is_selection "$WS_SESSION_WAITING_REASON"; then
      if [[ "$WS_SESSION_FRESHNESS" != "stale" ]]; then
        SELECTION_SCREEN_DETECTED="true"
        SELECTION_SCREEN_SOURCE="ws_waiting_reason"
        SELECTION_SCREEN_REASON="status=${WS_SESSION_STATUS:-unknown},waiting_reason=${WS_SESSION_WAITING_REASON},freshness=${WS_SESSION_FRESHNESS}"
        return 0
      fi
      needs_capture="true"
    elif [[ -n "$WS_SESSION_WAITING_REASON" && "$WS_SESSION_WAITING_REASON" != "unknown" && "$WS_SESSION_WAITING_REASON" != "nil" && "$WS_SESSION_WAITING_REASON" != "null" ]]; then
      needs_capture="false"
    fi
  fi

  if [[ "$needs_capture" == "true" ]] && detect_selection_screen_capture "$pane"; then
    return 0
  fi

  SELECTION_SCREEN_DETECTED="false"
  SELECTION_SCREEN_SOURCE="none"
  SELECTION_SCREEN_REASON="${WS_SESSION_REASON:-capture_no_selection}"
  return 1
}

# Send block slots populated by send_block_reason:
#   SEND_BLOCK_REASON -> none | typing_draft | selection_screen
#   SEND_BLOCK_SOURCE -> prompt_state | ws_waiting_reason | capture | none
#   SEND_BLOCK_DETAIL -> diagnostic detail
SEND_BLOCK_REASON="none"
SEND_BLOCK_SOURCE="none"
SEND_BLOCK_DETAIL="none"

send_block_reason() {
  local pane="$1"

  SEND_BLOCK_REASON="none"
  SEND_BLOCK_SOURCE="none"
  SEND_BLOCK_DETAIL="none"

  if detect_selection_screen "$pane"; then
    SEND_BLOCK_REASON="selection_screen"
    SEND_BLOCK_SOURCE="$SELECTION_SCREEN_SOURCE"
    SEND_BLOCK_DETAIL="$SELECTION_SCREEN_REASON"
    return 0
  fi

  resolve_prompt_state "$pane"
  case "$PROMPT_RESOLVED_STATE" in
    typing)
      SEND_BLOCK_REASON="typing_draft"
      SEND_BLOCK_SOURCE="$PROMPT_RESOLVED_SOURCE"
      SEND_BLOCK_DETAIL="$PROMPT_RESOLVED_REASON"
      [[ -n "$PROMPT_RESOLVED_SNIPPET" ]] && SEND_BLOCK_DETAIL+=",draft=${PROMPT_RESOLVED_SNIPPET}"
      return 0
      ;;
  esac

  # Independent draft measurement (signal-agnostic). resolve_prompt_state above
  # may have trusted a fresh @prompt_state=idle that is actually stale, so
  # re-check the input line directly: a paused user draft must still queue rather
  # than be submitted together with our text (2026-07-19 incident). This only
  # runs when the resolution above did not already block, and only ADDS a block
  # on a positively-detected draft -- an "unknown"/"clear" measurement leaves the
  # existing verdict untouched (fail-open).
  measure_input_line_draft "$pane"
  if [[ "$INPUT_DRAFT_RESULT" == "draft" ]]; then
    SEND_BLOCK_REASON="typing_draft"
    SEND_BLOCK_SOURCE="input_line_capture"
    SEND_BLOCK_DETAIL="draft_detected"
    [[ -n "$INPUT_DRAFT_SNIPPET" ]] && SEND_BLOCK_DETAIL+=",draft=${INPUT_DRAFT_SNIPPET}"
    return 0
  fi

  return 0
}

send_block_detail_for_status() {
  local pane="$1"

  if ! is_target_online "$pane"; then
    echo "offline:stale_or_missing_evidence"
    return 0
  fi

  send_block_reason "$pane"
  case "$SEND_BLOCK_REASON" in
    typing_draft)
      echo "blocked_typing:${SEND_BLOCK_SOURCE}:${SEND_BLOCK_DETAIL}"
      return 0
      ;;
    selection_screen)
      echo "blocked_selection:${SEND_BLOCK_SOURCE}:${SEND_BLOCK_DETAIL}"
      return 0
      ;;
  esac

  if [[ "${PROMPT_RESOLVED_STATE:-}" == "suggestion" ]]; then
    echo "sendable_suggestion:${PROMPT_RESOLVED_SOURCE}:${PROMPT_RESOLVED_REASON}"
    return 0
  fi

  if get_ws_session_state_for_pane "$pane" \
      && [[ "${WS_SESSION_STATUS:-}" == "running" ]] \
      && [[ "${WS_SESSION_FRESHNESS:-}" == "fresh" ]]; then
    echo "sendable_running:ws_status:status=running,waiting_reason=${WS_SESSION_WAITING_REASON:-unknown},freshness=${WS_SESSION_FRESHNESS}"
    return 0
  fi

  echo "sendable_prompt:${PROMPT_RESOLVED_SOURCE}:${PROMPT_RESOLVED_REASON}"
  return 0
}

# Returns 0 if target pane is idle (safe to send text), 1 if busy
# Flow:
#   1. WebSocket (1s timeout): running -> BUSY, waiting_input -> IDLE, unreachable -> Step 2
#   2. tmux prompt marker: CC ❯ or Codex › -> IDLE, otherwise -> BUSY
is_target_idle() {
  local pane="$1"
  local target_type
  target_type=$(get_target_type "$pane")

  # Step 1: WebSocket check (fast, 1s timeout).
  # Codex (cdx) panes are EXCLUDED: the CCStatusBar :8080 server misreports
  # Codex panes as "running" even when idle, so trusting it would queue
  # cdx-bound messages indefinitely. Codex idle is read reliably from the
  # prompt marker (Step 2), matching pre-websocat-fix behavior.
  if [[ "$target_type" != "cdx" ]] && get_ws_session_state_for_pane "$pane"; then
    case "${WS_SESSION_STATUS:-}" in
      running)
        # The :8080 status server can lag, reporting 'running' for a beat
        # after the pane has already returned to its prompt. Cross-check the
        # pane's own @prompt_state signal: read_prompt_state_signal succeeds
        # only when the signal is present AND fresh (<= PROMPT_SIGNAL_MAX_AGE_SEC),
        # so a fresh 'idle' there means the pane really is at rest and the WS
        # status is stale -> trust idle. Absent/stale/non-idle signal leaves
        # the WS 'running' authoritative.
        if read_prompt_state_signal "$pane" && [[ "$PROMPT_SIGNAL_STATE" == "idle" ]]; then
          return 0  # Fresh local idle overrides a lagging WS 'running'
        fi
        return 1  # Definitely BUSY
        ;;
      waiting_input)
        return 0  # Definitely IDLE (legacy behavior; send gate handles selections)
        ;;
      # stopped/other -> fall through to tmux marker check
    esac
  fi

  # Step 2: tmux prompt marker check (instant, no sleep)
  case "$target_type" in
    cc|agent)
      has_cc_prompt "$pane" && return 0
      ;;
    cdx)
      has_codex_prompt "$pane" && return 0
      ;;
    *)
      # Unknown type: try both
      has_cc_prompt "$pane" && return 0
      has_codex_prompt "$pane" && return 0
      ;;
  esac

  return 1  # BUSY (no prompt marker found)
}

# Get idle status as string for display
get_idle_status() {
  local pane="$1"
  send_block_reason "$pane"
  case "$SEND_BLOCK_REASON" in
    typing_draft)
      echo "typing"
      return 0
      ;;
    selection_screen)
      echo "busy"
      return 0
      ;;
  esac

  case "$PROMPT_RESOLVED_STATE" in
    suggestion)
      echo "suggestion"
      return 0
      ;;
    # unknown: prompt state could not be resolved. Defer to is_target_idle
    # (WS + prompt marker) instead of hard-reporting busy, so an idle pane with
    # leftover/unparseable prompt text surfaces as idle. This matches the send
    # path, which also falls through to is_target_idle on unknown.
  esac

  echo "idle"
}

# === Queue functions ===

# M-D5: run a queue-mutating section under a per-target mkdir lock so enqueue's
# append and flush's read->truncate cannot interleave (silent message loss).
# Usage: with_queue_lock <target_name> <cmd> [args...]. Fail-open on timeout:
# never block delivery on an unavailable lock.
with_queue_lock() {
  local target_name="$1"; shift
  local lockdir="${QUEUE_DIR}/${target_name}.queue.lock"
  local waited=0
  while (( waited < QUEUE_LOCK_WAIT_MS )); do
    if mkdir "$lockdir" 2>/dev/null; then
      "$@"
      local rc=$?
      rmdir "$lockdir" 2>/dev/null || true
      return $rc
    fi
    sleep 0.025
    waited=$(( waited + QUEUE_LOCK_POLL_MS ))
  done
  # fail-open: proceed unlocked (former behaviour) rather than stall the send.
  "$@"
}

# M-D5c: locked append target for with_queue_lock. Args: <target> <epoch>
# <header> <msg>. Kept as a named helper because with_queue_lock runs a command,
# and the append needs a redirection that can't be passed as an argument.
# M-D5c args: <target> <epoch> <header> <msg> [dbid]. D3 adds an optional 4th
# TSV column carrying the DB row id so flush can advance that row's delivery in
# place. Legacy 3-column rows parse with an empty dbid (backward compatible).
_queue_append() {
  local encoded
  encoded=$(printf '%s' "$4" | base64 | tr -d '\n')
  printf '%s\t%s\tTPROJ-B64:%s\t%s\n' "$2" "$3" "$encoded" "${5:-}" >> "${QUEUE_DIR}/$1.queue"
}

queue_decode_message() {
  local encoded="$1"
  if printf '%s' "$encoded" | base64 --decode 2>/dev/null; then
    return 0
  fi
  printf '%s' "$encoded" | base64 -D 2>/dev/null
}

# Enqueue a message for later delivery
enqueue() {
  local target_name="$1" header="$2" msg="$3"
  ensure_queue_dir
  local epoch _dbid="" _hash _from
  epoch=$(date +%s)
  # R1' Stage 3 shadow write — record queued state (no delivered_at yet) FIRST so
  # the row id can be threaded into the queue TSV (D3). Fail-open: on any DB
  # error _dbid stays empty and the queue entry degrades to the legacy 3-column
  # form, which flush still handles.
  if declare -F tt_db_log_message >/dev/null 2>&1; then
    _hash=$(sha1_hash "$msg" 2>/dev/null)
    _from="${MY_ALIAS:-unknown}.${MY_ROLE:-unknown}"
    _dbid=$(tt_db_log_message "$SESSION" "$_from" "$target_name" "$msg" "$_hash" "$header" "${TASK_ID:-}" "outbound" "queued" "${MY_ROLE:-cc}" "tmux" "" "${MSG_KIND:-}" "$(consult_task_run "$_from")" 2>/dev/null) || _dbid=""
    [[ "$_dbid" =~ ^[0-9]+$ ]] || _dbid=""
  fi
  # M-D5c: append under the per-target queue lock so a concurrent flush's
  # read->truncate cannot swallow this line.
  with_queue_lock "$target_name" _queue_append "$target_name" "$epoch" "$header" "$msg" "$_dbid"
  dlog "queue: enqueued to=${target_name} epoch=${epoch} dbid=${_dbid:-none}"
  # D2 (msg-repair): mark the short-window dedup store on successful enqueue too,
  # so a duplicate resend while the first is still queued is rejected.
  [[ -n "${DEDUP_BODY:-}" ]] && send_dedup_mark "$target_name" "$DEDUP_BODY" || true
  start_flush_worker
  emit_task_tracking_metadata
}

# Start background flush worker (idempotent, one per queue dir)
start_flush_worker() {
  local pidfile="$QUEUE_DIR/.flush-worker.pid"

  # Already running?
  if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then
    return 0
  fi

  local script_path
  script_path=$(command -v tproj-msg)

  # D4 (msg-repair): capture the worker's stderr (flush delivery/drop diagnostics)
  # instead of discarding it via &>/dev/null. Rotate at 1MB (respawn-guard style)
  # so it can't grow unbounded.
  local logf="${TPROJ_MSG_FLUSH_WORKER_LOG:-$HOME/.cache/tproj-msg/flush-worker.log}"
  mkdir -p "$(dirname "$logf")" 2>/dev/null || true
  if [[ -f "$logf" ]] && [[ $(stat -f%z "$logf" 2>/dev/null || echo 0) -gt 1048576 ]]; then
    mv -f "$logf" "${logf}.1" 2>/dev/null || true
  fi

  bash -c '
    pidfile="$1"; poll="$2"; stale="$3"; script="$4"; qdir="$5"
    echo $$ > "$pidfile"
    trap "rm -f \"$pidfile\"" EXIT INT TERM
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] flush-worker started (pid $$, qdir=$qdir)" >&2
    deadline=$(( $(date +%s) + stale ))
    while [[ $(date +%s) -lt $deadline ]]; do
      sleep "$poll"
      has_q=false
      for qf in "$qdir"/*.queue; do
        [[ -f "$qf" ]] && { has_q=true; break; }
      done
      $has_q || break
      "$script" --flush || true
    done
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] flush-worker exiting (pid $$)" >&2
  ' _ "$pidfile" "$FLUSH_POLL_INTERVAL" "$STALE_SECONDS" "$script_path" "$QUEUE_DIR" >>"$logf" 2>&1 &
  disown 2>/dev/null || true
}

# Count queued messages for a target
queue_count() {
  local target_name="$1"
  local qfile="${QUEUE_DIR}/${target_name}.queue"
  if [[ -f "$qfile" ]]; then
    wc -l < "$qfile" | tr -d ' '
  else
    echo "0"
  fi
}

# Age (seconds) of a queue's NEWEST valid message, or empty if none/no file.
# Used by flush_all_queues (M-D6c) to decide gone-target early discard: taking
# the newest entry keeps the whole-queue drop conservative (no message younger
# than the grace is ever lost).
queue_newest_age() {
  local target_name="$1"
  local qfile="${QUEUE_DIR}/${target_name}.queue"
  [[ -f "$qfile" ]] || return 0
  local now newest="" epoch _rest
  now=$(date +%s)
  while IFS=$'\t' read -r epoch _rest; do
    [[ "$epoch" =~ ^[0-9]+$ ]] || continue
    if [[ -z "$newest" || $epoch -gt $newest ]]; then
      newest=$epoch
    fi
  done < "$qfile"
  [[ -n "$newest" ]] && echo $(( now - newest ))
}

# D3 (msg-repair): mark a queued DB row as dropped, in place. No-op for legacy
# entries with no dbid or when the DB layer is absent (fail-open).
_flush_mark_dropped() {
  local dbid="$1" state="$2" err="$3"
  [[ -n "$dbid" ]] || return 0
  declare -F tt_db_set_dropped >/dev/null 2>&1 && tt_db_set_dropped "$dbid" "$state" "$err" 2>/dev/null
  return 0
}

# D3 (msg-repair): before discarding a whole queue for a gone target, mark each
# entry's DB row as dropped-gone. Best-effort; legacy rows without a dbid are
# skipped.
_flush_mark_queue_gone() {
  local qfile="$1" epoch header stored_msg dbid
  [[ -f "$qfile" ]] || return 0
  while IFS=$'\t' read -r epoch header stored_msg dbid; do
    [[ "$dbid" =~ ^[0-9]+$ ]] || continue
    _flush_mark_dropped "$dbid" "dropped-gone" "target gone"
  done < "$qfile"
  return 0
}

# M-D5d: the read->truncate critical section of flush_queue, extracted verbatim
# so with_queue_lock can serialize it against enqueue's append. Args:
# <target_name> <pane> <max_count> <qfile>. D3 adds an optional dbid TSV column
# (4th field) so each terminal outcome advances the original queued row in place
# (flushed / dropped-*) instead of leaving it orphaned. Legacy 3-column rows
# (empty dbid) keep the pre-D3 behaviour.
_flush_drain_queue() {
  local target_name="$1" pane="$2" max_count="$3" qfile="$4"
  local now delivered=0 kept_lines=""
  now=$(date +%s)

  while IFS=$'\t' read -r epoch header stored_msg dbid; do
    # Validate epoch (skip corrupt entries)
    if [[ ! "$epoch" =~ ^[0-9]+$ ]]; then
      echo "  Skipped corrupt entry" >&2
      continue
    fi
    # D3: normalize the optional dbid column (legacy rows have none).
    [[ "$dbid" =~ ^[0-9]+$ ]] || dbid=""

    local msg="$stored_msg"
    if [[ "$stored_msg" == TPROJ-B64:* ]]; then
      if ! msg=$(queue_decode_message "${stored_msg#TPROJ-B64:}"); then
        echo "  Skipped corrupt encoded entry" >&2
        continue
      fi
    fi

    local age=$(( now - epoch ))
    if [[ $age -gt $STALE_SECONDS ]]; then
      echo "  Discarded stale message (${age}s old) for $target_name" >&2
      _flush_mark_dropped "$dbid" "dropped-stale" "stale ${age}s"
      continue
    fi

    # Check max_count limit
    if [[ $max_count -gt 0 && $delivered -ge $max_count ]]; then
      # Keep remaining messages in queue (preserve the dbid column)
      kept_lines+="${epoch}"$'\t'"${header}"$'\t'"${stored_msg}"$'\t'"${dbid}"$'\n'
      continue
    fi

    if stale_meta=$(queued_role_handoff_stale "$target_name" "$pane" "$msg" 2>/dev/null); then
      IFS=$'\t' read -r stale_task stale_epoch current_epoch <<< "$stale_meta"
      echo "  Cancelled stale role handoff ${stale_task} for $target_name (queued epoch ${stale_epoch}, current epoch ${current_epoch})" >&2
      _flush_mark_dropped "$dbid" "dropped-policy" "stale-role-epoch ${stale_epoch}->${current_epoch}"
      continue
    fi

    if suppressed_state=$(delegated_message_tombstone_state "$target_name" "$msg" 2>/dev/null); then
      suppressed_task="$(task_id_from_message "$msg" 2>/dev/null || true)"
      echo "  Suppressed ${suppressed_state} task message ${suppressed_task:-unknown} for $target_name" >&2
      _flush_mark_dropped "$dbid" "dropped-policy" "${suppressed_state}-task"
      continue
    fi

    # Policy guard (drop queued relay-like messages unless explicitly allowed on this invocation)
    if enforce_send_policy "$target_name" "$msg"; then
      :
    else
      local rc=$?
      if [[ $rc -eq $RELAY_BLOCK_EXIT || $rc -eq $BROADCAST_BLOCK_EXIT ]]; then
        echo "  Dropped policy-blocked queued message for $target_name" >&2
      else
        echo "  Failed send policy check for $target_name (rc=$rc), dropping entry" >&2
      fi
      _flush_mark_dropped "$dbid" "dropped-policy" "policy rc=$rc"
      continue
    fi

    # Control message dedup (drop duplicate control/ack entries)
    if control_dedup_check "$target_name" "$msg"; then
      :
    else
      local rc=$?
      if [[ $rc -eq 12 ]]; then
        echo "  Dropped duplicate control message for $target_name: ${header} ${msg}" >&2
        _flush_mark_dropped "$dbid" "dropped-policy" "control-dedup"
        continue
      fi
      echo "  Failed control dedup check for $target_name (rc=$rc), dropping entry" >&2
      _flush_mark_dropped "$dbid" "dropped-policy" "control-dedup rc=$rc"
      continue
    fi

    # Deliver
    tmux send-keys -l -t "$pane" "${header} ${msg}"
    sleep 0.5
    tmux send-keys -t "$pane" Enter
    sleep 0.3
    control_dedup_mark "$target_name" "$msg" || true
    ((delivered++)) || true
    echo "  Delivered queued message to $target_name: ${header} ${msg}" >&2
    # D3 shadow write — advance the original queued row to 'flushed' in place (no
    # second outbound INSERT); legacy rows with no dbid keep the old insert path.
    # Inbound mirror is kept in both cases.
    if declare -F tt_db_log_message >/dev/null 2>&1; then
      local _hash _from _outid
      _hash=$(sha1_hash "$msg" 2>/dev/null)
      _from="${MY_ALIAS:-unknown}.${MY_ROLE:-unknown}"
      if [[ -n "$dbid" ]] && declare -F tt_db_set_flushed >/dev/null 2>&1; then
        tt_db_set_flushed "$dbid" 2>/dev/null
      else
        _outid=$(tt_db_log_message "$SESSION" "$_from" "$target_name" "$msg" "$_hash" "$header" "" "outbound" "flushed" "${MY_ROLE:-cc}" "tmux" "" "${MSG_KIND:-}" "$(consult_task_run "$_from")" 2>/dev/null)
        [[ -n "$_outid" ]] && tt_db_set_delivered "$_outid" 2>/dev/null
      fi
      tt_db_mirror_inbound "$SESSION" "$_from" "$target_name" "$msg" "$_hash" "$header" "" "flushed" "${MY_ROLE:-cc}" "tmux" "" >/dev/null 2>&1 || true
    fi
  done < "$qfile"

  if [[ -n "$kept_lines" ]]; then
    printf '%s' "$kept_lines" > "$qfile"
  else
    rm -f "$qfile"
  fi
}

# Flush queue for a specific target (deliver messages, discard stale)
# Usage: flush_queue <target_name> <pane_id> [max_count]
# max_count: 0 = unlimited (default for --flush), N = deliver at most N
# Returns: number of messages delivered
flush_queue() {
  local target_name="$1" pane="$2" max_count="${3:-0}"
  local qfile="${QUEUE_DIR}/${target_name}.queue"
  [[ -f "$qfile" ]] || return 0

  send_block_reason "$pane"
  case "$SEND_BLOCK_REASON" in
    typing_draft)
      echo "  Skipped flush for $target_name (blocked_typing: ${SEND_BLOCK_DETAIL})" >&2
      return 0
      ;;
    selection_screen)
      echo "  Skipped flush for $target_name (blocked_selection: ${SEND_BLOCK_DETAIL})" >&2
      return 0
      ;;
  esac

  # M-D5d: run the read->truncate as one critical section under the per-target
  # queue lock so a concurrent enqueue append can't be swallowed by the truncate.
  with_queue_lock "$target_name" _flush_drain_queue "$target_name" "$pane" "$max_count" "$qfile"

  return 0
}

# Flush all queues (for --flush command)
flush_all_queues() {
  ensure_queue_dir
  local any_flushed=false

  for qfile in "${QUEUE_DIR}"/*.queue; do
    [[ -f "$qfile" ]] || continue
    local target_name
    target_name=$(basename "$qfile" .queue)
    local pane rc_resolve=0
    pane=$(resolve_target "$target_name" 2>/dev/null) || rc_resolve=$?
    if [[ $rc_resolve -ne 0 ]]; then
      # M-D6b: same keep-queue behaviour, clearer diagnostic. NOT_FOUND means the
      # target is absent from a populated pane list (likely gone); anything else
      # (TRANSIENT) is a tmux hiccup to retry next poll.
      if [[ $rc_resolve -eq $RT_NOT_FOUND ]]; then
        # M-D6c: gone target. Discard the whole queue once even its newest message
        # is older than TARGET_GONE_GRACE (default = STALE_SECONDS: end-state
        # equivalent, since those messages would be dropped as stale anyway).
        local newest_age
        newest_age=$(queue_newest_age "$target_name")
        if [[ -n "$newest_age" && "$newest_age" -gt "$TARGET_GONE_GRACE" ]]; then
          echo "Discarding queue for gone target '$target_name' (newest ${newest_age}s > grace ${TARGET_GONE_GRACE}s)" >&2
          _flush_mark_queue_gone "$qfile"
          rm -f "$qfile"
        else
          echo "Warning: target '$target_name' appears gone (not in pane list), keeping queue" >&2
        fi
      else
        echo "Warning: target '$target_name' unresolved (transient tmux error), keeping queue" >&2
      fi
      continue
    fi
    local idle_status
    idle_status=$(get_idle_status "$pane")
    if [[ "$idle_status" == "idle" ]]; then
      local count
      count=$(queue_count "$target_name")
      echo "Flushing $count message(s) to $target_name..." >&2
      flush_queue "$target_name" "$pane" 0
      any_flushed=true
    else
      local count
      count=$(queue_count "$target_name")
      echo "$target_name: $idle_status ($count message(s) queued)" >&2
    fi
  done

  if [[ "$any_flushed" == "false" ]]; then
    echo "No messages to flush (or all targets busy)" >&2
  fi
}

# === ClawGate bridge support ===
WORKSPACE_CONFIG="$HOME/.config/tproj/workspace.yaml"

# Read bridge config from workspace.yaml (mikefarah/yq v4+)
gate_bridge_url() {
  local url=""
  if command -v yq >/dev/null 2>&1 && [[ -f "$WORKSPACE_CONFIG" ]]; then
    url=$(yq '.gui.bridge.url' "$WORKSPACE_CONFIG" 2>/dev/null || true)
    [[ "$url" == "null" ]] && url=""
  fi
  echo "${url:-http://localhost:8765}"
}

gate_default_adapter() {
  local adapter=""
  if command -v yq >/dev/null 2>&1 && [[ -f "$WORKSPACE_CONFIG" ]]; then
    adapter=$(yq '.gui.bridge.default_adapter' "$WORKSPACE_CONFIG" 2>/dev/null || true)
    [[ "$adapter" == "null" ]] && adapter=""
  fi
  echo "${adapter:-direct}"
}

gate_reply_callback_url() {
  local url=""
  if command -v yq >/dev/null 2>&1 && [[ -f "$WORKSPACE_CONFIG" ]]; then
    url=$(yq '.gui.bridge.reply_callback_url' "$WORKSPACE_CONFIG" 2>/dev/null || true)
    [[ "$url" == "null" ]] && url=""
  fi
  echo "$url"
}

# Check if target is a gate target (gate or gate:adapter)
is_gate_target() {
  [[ "$1" == "gate" || "$1" == gate:* ]]
}

# Normalize adapter aliases:
#   session -> tmux
#   default        -> workspace default adapter
normalize_gate_adapter() {
  local adapter="$1" lower resolved
  lower=$(printf '%s' "$adapter" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    session)
      echo "tmux"
      ;;
    "")
      resolved=$(printf '%s' "$(gate_default_adapter)" | tr '[:upper:]' '[:lower:]')
      case "$resolved" in
        ""|session|default) echo "tmux" ;;
        direct) echo "direct" ;;
        *) echo "$resolved" ;;
      esac
      ;;
    default)
      resolved=$(printf '%s' "$(gate_default_adapter)" | tr '[:upper:]' '[:lower:]')
      case "$resolved" in
        ""|session|default) echo "tmux" ;;
        direct) echo "direct" ;;
        *) echo "$resolved" ;;
      esac
      ;;
    *)
      echo "$lower"
      ;;
  esac
}

# Extract adapter from gate target.
# Defaults to workspace default:
#   gate          -> workspace default (default_adapter in workspace.yaml)
#   gate:session  -> tmux (session)
#   gate:default  -> workspace default
#   gate:line     -> line
gate_adapter() {
  local target="$1" raw
  if [[ "$target" == gate:* ]]; then
    raw="${target#gate:}"
  else
    raw="default"
  fi
  normalize_gate_adapter "$raw"
}

# Resolve session lane target for tmux adapter.
# Priority:
#   1) $TPROJ_GATE_SESSION_TARGET env
#   2) workspace.yaml gui.bridge.session_target
#   3) /v1/config tmux.sessionModes with value=autonomous (first key's alias)
#   4) fallback: clawgate
gate_session_target() {
  local target=""
  local bridge_url cfg

  target=$(trim_spaces "${TPROJ_GATE_SESSION_TARGET:-}")
  if [[ -n "$target" ]]; then
    echo "$target"
    return
  fi

  if command -v yq >/dev/null 2>&1 && [[ -f "$WORKSPACE_CONFIG" ]]; then
    target=$(yq '.gui.bridge.session_target' "$WORKSPACE_CONFIG" 2>/dev/null || true)
    [[ "$target" == "null" ]] && target=""
    target=$(trim_spaces "$target")
    if [[ -n "$target" ]]; then
      echo "$target"
      return
    fi
  fi

  if command -v jq >/dev/null 2>&1; then
    bridge_url=$(gate_bridge_url)
    cfg=$(curl -s --connect-timeout 2 --max-time 3 "${bridge_url}/v1/config" 2>/dev/null || true)
    if [[ -n "$cfg" ]]; then
      target=$(printf '%s' "$cfg" | jq -r '.result.tmux.sessionModes // {} | to_entries[] | select(.value=="autonomous") | .key' 2>/dev/null | head -n 1 || true)
      target=$(printf '%s' "$target" | awk -F ':' '{print $2}')
      target=$(trim_spaces "$target")
      if [[ -n "$target" ]]; then
        echo "$target"
        return
      fi
    fi
  fi

  echo "clawgate"
}

is_line_private_message() {
  local msg="$1"
  printf '%s\n' "$msg" | grep -Eiq '^[[:space:]]*\[line-private\]'
}

strip_line_private_tag() {
  local msg="$1"
  printf '%s' "$msg" | sed -E 's/^[[:space:]]*\[[Ll][Ii][Nn][Ee]-[Pp][Rr][Ii][Vv][Aa][Tt][Ee]\][[:space:]]*//'
}

gate_sender_label() {
  if [[ "$IS_WORKSPACE" == "true" && -n "$MY_ALIAS" && "$MY_ALIAS" != "null" ]]; then
    echo "${MY_ALIAS}.${MY_ROLE}"
  else
    echo "${MY_ROLE}"
  fi
}

format_line_private_notice() {
  local sender="$1" body="$2"
  printf '%sから私信（セッション非共有）: %s' "$sender" "$body"
}

strip_leading_tproj_msg_headers() {
  local msg="$1" prev
  while [[ "$msg" =~ ^[[:space:]]*\[tproj-msg:[^]]*\][[:space:]]* ]]; do
    prev="$msg"
    msg=$(printf '%s' "$msg" | sed -E 's/^[[:space:]]*\[tproj-msg:[^]]*\][[:space:]]*//')
    [[ "$msg" == "$prev" ]] && break
  done
  printf '%s' "$msg"
}

gate_prepend_header_once() {
  local header="$1" msg="$2" body
  body=$(strip_leading_tproj_msg_headers "$msg")
  if [[ -n "$body" ]]; then
    printf '%s %s' "$header" "$body"
  else
    printf '%s' "$header"
  fi
}

# Send message via ClawGate bridge
# Routes:
#   gate/session   -> /v1/send adapter=tmux (session lane)
#   gate:line      -> /v1/send with LINE adapter
#   gate:direct    -> /v1/debug/inject (legacy direct EventBus lane)
# Usage: send_via_gate <adapter> <message>
send_via_gate() {
  local adapter="$1" msg="$2" conversation_hint="${3:-tproj}"
  local bridge_url
  bridge_url=$(gate_bridge_url)
  local escaped_msg
  escaped_msg=$(printf '%s' "$msg" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g' | tr '\n' ' ')
  local trace_id="tproj-msg-$(date +%s)"

  local endpoint payload
  if [[ "$adapter" == "direct" ]]; then
    # Direct EventBus injection -> handleInboundMessage (default path)
    # Chi identifies sender via [tproj-msg:...] header in text
    # reply lane hint is embedded by caller
    endpoint="/v1/debug/inject"
    local conv="${MY_ALIAS:-tproj-msg}"
    payload=$(printf '{"type":"inbound_message","adapter":"tproj","text":"%s","conversation":"%s"}' \
      "$escaped_msg" "$conv")
  else
    # Adapter-routed send (line, tmux, etc.)
    endpoint="/v1/send"
    payload=$(printf '{"adapter":"%s","action":"send_message","payload":{"conversation_hint":"%s","text":"%s","enter_to_send":true,"trace_id":"%s"}}' \
      "$adapter" "$conversation_hint" "$escaped_msg" "$trace_id")
  fi

  local result http_code
  result=$(curl -s -w "\n%{http_code}" -X POST "${bridge_url}${endpoint}" \
    -H "Content-Type: application/json" \
    -H "X-Trace-ID: $trace_id" \
    --connect-timeout 3 \
    --max-time 10 \
    -d "$payload" 2>&1) || {
    echo "Error: ClawGate unreachable at $bridge_url" >&2
    # R1' Stage 3 shadow write — curl failure (connection refused / timeout).
    # Record the unreachable attempt so the DB reflects delivery truth.
    if declare -F tt_db_log_message >/dev/null 2>&1; then
      local _hash _from _outid
      _hash=$(sha1_hash "$msg" 2>/dev/null)
      _from="${MY_ALIAS:-unknown}.${MY_ROLE:-unknown}"
      _outid=$(tt_db_log_message "$SESSION" "$_from" "gate:${adapter}" "$msg" "$_hash" "" "" "outbound" "error" "${MY_ROLE:-cc}" "clawgate" "$trace_id" 2>/dev/null)
      [[ -n "$_outid" ]] && tt_db_set_delivery_error "$_outid" "curl failed: ClawGate unreachable at ${bridge_url}" 2>/dev/null
    fi
    return 1
  }

  http_code=$(echo "$result" | tail -1)
  local body
  body=$(echo "$result" | sed '$d')

  if [[ "$http_code" =~ ^2 ]]; then
    echo "Sent via gate:${adapter} -> ${bridge_url}${endpoint}" >&2
    # R1' Stage 3 shadow write — gate delivery (bridge=clawgate, external_id=trace_id).
    if declare -F tt_db_log_message >/dev/null 2>&1; then
      local _hash _from _outid
      _hash=$(sha1_hash "$msg" 2>/dev/null)
      _from="${MY_ALIAS:-unknown}.${MY_ROLE:-unknown}"
      _outid=$(tt_db_log_message "$SESSION" "$_from" "gate:${adapter}" "$msg" "$_hash" "" "" "outbound" "gate" "${MY_ROLE:-cc}" "clawgate" "$trace_id" 2>/dev/null)
      [[ -n "$_outid" ]] && tt_db_set_delivered "$_outid" 2>/dev/null
    fi
  else
    echo "Error: gate:${adapter} returned HTTP $http_code" >&2
    [[ -n "$body" ]] && echo "  $body" >&2
    # R1' Stage 3 shadow write — gate error.
    if declare -F tt_db_log_message >/dev/null 2>&1; then
      local _hash _from _outid _err
      _hash=$(sha1_hash "$msg" 2>/dev/null)
      _from="${MY_ALIAS:-unknown}.${MY_ROLE:-unknown}"
      _err="HTTP ${http_code}: ${body:0:200}"
      _outid=$(tt_db_log_message "$SESSION" "$_from" "gate:${adapter}" "$msg" "$_hash" "" "" "outbound" "error" "${MY_ROLE:-cc}" "clawgate" "$trace_id" 2>/dev/null)
      [[ -n "$_outid" ]] && tt_db_set_delivery_error "$_outid" "$_err" 2>/dev/null
    fi
    return 1
  fi
}

# Gate cross-adapter dedup: block same message via different adapters within TTL
GATE_DEDUP_DIR="${TPROJ_MSG_GATE_DEDUP_DIR:-/tmp/tproj-msg-gate-dedup}"
GATE_DEDUP_TTL="${TPROJ_MSG_GATE_DEDUP_SEC:-60}"

# E2 (msg-repair): TTL sweep for the file-per-hash dedup stores. gate_dedup and
# send_dedup each write one file per message hash and never removed stale ones,
# so they grew monotonically (unlike the control/fanout TSV stores, which sweep
# on every check). This gives them the same TTL-bounded cleanup. A file is
# written once (truncating `>`), so its mtime equals the stored timestamp; a
# minute-granularity find that rounds the TTL up never deletes a still-live
# (age < TTL) entry, matching the check's own age gate. Fail-open.
cleanup_hashfile_dedup_store() {
  local dir="$1" ttl="$2" ttl_min
  [[ -d "$dir" ]] || return 0
  [[ "$ttl" =~ ^[0-9]+$ ]] || return 0
  ttl_min=$(( (ttl + 59) / 60 ))
  find "$dir" -maxdepth 1 -type f -mmin +"$ttl_min" -delete 2>/dev/null || true
}

gate_dedup_check() {
  local adapter="$1" msg_body="$2"
  cleanup_hashfile_dedup_store "$GATE_DEDUP_DIR" "$GATE_DEDUP_TTL"
  local msg_hash
  msg_hash=$(printf '%s' "$msg_body" | shasum -a 1 | cut -d' ' -f1)
  local dedup_file="${GATE_DEDUP_DIR}/${msg_hash}"
  if [[ -f "$dedup_file" ]]; then
    local prev_adapter prev_ts now_ts age
    IFS=: read -r prev_adapter prev_ts < "$dedup_file"
    now_ts=$(date +%s)
    age=$((now_ts - prev_ts))
    if [[ $age -lt $GATE_DEDUP_TTL && "$prev_adapter" != "$adapter" ]]; then
      echo "Error: same message already sent via gate:${prev_adapter} ${age}s ago. Duplicate blocked." >&2
      return 1
    fi
  fi
  return 0
}

gate_dedup_mark() {
  local adapter="$1" msg_body="$2"
  local msg_hash
  msg_hash=$(printf '%s' "$msg_body" | shasum -a 1 | cut -d' ' -f1)
  mkdir -p "$GATE_DEDUP_DIR"
  printf '%s:%s' "$adapter" "$(date +%s)" > "${GATE_DEDUP_DIR}/${msg_hash}"
}

# D2 (msg-repair): short-window duplicate-resend guard, generalized from the
# gate-dedup file+TTL store. Keyed on (from|to|body) so the same message to a
# different target is not blocked. Marked at check time (new-send-command
# semantics); --force skips both check and mark. Never invoked from flush_queue.
send_dedup_key() {
  printf '%s|%s|%s' "$1" "$2" "$3" | shasum -a 1 | cut -d' ' -f1
}

send_dedup_check() {
  local to="$1" msg="$2"
  local from key file prev_ts now age
  cleanup_hashfile_dedup_store "$SEND_DEDUP_DIR" "$SEND_DEDUP_TTL"
  from="${MY_ALIAS:-unknown}.${MY_ROLE:-unknown}"
  key=$(send_dedup_key "$from" "$to" "$msg")
  file="${SEND_DEDUP_DIR}/${key}"
  [[ -f "$file" ]] || return 0
  prev_ts=$(cat "$file" 2>/dev/null)
  [[ "$prev_ts" =~ ^[0-9]+$ ]] || return 0
  now=$(date +%s)
  age=$((now - prev_ts))
  if [[ $age -lt $SEND_DEDUP_TTL ]]; then
    dlog "dedup: blocked duplicate to=${to} age=${age}s ttl=${SEND_DEDUP_TTL}s"
    echo "Error: identical message already sent to '$to' ${age}s ago (within ${SEND_DEDUP_TTL}s window). Duplicate blocked; use --force to override." >&2
    return 1
  fi
  return 0
}

send_dedup_mark() {
  local to="$1" msg="$2"
  local from key
  from="${MY_ALIAS:-unknown}.${MY_ROLE:-unknown}"
  key=$(send_dedup_key "$from" "$to" "$msg")
  mkdir -p "$SEND_DEDUP_DIR" 2>/dev/null || true
  printf '%s' "$(date +%s)" > "${SEND_DEDUP_DIR}/${key}" 2>/dev/null || true
}

# Check ClawGate health
gate_health() {
  local bridge_url
  bridge_url=$(gate_bridge_url)
  local result
  result=$(curl -s --connect-timeout 2 --max-time 3 "${bridge_url}/v1/health" 2>/dev/null) || {
    echo "offline"
    return
  }
  echo "online"
}

# === Target resolution ===
resolve_target() {
  local target="$1"
  local target_alias="" target_role="" target_col=""
  TARGET_RESOLVE_REASON="unresolved"

  # Parse target format
  if [[ "$target" == agent-* ]]; then
    target_role="$target"
  elif [[ "$target" == *.* ]]; then
    target_alias="${target%%.*}"
    target_role="${target#*.}"
  elif [[ "$target" == "cc" || "$target" == "cdx" ]]; then
    target_role="$target"
  else
    target_alias="$target"
    target_role="cc"
  fi

  local pane_list list_status
  # Bind both probes to the exact session. A missing session must never fall
  # through to a similarly named prefix session.
  if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    TARGET_RESOLVE_REASON="session_not_found"
    return "$RT_NOT_FOUND"
  fi
  pane_list=$(tmux list-panes -t "=$SESSION:dev" -F '#{pane_id}:#{@role}:#{@alias}:#{@column}:#{pane_dead}' 2>/dev/null)
  list_status=$?

  # Classify a lookup miss (M-D6): a populated list means the target is genuinely
  # absent (likely gone); a failed/empty list means tmux was transiently
  # unavailable. Every "not found" return below yields this code so callers that
  # care (flush_all_queues) can tell gone from retry; callers that only test for
  # non-zero keep their existing behaviour.
  local rt_fail=$RT_NOT_FOUND
  if [[ $list_status -ne 0 || -z "$pane_list" ]]; then
    rt_fail=$RT_TRANSIENT
    TARGET_RESOLVE_REASON="pane_list_unavailable"
  fi

  if [[ "$target" == agent-* ]]; then
    echo "$pane_list" | while IFS=: read -r pid prole palias pcol pdead; do
      [[ "$pdead" == "1" ]] && continue
      if [[ "$prole" == "$target_role" ]]; then
        echo "$pid"
        return 0
      fi
    done
    return $rt_fail
  fi

  if [[ "$IS_WORKSPACE" == "true" ]]; then
    if [[ -n "$target_alias" ]]; then
      local requested_role match_count=0 matched_pane=""
      requested_role=$(role_to_short "$target_role")
      while IFS=: read -r pid prole palias pcol pdead; do
        [[ "$pdead" == "1" ]] && continue
        [[ "$palias" == "$target_alias" ]] || continue
        [[ "$(role_to_short "$prole")" == "$requested_role" ]] || continue
        match_count=$((match_count+1))
        matched_pane="$pid"
      done <<< "$pane_list"
      if [[ "$match_count" -eq 1 ]]; then
        echo "$matched_pane"
        return 0
      elif [[ "$match_count" -gt 1 ]]; then
        TARGET_RESOLVE_REASON="ambiguous_alias_role"
        echo "Error: target '$target' is ambiguous (multiple live panes with exact alias and role)" >&2
        return "$AMBIGUOUS_BARE_EXIT"
      fi
      TARGET_RESOLVE_REASON="alias_role_not_found"
      echo "Error: target '$target' not found with exact alias and role" >&2
      return $rt_fail
    else
      local role_pattern match_count=0 matched_pane=""
      role_pattern=$(short_to_role_pattern "$target_role" "$MY_COLUMN")
      while IFS=: read -r pid prole palias pcol pdead; do
        [[ "$pdead" == "1" ]] && continue
        if [[ "$prole" == "$role_pattern" ]]; then
          match_count=$((match_count+1))
          matched_pane="$pid"
        fi
      done <<< "$pane_list"
      if [[ "$match_count" -eq 1 ]]; then
        echo "$matched_pane"
        return 0
      elif [[ "$match_count" -gt 1 ]]; then
        TARGET_RESOLVE_REASON="ambiguous_bare_role"
        return "$AMBIGUOUS_BARE_EXIT"
      fi
    fi
  else
    local role_pattern match_count=0 matched_pane=""
    role_pattern=$(short_to_role_pattern "$target_role")
    while IFS=: read -r pid prole palias pcol pdead; do
      [[ "$pdead" == "1" ]] && continue
      if [[ "$prole" == "$role_pattern" ]]; then
        match_count=$((match_count+1))
        matched_pane="$pid"
      fi
    done <<< "$pane_list"
    if [[ "$match_count" -eq 1 ]]; then
      echo "$matched_pane"
      return 0
    elif [[ "$match_count" -gt 1 ]]; then
      TARGET_RESOLVE_REASON="ambiguous_role"
      return "$AMBIGUOUS_BARE_EXIT"
    fi
  fi

  TARGET_RESOLVE_REASON="target_not_found"
  return $rt_fail
}

# C4 (P0-3): a bare cc/cdx target is only unambiguous when the workspace resolves
# it to a single pane. In a multi-column workspace an in-pane sender's own column
# scopes it to one; an external/columnless caller cannot, so we reject with the
# candidate list to force an explicit <alias>.<role>. Single-column workspaces and
# non-workspace single mode keep exactly one candidate -> unchanged (backward
# compatible). Returns 0 to allow, non-zero (after printing) to reject.
check_bare_target_unambiguous() {
  local target="$1"
  [[ "$target" == "cc" || "$target" == "cdx" ]] || return 0
  [[ "$IS_WORKSPACE" == "true" ]] || return 0
  tmux has-session -t "=$SESSION" 2>/dev/null || return 0
  local pane_list
  pane_list=$(tmux list-panes -t "=$SESSION:dev" -F '#{pane_id}:#{@role}:#{@alias}:#{@column}:#{pane_dead}' 2>/dev/null)
  [[ -n "$pane_list" ]] || return 0   # transient tmux hiccup: let resolve_target handle
  local pid prole palias pcol pshort tname
  local candidates="" ccount=0 same_col=0
  while IFS=: read -r pid prole palias pcol pdead; do
    [[ "$pdead" == "1" ]] && continue
    pshort=$(role_to_short "$prole")
    [[ "$pshort" == "$target" ]] || continue
    [[ -z "$palias" || "$palias" == "null" ]] && palias="col${pcol}"
    tname="${palias}.${pshort}"
    ccount=$((ccount + 1))
    if [[ -z "$candidates" ]]; then candidates="$tname"; else candidates="${candidates}, ${tname}"; fi
    [[ -n "$MY_COLUMN" && "$pcol" == "$MY_COLUMN" ]] && same_col=$((same_col + 1))
  done <<< "$pane_list"
  # 0 or 1 candidate total -> unambiguous (single-column / single-mode compat).
  [[ "$ccount" -le 1 ]] && return 0
  # In-pane sender with exactly one same-column candidate -> same-column semantic.
  [[ -n "$MY_COLUMN" && "$same_col" -eq 1 ]] && return 0
  echo "Error: ${target} is ambiguous: ${candidates}" >&2
  echo "Hint: address a specific column, e.g. ${candidates%%,*}" >&2
  return "$AMBIGUOUS_BARE_EXIT"
}

# E2 (msg-repair): remove stale task-id sequence buckets. Each is an
# <root>/<target>/<epoch_min>/ dir; once its minute has long passed it is dead
# weight (192 dirs observed accumulating). Delete buckets whose epoch_min is
# older than `stale` seconds. Only obviously-stale buckets are touched, so the
# current allocation minute is never removed. Fail-open (best-effort rm).
prune_task_seq_buckets() {
  local root="${1:-$TASK_SEQ_ROOT}" stale="${2:-$TASK_SEQ_STALE_SEC}"
  [[ -d "$root" ]] || return 0
  [[ "$stale" =~ ^[0-9]+$ ]] || return 0
  local now cutoff_min target_dir bucket bmin
  now=$(date +%s)
  cutoff_min=$(( (now - stale) / 60 ))
  for target_dir in "$root"/*/; do
    [[ -d "$target_dir" ]] || continue
    for bucket in "$target_dir"*/; do
      [[ -d "$bucket" ]] || continue
      bmin=$(basename "$bucket")
      [[ "$bmin" =~ ^[0-9]+$ ]] || continue
      (( bmin < cutoff_min )) && rm -rf "$bucket" 2>/dev/null || true
    done
  done
  return 0
}

# Low-frequency gate around prune_task_seq_buckets: prune at most once per
# TASK_SEQ_GC_INTERVAL, tracked by a stamp file at the seq root. Runs on the
# first send after each interval so the accumulated backlog is reclaimed without
# scanning on every send. Fail-open.
maybe_prune_task_seq() {
  local stamp="${TASK_SEQ_ROOT}/.last-gc" now last age
  now=$(date +%s)
  last=0
  [[ -f "$stamp" ]] && last=$(cat "$stamp" 2>/dev/null || echo 0)
  [[ "$last" =~ ^[0-9]+$ ]] || last=0
  age=$(( now - last ))
  if (( age < TASK_SEQ_GC_INTERVAL )); then
    return 0
  fi
  mkdir -p "$TASK_SEQ_ROOT" 2>/dev/null || true
  printf '%s' "$now" > "$stamp" 2>/dev/null || true
  prune_task_seq_buckets "$TASK_SEQ_ROOT" "$TASK_SEQ_STALE_SEC" || true
  return 0
}

generate_task_id() {
  local alias_part target_token epoch_min seq_root epoch_root seq=0 next=0 seq_dir
  maybe_prune_task_seq
  alias_part=$(printf '%s' "${MY_ALIAS:-}" | tr -cd '[:alnum:]-')
  [[ -n "$alias_part" ]] || alias_part="tp"
  # Second layer of collision defense (the DB composite identity is the first):
  # embed a target-derived component in the id so the per-target sequence counter
  # can never yield the same id for two different targets in the same epoch min.
  # The encoding is INJECTIVE: a lowercase hex encoding of the target's bytes, so
  # distinct targets (e.g. "a-b", "ab", "a_b", "a.b") always yield distinct
  # tokens. `od -v` disables the '*' run-collapsing that would otherwise break
  # injectivity. It is pure hex, so it never collides with the id's '-' delimiter.
  # (A truncated hash is deliberately avoided -- it is not injective.)
  target_token=$(printf '%s' "${TARGET:-}" | od -An -v -tx1 | tr -d ' \n')
  [[ -n "$target_token" ]] || target_token="74"
  epoch_min=$(( $(date +%s) / 60 ))
  seq_root="${TASK_SEQ_ROOT}/${TARGET}"
  epoch_root="${seq_root}/${epoch_min}"
  mkdir -p "$epoch_root"
  while [[ $seq -lt 100 ]]; do
    next=$((seq + 1))
    seq_dir=$(printf '%s/%02d' "$epoch_root" "$next")
    if mkdir "$seq_dir" 2>/dev/null; then
      printf '%s-%s-%s-%02d\n' "$alias_part" "$target_token" "$epoch_min" "$next"
      return 0
    fi
    seq=$next
  done
  echo "Error: failed to allocate task id sequence for $TARGET" >&2
  exit 1
}

emit_task_tracking_metadata() {
  [[ "${NEW_TASK_MODE:-false}" == "true" ]] || return 0
  [[ -n "${TASK_ID:-}" ]] || return 0
  [[ -z "${TASK_SENT_AT:-}" ]] || return 0
  TASK_SENT_AT=$(date +%s)
  echo "TASK_ID=${TASK_ID} TASK_TARGET=${TARGET} TASK_TTL_SEC=${TTL_SEC} TASK_SENT_AT=${TASK_SENT_AT} TASK_KIND=${TASK_KIND:-delegated} TASK_INTENT_HASH=${TASK_INTENT_HASH:-} TASK_USER_AUTHORIZED_EXACT=${TASK_USER_AUTHORIZED_EXACT:-0} TASK_ROLE_EPOCH=${ROLE_HANDOFF_EPOCH:-} TASK_ORCHESTRATOR=${ROLE_HANDOFF_ORCHESTRATOR:-}" >&2
}

current_pane_metadata() {
  local key="$1" pane="${MY_PANE:-${TMUX_PANE:-}}"
  [[ -n "$pane" ]] || return 1
  tmux show-options -pv -t "$pane" "$key" 2>/dev/null || true
}

resolve_role_handoff_metadata() {
  local pane_epoch pane_role sender_identity
  [[ "$ROLE_HANDOFF_MODE" == "true" ]] || return 0

  if [[ -z "$ROLE_HANDOFF_EPOCH" ]]; then
    pane_epoch=$(current_pane_metadata '@role_epoch')
    ROLE_HANDOFF_EPOCH="${pane_epoch:-0}"
  fi
  if [[ -z "$ROLE_HANDOFF_ORCHESTRATOR" ]]; then
    pane_role=$(current_pane_metadata '@orchestration_role')
    sender_identity="${MY_ALIAS:+${MY_ALIAS}.}${MY_ROLE:-unknown}"
    case "$pane_role" in
      worker) ROLE_HANDOFF_ORCHESTRATOR="$TARGET" ;;
      orchestrator|solo-fallback) ROLE_HANDOFF_ORCHESTRATOR="$sender_identity" ;;
      *) ROLE_HANDOFF_ORCHESTRATOR="$TARGET" ;;
    esac
  fi

  if [[ ! "$ROLE_HANDOFF_EPOCH" =~ ^[0-9]+$ ]]; then
    echo "Error: current pane @role_epoch must be a non-negative integer" >&2
    exit 1
  fi
  if [[ ! "$ROLE_HANDOFF_ORCHESTRATOR" =~ ^[[:alnum:]_.:-]+$ ]]; then
    echo "Error: resolved orchestrator identity contains unsupported characters" >&2
    exit 1
  fi
}

task_id_from_message() {
  local msg="$1"
  if [[ "$msg" =~ \[(Role-Handoff|Task|ACK-PROGRESS|ACK|DONE|BLOCK|BLOCKED):[[:space:]]*([A-Za-z0-9._-]+)\] ]]; then
    printf '%s\n' "${BASH_REMATCH[2]}"
    return 0
  fi
  return 1
}

task_counterparty_alias() {
  local target_name="$1"
  case "$target_name" in
    *.*) printf '%s\n' "${target_name%%.*}" ;;
    cc|cdx) printf '%s\n' "${MY_ALIAS:-}" ;;
    *) return 1 ;;
  esac
}

delegated_message_tombstone_state() {
  local target_name="$1" msg="$2"
  [[ -n "${SESSION:-}" && -n "${MY_ALIAS:-}" && -n "${MY_ROLE:-}" ]] || return 1
  declare -F tt_db_exec_safe >/dev/null 2>&1 || return 1
  declare -F tt_db_quote >/dev/null 2>&1 || return 1
  local task_id counterparty self_alias self_owner_q counterparty_q target_q self_q task_q
  task_id=$(task_id_from_message "$msg" 2>/dev/null || true)
  [[ -n "$task_id" ]] || return 1
  counterparty=$(task_counterparty_alias "$target_name" 2>/dev/null || true)
  [[ -n "$counterparty" ]] || return 1
  self_alias="${MY_ALIAS}.${MY_ROLE}"
  self_owner_q="$(tt_db_quote "$MY_ALIAS")"
  counterparty_q="$(tt_db_quote "$counterparty")"
  target_q="$(tt_db_quote "$target_name")"
  self_q="$(tt_db_quote "$self_alias")"
  task_q="$(tt_db_quote "$task_id")"
  local state
  state="$(tt_db_exec_safe "SELECT state FROM tasks WHERE owner_session='$(tt_db_quote "$SESSION")' AND task_id='${task_q}' AND state IN ('cancelled','frozen') AND ((owner_alias='${self_owner_q}' AND target='${target_q}') OR (owner_alias='${counterparty_q}' AND target='${self_q}')) ORDER BY COALESCE(frozen_at, cancelled_at, 0) DESC, sent_at DESC LIMIT 1;" 2>/dev/null || true)"
  [[ -n "$state" ]] || return 1
  printf '%s\n' "$state"
}

cancel_sender_task_tombstone() {
  local target_name="$1" task_id="$2" reason_hash="$3"
  [[ -n "${SESSION:-}" && -n "${MY_ALIAS:-}" ]] || return 1
  if tt_cache_tombstone_task "${SESSION}/${MY_ALIAS}" "$target_name" "$task_id" cancelled "$reason_hash" >/dev/null 2>&1; then
    return 0
  fi
  declare -F tt_db_tombstone_task >/dev/null 2>&1 || return 1
  tt_db_tombstone_task "$task_id" cancelled "$SESSION" "$MY_ALIAS" "$target_name" "$reason_hash" >/dev/null 2>&1
}

queued_role_handoff_stale() {
  local target_name="$1" pane="$2" msg="$3"
  [[ "$msg" == *"[Role-Handoff:"* ]] || return 1
  local task_id queued_epoch current_epoch reason_hash
  task_id=$(printf '%s\n' "$msg" | sed -nE 's/^\[Role-Handoff:[[:space:]]*([A-Za-z0-9._-]+)\].*/\1/p' | head -n 1)
  queued_epoch=$(printf '%s\n' "$msg" | sed -nE 's/^Role-Epoch:[[:space:]]*([0-9]+).*/\1/p' | head -n 1)
  [[ -n "$task_id" && "$queued_epoch" =~ ^[0-9]+$ ]] || return 1
  current_epoch=$(tmux show-options -p -t "$pane" -v @role_epoch 2>/dev/null || true)
  [[ "$current_epoch" =~ ^[0-9]+$ ]] || return 1
  [[ "$queued_epoch" == "$current_epoch" ]] && return 1
  reason_hash="$(sha256_hash "stale-role-epoch:${queued_epoch}:${current_epoch}")"
  cancel_sender_task_tombstone "$target_name" "$task_id" "$reason_hash" || true
  printf '%s\t%s\t%s\n' "$task_id" "$queued_epoch" "$current_epoch"
  return 0
}

# === Send helpers ===

# Raw send: push text into target pane via tmux send-keys
# Record a failed send in the DB shadow store as a delivery error (not delivered),
# mirroring send_via_gate's error path. Best-effort; no-op if the DB layer is absent.
_raw_send_record_error() {
  local _reason="$1"
  if declare -F tt_db_log_message >/dev/null 2>&1; then
    local _hash _from _outid
    _hash=$(sha1_hash "$MESSAGE" 2>/dev/null)
    _from="${MY_ALIAS:-unknown}.${MY_ROLE:-unknown}"
    _outid=$(tt_db_log_message "$SESSION" "$_from" "$TARGET" "$MESSAGE" "$_hash" "$HEADER" "${TASK_ID:-}" "outbound" "error" "${MY_ROLE:-cc}" "tmux" "" "${MSG_KIND:-}" "$(consult_task_run "$_from")" 2>/dev/null)
    if [[ -n "$_outid" ]] && declare -F tt_db_set_delivery_error >/dev/null 2>&1; then
      tt_db_set_delivery_error "$_outid" "$_reason" 2>/dev/null
    fi
  fi
}

raw_send() {
  # Verify each tmux send-keys actually succeeded. On failure: emit no "Sent to"
  # line, report the error on stderr, record the attempt in the DB as a delivery
  # error (not delivered), and return non-zero so callers skip the dedup/fanout
  # marks and propagate the failure. The success path below is unchanged.
  if ! tmux send-keys -l -t "$TARGET_PANE" "${HEADER} ${MESSAGE}"; then
    echo "Error: failed to deliver to $TARGET (tmux send-keys failed on message body)" >&2
    _raw_send_record_error "send-keys body failed"
    return 1
  fi
  sleep 0.5
  if ! tmux send-keys -t "$TARGET_PANE" Enter; then
    echo "Error: failed to deliver to $TARGET (tmux send-keys failed on Enter)" >&2
    _raw_send_record_error "send-keys Enter failed"
    return 1
  fi
  echo "Sent to $TARGET: ${HEADER} ${MESSAGE}" >&2
  dlog "deliver: send-keys ok to=${TARGET} pane=${TARGET_PANE:-?}"
  emit_task_tracking_metadata
  # R1' Stage 3 shadow write — best-effort. outbound + inbound mirror in DB.
  if declare -F tt_db_log_message >/dev/null 2>&1; then
    local _hash _from _outid
    _hash=$(sha1_hash "$MESSAGE" 2>/dev/null)
    _from="${MY_ALIAS:-unknown}.${MY_ROLE:-unknown}"
    _outid=$(tt_db_log_message "$SESSION" "$_from" "$TARGET" "$MESSAGE" "$_hash" "$HEADER" "${TASK_ID:-}" "outbound" "send-keys" "${MY_ROLE:-cc}" "tmux" "" "${MSG_KIND:-}" "$(consult_task_run "$_from")" 2>/dev/null)
    [[ -n "$_outid" ]] && tt_db_set_delivered "$_outid" 2>/dev/null
    tt_db_mirror_inbound "$SESSION" "$_from" "$TARGET" "$MESSAGE" "$_hash" "$HEADER" "${TASK_ID:-}" "send-keys" "${MY_ROLE:-cc}" "tmux" "" >/dev/null 2>&1 || true
  fi
  # D2 (msg-repair): record this delivery in the short-window dedup store so a
  # subsequent identical (from,to,body) send is rejected. Uses the pre-mutation
  # body captured at precheck; no-op if unset (non-dispatch caller).
  [[ -n "${DEDUP_BODY:-}" ]] && send_dedup_mark "$TARGET" "$DEDUP_BODY" || true
}

do_read() {
  CAPTURED_OUTPUT="$(tmux capture-pane -t "$TARGET_PANE" -p -S "-${READ_LINES}")"
  printf '%s\n' "$CAPTURED_OUTPUT"

  # C2 (P0-2): best-effort mark inbound messages from this target to self as read.
  # Not a strict scrollback reconciliation -- advance every unread inbound row
  # whose sender is this target pane and whose recipient is us. Fail-open: DB
  # errors are ignored and no DB is created if one does not already exist.
  if declare -F tt_db_exec_safe >/dev/null 2>&1 && declare -F tt_db_quote >/dev/null 2>&1 \
     && declare -F tt_db_path >/dev/null 2>&1 && [[ -n "${MY_ALIAS:-}" ]] && [[ -f "$(tt_db_path)" ]]; then
    _c2_talias=$(tmux display-message -t "$TARGET_PANE" -p '#{@alias}' 2>/dev/null || true)
    _c2_trole=$(role_to_short "$(tmux display-message -t "$TARGET_PANE" -p '#{@role}' 2>/dev/null || true)")
    if [[ -n "$_c2_talias" && "$_c2_talias" != "null" && -n "$_c2_trole" ]]; then
      _c2_from=$(tt_db_quote "${_c2_talias}.${_c2_trole}")
      _c2_self=$(tt_db_quote "${MY_ALIAS}.${MY_ROLE}")
      tt_db_exec_safe "UPDATE messages SET read_at=strftime('%s','now') WHERE from_alias='${_c2_from}' AND to_alias='${_c2_self}' AND direction='inbound' AND read_at IS NULL;" >/dev/null 2>&1 || true
    fi
  fi

  if [[ ! -f "$TASK_CACHE_HELPER" ]]; then
    exit 0
  fi

  # shellcheck source=/dev/null
  source "$TASK_CACHE_HELPER"
  FOUND_REPLY=1
  # Owner-scoped MUTATION guard (cross-column leak fix): lifecycle side effects
  # fire ONLY for task ids
  # present in OUR OWN cache subdir (owner = "<session>/<my_alias>"). A tag seen
  # in this target's pane scrollback for a task some OTHER column delegated must
  # never transition the shared DB row or steal that column's cache entry (which
  # is how the other column detects its own reply). Fail-closed: an unresolvable
  # owner tracks nothing, so nothing is mutated.
  #
  # The informational `TASK_REPLIED=<id>` stderr line and the exit code are left
  # untouched for ALL detected tags: they are this invoking pane's own output of
  # an explicit `--read`, not a cross-column notice (the D5 hook cross-references
  # only its own pending ids), and legacy `--read` tag-reading compatibility
  # depends on it.
  READ_OWNER=""
  if [[ -n "${SESSION:-}" && -n "${MY_ALIAS:-}" && "$MY_ALIAS" != "null" ]]; then
    READ_OWNER="${SESSION}/${MY_ALIAS}"
  fi
  OWN_TASK_IDS=""
  if [[ -n "$READ_OWNER" ]] && tt_cache_valid_owner "$READ_OWNER" 2>/dev/null; then
    OWN_TASK_IDS="$(tt_cache_list_open_tasks "$READ_OWNER" "$TARGET" 2>/dev/null | awk -F '\t' 'NF {print $1}')"
  fi
  while IFS= read -r reply_id; do
    [[ -n "$reply_id" ]] || continue
    # Is this tag for a task WE are tracking in our own cache subdir?
    _own_task=0
    printf '%s\n' "$OWN_TASK_IDS" | grep -qxF "$reply_id" && _own_task=1
    # Determine the highest-precedence lifecycle tag. ACK and ACK-PROGRESS are
    # non-terminal. DONE/BLOCK require durable message-id + body-hash evidence
    # from the exact sender/recipient pair before the cache can advance.
    if [[ "$_own_task" -eq 1 ]]; then
      # Pick the highest-precedence tag for this reply_id: terminal tags
      # (DONE/BLOCK) win over ACK regardless of buffer order, so an ACK still
      # visible in scrollback cannot block the done/blocked transition.
      _tags=$(printf '%s\n' "$CAPTURED_OUTPUT" | grep -Eo "\[(ACK-PROGRESS|ACK|DONE|BLOCK|BLOCKED):[[:space:]]*${reply_id}[[:space:]]*\]" | sed -E 's/^\[([A-Z-]+):.*$/\1/')
      if printf '%s\n' "$_tags" | grep -q '^DONE$'; then _tag=DONE
      elif printf '%s\n' "$_tags" | grep -qE '^BLOCK(ED)?$'; then _tag=BLOCK
      elif printf '%s\n' "$_tags" | grep -q '^ACK-PROGRESS$'; then _tag=ACK-PROGRESS
      elif printf '%s\n' "$_tags" | grep -q '^ACK$'; then _tag=ACK
      else _tag=""; fi
      case "$_tag" in
        ACK|ACK-PROGRESS)
          tt_cache_apply_reply "$READ_OWNER" "$TARGET" "$reply_id" "$_tag" >/dev/null 2>&1 || true
          ;;
        DONE|BLOCK)
          _evidence=""
          if declare -F tt_db_find_lifecycle_evidence >/dev/null 2>&1; then
            _self_alias="${MY_ALIAS}.${MY_ROLE}"
            _evidence=$(tt_db_find_lifecycle_evidence "$reply_id" "$TARGET" "$_self_alias" "$_tag" 2>/dev/null || true)
            if [[ -z "$_evidence" && "$_tag" == BLOCK ]]; then
              _evidence=$(tt_db_find_lifecycle_evidence "$reply_id" "$TARGET" "$_self_alias" BLOCKED 2>/dev/null || true)
            fi
          fi
          _message_id="${_evidence%%$'\t'*}"
          _body_hash="${_evidence#*$'\t'}"
          [[ "$_evidence" == *$'\t'* ]] || { _message_id=""; _body_hash=""; }
          tt_cache_apply_reply "$READ_OWNER" "$TARGET" "$reply_id" "$_tag" "$_message_id" "$_body_hash" "$_self_alias" >/dev/null 2>&1 || true
          ;;
      esac
    fi
    echo "TASK_REPLIED=${reply_id}" >&2
    FOUND_REPLY=0
  done < <(printf '%s\n' "$CAPTURED_OUTPUT" | grep -Eo '\[(ACK-PROGRESS|ACK|DONE|BLOCK|BLOCKED):[[:space:]]*[^]]+\]' | sed -E 's/^\[(ACK-PROGRESS|ACK|DONE|BLOCK|BLOCKED):[[:space:]]*//; s/\]$//' | awk 'NF {print $0}' | sort -u)

  exit "$FOUND_REPLY"
}

assist_mode_blocks_peer_task() {
  [[ "${NEW_TASK_MODE:-false}" == "true" ]] || return 1
  local peer project router mode_json mode
  case "${MY_ROLE:-}" in
    cc) peer="${MY_ALIAS}.cdx" ;;
    cdx) peer="${MY_ALIAS}.cc" ;;
    *) return 1 ;;
  esac
  [[ -n "${MY_ALIAS:-}" && "$TARGET" == "$peer" ]] || return 1

  project="${VERIFIED_REG_PROJECT:-}"
  if [[ -z "$project" && -n "${MY_PANE:-}" ]]; then
    project="$(tmux display-message -t "$MY_PANE" -p '#{@project}' 2>/dev/null || true)"
  fi
  [[ "$project" == /* ]] || return 1

  router="${TPROJ_MODEL_ROLE_ROUTER:-$HOME/bin/model-role-router}"
  [[ -x "$router" ]] || router="$(command -v model-role-router 2>/dev/null || true)"
  [[ -x "$router" ]] || return 1
  mode_json="$("$router" mode --json --project "$project" 2>/dev/null || true)"
  mode="$(printf '%s' "$mode_json" | jq -r '.mode // empty' 2>/dev/null || true)"
  [[ "$mode" == "assist" ]]
}

do_send_tmux() {
# Assist mode makes the side directly prompted by the user the working side.
# The opposite same-column peer remains available for ordinary consultation,
# but cannot receive a delegated task or role-handoff. Enforce this before
# liveness checks, task-id creation, database writes, or send-keys so stale
# role markers cannot silently reverse the user-selected ownership.
if assist_mode_blocks_peer_task; then
  echo "Error: task delegation to '$TARGET' is disabled in Assist mode (reason: assist_peer_is_advice_only). Send an ordinary consultation message, prompt that pane directly, or change the mode." >&2
  exit 1
fi

# For send modes, refuse to send if pane exists but AI is not running.
if ! is_target_online "$TARGET_PANE"; then
  target_role=$(tmux display-message -t "$TARGET_PANE" -p '#{@role}' 2>/dev/null || true)
  target_cmd=$(tmux display-message -t "$TARGET_PANE" -p '#{pane_current_command}' 2>/dev/null || true)
  echo "Error: target '$TARGET' is offline (role=${target_role}, cmd=${target_cmd})" >&2
  echo "Hint: start the target AI first, then retry." >&2
  exit 1
fi

# === Build message header ===
if [[ "$IS_WORKSPACE" == "true" && -n "$MY_ALIAS" && "$MY_ALIAS" != "null" ]]; then
  HEADER="[from:${MY_ALIAS}.${MY_ROLE}]"
else
  HEADER="[from:${MY_ROLE}]"
fi

# R2 Stage 1 — fail-closed gate for ALL sends, not only --role-handoff.
# An unverified explicit --as claim (dot alias.role or bare role) is
# refused outright: no tmux send-keys, no ordinary messages row, only the
# reject audit entry below. Callers that never claimed an identity via
# --as (in-tmux pane-derived, or the CWD+ancestry auto-detect fallback)
# are unaffected -- both already set AS_CALLER_VERIFIED=true above.
if [[ "${AS_CALLER_VERIFIED:-false}" != "true" && -n "${EXPLICIT_AS:-}" ]]; then
  echo "Error: send refused for '$TARGET': sender identity for --as '${EXPLICIT_AS}' could not be verified (reason: ${CALLER_VERIFY_REASON:-unverified_caller})" >&2
  audit_log_caller_decision "$TARGET" "${AS_CLAIMED_IDENTITY:-$EXPLICIT_AS}" 0 "${CALLER_VERIFY_REASON:-unverified_caller}" "$(sha256_hash "$MESSAGE")" "$HEADER" ""
  exit 1
fi

# The non---as send paths (in-tmux pane-derived; the CWD auto-detect fallback)
# prove ancestry through their own mechanism. If that proof failed for a real
# send, refuse it here too: no send-keys, only the reject audit entry. SEND_MODE
# excludes read/status/list, which never send-keys.
if [[ "${AS_CALLER_VERIFIED:-false}" != "true" && -z "${EXPLICIT_AS:-}" && "$SEND_MODE" == "true" ]]; then
  echo "Error: send refused for '$TARGET': sender identity could not be verified (reason: ${CALLER_VERIFY_REASON:-unverified_caller})" >&2
  audit_log_caller_decision "$TARGET" "${AS_CLAIMED_IDENTITY:-${MY_ALIAS:-}.${MY_ROLE:-}}" 0 "${CALLER_VERIFY_REASON:-unverified_caller}" "$(sha256_hash "$MESSAGE")" "$HEADER" ""
  exit 1
fi

TASK_ID=""
TASK_SENT_AT=""
TASK_KIND="delegated"
TASK_INTENT_HASH=""
TASK_USER_AUTHORIZED_EXACT=0

if [[ "$NEW_TASK_MODE" == "true" ]]; then
  TASK_ID=$(generate_task_id)
  if [[ "$USER_AUTHORIZED_EXACT" == "true" ]]; then
    TASK_USER_AUTHORIZED_EXACT=1
    TASK_INTENT_HASH="$(sha256_hash "$MESSAGE")"
  fi
  if [[ "$ROLE_HANDOFF_MODE" == "true" ]]; then
    TASK_KIND="role_handoff"
    # R2 Stage 1 — fail-closed gate. A --role-handoff send from a caller
    # whose --as claim could not be bound to the live model-role-router
    # registry is refused outright: no tmux send-keys, no messages.db row
    # beyond the reject audit entry below. This is the primary fix for
    # the unauthenticated sender-spoofing incidents (2026-07).
    _rh_payload_sha=$(sha256_hash "$MESSAGE")
    if [[ "${AS_CALLER_VERIFIED:-false}" != "true" ]]; then
      echo "Error: --role-handoff refused for '$TARGET': sender identity could not be verified against the model-role-router registry (reason: ${CALLER_VERIFY_REASON:-unverified_caller})" >&2
      audit_log_caller_decision "$TARGET" "${AS_CLAIMED_IDENTITY:-${MY_ALIAS}.${MY_ROLE}}" 0 "${CALLER_VERIFY_REASON:-unverified_caller}" "$_rh_payload_sha" "$HEADER" "$TASK_ID"
      exit 1
    fi
    resolve_role_handoff_metadata
    # Even a verified caller cannot self-declare an epoch/orchestrator the
    # registry disagrees with -- this is the value actually observed by
    # the SessionStart/UserPromptSubmit hooks, not a client-supplied claim.
    if [[ -n "${VERIFIED_ROLE_EPOCH:-}" && "$ROLE_HANDOFF_EPOCH" != "$VERIFIED_ROLE_EPOCH" ]]; then
      echo "Error: --role-handoff refused for '$TARGET': claimed --role-epoch ${ROLE_HANDOFF_EPOCH} does not match registry epoch ${VERIFIED_ROLE_EPOCH} for '${AS_CLAIMED_IDENTITY}'" >&2
      audit_log_caller_decision "$TARGET" "$AS_CLAIMED_IDENTITY" 0 "role_epoch_mismatch" "$_rh_payload_sha" "$HEADER" "$TASK_ID"
      exit 1
    fi
    if [[ -n "${VERIFIED_ORCHESTRATOR_ALIAS:-}" && "$ROLE_HANDOFF_ORCHESTRATOR" != "$VERIFIED_ORCHESTRATOR_ALIAS" ]]; then
      echo "Error: --role-handoff refused for '$TARGET': claimed --orchestrator ${ROLE_HANDOFF_ORCHESTRATOR} does not match registry orchestrator_alias ${VERIFIED_ORCHESTRATOR_ALIAS} for '${AS_CLAIMED_IDENTITY}'" >&2
      audit_log_caller_decision "$TARGET" "$AS_CLAIMED_IDENTITY" 0 "orchestrator_mismatch" "$_rh_payload_sha" "$HEADER" "$TASK_ID"
      exit 1
    fi
    # Gate A (defense-in-depth): the sending process must actually be working
    # inside the registry's recorded project tree. A cross-project conversation
    # that borrowed another agent's registry identity (2026-07 incident) passes
    # every check above, but its cwd is not under the victim's project. Boundary
    # match ("$proj" or "$proj"/*) avoids /foo/bar spoofing /foo/barbaz. Legacy
    # registry entries without .project skip this gate (backward compatible).
    if [[ -n "${VERIFIED_REG_PROJECT:-}" ]]; then
      _rh_cwd="$PWD"
      # Strip ALL trailing slashes so a recorded "/foo/bar/" (or "/foo/bar///")
      # matches a legitimate child cwd "/foo/bar/sub". A project that reduces to
      # the empty string was the filesystem root ("/" or only slashes): any
      # absolute cwd is within root, so admit it without the prefix comparison
      # (which would otherwise become "//*" and reject "/tmp").
      _rh_proj="$VERIFIED_REG_PROJECT"
      while [[ "$_rh_proj" == */ ]]; do _rh_proj="${_rh_proj%/}"; done
      _rh_in_project=false
      if [[ -z "$_rh_proj" ]]; then
        [[ "$_rh_cwd" == /* ]] && _rh_in_project=true
      elif [[ "$_rh_cwd" == "$_rh_proj" || "$_rh_cwd" == "$_rh_proj"/* ]]; then
        _rh_in_project=true
      fi
      if [[ "$_rh_in_project" != true ]]; then
        echo "Error: --role-handoff refused for '$TARGET': sender cwd ${_rh_cwd} is not within registry project ${VERIFIED_REG_PROJECT} for '${AS_CLAIMED_IDENTITY}'" >&2
        audit_log_caller_decision "$TARGET" "$AS_CLAIMED_IDENTITY" 0 "cwd_project_mismatch" "$_rh_payload_sha" "$HEADER" "$TASK_ID"
        exit 1
      fi
    fi
    # Gate B (defense-in-depth): when the router-driven auto_handoff call supplies
    # the caller turn's session id, require it to be a USABLE value that matches
    # the registry's recorded session_id. The router writes "unknown" when the
    # payload carries no session id, so "unknown" (and empty) are unusable and
    # must not pass as a match -- an "unknown"==="unknown" coincidence would
    # otherwise wave the gate through. An unset or empty env var is treated as
    # "not supplied" and skips the gate (manual sends, backward compatible).
    #
    # Scope limit: this only catches an auto_handoff that accidentally fires
    # across threads. It is NOT an authorization boundary against a same-process
    # malicious caller -- the env var is caller-suppliable and the registry is
    # world-readable, so a determined local caller can satisfy it. Closing that
    # requires a per-turn origin seam upstream (which does not exist yet).
    if [[ -n "${TPROJ_MSG_CALLER_SESSION_ID:-}" ]]; then
      _rh_env_sid="$TPROJ_MSG_CALLER_SESSION_ID"
      _rh_reg_sid="${VERIFIED_REG_SESSION_ID:-}"
      if [[ "$_rh_env_sid" == "unknown" || -z "$_rh_reg_sid" || "$_rh_reg_sid" == "unknown" \
            || "$_rh_env_sid" != "$_rh_reg_sid" ]]; then
        echo "Error: --role-handoff refused for '$TARGET': caller session '${_rh_env_sid}' is not a usable match for registry session_id '${_rh_reg_sid}' for '${AS_CLAIMED_IDENTITY}'" >&2
        audit_log_caller_decision "$TARGET" "$AS_CLAIMED_IDENTITY" 0 "session_id_mismatch" "$_rh_payload_sha" "$HEADER" "$TASK_ID"
        exit 1
      fi
    fi
    _delegated_auth_lines=""
    if [[ "$TASK_USER_AUTHORIZED_EXACT" == 1 ]]; then
      _delegated_auth_lines=$'\n'"Intent-Hash: ${TASK_INTENT_HASH}"$'\n'"Delegated-User-Authorization: exact"
    fi
    MESSAGE="[Role-Handoff: ${TASK_ID}]
Role-Epoch: ${ROLE_HANDOFF_EPOCH}
Orchestrator: ${ROLE_HANDOFF_ORCHESTRATOR}${_delegated_auth_lines}
[Task: ${TASK_ID}] ${MESSAGE}"
    audit_log_caller_decision "$TARGET" "$AS_CLAIMED_IDENTITY" 1 "" "$_rh_payload_sha" "$HEADER" "$TASK_ID"
  fi
  if [[ "$ROLE_HANDOFF_MODE" != "true" ]]; then
    if [[ -n "${EXPLICIT_AS:-}" ]]; then
      MESSAGE="[Task: ${TASK_ID}] ${MESSAGE}"
      audit_log_caller_decision "$TARGET" "$AS_CLAIMED_IDENTITY" 1 "" "$(sha256_hash "$MESSAGE")" "$HEADER" ""
    else
      # Non-explicit-as verified new-task (pane-derived / cwd): exactly one accept
      # audit too. No [Task:] prepend -- that is an --as-only convention.
      audit_log_caller_decision "$TARGET" "${AS_CLAIMED_IDENTITY:-${MY_ALIAS:+${MY_ALIAS}.}${MY_ROLE}}" 1 "" "$(sha256_hash "$MESSAGE")" "$HEADER" ""
    fi
  fi
  if declare -F tt_db_upsert_task >/dev/null 2>&1 && [[ -n "${SESSION:-}" && -n "${MY_ALIAS:-}" ]]; then
    tt_db_upsert_task "$TASK_ID" "$TARGET" "$(date +%s)" "$TTL_SEC" "" "$MY_ALIAS" "$SESSION" "$TASK_KIND" "$TASK_INTENT_HASH" "$TASK_USER_AUTHORIZED_EXACT" "${ROLE_HANDOFF_EPOCH:-}" "${ROLE_HANDOFF_ORCHESTRATOR:-}" >/dev/null 2>&1 || true
  fi
elif [[ -n "${EXPLICIT_AS:-}" ]]; then
  audit_log_caller_decision "$TARGET" "$AS_CLAIMED_IDENTITY" 1 "" "$(sha256_hash "$MESSAGE")" "$HEADER" ""
else
  # Non-explicit-as verified ordinary send (in-tmux pane-derived / cwd): exactly
  # one accept audit so every send leaves a single caller-audit row.
  audit_log_caller_decision "$TARGET" "${AS_CLAIMED_IDENTITY:-${MY_ALIAS:+${MY_ALIAS}.}${MY_ROLE}}" 1 "" "$(sha256_hash "$MESSAGE")" "$HEADER" ""
fi

if fanout_guard_check "$TARGET" "$MESSAGE"; then
  :
else
  fanout_rc=$?
  exit "$fanout_rc"
fi

if control_dedup_check "$TARGET" "$MESSAGE"; then
  :
else
  rc=$?
  [[ $rc -eq 12 ]] && exit 12
  echo "Error: control dedup check failed (rc=$rc)" >&2
  exit "$rc"
fi

if suppressed_state=$(delegated_message_tombstone_state "$TARGET" "$MESSAGE" 2>/dev/null); then
  suppressed_task="$(task_id_from_message "$MESSAGE" 2>/dev/null || true)"
  echo "Error: suppressed ${suppressed_state} task message ${suppressed_task:-unknown} for $TARGET" >&2
  exit 1
fi

# === --force: bypass typing/running, but never press selection screens ===
if [[ "$FORCE_MODE" == "true" ]]; then
  # Safety exception: ClawGate reverse delivery uses --force, and sending text
  # into a permission/choice menu can approve the wrong action. Return a clear
  # non-zero status so the caller can fall back instead of silently dropping.
  if detect_selection_screen "$TARGET_PANE"; then
    echo "Error: target '$TARGET' is showing a selection screen; --force delivery deferred to avoid accidental approval." >&2
    echo "Detail: source=${SELECTION_SCREEN_SOURCE} reason=${SELECTION_SCREEN_REASON}" >&2
    echo "Hint: retry after the menu is resolved, or use caller-side fallback handling." >&2
    exit "$SELECTION_BLOCK_EXIT"
  fi
  resolve_prompt_state "$TARGET_PANE"
  if [[ "$PROMPT_RESOLVED_STATE" == "typing" ]]; then
    echo "Warning: target '$TARGET' has unsent input (session_typing_busy); proceeding due to --force" >&2
    echo "Detail: source=${PROMPT_RESOLVED_SOURCE} reason=${PROMPT_RESOLVED_REASON}" >&2
    [[ -n "$PROMPT_RESOLVED_SNIPPET" ]] && echo "Detail: draft='${PROMPT_RESOLVED_SNIPPET}'" >&2
  else
    # Surface a draft that the (possibly stale) prompt-state resolution missed,
    # so an operator forcing delivery still sees they are overwriting input.
    # --force always proceeds; this only adds the warning, never blocks.
    measure_input_line_draft "$TARGET_PANE"
    if [[ "$INPUT_DRAFT_RESULT" == "draft" ]]; then
      echo "Warning: target '$TARGET' has unsent input (input_line_capture:draft_detected); proceeding due to --force" >&2
      [[ -n "$INPUT_DRAFT_SNIPPET" ]] && echo "Detail: draft='${INPUT_DRAFT_SNIPPET}'" >&2
    fi
  fi
  if raw_send; then
    fanout_guard_mark "$TARGET" "$MESSAGE" || true
    control_dedup_mark "$TARGET" "$MESSAGE" || true
    exit 0
  else
    exit 1
  fi
fi

# === --fire: send unless a concrete sendability block is detected ===
if [[ "$FIRE_MODE" == "true" ]]; then
  send_block_reason "$TARGET_PANE"
  if [[ "$SEND_BLOCK_REASON" != "none" ]]; then
    if [[ "$ALLOW_RELAY" == "true" ]] && is_relay_like_message "$MESSAGE"; then
      echo "Error: relay override cannot enqueue when target is blocked (${SEND_BLOCK_REASON})" >&2
      echo "Hint: retry with --force if immediate delivery is intended." >&2
      exit "$RELAY_BLOCK_EXIT"
    fi
    enqueue "$TARGET" "$HEADER" "$MESSAGE"
    fanout_guard_mark "$TARGET" "$MESSAGE" || true
    control_dedup_mark "$TARGET" "$MESSAGE" || true
    echo "Queued for $TARGET (target blocked: ${SEND_BLOCK_REASON})" >&2
    echo "Detail: source=${SEND_BLOCK_SOURCE} reason=${SEND_BLOCK_DETAIL}" >&2
    exit 0
  fi
  ensure_queue_dir
  # Auto-flush queued messages first (max AUTO_FLUSH_MAX)
  if [[ -f "${QUEUE_DIR}/${TARGET}.queue" ]]; then
    echo "Delivering queued messages first (max $AUTO_FLUSH_MAX)..." >&2
    flush_queue "$TARGET" "$TARGET_PANE" "$AUTO_FLUSH_MAX"
  fi
  if raw_send; then
    fanout_guard_mark "$TARGET" "$MESSAGE" || true
    control_dedup_mark "$TARGET" "$MESSAGE" || true
    exit 0
  else
    exit 1
  fi
fi

# === Normal mode: concrete block -> queue, otherwise send ===
send_block_reason "$TARGET_PANE"
if [[ "$SEND_BLOCK_REASON" == "none" ]]; then
  # Auto-flush queued messages first (max AUTO_FLUSH_MAX)
  ensure_queue_dir
  if [[ -f "${QUEUE_DIR}/${TARGET}.queue" ]]; then
    echo "Delivering queued messages first (max $AUTO_FLUSH_MAX)..." >&2
    flush_queue "$TARGET" "$TARGET_PANE" "$AUTO_FLUSH_MAX"
  fi
  if raw_send; then
    fanout_guard_mark "$TARGET" "$MESSAGE" || true
    control_dedup_mark "$TARGET" "$MESSAGE" || true
  else
    exit 1
  fi
else
  case "$SEND_BLOCK_REASON" in
    typing_draft)
      echo "Info: target '$TARGET' has unsent input (session_typing_busy); queueing instead of immediate send." >&2
      echo "Detail: source=${SEND_BLOCK_SOURCE} reason=${SEND_BLOCK_DETAIL}" >&2
      ;;
    selection_screen)
      echo "Info: target '$TARGET' is showing a selection screen; queueing instead of immediate send." >&2
      echo "Detail: source=${SEND_BLOCK_SOURCE} reason=${SEND_BLOCK_DETAIL}" >&2
      ;;
  esac

  # Keep override one-shot semantics strict: relay-like override cannot fall back to queue.
  if [[ "$ALLOW_RELAY" == "true" ]] && is_relay_like_message "$MESSAGE"; then
    echo "Error: relay override cannot enqueue when target is blocked (${SEND_BLOCK_REASON})" >&2
    echo "Hint: retry with --fire or --force if immediate delivery is intended." >&2
    exit "$RELAY_BLOCK_EXIT"
  fi
  enqueue "$TARGET" "$HEADER" "$MESSAGE"
  fanout_guard_mark "$TARGET" "$MESSAGE" || true
  control_dedup_mark "$TARGET" "$MESSAGE" || true
  echo "Queued for $TARGET (target blocked: ${SEND_BLOCK_REASON})" >&2
fi

exit 0
}

do_send_gate() {
  if [[ "$READ_MODE" == "true" ]]; then
    echo "Error: --read is not supported for gate targets" >&2
    exit 1
  fi

  sender_label=""
  gate_msg=""
  gate_adpt=""
  gate_hint=""
  sender_label=$(gate_sender_label)
  # Structured header includes reply lane hint + workspace for reverse routing.
  reply_url=$(gate_reply_callback_url)
  if [[ "$IS_WORKSPACE" == "true" && -n "$MY_ALIAS" && "$MY_ALIAS" != "null" ]]; then
    HEADER="[tproj-msg:sender=${sender_label},project=${MY_ALIAS},workspace=${SESSION},reply=session"
    [[ -n "$reply_url" ]] && HEADER+=",return_url=${reply_url}"
    HEADER+="]"
  else
    HEADER="[tproj-msg:sender=${sender_label},reply=session"
    [[ -n "$reply_url" ]] && HEADER+=",return_url=${reply_url}"
    HEADER+="]"
  fi

  if control_dedup_check "$TARGET" "$MESSAGE"; then
    :
  else
    rc=$?
    [[ $rc -eq 12 ]] && exit 12
    echo "Error: control dedup check failed (rc=$rc)" >&2
    exit "$rc"
  fi

  gate_adpt=$(gate_adapter "$TARGET")
  gate_hint="${MY_ALIAS:-tproj}"
  if [[ "$gate_adpt" == "tmux" ]]; then
    gate_hint=$(gate_session_target)
  fi
  # Reverse-channel routing depends on exactly one current header. If a caller
  # supplies an old [tproj-msg:...] prefix, replace it instead of nesting it.
  gate_msg=$(gate_prepend_header_once "$HEADER" "$MESSAGE")

  # Explicit private lane:
  #   [line-private] ...  -> LINE only, no session share wording in payload.
  if is_line_private_message "$MESSAGE"; then
    private_body=""
    private_body=$(strip_line_private_tag "$MESSAGE")
    private_body=$(trim_spaces "$private_body")
    if [[ -z "$private_body" ]]; then
      echo "Error: [line-private] requires non-empty message body" >&2
      exit 1
    fi
    gate_adpt="line"
    gate_hint="${MY_ALIAS:-tproj}"
    gate_msg=$(format_line_private_notice "$sender_label" "$private_body")
  fi

  # Gate cross-adapter dedup check
  if ! gate_dedup_check "$gate_adpt" "$MESSAGE"; then
    exit 1
  fi

  if [[ "$gate_adpt" == "tmux" ]]; then
    tmux_err=""
    tmux_err=$(send_via_gate "$gate_adpt" "$gate_msg" "$gate_hint" 2>&1) || {
      if echo "$tmux_err" | grep -q "session_busy"; then
        echo "Info: gate:tmux session_busy -> auto-fallback to gate:direct" >&2
        if send_via_gate "direct" "$gate_msg" "$gate_hint"; then
          gate_dedup_mark "direct" "$MESSAGE"
          control_dedup_mark "$TARGET" "$MESSAGE" || true
          exit 0
        fi
        echo "Error: gate:direct fallback also failed." >&2
        exit 1
      fi
      echo "$tmux_err" >&2
      echo "Error: gate:tmux failed. Use 'gate:direct' to bypass tmux." >&2
      exit 1
    }
    echo "$tmux_err" >&2
    gate_dedup_mark "$gate_adpt" "$MESSAGE"
    control_dedup_mark "$TARGET" "$MESSAGE" || true
    exit 0
  fi
  if send_via_gate "$gate_adpt" "$gate_msg" "$gate_hint"; then
    gate_dedup_mark "$gate_adpt" "$MESSAGE"
    control_dedup_mark "$TARGET" "$MESSAGE" || true
    exit 0
  fi
  exit $?
}

# === --list mode ===
if [[ "$LIST_MODE" == "true" ]]; then
  echo "Available targets ($SESSION):"
  echo ""

  if [[ "$IS_WORKSPACE" == "true" ]]; then
    tmux list-panes -t "=$SESSION:dev" -F '#{pane_id}:#{@role}:#{@alias}:#{@column}:#{pane_dead}' 2>/dev/null | \
    while IFS=: read -r pane_id role pane_alias col pane_dead; do
      [[ "$pane_dead" == "1" ]] && continue
      [[ -z "$role" || "$role" == "null" ]] && continue
      short=$(role_to_short "$role")
      case "$role" in yazi|yazi-p*) continue ;; esac
      [[ -z "$pane_alias" || "$pane_alias" == "null" ]] && pane_alias="col${col}"
      printf "  %-20s  %s (col %s)\n" "${pane_alias}.${short}" "$role" "$col"
    done
  else
    tmux list-panes -t "=$SESSION:dev" -F '#{pane_id}:#{@role}:#{@alias}:#{pane_dead}' 2>/dev/null | \
    while IFS=: read -r pane_id role pane_alias pane_dead; do
      [[ "$pane_dead" == "1" ]] && continue
      [[ -z "$role" || "$role" == "null" ]] && continue
      short=$(role_to_short "$role")
      case "$role" in yazi|yazi-p*) continue ;; esac
      printf "  %-20s  %s\n" "$short" "$role"
    done
  fi

  # Show gate targets
  gstatus=$(gate_health)
  default_adapter=$(gate_default_adapter)
  gurl=$(gate_bridge_url)
  echo ""
  printf "  %-20s  bridge (session-first/tmux, %s)\n" "gate" "$gstatus"
  printf "  %-20s  bridge (legacy direct lane)\n" "gate:direct"
  printf "  %-20s  bridge (LINE explicit lane)\n" "gate:line"
  printf "  %-20s  bridge default adapter: %s\n" "gate:default" "$default_adapter"
  printf "  %-20s  bridge session target: %s\n" "gate:session" "$(gate_session_target)"
  printf "  %-20s  %s\n" "" "$gurl"

  exit 0
fi

# === --flush mode (no target needed) ===
if [[ "$FLUSH_MODE" == "true" ]]; then
  flush_all_queues
  exit 0
fi

# === --status mode (target optional) ===
# C3 (P0-2): self's inbox-monitor liveness, derived from the monitor_cursors row
# for this session+alias (the C1 role-independent key). Additive only: it prints
# one extra line and never alters the existing status rows. Fail-open when the DB
# layer, the DB file, or the cursor row is absent.
print_monitor_diagnostic() {
  declare -F tt_db_exec_safe >/dev/null 2>&1 && declare -F tt_db_quote >/dev/null 2>&1 \
    && declare -F tt_db_path >/dev/null 2>&1 || return 0
  [[ -n "${MY_ALIAS:-}" ]] || return 0
  local db threshold key row age last_dt
  db=$(tt_db_path)
  [[ -f "$db" ]] || return 0
  key=$(tt_db_quote "${SESSION}:${MY_ALIAS}")
  threshold="${TPROJ_MONITOR_STALE_SEC:-300}"
  row=$(tt_db_exec_safe "SELECT (strftime('%s','now') - updated_at) || '|' || datetime(updated_at,'unixepoch','localtime') FROM monitor_cursors WHERE consumer='${key}';" 2>/dev/null)
  if [[ -z "$row" ]]; then
    printf "%-20s  monitor: not running\n" ""
    return 0
  fi
  age="${row%%|*}"
  last_dt="${row#*|}"
  if [[ "$age" =~ ^-?[0-9]+$ ]] && (( age > threshold )); then
    printf "%-20s  monitor: stale (last %s)\n" "" "$last_dt"
  else
    printf "%-20s  monitor: ok (last %s)\n" "" "$last_dt"
  fi
}

if [[ "$STATUS_MODE" == "true" ]]; then
  dlog "status: target=${TARGET:-<none>} session=${SESSION:-?}"
  if [[ -n "$TARGET" ]]; then
    # Gate target: show bridge health instead of pane status
    if is_gate_target "$TARGET"; then
      gstatus=$(gate_health)
      printf "%-20s  %s\n" "$TARGET" "$gstatus"
      print_monitor_diagnostic
      exit 0
    fi
    TARGET_PANE=$(resolve_target "$TARGET")
    if [[ -z "$TARGET_PANE" ]]; then
      echo "Error: target '$TARGET' not found" >&2
      exit 1
    fi
    local_live=$(get_liveness_status "$TARGET_PANE")
    local_status=$(get_idle_status "$TARGET_PANE")
    local_detail_reason=$(send_block_detail_for_status "$TARGET_PANE")
    local_qcount=$(queue_count "$TARGET")
    printf "%-20s  %s/%s  (queued: %s)\n" "$TARGET" "$local_live" "$local_status" "$local_qcount"
    printf "%-20s  detail: %s\n" "" "$local_detail_reason"
    print_monitor_diagnostic
  else
    if [[ "$IS_WORKSPACE" == "true" ]]; then
      tmux list-panes -t "=$SESSION:dev" -F '#{pane_id}:#{@role}:#{@alias}:#{@column}:#{pane_dead}' 2>/dev/null | \
      while IFS=: read -r pane_id role pane_alias col pane_dead; do
        [[ "$pane_dead" == "1" ]] && continue
        [[ -z "$role" || "$role" == "null" ]] && continue
        short=$(role_to_short "$role")
        case "$role" in yazi|yazi-p*) continue ;; esac
        [[ -z "$pane_alias" || "$pane_alias" == "null" ]] && pane_alias="col${col}"
        tname="${pane_alias}.${short}"
        local_live=$(get_liveness_status "$pane_id")
        local_status=$(get_idle_status "$pane_id")
        local_qcount=$(queue_count "$tname")
        printf "%-20s  %s/%s  (queued: %s)\n" "$tname" "$local_live" "$local_status" "$local_qcount"
      done
    else
      tmux list-panes -t "=$SESSION:dev" -F '#{pane_id}:#{@role}:#{@alias}:#{pane_dead}' 2>/dev/null | \
      while IFS=: read -r pane_id role pane_alias pane_dead; do
        [[ "$pane_dead" == "1" ]] && continue
        [[ -z "$role" || "$role" == "null" ]] && continue
        short=$(role_to_short "$role")
        case "$role" in yazi|yazi-p*) continue ;; esac
        local_live=$(get_liveness_status "$pane_id")
        local_status=$(get_idle_status "$pane_id")
        local_qcount=$(queue_count "$short")
        printf "%-20s  %s/%s  (queued: %s)\n" "$short" "$local_live" "$local_status" "$local_qcount"
      done
    fi
    # Append gate status
    gstatus=$(gate_health)
    printf "%-20s  %s\n" "gate" "$gstatus"
    print_monitor_diagnostic
  fi
  exit 0
fi

# True (rc 0) if TARGET names the Desktop data-plane mailbox (desktop / desktop.<project>).
is_desktop_target() {
  case "$1" in
    desktop|desktop.*) return 0 ;;
    *) return 1 ;;
  esac
}

# In-tmux session side of the Desktop mailbox. Never resolves a pane, never
# send-keys. `--read desktop[.x]` reads what Desktop sent to this pane; a send to
# `desktop[.x]` writes into the desktop's own mailbox. ALWAYS exits.
do_desktop_session_side() {
  if ! declare -F desktop_mailbox_dir >/dev/null 2>&1; then
    echo "Error: Desktop mailbox helper (tproj-msg-desktop.sh) not available" >&2
    exit 1
  fi
  local _self _proj _rc=0 _mbdir
  _self="${MY_ALIAS:+${MY_ALIAS}.}${MY_ROLE}"

  # --- read: messages Desktop sent to me (to-session mailbox) ---
  if [[ "$READ_MODE" == "true" ]]; then
    desktop_mailbox_read "$(desktop_mailbox_dir to-session "$SESSION" "$_self")"
    exit 0
  fi

  # --- drain: explicit ack-all of this pane's own inbox (reclaims a full box) ---
  if [[ "$DRAIN_MODE" == "true" ]]; then
    local _n _drc=0
    _n=$(desktop_mailbox_drain "$(desktop_mailbox_dir to-session "$SESSION" "$_self")") || _drc=$?
    if [[ "$_drc" == "$TPROJ_DESKTOP_MAILBOX_BUSY_RC" ]]; then
      # Lock contended/stale: the drain never entered the critical section, so
      # NO envelope was removed. Fail closed rather than delete unserialized.
      echo "Error: Desktop mailbox is busy (reason: desktop_mailbox_busy); could not acquire mailbox lock to drain" >&2
      exit "$TPROJ_DESKTOP_MAILBOX_BUSY_RC"
    fi
    echo "Drained ${_n} message(s) from Desktop mailbox for $_self" >&2
    exit 0
  fi

  # Task tracking cannot cross the mailbox boundary (Desktop cannot ACK/handoff).
  if [[ "$NEW_TASK_MODE" == "true" || "$ROLE_HANDOFF_MODE" == "true" ]]; then
    echo "Error: --new-task / --role-handoff are not supported for Desktop mailbox targets" >&2
    exit 1
  fi

  # Fail-closed: the sending pane's identity must be verified (same rule the
  # pane send path enforces). No mailbox write on an unverified sender.
  if [[ "${AS_CALLER_VERIFIED:-false}" != "true" ]]; then
    echo "Error: send to '$TARGET' refused: sender identity could not be verified (reason: ${CALLER_VERIFY_REASON:-unverified_caller})" >&2
    AUTH_PATH="desktop-rejected"
    audit_log_caller_decision "$TARGET" "$_self" 0 "${CALLER_VERIFY_REASON:-unverified_caller}" "$(sha256_hash "$MESSAGE")" "" ""
    exit 1
  fi
  if [[ -z "${MESSAGE//[[:space:]]/}" ]]; then
    echo "Error: refusing to send empty / whitespace-only message" >&2
    exit "$EMPTY_BODY_EXIT"
  fi

  case "$TARGET" in
    desktop)   _proj="${MY_ALIAS:-unknown}" ;;
    desktop.*) _proj="${TARGET#desktop.}" ;;
  esac
  _mbdir=$(desktop_mailbox_dir to-desktop "$_proj")
  desktop_mailbox_write "$_mbdir" "$_self" "$TARGET" "$MESSAGE" || _rc=$?
  case "$_rc" in
    0) : ;;
    1) echo "Error: message exceeds mailbox size limit (${TPROJ_DESKTOP_MAILBOX_MAX_BYTES} bytes)" >&2; exit 1 ;;
    2) echo "Error: Desktop mailbox for $TARGET is full (${TPROJ_DESKTOP_MAILBOX_MAX_COUNT} messages); recipient must drain it (tproj-msg --desktop --drain)" >&2; exit 1 ;;
    "$TPROJ_DESKTOP_MAILBOX_BUSY_RC")
      # Lock contended/stale: the write never entered the critical section, so
      # NO envelope was created. Fail closed rather than write unserialized.
      echo "Error: Desktop mailbox for $TARGET is busy (reason: desktop_mailbox_busy); could not acquire mailbox lock" >&2
      AUTH_PATH="desktop-rejected"
      audit_log_caller_decision "$TARGET" "$_self" 0 "desktop_mailbox_busy" "$(sha256_hash "$MESSAGE")" "" ""
      exit "$TPROJ_DESKTOP_MAILBOX_BUSY_RC" ;;
    *) echo "Error: failed to write Desktop mailbox for $TARGET" >&2; exit 1 ;;
  esac
  AUTH_PATH="desktop-mailbox"
  audit_log_caller_decision "$TARGET" "$_self" 1 "" \
    "$(sha256_hash "$MESSAGE")" "[desktop-mailbox]" ""
  echo "Delivered to Desktop mailbox: $_self -> $TARGET" >&2
  exit 0
}

dispatch_mode() {
# === Desktop mailbox target (data-plane only; no pane) ===
if is_desktop_target "$TARGET"; then
  do_desktop_session_side
fi

# === Send policy precheck (send modes only) ===
if [[ "$READ_MODE" != "true" ]]; then
  # D2 (msg-repair): refuse empty / whitespace-only bodies (covers empty --stdin
  # input too). Distinct exit code so callers can tell this from other failures.
  if [[ -z "${MESSAGE//[[:space:]]/}" ]]; then
    echo "Error: refusing to send empty / whitespace-only message" >&2
    exit "$EMPTY_BODY_EXIT"
  fi
  dlog "send precheck: target=${TARGET} force=${FORCE_MODE:-?} fire=${FIRE_MODE:-?} bytes=${#MESSAGE}"
  if enforce_send_policy "$TARGET" "$MESSAGE"; then
    :
  else
    policy_rc=$?
    exit "$policy_rc"
  fi
  # C4 (P0-3): reject ambiguous bare cc/cdx targets in multi-column workspaces.
  if ! check_bare_target_unambiguous "$TARGET"; then
    exit "$AMBIGUOUS_BARE_EXIT"
  fi
  # D2 (msg-repair): short-window duplicate-resend guard for a NEW send command
  # (this precheck never runs on the flush path). Check only here; the store is
  # marked on delivery/enqueue success (raw_send / enqueue) so a send rejected
  # downstream (e.g. fan-out) can't poison a later legitimate send. DEDUP_BODY
  # captures the pre-mutation body so check and mark hash the same string even
  # when --as/--role-handoff later prepend a [Task:]/[Role-Handoff:] header.
  # --force bypasses the check; gate targets use their own gate_dedup.
  DEDUP_BODY="$MESSAGE"
  if [[ "$FORCE_MODE" != "true" ]] && ! is_gate_target "$TARGET"; then
    if ! send_dedup_check "$TARGET" "$DEDUP_BODY"; then
      exit "$DUP_SEND_EXIT"
    fi
  fi
fi

if [[ "$POLICY_DRY_RUN" == "1" || "$POLICY_DRY_RUN" == "true" ]]; then
  echo "Policy dry-run passed for $TARGET" >&2
  exit 0
fi

# === Gate target early-exit (bypasses tmux pane resolution) ===
if is_gate_target "$TARGET"; then
  do_send_gate
fi

# === Resolve target (required for send and read modes) ===
TARGET_PANE=$(resolve_target "$TARGET")
if [[ -z "$TARGET_PANE" ]]; then
  echo "Error: target '$TARGET' not found" >&2
  echo "" >&2
  echo "Available targets:" >&2
  "$0" --list >&2
  exit 1
fi

# === --read mode ===
if [[ "$READ_MODE" == "true" ]]; then
  do_read
fi

do_send_tmux
}

dispatch_mode
