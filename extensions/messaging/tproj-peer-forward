#!/usr/bin/env python3
"""Supervise one fixed SSH reverse Unix forward and its source authority."""

import argparse
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import re
import socketserver
import subprocess
import sys
import threading
import time

SOURCE = Path(__file__).resolve().with_name('tproj-peer-authority')
loader = importlib.machinery.SourceFileLoader('tproj_peer_authority', str(SOURCE))
spec = importlib.util.spec_from_loader(loader.name, loader)
a = importlib.util.module_from_spec(spec)
loader.exec_module(a)

HOST = re.compile(r'^[A-Za-z0-9_.@-]+$')


def ssh_command(host, remote_socket, source_socket):
    if not isinstance(host, str) or not HOST.fullmatch(host) or host.startswith('-'):
        raise a.Refused('invalid fixed SSH host')
    for path in (remote_socket, source_socket):
        if (not isinstance(path, str) or not Path(path).is_absolute() or
                ':' in path or any(ord(char) < 32 for char in path)):
            raise a.Refused('invalid fixed Unix socket path')
    return ['ssh', '-N', '-T', '-o', 'BatchMode=yes', '-o', 'ControlMaster=no',
            '-o', 'ControlPath=none', '-o', 'ClearAllForwardings=yes',
            '-o', 'ExitOnForwardFailure=yes', '-o', 'StrictHostKeyChecking=yes',
            '-o', 'StreamLocalBindMask=0177', '-o', 'StreamLocalBindUnlink=no',
            '-R', f'{remote_socket}:{source_socket}', host]


def live_forward(proc, started):
    if proc.poll() is not None:
        raise a.Refused('SSH forward exited')
    _, actual_start, uid = a.process(proc.pid)
    if actual_start != started or uid != os.getuid():
        raise a.Refused('SSH forward process changed')


def supervise(args):
    source_socket = Path(args.socket)
    parent = source_socket.parent.stat()
    if (not source_socket.is_absolute() or source_socket.exists() or
            parent.st_uid != os.getuid() or parent.st_mode & 0o077):
        raise a.Refused('source socket must be unused under private directory')
    cmd = ssh_command(args.ssh_host, args.remote_socket, args.socket)
    route = {'source_host': args.source_host, 'destination_host': args.destination_host,
             'source_project': args.source_project,
             'destination_project': args.destination_project,
             'owner_session': args.session, 'destination_session': args.destination_session,
             'target': args.target}
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)
    try:
        for _ in range(10):
            if proc.poll() is not None:
                raise a.Refused('SSH forward failed to establish')
            try:
                _, started, uid = a.process(proc.pid)
                if uid == os.getuid():
                    break
            except a.Refused:
                pass
            time.sleep(0.05)
        else:
            raise a.Refused('SSH forward identity unavailable')
        authority = a.Authority(args.registry_root, args.project, args.session,
                                args.target, proc.pid, route=route,
                                outbox_path=args.outbox_db)
        if authority.receiver_start != started:
            raise a.Refused('SSH forward changed during registration')
        with socketserver.ThreadingUnixStreamServer(str(source_socket), a.Handler) as server:
            server.authority = authority
            os.chmod(source_socket, 0o600)
            thread = threading.Thread(target=server.serve_forever, daemon=True)
            thread.start()
            try:
                while True:
                    live_forward(proc, started)
                    time.sleep(0.1)
            finally:
                server.shutdown()
                thread.join(timeout=2)
                source_socket.unlink(missing_ok=True)
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=2)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('socket', 'remote-socket', 'ssh-host', 'registry-root', 'project',
                 'session', 'target', 'outbox-db', 'source-host', 'destination-host',
                 'source-project', 'destination-project', 'destination-session'):
        parser.add_argument('--' + name, required=True)
    args = parser.parse_args()
    try:
        supervise(args)
        return 0
    except (OSError, ValueError) as exc:
        print(f'Error: peer forward {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
