#!/usr/bin/env python3
"""Live, unprivileged Unix-socket transport for host-scoped tproj chat.

The local listener is reached from another Mac only through an operator-run
client-initiated SSH -R Unix-socket forward. It never persists messages.
"""

import argparse
import json
import os
from pathlib import Path
import socket
import socketserver
import subprocess
import sys

MAX_BYTES = 65536


def read_line(sock):
    data = bytearray()
    while len(data) < MAX_BYTES:
        chunk = sock.recv(1)
        if not chunk:
            break
        if chunk == b"\n":
            break
        data.extend(chunk)
    else:
        raise ValueError("message too large")
    return json.loads(data.decode("utf-8"))


def write_line(sock, value):
    sock.sendall(json.dumps(value, ensure_ascii=False).encode("utf-8") + b"\n")


class Handler(socketserver.BaseRequestHandler):
    def handle(self):
        self.request.settimeout(10)
        try:
            request = read_line(self.request)
            if set(request) != {"session", "target", "message"}:
                raise ValueError("invalid request fields")
            if not all(isinstance(request[k], str) for k in request):
                raise ValueError("invalid request types")
            result = subprocess.run(
                [str(Path(__file__).resolve().with_name("tproj-msg")),
                 "--remote-relay-ingress", self.server.server_address,
                 "--session", request["session"],
                 "--stdin", request["target"]],
                input=request["message"], text=True, capture_output=True,
                timeout=20, check=False,
            )
            write_line(self.request, {"ok": result.returncode == 0,
                                      "detail": result.stderr[-2048:]})
        except (ValueError, UnicodeError, OSError, subprocess.TimeoutExpired) as exc:
            write_line(self.request, {"ok": False, "detail": str(exc)})


def serve(socket_path):
    path = Path(socket_path).resolve(strict=False)
    if not path.is_absolute() or path.exists():
        raise ValueError("socket path must be absolute and unused")
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if path.parent.stat().st_mode & 0o077:
        raise ValueError("socket directory must be private (mode 0700)")
    pid_path = Path(str(path) + ".pid")
    if pid_path.exists():
        raise ValueError("stale relay PID record; inspect before removing")
    with socketserver.UnixStreamServer(str(path), Handler) as server:
        os.chmod(path, 0o600)
        fd = os.open(pid_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            with os.fdopen(fd, "w") as record:
                started = subprocess.check_output(
                    ["ps", "-p", str(os.getpid()), "-o", "lstart="], text=True
                ).strip()
                json.dump({"pid": os.getpid(), "started": started,
                           "script": str(Path(__file__).resolve())}, record)
            server.serve_forever(poll_interval=0.2)
        finally:
            pid_path.unlink(missing_ok=True)
            path.unlink(missing_ok=True)


def send(socket_path, session, target):
    message = sys.stdin.read(MAX_BYTES + 1)
    if len(message.encode("utf-8")) > MAX_BYTES:
        raise ValueError("message too large")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(10)
        client.connect(socket_path)
        write_line(client, {"session": session, "target": target, "message": message})
        result = read_line(client)
    if result.get("detail"):
        print(result["detail"], file=sys.stderr, end="")
    return 0 if result.get("ok") is True else 1


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="action", required=True)
    service = sub.add_parser("serve")
    service.add_argument("--socket", required=True)
    client = sub.add_parser("send")
    client.add_argument("--socket", required=True)
    client.add_argument("--session", required=True)
    client.add_argument("--target", required=True)
    args = parser.parse_args()
    try:
        if args.action == "serve":
            serve(args.socket)
            return 0
        return send(args.socket, args.session, args.target)
    except (OSError, ValueError) as exc:
        print(f"Error: remote relay {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
