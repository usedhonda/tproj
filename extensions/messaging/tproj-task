#!/bin/bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd -P)"
# shellcheck source=/dev/null
source "$SELF_DIR/tproj-task-cache.sh"

# Resolve this pane's owner = "<session>/<owner_alias>" so lifecycle actions act
# ONLY on our own column's tracked tasks (cache is owner-scoped, v2). Explicit
# override via TT_CACHE_OWNER (tests / non-tmux); else resolve from tmux.
if [[ -n "${TT_CACHE_OWNER+x}" ]]; then
  OWNER="$TT_CACHE_OWNER"
elif [[ -n "${TMUX_PANE:-}" ]]; then
  # -t "$TMUX_PANE": resolve THIS pane's owner, not the client's focused pane
  # (a bare display-message would let `tproj-task` inspect/close another column's
  # tasks depending on where the user's focus is).
  _own_sess="$(tmux display-message -t "$TMUX_PANE" -p '#S' 2>/dev/null || true)"
  _own_alias="$(tmux display-message -t "$TMUX_PANE" -p '#{@alias}' 2>/dev/null || true)"
  OWNER="${_own_sess}/${_own_alias}"
else
  OWNER=""   # not inside a pane -> unresolved -> fail-closed
fi

show_help() {
  cat <<'EOF'
tproj-task - inspect tracked tproj delegated tasks

Usage:
  tproj-task list
  tproj-task status <id>
  tproj-task cancel <id> <target> <reason-hash>
  tproj-task freeze <id> <target> <reason-hash>
  tproj-task verify <id> <target> <summary> <done-body-hash>
  tproj-task report <id> <target>
  tproj-task gc
  tproj-task --help
EOF
}

find_task() {
  local task_id="$1"
  local target entry
  while IFS= read -r target; do
    [[ -n "$target" ]] || continue
    # tt_cache_get_task returns rc 0 with EMPTY stdout when the id is not in that
    # target (missing != error), so an rc-only check would match the first target
    # spuriously. Require a non-empty entry to count as a hit.
    entry="$(tt_cache_get_task "$OWNER" "$target" "$task_id" 2>/dev/null)"
    if [[ -n "$entry" ]]; then
      printf '%s\t%s\n' "$target" "$entry"
      return 0
    fi
  done < <(tt_cache_list_targets "$OWNER")
  return 1
}

require_owner() {
  tt_cache_valid_owner "$OWNER" || {
    echo "Error: current task owner could not be resolved" >&2
    exit 1
  }
}

require_exact_task() {
  local task_id="$1" expected_target="$2" result target entry
  result="$(find_task "$task_id")" || {
    echo "Error: task '$task_id' not found for current owner" >&2
    return 1
  }
  target="${result%%$'\t'*}"
  entry="${result#*$'\t'}"
  if [[ "$target" != "$expected_target" ]]; then
    echo "Error: task '$task_id' belongs to target '$target', not '$expected_target'" >&2
    return 1
  fi
  printf '%s\n' "$entry"
}

apply_tombstone() {
  local state="$1" task_id="$2" target="$3" reason_hash="$4"
  entry="$(require_exact_task "$task_id" "$target")" || exit 1
  current_state="$(printf '%s' "$entry" | jq -r '.state // ""')"
  if [[ "$current_state" == "$state" ]]; then
    echo "${state} ${task_id} (${target})"
    return 0
  fi
  if [[ "$current_state" == "cancelled" || "$current_state" == "frozen" ]]; then
    echo "Error: task '$task_id' is already tombstoned as '$current_state'" >&2
    exit 1
  fi
  [[ "$reason_hash" =~ ^[A-Za-z0-9._:-]{8,128}$ ]] || {
    echo "Error: invalid reason hash" >&2
    exit 1
  }
  tt_cache_tombstone_task "$OWNER" "$target" "$task_id" "$state" "$reason_hash" >/dev/null
  refreshed="$(require_exact_task "$task_id" "$target")" || exit 1
  [[ "$(printf '%s' "$refreshed" | jq -r '.state // ""')" == "$state" ]] || {
    echo "Error: task '$task_id' was not durably tombstoned" >&2
    exit 1
  }
  echo "${state} ${task_id} (${target})"
}

cmd="${1:-}"
case "$cmd" in
  list)
    tt_cache_list_all "$OWNER"
    ;;
  status)
    [[ $# -eq 2 ]] || { echo "Error: status requires <id>" >&2; exit 1; }
    if ! result="$(find_task "$2")"; then
      echo "Error: task '$2' not found" >&2
      exit 1
    fi
    target="${result%%$'\t'*}"
    entry="${result#*$'\t'}"
    printf 'target=%s\n%s\n' "$target" "$entry"
    ;;
  cancel|freeze)
    [[ $# -eq 4 ]] || { echo "Error: $cmd requires <id> <target> <reason-hash>" >&2; exit 1; }
    require_owner
    tombstone_state="cancelled"
    [[ "$cmd" == freeze ]] && tombstone_state="frozen"
    apply_tombstone "$tombstone_state" "$2" "$3" "$4"
    ;;
  verify)
    [[ $# -eq 5 ]] || { echo "Error: verify requires <id> <target> <summary> <done-body-hash>" >&2; exit 1; }
    require_owner
    task_id="$2"; target="$3"; summary="$4"; done_hash="$5"
    entry="$(require_exact_task "$task_id" "$target")" || exit 1
    [[ "$(printf '%s' "$entry" | jq -r '.state // ""')" == received ]] || {
      echo "Error: task '$task_id' is not awaiting verification" >&2
      exit 1
    }
    [[ "$done_hash" =~ ^[A-Za-z0-9._:-]{8,128}$ ]] || {
      echo "Error: invalid DONE body hash" >&2
      exit 1
    }
    [[ -n "$summary" && ${#summary} -le 240 && "$summary" != *$'\n'* ]] || {
      echo "Error: verification summary must be one non-empty line (max 240 chars)" >&2
      exit 1
    }
    lifecycle="$(tt_db_task_lifecycle "$task_id" "${OWNER%%/*}" "${OWNER##*/}" "$target" 2>/dev/null || true)"
    IFS='|' read -r db_state _msg_id db_done_hash _received _verified _reported <<< "$lifecycle"
    [[ "$db_state" == received && "$db_done_hash" == "$done_hash" ]] || {
      echo "Error: DONE evidence does not match the current owner/target" >&2
      exit 1
    }
    tt_db_record_verification "$task_id" "${OWNER%%/*}" "${OWNER##*/}" "$target" "$summary" "$done_hash"
    lifecycle="$(tt_db_task_lifecycle "$task_id" "${OWNER%%/*}" "${OWNER##*/}" "$target" 2>/dev/null || true)"
    [[ "${lifecycle%%|*}" == verified ]] || {
      echo "Error: verification was not durably recorded" >&2
      exit 1
    }
    tt_cache_transition_state "$OWNER" "$target" "$task_id" verified >/dev/null
    echo "verified $task_id ($target)"
    ;;
  report)
    [[ $# -eq 3 ]] || { echo "Error: report requires <id> <target>" >&2; exit 1; }
    [[ "${TPROJ_PLATFORM_REPORT_OBSERVED:-}" == 1 ]] || {
      echo "Error: report requires a platform-observed COMPLETION-REPORT marker" >&2
      exit 1
    }
    require_owner
    task_id="$2"; target="$3"
    entry="$(require_exact_task "$task_id" "$target")" || exit 1
    [[ "$(printf '%s' "$entry" | jq -r '.state // ""')" == verified ]] || {
      echo "Error: task '$task_id' is not verified" >&2
      exit 1
    }
    tt_db_transition_task "$task_id" user_reported "${OWNER%%/*}" "${OWNER##*/}" "$target"
    lifecycle="$(tt_db_task_lifecycle "$task_id" "${OWNER%%/*}" "${OWNER##*/}" "$target" 2>/dev/null || true)"
    IFS='|' read -r db_state _msg_id _done_hash _received _verified reported_at <<< "$lifecycle"
    [[ "$db_state" == user_reported && -n "$reported_at" ]] || {
      echo "Error: USER_REPORTED was not durably recorded" >&2
      exit 1
    }
    tt_cache_remove_task "$OWNER" "$target" "$task_id" >/dev/null
    echo "reported $task_id ($target)"
    ;;
  close)
    echo "Error: close is retired; a task closes only via platform-observed 'tproj-task report'" >&2
    exit 1
    ;;
  gc)
    tt_cache_gc_expired "$OWNER"
    ;;
  -h|--help|"")
    show_help
    ;;
  *)
    echo "Error: unknown subcommand '$cmd'" >&2
    show_help >&2
    exit 1
    ;;
esac
