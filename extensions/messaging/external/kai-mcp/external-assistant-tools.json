  "tools": [
    {"name":"tproj_list","title":"List authorized tproj participants","description":"List the caller's authorized participant catalog. This is not provider enrollment or proof of message presentation.","annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"inputSchema":{"type":"object","properties":{},"additionalProperties":false},"outputSchema":{"type":"object","required":["participants"],"properties":{"participants":{"type":"array","items":{"type":"object","required":["address"],"properties":{"address":{"type":"string","minLength":1},"kind":{"type":"string"},"available":{"type":"boolean"}},"additionalProperties":false}}},"additionalProperties":false}},
    {"name":"tproj_status","title":"Get authorized tproj participant status","description":"Return status for one full project-qualified target from the authorized catalog; never expose raw process, host, or credential data.","annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"inputSchema":{"type":"object","required":["target"],"properties":{"target":{"type":"string","pattern":"^[^./\\s]+\\.(cc|cdx)$"}},"additionalProperties":false},"outputSchema":{"type":"object","required":["target","available"],"properties":{"target":{"type":"string","minLength":1},"available":{"type":"boolean"},"state":{"type":"string"}},"additionalProperties":false}},
    {"name":"tproj_send","title":"Submit a tproj message","description":"Submit one message to a full target address using a caller-persisted stable submission_id.","annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"inputSchema":{"type":"object","required":["target","body","submission_id"],"properties":{"target":{"type":"string","pattern":"^[^./\\s]+\\.(cc|cdx)$"},"body":{"type":"string","maxLength":65536},"submission_id":{"type":"string","minLength":1,"maxLength":128}},"additionalProperties":false},"outputSchema":{"type":"object","required":["message_id","thread_id","state"],"properties":{"message_id":{"type":"string","minLength":1},"thread_id":{"type":"string","minLength":1},"state":{"type":"string","enum":["accepted","queued","adapter_received","presented","uncertain","stale_session","rejected","expired"]},"duplicate":{"type":"boolean"}},"additionalProperties":false}},
    {"name":"tproj_inbox","title":"Read the authorized tproj inbox","description":"Read a bounded page for the authenticated recipient binding. Reading or enumerating does not acknowledge presentation. Once you have actually read a message addressed to you, call tproj_ack for it so the sender can see it was presented.","annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"inputSchema":{"type":"object","properties":{"cursor":{"type":"integer","minimum":0,"default":0},"limit":{"type":"integer","minimum":1,"maximum":100,"default":100}},"additionalProperties":false},"outputSchema":{"type":"object","required":["messages","next_cursor"],"properties":{"messages":{"type":"array","items":{"type":"object","required":["message_id","thread_id","target","body","state"],"properties":{"message_id":{"type":"string","minLength":1},"thread_id":{"type":"string","minLength":1},"in_reply_to":{"type":"string","minLength":1},"sender_address":{"type":"string"},"target":{"type":"string","minLength":1},"body":{"type":"string"},"state":{"type":"string","enum":["accepted","queued","adapter_received","presented","uncertain","stale_session","rejected","expired"]}},"additionalProperties":false}},"next_cursor":{"type":"integer","minimum":0}},"additionalProperties":false}},
    {"name":"tproj_message","title":"Read one authorized tproj message","description":"Read one message only when the authenticated context is a sender or recipient. If you are the recipient and have read it, call tproj_ack so the sender can see it was presented.","annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"inputSchema":{"type":"object","required":["message_id"],"properties":{"message_id":{"type":"string","minLength":1}},"additionalProperties":false},"outputSchema":{"type":"object","required":["message_id","thread_id","target","body","state"],"properties":{"message_id":{"type":"string","minLength":1},"thread_id":{"type":"string","minLength":1},"in_reply_to":{"type":"string","minLength":1},"sender_address":{"type":"string"},"target":{"type":"string","minLength":1},"body":{"type":"string"},"state":{"type":"string","enum":["accepted","queued","adapter_received","presented","uncertain","stale_session","rejected","expired"]}},"additionalProperties":false}},
    {"name":"tproj_reply","title":"Reply to a pinned tproj message","description":"Reply to the original message_id. The authenticated adapter resolves the original thread and recipient; callers cannot choose a receiver or conversation.","annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"inputSchema":{"type":"object","required":["message_id","body","submission_id"],"properties":{"message_id":{"type":"string","minLength":1},"body":{"type":"string","maxLength":65536},"submission_id":{"type":"string","minLength":1,"maxLength":128}},"additionalProperties":false},"outputSchema":{"type":"object","required":["message_id","thread_id","in_reply_to","state"],"properties":{"message_id":{"type":"string","minLength":1},"thread_id":{"type":"string","minLength":1},"in_reply_to":{"type":"string","minLength":1},"state":{"type":"string","enum":["accepted","queued","adapter_received","presented","uncertain","stale_session","rejected","expired"]},"duplicate":{"type":"boolean"}},"additionalProperties":false}},
    {"name":"tproj_ack","title":"Acknowledge consumed tproj message","description":"Acknowledge presentation only after explicit consumption by the authenticated recipient. Enumeration alone is insufficient.","annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"inputSchema":{"type":"object","required":["message_id"],"properties":{"message_id":{"type":"string","minLength":1}},"additionalProperties":false},"outputSchema":{"type":"object","required":["message_id","state"],"properties":{"message_id":{"type":"string","minLength":1},"state":{"const":"presented"}},"additionalProperties":false}}
  ]
