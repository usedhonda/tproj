    {"name":"tproj_inbox","title":"Read the authorized tproj inbox","description":"Read a bounded page for the authenticated recipient binding. Reading or enumerating does not acknowledge presentation. Once you have actually read a message addressed to you, call tproj_ack for it so the sender can see it was presented.","annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"inputSchema":{"type":"object","properties":{"cursor":{"type":"integer","minimum":0,"default":0},"limit":{"type":"integer","minimum":1,"maximum":100,"default":100}, "metadata_only": {"type": "boolean", "default": false, "description": "Read metadata without body or presentation reservation; safe for detectors and dry runs."}},"additionalProperties":false},"outputSchema":{"type":"object","required":["messages","next_cursor"],"properties":{"messages":{"type":"array","items":{"type":"object","required":["message_id","thread_id","target","body","state"],"properties":{"message_id":{"type":"string","minLength":1},"thread_id":{"type":"string","minLength":1},"in_reply_to":{"type":"string","minLength":1},"sender_address":{"type":"string"},"target":{"type":"string","minLength":1},"body":{"type":"string"},"state":{"type":"string","enum":["accepted","queued","adapter_received","presented","uncertain","stale_session","rejected","expired"]},"external_origin":{"oneOf":[{"type":"object","additionalProperties":false,"required":["version","channel","binding_id","owner_id","bot_id","user_id","chat_id","message_id","update_id","generation","target","kind","mailbox_message_id","body_sha256"],"properties":{"version":{"const":1},"channel":{"const":"telegram"},"binding_id":{"type":"string"},"owner_id":{"type":"string"},"bot_id":{"type":"integer","minimum":1},"user_id":{"type":"integer","minimum":1},"chat_id":{"type":"integer","minimum":1},"message_id":{"type":"integer","minimum":1},"update_id":{"type":"integer","minimum":0},"generation":{"type":"integer","minimum":1},"targ