#!/bin/bash
# memory-guard - System-wide + Claude process memory alerts
# Runs as persistent daemon via launchd (KeepAlive)
# - Checks large individual processes every 3 seconds
# - Checks every 15 seconds for Claude aggregate memory
# No set -e for a daemon that must never exit on transient errors

INTERVAL="${MEMORY_GUARD_INTERVAL:-3}"          # main loop interval (seconds)
AGGREGATE_EVERY="${MEMORY_GUARD_AGG_EVERY:-5}"   # aggregate check every N loops (5*3=15s)

# Dynamic thresholds based on physical memory (env vars override)
TOTAL_PHYS_MB=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 25769803776) / 1024 / 1024 ))
PROC_MAX_MB="${MEMORY_GUARD_PROC_MAX:-$(( TOTAL_PHYS_MB / 4 ))}"    # 25% of RAM (24GB->6GB)
WARN_MB="${MEMORY_GUARD_WARN:-$(( TOTAL_PHYS_MB * 17 / 100 ))}"     # 17% of RAM (24GB->4GB)
CRIT_MB="${MEMORY_GUARD_CRIT:-$(( TOTAL_PHYS_MB / 4 ))}"            # 25% of RAM (24GB->6GB)
LOG="/tmp/memory-guard.log"
HISTORY_FILE="/tmp/memory-guard-history.jsonl"
HISTORY_MAX_LINES=10000
# System processes excluded from individual alerts (matched against short command name)
IMMUNE_PROCS="kernel_task|launchd|WindowServer|loginwindow|opendirectoryd|diskarbitrationd|configd|syslogd|notifyd|distnoted|logd|powerd|coreduetd|mds|mds_stores|Finder|Dock|SystemUIServer|Spotlight"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOG"; }

# Graceful shutdown
trap 'log "Shutting down"; exit 0' SIGTERM SIGINT

log "Started (alert-only, interval=${INTERVAL}s, proc_max=${PROC_MAX_MB}MB, warn=${WARN_MB}MB, crit=${CRIT_MB}MB)"

# --- Helper functions ---

get_claude_pids_rss() {
  ps -eo pid,rss,pcpu,command 2>/dev/null \
    | grep -E '(claude|anthropic)' \
    | grep -v grep \
    | grep -v memory-guard \
    | awk '{print $1, $2, $3}' \
    || true
}

calc_total_mb() {
  local total_kb=0
  while read -r pid rss cpu; do
    [[ -z "$pid" ]] && continue
    total_kb=$(( total_kb + rss ))
  done <<< "$(get_claude_pids_rss)"
  echo $(( total_kb / 1024 ))
}

# --- Snapshot recording for cc-mem history ---
record_snapshot() {
  local event="${1:-}"
  local ts
  ts=$(date -u '+%Y-%m-%dT%H:%M:%S')

  # System free memory
  local page_size
  page_size=$(sysctl -n hw.pagesize 2>/dev/null || echo 16384)
  local vm_out
  vm_out=$(vm_stat 2>/dev/null)
  local free_pages
  free_pages=$(echo "$vm_out" | awk '/Pages free:/ {gsub(/\./,"",$3); print $3}')
  local spec_pages
  spec_pages=$(echo "$vm_out" | awk '/Pages speculative:/ {gsub(/\./,"",$3); print $3}')
  local free_mb=$(( (${free_pages:-0} + ${spec_pages:-0}) * page_size / 1024 / 1024 ))

  # System used memory
  local total_mb=$(( $(sysctl -n hw.memsize 2>/dev/null) / 1024 / 1024 ))
  local sys_used_mb=$(( total_mb - free_mb ))

  # CC aggregate
  local cc_mb
  cc_mb=$(calc_total_mb)
  local cc_count=0
  while read -r snap_pid snap_rss snap_cpu; do
    [[ -z "$snap_pid" ]] && continue
    cc_count=$(( cc_count + 1 ))
  done <<< "$(get_claude_pids_rss)"

  # MCP servers
  local mcp_kb=0
  while IFS= read -r line; do
    local rss
    rss=$(echo "$line" | awk '{print $2}')
    [[ -z "$rss" ]] && continue
    mcp_kb=$(( mcp_kb + rss ))
  done < <(ps -eo pid,rss,comm 2>/dev/null | grep -iE '(mcp|context7|playwright-server|chrome-ai-bridge)' | grep -v grep)
  local mcp_mb=$(( mcp_kb / 1024 ))

  # Chrome
  local chrome_kb=0
  while IFS= read -r line; do
    local rss
    rss=$(echo "$line" | awk '{print $2}')
    [[ -z "$rss" ]] && continue
    chrome_kb=$(( chrome_kb + rss ))
  done < <(ps -eo pid,rss,comm 2>/dev/null | grep -iE '(google chrome|chrome helper)' | grep -v grep)
  local chrome_mb=$(( chrome_kb / 1024 ))

  # Top process (highest RSS Claude process)
  local top_name="" top_rss_mb=0 top_pid=0
  while read -r snap_pid snap_rss snap_cpu; do
    [[ -z "$snap_pid" ]] && continue
    local snap_rss_mb=$(( snap_rss / 1024 ))
    if [[ "$snap_rss_mb" -gt "$top_rss_mb" ]]; then
      top_rss_mb=$snap_rss_mb
      top_pid=$snap_pid
      top_name=$(ps -o comm= -p "$snap_pid" 2>/dev/null | sed 's|.*/||' || echo "unknown")
    fi
  done <<< "$(get_claude_pids_rss)"

  # Build JSON line
  local json="{\"ts\":\"$ts\",\"free_mb\":$free_mb,\"sys_used_mb\":$sys_used_mb,\"cc_mb\":$cc_mb,\"cc_count\":$cc_count,\"mcp_mb\":$mcp_mb,\"chrome_mb\":$chrome_mb,\"top_name\":\"$top_name\",\"top_rss_mb\":$top_rss_mb,\"top_pid\":$top_pid"
  if [[ -n "$event" ]]; then
    json+=",\"event\":\"$event\""
  fi
  json+="}"
  echo "$json" >> "$HISTORY_FILE"

  # Trim if too large
  local lines
  lines=$(wc -l < "$HISTORY_FILE" 2>/dev/null || echo 0)
  if [[ "$lines" -gt "$HISTORY_MAX_LINES" ]]; then
    tail -n $(( HISTORY_MAX_LINES / 2 )) "$HISTORY_FILE" > "${HISTORY_FILE}.tmp"
    mv "${HISTORY_FILE}.tmp" "$HISTORY_FILE"
  fi
}

# Notify once per process while it stays above the threshold.
process_notices=" "

check_large_processes() {
  local current_notices=" "
  while read -r pid rss comm; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    local proc_mb=$(( rss / 1024 ))
    [[ "$proc_mb" -gt "$PROC_MAX_MB" && "$pid" -ne $$ ]] || continue

    local short_name=${comm##*/}
    if [[ "$short_name" =~ ^($IMMUNE_PROCS)$ ]]; then
      continue
    fi

    current_notices+="$pid "
    [[ "$process_notices" == *" $pid "* ]] && continue

    record_snapshot "HIGH_MEMORY: PID $pid ${proc_mb}MB"
    log "HIGH_MEMORY: PID $pid ($short_name) using ${proc_mb}MB (limit: ${PROC_MAX_MB}MB)"
    osascript -e 'on run argv' \
      -e 'display notification (item 1 of argv) with title "tproj Memory Guard" subtitle "High process memory"' \
      -e 'end run' -- "$short_name (PID $pid) is using ${proc_mb}MB" 2>/dev/null || true
  done < <(ps -eo pid,rss,comm 2>/dev/null)
  process_notices=$current_notices
}

# --- Claude aggregate check ---
aggregate_notice_level=0

check_claude_aggregate() {
  local total_mb
  total_mb=$(calc_total_mb)

  if [[ "$total_mb" -le "$WARN_MB" ]]; then
    aggregate_notice_level=0
    return 0
  fi

  # Recheck after 10s to exclude transient spikes
  sleep 10
  local total_mb2
  total_mb2=$(calc_total_mb)

  if [[ "$total_mb2" -le "$WARN_MB" ]]; then
    aggregate_notice_level=0
    return 0
  fi

  # WARNING level
  if [[ "$total_mb2" -le "$CRIT_MB" ]]; then
    log "WARNING: Claude processes using ${total_mb2}MB (threshold: ${WARN_MB}MB)"
    if [[ "$aggregate_notice_level" -lt 1 ]]; then
      osascript -e "display notification \"Claude processes: ${total_mb2}MB / ${WARN_MB}MB warning\" with title \"tproj Memory Guard\" subtitle \"Memory usage elevated\"" 2>/dev/null || true
      aggregate_notice_level=1
    fi
    return 0
  fi

  # CRITICAL level
  log "CRITICAL: Claude processes using ${total_mb2}MB (threshold: ${CRIT_MB}MB)"
  if [[ "$aggregate_notice_level" -lt 2 ]]; then
    osascript -e "display notification \"Claude processes: ${total_mb2}MB\" with title \"tproj Memory Guard\" subtitle \"CRITICAL\"" 2>/dev/null || true
    aggregate_notice_level=2
  fi
}

# --- Main loop ---
# macOS /bin/bash 3.2 leaks memory in long-running loops full of $(...) and
# process substitution: after 12 days this daemon held 1.5GB while the system ran out
# of swap. Exit after MAX_RUNTIME and let launchd KeepAlive start a fresh process.
MAX_RUNTIME_SEC="${MEMORY_GUARD_MAX_RUNTIME_SEC:-3600}"
started_at=$(date +%s)
loop_count=0
while true; do
  if (( $(date +%s) - started_at >= MAX_RUNTIME_SEC )); then
    log "Restarting after ${MAX_RUNTIME_SEC}s to shed bash memory growth"
    exit 0
  fi
  check_large_processes

  # Record history and check Claude aggregate usage periodically.
  loop_count=$(( loop_count + 1 ))
  if [[ $(( loop_count % AGGREGATE_EVERY )) -eq 0 ]]; then
    record_snapshot
    check_claude_aggregate
  fi

  sleep "$INTERVAL"
done
