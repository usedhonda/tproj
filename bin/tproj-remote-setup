#!/usr/bin/env bash
# Explicit remote provisioning; never stop tmux, agent sessions, or a loaded restore job.
set -euo pipefail
if [[ "${1:-}" == add ]]; then shift; fi
if [[ $# -ne 1 || ! "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "usage: tproj-remote-setup [add] SSH_HOST" >&2; exit 2
fi
exec python3 - "$1" "$(cd "$(dirname "$0")/.." && pwd)" <<'PYSETUP'
import io, pathlib, subprocess, sys, tarfile
alias,root=sys.argv[1],pathlib.Path(sys.argv[2])
files={}
for name in ('tproj','tproj-topology','tproj-remote-host','tproj-remote-cache','tproj-msg-runtime'):
    files['bin/'+name]=root/'bin'/name
for name in ('tproj_topology.py','tproj-common.sh','tproj-model-role.sh'):
    files['bin/lib/'+name]=root/'bin/lib'/name
library=root/'extensions/messaging/unified'
if not library.is_dir(): library=root/'lib/tproj-msg-unified'
for name in ('cli.py','host.py','hub.py','identity.py','protocol.py','policy.py','receipt.py','federation.py','directory.py','enrollment.py','runtime.py','terminal-guard.sh','terminal-parser.sh'):
    files['lib/tproj-msg-unified/'+name]=library/name
plist=root/'config/com.tproj.remote-host.plist'
if not plist.exists(): plist=root/'.config/tproj/remote-host.plist'
files['Library/LaunchAgents/com.tproj.remote-host.plist']=plist
for path in files.values():
    if not path.is_file(): raise SystemExit('Missing remote installation artifact: '+str(path))
buf=io.BytesIO()
with tarfile.open(fileobj=buf,mode='w') as archive:
    for dest,source in files.items(): archive.add(source,arcname=dest,recursive=False)
ssh=['ssh','-o','BatchMode=yes','-o','ConnectTimeout=5','-T','--',alias]
check='PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; command -v python3 >/dev/null && command -v tmux >/dev/null'
subprocess.run(ssh+[check],check=True,timeout=12)
subprocess.run(ssh+['umask 077; tar -xf - -C "$HOME"'],input=buf.getvalue(),check=True,timeout=30)
command='''set -e
export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
chmod 755 "$HOME/bin/tproj" "$HOME/bin/tproj-topology" "$HOME/bin/tproj-remote-host" "$HOME/bin/tproj-msg-runtime"
uid=$(id -u)
if ! launchctl print "gui/$uid/com.tproj.remote-host" >/dev/null 2>&1; then
 launchctl bootstrap "gui/$uid" "$HOME/Library/LaunchAgents/com.tproj.remote-host.plist"
fi
"$HOME/bin/tproj-msg-runtime" setup
'''
subprocess.run(ssh+[command],check=True,timeout=30)
print('Remote helpers installed; existing agent sessions were not restarted.')
PYSETUP
