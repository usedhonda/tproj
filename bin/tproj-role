#!/usr/bin/env bash
# Declare how the two agents of a PROJECT work together.
#
#   tproj-role                  show this project's mode
#   tproj-role assist          the side you prompt does the work, the other advises
#   tproj-role solo             the side you prompt works alone
#   tproj-role collab             back to the default, where model tier decides
#
# The mode is per project: its state lives at <project>/.local/role-mode.json, so
# switching one column never touches its neighbours, and every pane of the project
# (including ones opened later) follows it from its next prompt.
# `model-role-router mode` owns the state; this is a front end for it so there is
# only ever one reader of that file.
set -uo pipefail

usage() {
  cat <<'USAGE'
usage: tproj-role [collab|assist|solo] [main cc|cdx|derived] [--project DIR | --all] [--json]
       tproj-role --status-segment

  collab      model tier decides who leads (default)
  assist   the side you prompt leads; the other side advises only
  solo      the side you prompt leads; the other side stays out

  main <side>       hand the conversation main side to cc or cdx (derived clears it)
  --main <side>     same, alongside a mode declaration

  --project DIR     act on that project instead of the current one
  --all             apply the declaration to every project in workspace.yaml
  --json            machine readable state
  --status-segment  short label for the tmux status line, empty under collab

To return a project to collab you can also delete its state file:
  rm <project>/.local/role-mode.json
USAGE
}

router=$(command -v model-role-router 2>/dev/null)
if [ -z "$router" ]; then
  # Reading a mode without the router simply means there is no declared mode, and the
  # two read-only entry points must survive that. The tmux status line calls
  # --status-segment on every refresh, so an installation without the router would
  # otherwise paint an error into the status bar forever, and --help should answer
  # from the script itself. Declaring a mode genuinely needs the router, so that path
  # still reports the problem.
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --status-segment) exit 0 ;;
    --json) echo '{"mode": "collab"}'; exit 0 ;;
  esac
  echo "tproj-role: model-role-router is not on PATH" >&2
  exit 1
fi

declared_by() {
  # Provenance must name the real declarer. When this runs inside a tmux pane that
  # carries agent tags, the declarer is that agent (an agent widening its own
  # permissions must be visible as itself in every injected context line); a plain
  # terminal without agent tags is the human.
  local pane_role pane_alias
  if [ -n "${TMUX_PANE:-}" ]; then
    pane_role=$(tmux display-message -t "$TMUX_PANE" -p '#{@role}' 2>/dev/null)
    pane_alias=$(tmux display-message -t "$TMUX_PANE" -p '#{@alias}' 2>/dev/null)
    case "$pane_role" in
      claude*|cc) [ -n "$pane_alias" ] && { printf '%s.cc' "$pane_alias"; return; } ;;
      codex*|cdx) [ -n "$pane_alias" ] && { printf '%s.cdx' "$pane_alias"; return; } ;;
    esac
  fi
  printf 'user'
}

workspace_projects() {
  # Local project paths from workspace.yaml, one per line. Remote projects are
  # skipped: they have no local .local directory to hold a mode.
  local cfg="$HOME/.config/tproj/workspace.yaml"
  [ -f "$cfg" ] || return 0
  # yq v4: a bare string entry is a local project; a mapping is local unless it says
  # otherwise. Two passes keep the expression simple enough to survive yq's lexer.
  yq -r '.projects[] | select(tag == "!!str")' "$cfg" 2>/dev/null
  yq -r '.projects[] | select(tag == "!!map") | select((.type // "local") == "local") | .path' "$cfg" 2>/dev/null
}

value=""
main_side=""
project=""
all=false
json=false
segment=false
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --status-segment) segment=true ;;
    --json) json=true ;;
    --all) all=true ;;
    --project)
      shift
      project="${1:-}"
      [ -n "$project" ] || { echo "tproj-role: --project needs a directory" >&2; exit 2; }
      ;;
    collab|assist|solo) value="$1" ;;
    --main)
      shift
      main_side="${1:-}"
      case "$main_side" in
        cc|cdx|derived) ;;
        *) echo "tproj-role: --main needs cc, cdx, or derived" >&2; exit 2 ;;
      esac
      ;;
    main)
      # Bare form so the common ask -- "hand the main side to Cdx" -- is one short
      # line to type or to say to an agent: tproj-role main cdx
      shift
      main_side="${1:-}"
      case "$main_side" in
        cc|cdx|derived) ;;
        *) echo "tproj-role: main needs cc, cdx, or derived" >&2; exit 2 ;;
      esac
      ;;
    *)
      echo "tproj-role: unknown argument '$1'" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if $segment; then
  # Nothing is shown under collab, so a project that never declares a mode keeps
  # exactly the status line it had before. tmux runs this format command against the
  # focused pane, so display-message without -t resolving the focused pane is, for
  # once, exactly the right behaviour: the segment describes the project you are
  # looking at.
  seg_project=$(tmux display-message -p '#{@project}' 2>/dev/null)
  seg_json=$("$router" mode --json ${seg_project:+--project "$seg_project"} 2>/dev/null)
  mode=$(printf '%s' "$seg_json" | sed -n 's/.*"mode"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  lead=$(printf '%s' "$seg_json" | sed -n 's/.*"lead"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  if [ -n "$mode" ] && [ "$mode" != collab ]; then
    # The lead answers "which side is main right now", which is the question the
    # segment exists to answer, so it rides along whenever it is known.
    printf ' role:%s%s' "$mode" "${lead:+·$lead}"
  fi
  exit 0
fi

if $all; then
  if [ -z "$value" ] && [ -z "$main_side" ]; then
    echo "tproj-role: --all needs a mode or --main to apply" >&2
    exit 2
  fi
  setter=$(declared_by)
  applied=0
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if "$router" mode $value --project "$path" ${main_side:+--main "$main_side"} --set-by "$setter" --source tproj-role >/dev/null 2>&1; then
      applied=$((applied + 1))
      printf 'role mode: %s [%s]\n' "${value:-$main_side}" "$path"
    else
      printf 'tproj-role: skipped %s\n' "$path" >&2
    fi
  done < <(workspace_projects)
  [ "$applied" -gt 0 ] || { echo "tproj-role: no local projects found in workspace.yaml" >&2; exit 1; }
  exit 0
fi

if [ -n "$value" ] || [ -n "$main_side" ]; then
  # Unquoted $value on purpose: it may be empty when only --main was given, and the
  # router's mode argument is optional.
  setter=$(declared_by)
  if $json; then
    "$router" mode $value ${project:+--project "$project"} ${main_side:+--main "$main_side"} --set-by "$setter" --source tproj-role >/dev/null \
      && "$router" mode --json ${project:+--project "$project"}
    exit $?
  fi
  "$router" mode $value ${project:+--project "$project"} ${main_side:+--main "$main_side"} --set-by "$setter" --source tproj-role
  exit $?
fi

if $json; then
  "$router" mode --json ${project:+--project "$project"}
else
  "$router" mode ${project:+--project "$project"}
fi
