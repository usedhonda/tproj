#!/usr/bin/env python3
"""Serialize startup global npm mutations across local and remote panes."""
import fcntl
import os
import subprocess
import sys


def main():
    if len(sys.argv) not in (2, 3) or sys.argv[1] not in (
        "@openai/codex", "@anthropic-ai/claude-code"
    ):
        raise ValueError("expected agent package and optional signing command")
    # Fixed host-local path: SSH and GUI can have different TMPDIR values.
    # Never unlink: otherwise competing processes could lock different inodes.
    path = f"/tmp/tproj-cli-update-{os.getuid()}.lock"
    fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "r+") as lock:
        if os.fstat(lock.fileno()).st_uid != os.getuid():
            raise ValueError("update lock belongs to another user")
        fcntl.flock(lock, fcntl.LOCK_EX)
        # Children retain the same locked open description if this helper dies
        # while npm or signing is still running (for example, a closed terminal).
        inherited_lock = (lock.fileno(),)
        result = subprocess.run(["npm", "update", "-g", sys.argv[1]],
                                check=False, pass_fds=inherited_lock)
        if len(sys.argv) == 3:
            subprocess.run([sys.argv[2]], check=False, pass_fds=inherited_lock)
        return result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"tproj-cli-update: {error}; using installed agent", file=sys.stderr)
        sys.exit(1)
