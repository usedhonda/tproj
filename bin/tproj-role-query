#!/usr/bin/env python3
"""Bounded, host-local read-only calls to the canonical role router."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


def valid_response(value):
    return (isinstance(value, dict) and value.get('mode') in ('auto', 'collab', 'assist', 'solo')
            and value.get('lead', '') in ('', 'cc', 'cdx')
            and value.get('main', '') in ('', 'cc', 'cdx'))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--project', default=os.getcwd())
    parser.add_argument('--router', default=str(Path.home() / 'bin/model-role-router'))
    parser.add_argument('--display-cache', action='store_true', help='emit last successful display data on failure, still exit nonzero')
    args = parser.parse_args()
    project = os.path.normpath(os.path.expanduser(args.project))
    if not os.path.isabs(project):
        parser.error('project must be absolute')
    # Do not resolve symlinks or access project files here: only the router owns
    # role derivation, and a stalled project volume must not stall this broker.
    key = hashlib.sha256((args.router + '\0' + project).encode()).hexdigest()
    root = Path.home() / '.cache/tproj-role-query'
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (root / (key + '.lock')).open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print('role query already running', file=sys.stderr)
            return 75
        cache = root / (key + '.json')
        saved = {}
        try:
            saved = json.loads(cache.read_text())
            if saved['code'] == 0 and not valid_response(json.loads(saved['stdout'])):
                raise ValueError('invalid cached router response')
            age = time.time() - saved['at']
            ttl = 3 if saved['code'] == 0 else 30
            if 0 <= age < ttl:
                sys.stdout.write(saved['stdout'] if saved['code'] == 0 or not args.display_cache else (saved.get('last_success') or {}).get('stdout', ''))
                sys.stderr.write(saved['stderr'])
                return saved['code']
        except (OSError, ValueError, KeyError, TypeError):
            saved = {}
        child = None
        code, out, err = 75, '', 'role query interrupted\n'

        def interrupted(signum, _frame):
            raise InterruptedError('role query interrupted by signal ' + str(signum))

        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(sig, interrupted)
        try:
            child = subprocess.Popen([args.router, 'mode', '--json', '--project', project],
                                     stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                     stderr=subprocess.PIPE, start_new_session=True)
            stdout, stderr = child.communicate(timeout=4)
            code = child.returncode if child.returncode >= 0 else 75
            out, err = stdout[:65536].decode(errors='replace'), stderr[:65536].decode(errors='replace')
            if code == 0:
                if len(stdout) > 65536 or not valid_response(json.loads(out)):
                    raise ValueError('invalid router response')
        except subprocess.TimeoutExpired:
            code, out, err = 75, '', 'role query unavailable: timeout\n'
        except (OSError, ValueError) as exc:
            code, out, err = 75, '', 'role query unavailable: ' + type(exc).__name__ + '\n'
        finally:
            # A timed-out/interrupted Popen has not reaped its group leader,
            # reserving the PID while we signal its owned group. Never signal a
            # numeric group ID after communicate has already reaped its leader.
            for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
                signal.signal(sig, signal.SIG_IGN)
            if child is not None:
                if child.returncode is None:
                    try:
                        os.killpg(child.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    try:
                        child.wait(timeout=0.5)
                    except subprocess.TimeoutExpired:
                        code, out, err = 75, '', 'role query cleanup incomplete\n'
                child.stdout.close()
                child.stderr.close()
        if code != 0 and not err:
            err = 'role query unavailable; retry after backoff\n'
        record = {'at': time.time(), 'code': code, 'stdout': out, 'stderr': err,
                  'last_success': {'at': time.time(), 'stdout': out} if code == 0 else saved.get('last_success')}
        temp = cache.with_suffix('.tmp.' + str(os.getpid()))
        temp.write_text(json.dumps(record))
        os.chmod(temp, 0o600)
        os.replace(temp, cache)
        sys.stdout.write(out if code == 0 or not args.display_cache else (record.get('last_success') or {}).get('stdout', ''))
        sys.stderr.write(err)
        return code


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError) as exc:
        print('role query unavailable: ' + type(exc).__name__, file=sys.stderr)
        sys.exit(75)
