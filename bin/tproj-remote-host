#!/usr/bin/env bash
# tproj-remote-host - persistent remote Claude/Codex tmux sessions.
set -euo pipefail

# LaunchAgents and non-login SSH sessions do not inherit the interactive shell's
# PATH.  Keep the helper usable in both contexts without requiring shell init
# files on the remote host.
path_prefix=("$HOME/bin" "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin /usr/bin /bin)
for path_entry in "${path_prefix[@]}"; do
  [[ -d "$path_entry" ]] || continue
  case ":${PATH:-}:" in
    *":$path_entry:"*) ;;
    *) PATH="$path_entry${PATH:+:$PATH}" ;;
  esac
done
export PATH

usage() { printf '%s\n' 'Usage: tproj-remote-host list|ensure-all|register|unregister|status|identity|ensure|attach|reattach|stop|migrate|separate [--path ABSOLUTE_PATH] [--role cc|cdx] [--alias NAME]' >&2; exit 2; }
die() { printf 'tproj-remote-host: %s\n' "$*" >&2; exit 1; }

action=${1:-}; case "$action" in list|status|identity|ensure|attach|reattach|stop|migrate|separate|register|unregister|ensure-all) shift ;; -h|--help) usage ;; *) usage ;; esac
project_path=; role=; alias_name=
while (($#)); do
  case "$1" in
    --path) (($# >= 2)) || usage; project_path=$2; shift 2 ;;
    --role) (($# >= 2)) || usage; role=$2; shift 2 ;;
    --alias) (($# >= 2)) || usage; alias_name=$2; shift 2 ;;
    *) usage ;;
  esac
done

state_dir=${TPROJ_REMOTE_STATE_DIR:-${HOME:?}/.config/tproj-remote}
projects_file=$state_dir/projects
catalog_file=$state_dir/catalog.yml
tmux_bin=$(command -v tmux || true)
tmux_run() { [[ -n "$tmux_bin" ]] || die 'required CLI not found on PATH: tmux'; if [[ -n "${TPROJ_TMUX_SOCKET:-}" ]]; then "$tmux_bin" -L "$TPROJ_TMUX_SOCKET" "$@"; else "$tmux_bin" "$@"; fi; }
validate_path() { [[ "$1" == /* ]] || die '--path must be an absolute path'; [[ -d "$1" ]] || die "project path does not exist or is not a directory: $1"; }
validate_field() { [[ "$1" != *$'\n'* && "$1" != *$'\t'* && "$1" != *'|'* ]] || die 'path or alias contains an unsupported delimiter'; }
catalog() {
  mkdir -p "$state_dir"
  python3 - "$catalog_file" "$projects_file" "$@" <<'PY'
import hashlib
import json
import os
import re
import sys
import tempfile

catalog, legacy, action, *args = sys.argv[1:]
def fail(message):
    raise SystemExit("tproj-remote-host: " + message)
def ident(path):
    return hashlib.sha256(path.encode()).hexdigest()[:16]
def default_alias(path):
    name = os.path.basename(path.rstrip("/"))
    name = re.sub(r"[^A-Za-z0-9._-]", "-", name).strip("-")
    return name or ident(path)
def validate(entry):
    if set(entry) != {"id", "path", "alias"}:
        fail("invalid catalog entry")
    if not isinstance(entry["path"], str) or not entry["path"].startswith("/") or any(c in entry["path"] for c in "\n\t|"):
        fail("invalid catalog path")
    if entry["id"] != ident(entry["path"]):
        fail("invalid catalog id")
    if not isinstance(entry["alias"], str) or not re.fullmatch(r"[A-Za-z0-9._-]+", entry["alias"]):
        fail("invalid catalog alias")
def load():
    if os.path.exists(catalog):
        lines = open(catalog, encoding="utf-8").read().splitlines()
        if lines[:2] != ["version: 1", "projects:"]:
            fail("invalid catalog header")
        entries = []
        rest = lines[2:]
        if len(rest) % 3:
            fail("invalid catalog structure")
        for i in range(0, len(rest), 3):
            match = [re.fullmatch(prefix + r"(\"(?:[^\"\\]|\\.)*\")", line) for prefix, line in zip(("  - id: ", "    path: ", "    alias: "), rest[i:i+3])]
            if not all(match):
                fail("invalid catalog structure")
            entry = dict(zip(("id", "path", "alias"), (json.loads(m.group(1)) for m in match)))
            validate(entry)
            entries.append(entry)
    else:
        entries = []
        if os.path.exists(legacy):
            for path in open(legacy, encoding="utf-8").read().splitlines():
                if not path:
                    continue
                entry = {"id": ident(path), "path": path, "alias": default_alias(path)}
                validate(entry)
                if any(e["path"] == path for e in entries):
                    continue
                if any(e["alias"] == entry["alias"] for e in entries):
                    entry["alias"] += "-" + entry["id"][:6]
                entries.append(entry)
        save(entries)
    if len({e["id"] for e in entries}) != len(entries) or len({e["alias"] for e in entries}) != len(entries):
        fail("duplicate catalog identity")
    return entries
def save(entries):
    data = "version: 1\nprojects:\n" + "".join(
        "  - id: " + json.dumps(e["id"]) + "\n    path: " + json.dumps(e["path"]) +
        "\n    alias: " + json.dumps(e["alias"]) + "\n" for e in entries)
    fd, tmp = tempfile.mkstemp(prefix=".catalog.", dir=os.path.dirname(catalog))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            os.fchmod(f.fileno(), 0o600)
            f.write(data)
        os.replace(tmp, catalog)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
entries = load()
if action == "register":
    path, alias = args
    alias = alias or default_alias(path)
    if not re.fullmatch(r"[A-Za-z0-9._-]+", alias):
        fail("alias must contain only letters, digits, dot, underscore, or hyphen")
    existing = next((e for e in entries if e["path"] == path), None)
    if existing:
        if alias != existing["alias"] and args[1]:
            if any(e["alias"] == alias and e["path"] != path for e in entries):
                fail("alias is already registered")
            existing["alias"] = alias
            save(entries)
    else:
        if any(e["alias"] == alias for e in entries):
            fail("alias is already registered")
        entries.append({"id": ident(path), "path": path, "alias": alias})
        save(entries)
elif action == "unregister":
    path = args[0]
    updated = [e for e in entries if e["path"] != path]
    if len(updated) != len(entries):
        save(updated)
elif action == "contains":
    if not any(e["path"] == args[0] for e in entries):
        fail("path is not registered")
elif action == "alias":
    entry = next((e for e in entries if e["path"] == args[0]), None)
    if entry is None:
        fail("path is not registered")
    print(entry["alias"])
elif action == "list":
    for e in entries:
        print(e["id"] + "\t" + e["path"] + "\t" + e["alias"])
else:
    fail("invalid catalog operation")
PY
}
validate_role() { case "$1" in cc|cdx) ;; *) die '--role must be cc or cdx' ;; esac; }
cli_for_role() { [[ "$1" == cc ]] && printf claude || printf codex; }
resolve_cli() { command -v "$1" 2>/dev/null || true; }
session_for() {
  local r=$1 p=$2 digest
  if command -v sha256sum >/dev/null 2>&1; then digest=$(printf '%s\0%s' "$r" "$p" | sha256sum | awk '{print substr($1,1,16)}')
  elif command -v shasum >/dev/null 2>&1; then digest=$(printf '%s\0%s' "$r" "$p" | shasum -a 256 | awk '{print substr($1,1,16)}')
  else digest=$(printf '%s\0%s' "$r" "$p" | cksum | awk '{print $1}'); fi
  printf 'tproj-remote-%s-%s' "$r" "$digest"
}
shared_session_for() {
  local p=$1 digest
  if command -v sha256sum >/dev/null 2>&1; then digest=$(printf '%s' "$p" | sha256sum | awk '{print substr($1,1,16)}')
  elif command -v shasum >/dev/null 2>&1; then digest=$(printf '%s' "$p" | shasum -a 256 | awk '{print substr($1,1,16)}')
  else digest=$(printf '%s' "$p" | cksum | awk '{print $1}'); fi
  printf 'tproj-remote-%s' "$digest"
}
role_tag() { [[ "$1" == cc ]] && printf claude-p1 || printf codex-p1; }
pane_for() {
  local s=$1 r=$2 tag pane role project
  tag=$(role_tag "$r")
  while IFS='|' read -r pane role project; do
    [[ "$role" == "$tag" && "$project" == "$3" ]] && { printf '%s' "$pane"; return 0; }
  done < <(tmux_run list-panes -t "=$s:dev" -F '#{pane_id}|#{@role}|#{@project}' 2>/dev/null)
  return 1
}
tag_pane() {
  local pane=$1 r=$2 p=$3 alias_name=$4
  tmux_run set-option -pt "$pane" @role "$(role_tag "$r")"
  tmux_run set-option -pt "$pane" @alias "$alias_name"
  tmux_run set-option -pt "$pane" @column 1
  tmux_run set-option -pt "$pane" @project "$p"
  initialize_role_metadata "$pane"
}
initialize_role_metadata() {
  local pane=$1 option default current
  for option in active_model model_tier orchestration_role role_epoch; do
    case "$option" in
      active_model|model_tier) default=unknown ;;
      orchestration_role) default=solo-fallback ;;
      role_epoch) default=0 ;;
    esac
    current=$(tmux_run show-options -pv -t "$pane" "@$option" 2>/dev/null || true)
    [[ -n "$current" ]] || tmux_run set-option -pt "$pane" "@$option" "$default"
  done
}
agent_status() {
  local s=$1 c=$2 pid cmd name
  pid=$(tmux_run display-message -t "$s" -p '#{pane_pid}' 2>/dev/null || true)
  cmd=$(ps -p "$pid" -o command= 2>/dev/null || true)
  name=${c##*/}
  # npm updates may leave launch and status resolving different CLI symlinks.
  [[ -n "$pid" && ( "$cmd" == *"$c"* || "$cmd" == *"/$name "* || "$cmd" == *"/$name" ) ]] && printf '%s' "$pid"
}
start_command() {
  local r=$1 c q npm_path sign_path update_path
  c=$(resolve_cli "$(cli_for_role "$r")")
  [[ -n "$c" ]] || die "required CLI not found on PATH: $(cli_for_role "$r")"
  q=$(printf '%q' "$c")
  if [[ "$r" == cdx ]]; then
    # Match local startup: update before resume, never while attaching to an
    # existing session. An unavailable registry must not prevent work.
    npm_path=$(resolve_cli npm)
    if [[ -n "$npm_path" ]]; then
      update_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tproj-cli-update"
      [[ -x "$update_path" ]] || update_path=$(resolve_cli tproj-cli-update)
      [[ -n "$update_path" ]] || update_path=tproj-cli-update
      printf '%q @openai/codex ' "$update_path"
      sign_path=$(resolve_cli sign-codex)
      [[ -z "$sign_path" ]] || printf '%q ' "$sign_path"
      printf '|| printf "Codex update failed; using installed version\\n" >&2; '
      printf 'hash -r; '
    fi
  fi
  [[ "$r" == cc ]] && printf '%s --continue || exec %s' "$q" "$q" || printf '%s resume --last || exec %s' "$q" "$q"
}
shared_pane_status() {
  local p=$1 r=$2 s pane c pid
  s=$(shared_session_for "$p")
  pane=$(pane_for "$s" "$r" "$p") || return 1
  c=$(resolve_cli "$(cli_for_role "$r")")
  [[ -n "$c" ]] || return 1
  pid=$(agent_status "$pane" "$c") || return 1
  printf '%s|%s|%s' "$s" "$pane" "$pid"
}
read_identity() {
  local p=$1 r=$2 s pane fields
  s=$(shared_session_for "$p")
  if ! pane=$(pane_for "$s" "$r" "$p"); then
    s=$(session_for "$r" "$p")
    pane=$(pane_for "$s" "$r" "$p") || die 'target pane not found'
  fi
  fields=$(tmux_run display-message -t "$pane" -p '#{pane_id}|#{pane_pid}|#{pane_dead}|#{pane_current_command}|#{@alias}|#{@project}|#{@role}|#{@role_epoch}|#{@orchestration_role}') || die 'target pane unavailable'
  python3 - "$s" "$p" "$r" "$fields" <<'PY'
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

session, project, platform, fields = sys.argv[1:]
def fail():
    raise SystemExit('tproj-remote-host: target identity unavailable')
parts = fields.split('|')
if len(parts) != 9:
    fail()
pane, pane_pid, dead, command, alias, pane_project, tag, epoch, role = parts
expected = 'claude-p1' if platform == 'cc' else 'codex-p1'
if (not pane.startswith('%') or not pane_pid.isdigit() or int(pane_pid) <= 0 or
        dead != '0' or pane_project != project or tag != expected or
        not re.fullmatch(r'[A-Za-z0-9._-]+', alias) or
        not epoch.isdigit() or int(epoch) <= 0):
    fail()
if not command.strip():
    fail()
safe = lambda value: re.sub(r'[^A-Za-z0-9_.-]+', '_', value) or 'unknown'
registry_alias = alias + '.' + platform
state = Path(os.environ.get('MODEL_ROLE_CACHE', str(Path.home() / '.cache/tproj-model-role'))) / safe(session) / (safe(registry_alias) + '.json')
try:
    record = json.loads(state.read_text())
    pid, started = record['pid'], record['pid_start']
    if (type(pid) is not int or pid <= 0 or type(started) is not int or started <= 0 or
            record.get('alias') != registry_alias or record.get('project') != project or
            record.get('role_epoch') != int(epoch) or record.get('role') != role or
            record.get('session') != session):
        fail()
    result = subprocess.run(['/bin/ps', '-p', str(pid), '-o', 'lstart='], capture_output=True, text=True, timeout=2)
    if result.returncode or int(time.mktime(time.strptime(result.stdout.strip(), '%a %b %d %H:%M:%S %Y'))) != started:
        fail()
    agent_command = subprocess.run(['/bin/ps', '-p', str(pid), '-o', 'command='], capture_output=True, text=True, timeout=2)
    agent_text = agent_command.stdout.lower()
    if agent_command.returncode or (platform == 'cc' and 'claude' not in agent_text) or (platform == 'cdx' and not ('codex' in agent_text or 'node' in agent_text)):
        fail()
    current = pid
    for _ in range(32):
        if current == int(pane_pid):
            break
        result = subprocess.run(['/bin/ps', '-p', str(current), '-o', 'ppid='], capture_output=True, text=True, timeout=2)
        current = int(result.stdout.strip()) if result.returncode == 0 else 0
        if current <= 1:
            fail()
    else:
        fail()
except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired, json.JSONDecodeError):
    fail()
print(json.dumps({'session': session, 'pane': pane, 'alias': registry_alias, 'project': project,
                  'platform': platform, 'pid': pid, 'pid_start': started,
                  'role': record.get('role'), 'role_epoch': int(epoch)}, separators=(',', ':')))
PY
}
ensure_one() {
  local p=$1 r=$2 c_name c s pid start shared pane alias_name other legacy_other
  validate_path "$p"; validate_role "$r"; c_name=$(cli_for_role "$r"); c=$(resolve_cli "$c_name"); [[ -n "$c" ]] || die "required CLI not found on PATH: $c_name"
  shared=$(shared_session_for "$p")
  if tmux_run has-session -t "=$shared" 2>/dev/null; then
    if pane=$(pane_for "$shared" "$r" "$p"); then
      pid=$(agent_status "$pane" "$c") || true
      [[ -n "$pid" ]] || die "shared pane exists but is not running $c: $pane"
      initialize_role_metadata "$pane"
    else
      alias_name=$(catalog alias "$p") || return 1
      start=$(start_command "$r")
      pane=$(tmux_run split-window -d -P -F '#{pane_id}' -t "=$shared:dev" -c "$p" "$start") || die "could not split shared session: $shared"
      tag_pane "$pane" "$r" "$p" "$alias_name"
    fi
    printf '%s\n' "$shared"; return
  fi
  s=$(session_for "$r" "$p")
  if tmux_run has-session -t "$s" 2>/dev/null; then
    pid=$(agent_status "$s" "$c") || true
    [[ -n "$pid" ]] || die "session exists but is not running $c: $s"
    if pane=$(pane_for "$s" "$r" "$p"); then
      initialize_role_metadata "$pane"
    fi
    tmux_run set-option -t "$s" status off
    tmux_run set-option -t "$s" mouse on
    printf '%s\n' "$s"; return
  fi
  alias_name=$(catalog alias "$p") || { catalog register "$p" ""; alias_name=$(catalog alias "$p"); }
  start=$(start_command "$r")
  tmux_run new-session -d -s "$s" -n dev -c "$p" "$start" || die "could not create role session: $s"
  pane=$(tmux_run display-message -t "=$s:dev" -p '#{pane_id}')
  tag_pane "$pane" "$r" "$p" "$alias_name"
  tmux_run set-option -t "$s" status off
  tmux_run set-option -t "$s" mouse on
  printf '%s\n' "$s"
}
separate_pair() {
  local p=$1 shared cc_pane cdx_pane cc_session cdx_session cc_pid cdx_pid
  shared=$(shared_session_for "$p")
  tmux_run has-session -t "=$shared" 2>/dev/null || die "shared session missing: $shared"
  cc_pane=$(pane_for "$shared" cc "$p") || die 'CC pane missing'
  cdx_pane=$(pane_for "$shared" cdx "$p") || die 'Cdx pane missing'
  cc_pid=$(agent_status "$cc_pane" "$(resolve_cli claude)") || die 'CC agent not running'
  cdx_pid=$(agent_status "$cdx_pane" "$(resolve_cli codex)") || die 'Cdx agent not running'
  cc_session=$(session_for cc "$p"); cdx_session=$(session_for cdx "$p")
  if tmux_run has-session -t "=$cc_session" 2>/dev/null || tmux_run has-session -t "=$cdx_session" 2>/dev/null; then
    die 'role session already exists; refusing to move live panes'
  fi
  tmux_run new-session -d -s "$cc_session" -n hold -c "$p" 'sleep 3600'
  tmux_run new-session -d -s "$cdx_session" -n hold -c "$p" 'sleep 3600'
  tmux_run break-pane -d -s "$cdx_pane" -t "=$cdx_session:1" -n dev || die 'could not separate Cdx pane'
  tmux_run move-window -s "=$shared:dev" -t "=$cc_session:1" || die 'could not move CC window'
  tmux_run kill-window -t "=$cc_session:0"
  tmux_run kill-window -t "=$cdx_session:0"
  tmux_run set-option -t "$cc_session" status off
  tmux_run set-option -t "$cdx_session" status off
  tmux_run set-option -t "$cc_session" mouse on
  tmux_run set-option -t "$cdx_session" mouse on
  [[ "$(tmux_run display-message -t "$cc_pane" -p '#{pane_pid}')" == "$cc_pid" ]] || die 'CC pane PID changed'
  [[ "$(tmux_run display-message -t "$cdx_pane" -p '#{pane_pid}')" == "$cdx_pid" ]] || die 'Cdx pane PID changed'
  printf '%s|%s\n' "$cc_session" "$cdx_session"
}
migrate_pair() {
  local p=$1 shared cc_session cdx_session cc_pane cdx_pane alias_name cc_pid cdx_pid
  catalog contains "$p"
  shared=$(shared_session_for "$p")
  if tmux_run has-session -t "=$shared" 2>/dev/null; then die "shared session already exists: $shared"; fi
  cc_session=$(session_for cc "$p"); cdx_session=$(session_for cdx "$p")
  tmux_run has-session -t "=$cc_session" 2>/dev/null || die "legacy CC session missing: $cc_session"
  tmux_run has-session -t "=$cdx_session" 2>/dev/null || die "legacy Cdx session missing: $cdx_session"
  cc_pane=$(tmux_run list-panes -t "=$cc_session" -F '#{pane_id}')
  cdx_pane=$(tmux_run list-panes -t "=$cdx_session" -F '#{pane_id}')
  [[ "$cc_pane" == %* && "$cdx_pane" == %* && "$cc_pane" != *$'\n'* && "$cdx_pane" != *$'\n'* ]] || die 'legacy sessions must contain exactly one pane each'
  cc_pid=$(agent_status "$cc_pane" "$(resolve_cli claude)") || die 'legacy CC pane is not running Claude'
  cdx_pid=$(agent_status "$cdx_pane" "$(resolve_cli codex)") || die 'legacy Cdx pane is not running Codex'
  alias_name=$(catalog alias "$p")
  # A temporary window is needed to establish the new session; both agent panes move unchanged.
  tmux_run new-session -d -s "$shared" -n hold -c "$p" 'sleep 30' || die "could not create migration target: $shared"
  tmux_run move-window -s "=$cc_session:0" -t "=$shared:1" || die 'could not move CC window'
  tmux_run kill-window -t "=$shared:0"
  tmux_run rename-window -t "=$shared:1" dev
  tmux_run join-pane -d -s "$cdx_pane" -t "$cc_pane" || die 'could not join Cdx pane'
  tag_pane "$cc_pane" cc "$p" "$alias_name"
  tag_pane "$cdx_pane" cdx "$p" "$alias_name"
  [[ "$(tmux_run display-message -t "$cc_pane" -p '#{pane_pid}')" == "$cc_pid" ]] || die 'CC pane PID changed during migration'
  [[ "$(tmux_run display-message -t "$cdx_pane" -p '#{pane_pid}')" == "$cdx_pid" ]] || die 'Cdx pane PID changed during migration'
  printf '%s\n' "$shared"
}

case "$action" in
  list)
    [[ -z "$project_path$role$alias_name" ]] || usage
    entries=$(catalog list) || exit 1
    printf 'id|alias|path|cc|cdx\n'
    while IFS=$'\t' read -r id p name; do
      [[ -n "$id" ]] || continue
      row="$id|$name|$p"
      for r in cc cdx; do
        s=$(session_for "$r" "$p")
        if shared_pane_status "$p" "$r" >/dev/null; then state=running
        elif tmux_run has-session -t "$s" 2>/dev/null; then
          c=$(resolve_cli "$(cli_for_role "$r")")
          if [[ -n "$c" ]] && [[ -n "$(agent_status "$s" "$c")" ]]; then state=running; else state=occupied; fi
        else state=stopped; fi
        row+="|$state"
      done
      printf '%s\n' "$row"
    done <<< "$entries"
    ;;
  migrate)
    [[ -n "$project_path" && -z "$role$alias_name" ]] || usage
    validate_path "$project_path"; validate_field "$project_path"
    migrate_pair "$project_path"
    ;;
  separate)
    [[ -n "$project_path" && -z "$role$alias_name" ]] || usage
    validate_path "$project_path"; catalog contains "$project_path"
    separate_pair "$project_path"
    ;;
  register)
    [[ -n "$project_path" && -z "$role" ]] || usage; validate_path "$project_path"; validate_field "$project_path"
    previous_alias=$(catalog alias "$project_path" 2>/dev/null || true)
    catalog register "$project_path" "$alias_name"
    current_alias=$(catalog alias "$project_path")
    if [[ -n "$previous_alias" && "$previous_alias" != "$current_alias" ]]; then
      # Keep the running panes and PIDs; only their routing identity changes.
      for session_name in "$(shared_session_for "$project_path")" "$(session_for cc "$project_path")" "$(session_for cdx "$project_path")"; do
        while IFS='|' read -r pane_id pane_project; do
          [[ -n "$pane_id" && "$pane_project" == "$project_path" ]] || continue
          tmux_run set-option -pt "$pane_id" @alias "$current_alias"
        done < <(tmux_run list-panes -t "=$session_name:dev" -F '#{pane_id}|#{@project}' 2>/dev/null || true)
      done
    fi
    ;;
  unregister)
    [[ -n "$project_path" && -z "$role$alias_name" ]] || usage; [[ "$project_path" == /* ]] || usage
    catalog unregister "$project_path"
    ;;
  ensure-all)
    [[ -z "$project_path$role$alias_name" ]] || usage
    entries=$(catalog list) || exit 1
    failures=0
    while IFS=$'\t' read -r id p name; do
      [[ -n "$p" ]] || continue
      for r in cc cdx; do
        if ! err=$(ensure_one "$p" "$r" >/dev/null 2>&1); then
          printf 'ensure-all: failed %s %s\n' "$r" "$p" >&2
          failures=1
        fi
      done
    done <<< "$entries"
    exit "$failures"
    ;;
  reattach)
    # Recovery must never call ensure_one, register, update, or start a CLI.
    [[ -n "$project_path" && -n "$role" && -z "$alias_name" ]] || usage
    validate_path "$project_path"; validate_field "$project_path"; validate_role "$role"
    s=$(session_for "$role" "$project_path")
    tmux_run has-session -t "=$s" 2>/dev/null || die 'remote session ended; automatic restart is disabled'
    pane=$(pane_for "$s" "$role" "$project_path") || die 'existing remote role pane not found'
    [[ $(tmux_run display-message -t "$pane" -p '#{pane_dead}') == 0 ]] || die 'remote pane ended; automatic restart is disabled'
    tmux_run attach-session -t "=$s"
    ;;
  status|identity|ensure|attach|stop)
    [[ -n "$project_path" && -n "$role" && -z "$alias_name" ]] || usage; validate_path "$project_path"; validate_field "$project_path"; validate_role "$role"
    c_name=$(cli_for_role "$role"); c=$(resolve_cli "$c_name"); [[ -n "$c" ]] || die "required CLI not found on PATH: $c_name"; s=$(session_for "$role" "$project_path")
    if [[ "$action" == identity ]]; then read_identity "$project_path" "$role"
    elif [[ "$action" == status ]]; then
      pid=
      if shared_info=$(shared_pane_status "$project_path" "$role"); then
        printf 'running|%s|%s\n' "${shared_info%%|*}" "${shared_info##*|}"
      elif tmux_run has-session -t "$s" 2>/dev/null && pid=$(agent_status "$s" "$c"); [[ -n "$pid" ]]; then printf 'running|%s|%s\n' "$s" "$pid"; else printf 'stopped|%s|-\n' "$s"; fi
    elif [[ "$action" == ensure ]]; then ensure_one "$project_path" "$role"
    elif [[ "$action" == stop ]]; then
      catalog contains "$project_path"
      shared=$(shared_session_for "$project_path")
      if tmux_run has-session -t "=$shared" 2>/dev/null; then
        pane=$(pane_for "$shared" "$role" "$project_path") || die "role pane not found in shared session: $shared"
        pid=$(agent_status "$pane" "$c") || die "shared pane is not running $c: $pane"
        tmux_run kill-pane -t "$pane"
        s=$shared
      elif tmux_run has-session -t "$s" 2>/dev/null; then
        pid=$(agent_status "$s" "$c") || true
        [[ -n "$pid" ]] || die "session exists but is not running $c: $s"
        tmux_run kill-session -t "$s"
      fi
      printf 'stopped|%s|-\n' "$s"
    else
      catalog register "$project_path" ""
      s=$(ensure_one "$project_path" "$role")
      shared=$(shared_session_for "$project_path")
      [[ "$s" != "$shared" ]] || die 'shared pair needs separate --path before role attach'
      tmux_run attach-session -t "$s"
    fi
    ;;
esac
