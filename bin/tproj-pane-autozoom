#!/bin/bash
# tproj-pane-autozoom - resize active pane and column to dominate the window.
#
# Triggered by after-select-pane hook (via tproj-pane-focus-hook) or directly
# from the GUI toggle. Flag-gated: no-op when the enable flag is absent.
#
# Usage:
#   tproj-pane-autozoom [<session>]   # sync (only acts when flag exists)
#   tproj-pane-autozoom --enable      # touch flag + sync
#   tproj-pane-autozoom --disable     # remove flag + restore uniform layout
#   tproj-pane-autozoom --reset       # restore uniform layout (flag untouched)
#   tproj-pane-autozoom --status      # print "on" or "off"
#
# Flag file: ${TPROJ_STATE_DIR:-$HOME/.config/tproj}/auto-zoom.enabled
# Width is derived from the Ghostty window width (W) and the column count (N).
# - active column = BUDGET * ACTIVE_SHARES / TOTAL_SHARES
# - other columns = BUDGET / TOTAL_SHARES (each)
#   where BUDGET = W - (N-1) borders, TOTAL_SHARES = ACTIVE_SHARES + (N-1)
# Defaults: ACTIVE_SHARES=2 -> active is twice as wide as each other column.
# Caps:
# - TPROJ_AUTOZOOM_W_MAX / W_MIN (default 120): upper bound on active width
# - TPROJ_AUTOZOOM_H_MIN (default 40): minimum active pane height (vertical)
# Tuning:
# - TPROJ_AUTOZOOM_ACTIVE_SHARES (default 2): how many "shares" the active
#   column gets relative to each other column. Active = 2x non-active by default.
# Debug:     TPROJ_AUTOZOOM_DEBUG=1 enables /tmp/tproj-pane-autozoom.log

set -euo pipefail

FLAG_DIR="${TPROJ_STATE_DIR:-$HOME/.config/tproj}"
FLAG="$FLAG_DIR/auto-zoom.enabled"
ACTIVE_SHARES="${TPROJ_AUTOZOOM_ACTIVE_SHARES:-2}"
TARGET_W_CAP="${TPROJ_AUTOZOOM_W_MAX:-${TPROJ_AUTOZOOM_W_MIN:-120}}"
TARGET_H="${TPROJ_AUTOZOOM_H_MIN:-${TPROJ_AUTOZOOM_H_MAX:-40}}"
DEBUG_LOG="/tmp/tproj-pane-autozoom.log"

# Log entry only under DEBUG gate (same condition as dlog), helps diagnose hook firing.
if [ "${TPROJ_AUTOZOOM_DEBUG:-0}" = "1" ]; then
  { echo "[$(date '+%H:%M:%S')] enter args=[$*] pid=$$"; } >> "$DEBUG_LOG" 2>/dev/null || true
fi

dlog() {
  [ "${TPROJ_AUTOZOOM_DEBUG:-0}" = "1" ] || return 0
  { echo "[$(date '+%H:%M:%S')]   $*"; } >> "$DEBUG_LOG" 2>/dev/null || true
}

# Shared tmux layout lock (same name as tproj-drop-column / add-column /
# rebalance) so autozoom's resize burst cannot interleave with other layout
# mutations. Release is trap-guaranteed so an early exit never leaves it held.
LAYOUT_LOCK_NAME="tproj-layout"
AZ_LOCK_HELD=false
az_release_lock() {
  if [ "$AZ_LOCK_HELD" = "true" ]; then
    tmux wait-for -U "$LAYOUT_LOCK_NAME" 2>/dev/null || true
    AZ_LOCK_HELD=false
  fi
}
trap az_release_lock EXIT INT TERM

# Default session: arg1 if non-flag, else env, else tproj-workspace
default_session() {
  if [ -n "${TMUX_SESSION:-}" ]; then echo "$TMUX_SESSION"; return; fi
  echo "tproj-workspace"
}

# Restore uniform layout: equal column widths + default Codex top ratio (42%).
# Used by --disable and --reset.
restore_uniform() {
  local sess="$1"
  local rebalance="$HOME/bin/rebalance-workspace-columns"
  if [ -x "$rebalance" ]; then
    "$rebalance" "$sess" 2>/dev/null || true
  fi
  local win_h target_h
  win_h=$(tmux display-message -t "$sess" -p '#{window_height}' 2>/dev/null || echo "")
  [ -z "$win_h" ] && return 0
  target_h=$(awk -v h="$win_h" 'BEGIN { printf "%d", h*0.42 }')
  [ "$target_h" -lt 5 ] && target_h=5
  # Resize each column's top pane (Codex) to default height.
  tmux list-panes -t "$sess" -F '#{@column} #{pane_top} #{pane_id}' 2>/dev/null \
    | awk 'NF==3 && $1!="" { if (!(($1) in seen) || $2<seen[$1]) { seen[$1]=$2; rep[$1]=$3 } }
           END { for (c in rep) print rep[c] }' \
    | while read -r pid; do
        [ -n "$pid" ] && tmux resize-pane -t "$pid" -y "$target_h" 2>/dev/null || true
      done
}

case "${1:-}" in
  --enable)
    mkdir -p "$FLAG_DIR"
    touch "$FLAG"
    shift
    set -- "$(default_session)" "$@"
    ;;
  --disable)
    rm -f "$FLAG"
    sess="${2:-$(default_session)}"
    restore_uniform "$sess"
    exit 0
    ;;
  --reset)
    sess="${2:-$(default_session)}"
    restore_uniform "$sess"
    exit 0
    ;;
  --status)
    [ -f "$FLAG" ] && echo "on" || echo "off"
    exit 0
    ;;
  -h|--help)
    sed -n '2,16p' "$0"
    exit 0
    ;;
  "")
    set -- "$(default_session)"
    ;;
esac

SESSION="${1:-$(default_session)}"

# Flag-gated: no-op when disabled
[ -f "$FLAG" ] || exit 0

# Verify session exists
tmux has-session -t "$SESSION" 2>/dev/null || exit 0

# Active pane and its column tag
ACTIVE=""
ACTIVE_COL=""
ACTIVE_ROLE=""
read -r ACTIVE ACTIVE_COL ACTIVE_ROLE < <(tmux display-message -t "$SESSION" -p '#{pane_id} #{@column} #{@role}' 2>/dev/null) || true
[ -z "$ACTIVE" ] && exit 0
[ -z "$ACTIVE_COL" ] && exit 0   # @column tag missing => non-multi-project mode

WIN_W=$(tmux display-message -t "$SESSION" -p '#{window_width}' 2>/dev/null || echo "")
WIN_H=$(tmux display-message -t "$SESSION" -p '#{window_height}' 2>/dev/null || echo "")
if [ -z "$WIN_W" ] || [ -z "$WIN_H" ]; then
  exit 0
fi

# Per-column representative pane (top-most pane: smallest pane_top).
# resize-pane -x on any pane in a column moves that column boundary.
COLS=$(tmux list-panes -t "$SESSION" -F '#{@column} #{pane_top} #{pane_id}' 2>/dev/null \
  | awk 'NF==3 && $1!="" { if (!(($1) in seen) || $2<seen[$1]) { seen[$1]=$2; rep[$1]=$3 } }
         END { for (c in rep) print c, rep[c] }' \
  | sort -n)

if [ -z "$COLS" ]; then
  exit 0
fi

N_COLS=$(printf '%s\n' "$COLS" | grep -c . || echo 0)
if [ "$N_COLS" -lt 2 ]; then
  exit 0
fi

[ "$TARGET_W_CAP" -lt 1 ] && TARGET_W_CAP=1
[ "$TARGET_H" -gt "$WIN_H" ] && TARGET_H=$WIN_H
[ "$TARGET_H" -lt 1 ] && TARGET_H=1
[ "$ACTIVE_SHARES" -lt 1 ] && ACTIVE_SHARES=1

# Horizontal sizing: keep the active column at its current width if it is
# already large enough, but always redistribute the other columns evenly so
# stale zoom widths from previous active columns do not remain.
ACTIVE_COL_REP_PANE=""
while IFS=' ' read -r col rep; do
  [ "$col" = "$ACTIVE_COL" ] && ACTIVE_COL_REP_PANE="$rep" && break
done <<EOF_COLS
$COLS
EOF_COLS
[ -z "$ACTIVE_COL_REP_PANE" ] && exit 0

CURRENT_COL_W=$(tmux display-message -t "$ACTIVE_COL_REP_PANE" -p '#{pane_width}' 2>/dev/null || echo 0)
case "$CURRENT_COL_W" in (*[!0-9]*|"") CURRENT_COL_W=0 ;; esac

# Account for tmux pane borders: each boundary between columns consumes 1 cell,
# so the actual budget for pane widths is WIN_W - (N_COLS - 1).
BORDERS=$(( N_COLS - 1 ))
BUDGET=$(( WIN_W - BORDERS ))

# Share-based proportional split derived purely from window width and column
# count: active gets ACTIVE_SHARES out of (ACTIVE_SHARES + N - 1) total shares.
TOTAL_SHARES=$(( ACTIVE_SHARES + BORDERS ))
NEW_ACTIVE_W=$(( BUDGET * ACTIVE_SHARES / TOTAL_SHARES ))
OTHER_W=$(( BUDGET / TOTAL_SHARES ))

# Cap active so it doesn't bloat on huge windows. Re-derive other width from
# the residual so the rightmost column ends up at exactly OTHER_W.
if [ "$NEW_ACTIVE_W" -gt "$TARGET_W_CAP" ]; then
  NEW_ACTIVE_W=$TARGET_W_CAP
  OTHER_W=$(( (BUDGET - NEW_ACTIVE_W) / BORDERS ))
fi

# Safety: bail if the math degenerates (e.g., negative widths from a tiny window)
if [ "$NEW_ACTIVE_W" -lt 5 ] || [ "$OTHER_W" -lt 5 ]; then
  exit 0
fi

# Acquire the shared layout lock only now, around the resize burst itself. All
# the cheap gates above (flag, session, column count, degenerate math) ran
# lock-free, so on every after-select-pane focus event we grab the lock for the
# minimum possible window. The per-column idempotent skips inside the loop stay
# intact — the lock is an ADDITIONAL safety layer, not a replacement for the
# no-op-when-settled behavior that keeps SIGWINCH quiet.
tmux wait-for -L "$LAYOUT_LOCK_NAME" 2>/dev/null && AZ_LOCK_HELD=true || AZ_LOCK_HELD=false

# Resize every column except the rightmost (LAST_COL). The last column
# absorbs the rounding remainder so we get a deterministic layout.
# With NEW_ACTIVE_W and OTHER_W computed against (BUDGET - borders), the
# residual width on the last column equals OTHER_W exactly.
LAST_COL=$(printf '%s\n' "$COLS" | awk 'END {print $1}')
while IFS=' ' read -r col rep; do
  [ -z "$col" ] && continue
  [ "$col" = "$LAST_COL" ] && continue
  if [ "$col" = "$ACTIVE_COL" ]; then
    [ "$NEW_ACTIVE_W" != "$CURRENT_COL_W" ] && tmux resize-pane -t "$rep" -x "$NEW_ACTIVE_W" 2>/dev/null || true
  else
    # Idempotent: only resize when this column is not already at OTHER_W, so a
    # re-run on an already-settled layout issues zero resize-pane (no SIGWINCH).
    cur_w=$(tmux display-message -t "$rep" -p '#{pane_width}' 2>/dev/null || echo 0)
    case "$cur_w" in (*[!0-9]*|"") cur_w=0 ;; esac
    [ "$OTHER_W" != "$cur_w" ] && tmux resize-pane -t "$rep" -x "$OTHER_W" 2>/dev/null || true
  fi
done <<EOF_COLS
$COLS
EOF_COLS

# Vertical target, derived the same way the horizontal one is: from the window
# size and the number of panes sharing the axis. A fixed row count silently stops
# doing anything once a pane already exceeds it -- focusing a pane that was
# already at the 40-row default in a 73-row window produced no growth at all,
# while the width still moved. TPROJ_AUTOZOOM_H_MIN keeps its documented meaning
# as a floor, so an explicit override is never made smaller.
PANES_IN_COL=$(tmux list-panes -t "$SESSION" -F '#{@column}' 2>/dev/null \
  | awk -v c="$ACTIVE_COL" '$1==c { n++ } END { print n+0 }')
case "$PANES_IN_COL" in (*[!0-9]*|"") PANES_IN_COL=1 ;; esac
V_BORDERS=$(( PANES_IN_COL > 1 ? PANES_IN_COL - 1 : 0 ))
if [ "$V_BORDERS" -gt 0 ]; then
  V_BUDGET=$(( WIN_H - V_BORDERS ))
  V_TOTAL_SHARES=$(( ACTIVE_SHARES + V_BORDERS ))
  PROPORTIONAL_H=$(( V_BUDGET * ACTIVE_SHARES / V_TOTAL_SHARES ))
  [ "$PROPORTIONAL_H" -gt "$TARGET_H" ] && TARGET_H=$PROPORTIONAL_H
  [ "$TARGET_H" -gt "$WIN_H" ] && TARGET_H=$WIN_H
fi
dlog "vertical target=$TARGET_H panes_in_col=$PANES_IN_COL win_h=$WIN_H"

# Vertical grow: enlarge whichever pane is focused, regardless of role.
CURRENT_ACTIVE_H=$(tmux display-message -t "$ACTIVE" -p '#{pane_height}' 2>/dev/null || echo 0)
case "$CURRENT_ACTIVE_H" in (*[!0-9]*|"") CURRENT_ACTIVE_H=0 ;; esac
if [ "$CURRENT_ACTIVE_H" -lt "$TARGET_H" ]; then
  tmux resize-pane -t "$ACTIVE" -y "$TARGET_H" 2>/dev/null || true
fi

az_release_lock
exit 0
